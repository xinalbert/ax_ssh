import { ScrollView, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { FlatTextInput } from "../components/flat-text-input.slint";
import { SettingsField, SettingsRow, SettingsSectionHeading, SettingsToggleRow } from "../components/settings-controls.slint";
import { ThemedComboBox } from "../components/themed-combo-box.slint";

component ThemePaletteEditor inherits VerticalLayout {
    in property <string> title;
    in-out property <string> background-color;
    in-out property <string> panel-color;
    in-out property <string> panel-alt-color;
    in-out property <string> border-color-value;
    in-out property <string> text-color-value;
    in-out property <string> muted-color;
    in-out property <string> accent-color;
    in-out property <string> success-color;
    in-out property <string> danger-color;
    in-out property <string> overlay-color;
    in-out property <string> terminal-foreground-color;
    in-out property <string> terminal-background-color;
    in-out property <string> terminal-selection-color;

    spacing: 0px;

    SettingsSectionHeading { label: root.title; }
    SettingsSectionHeading { label: @tr("SURFACES"); }
    SettingsRow {
        label: @tr("Background");
        description: @tr("Primary workspace surface");
        SettingsField { FlatTextInput { text <=> root.background-color; height: Theme.settings-control-height; accessible-label: @tr("{0} background color", root.title); } }
    }
    SettingsRow {
        label: @tr("Panel");
        description: @tr("Navigation and title surfaces");
        SettingsField { FlatTextInput { text <=> root.panel-color; height: Theme.settings-control-height; accessible-label: @tr("{0} panel color", root.title); } }
    }
    SettingsRow {
        label: @tr("Panel alternative");
        description: @tr("Hover and secondary surfaces");
        SettingsField { FlatTextInput { text <=> root.panel-alt-color; height: Theme.settings-control-height; accessible-label: @tr("{0} secondary panel color", root.title); } }
    }
    SettingsRow {
        label: @tr("Border");
        description: @tr("Dividers and control outlines");
        SettingsField { FlatTextInput { text <=> root.border-color-value; height: Theme.settings-control-height; accessible-label: @tr("{0} border color", root.title); } }
    }

    SettingsSectionHeading { label: @tr("CONTENT AND STATES"); }
    SettingsRow {
        label: @tr("Text");
        description: @tr("Primary readable text");
        SettingsField { FlatTextInput { text <=> root.text-color-value; height: Theme.settings-control-height; accessible-label: @tr("{0} text color", root.title); } }
    }
    SettingsRow {
        label: @tr("Muted text");
        description: @tr("Secondary labels and metadata");
        SettingsField { FlatTextInput { text <=> root.muted-color; height: Theme.settings-control-height; accessible-label: @tr("{0} muted text color", root.title); } }
    }
    SettingsRow {
        label: @tr("Accent / focus");
        description: @tr("Focus rings, selection, and active indicators");
        SettingsField { FlatTextInput { text <=> root.accent-color; height: Theme.settings-control-height; accessible-label: @tr("{0} accent color", root.title); } }
    }
    SettingsRow {
        label: @tr("Success");
        description: @tr("Positive status indicators");
        SettingsField { FlatTextInput { text <=> root.success-color; height: Theme.settings-control-height; accessible-label: @tr("{0} success color", root.title); } }
    }
    SettingsRow {
        label: @tr("Danger");
        description: @tr("Error and destructive indicators");
        SettingsField { FlatTextInput { text <=> root.danger-color; height: Theme.settings-control-height; accessible-label: @tr("{0} danger color", root.title); } }
    }
    SettingsRow {
        label: @tr("Overlay");
        description: @tr("Dialog and transient overlay tint");
        SettingsField { FlatTextInput { text <=> root.overlay-color; height: Theme.settings-control-height; accessible-label: @tr("{0} overlay color", root.title); } }
    }

    SettingsSectionHeading { label: @tr("TERMINAL DEFAULTS"); }
    SettingsRow {
        label: @tr("Foreground");
        description: @tr("Default terminal text color");
        SettingsField { FlatTextInput { text <=> root.terminal-foreground-color; height: Theme.settings-control-height; accessible-label: @tr("{0} terminal foreground color", root.title); } }
    }
    SettingsRow {
        label: @tr("Background");
        description: @tr("Default terminal background color");
        SettingsField { FlatTextInput { text <=> root.terminal-background-color; height: Theme.settings-control-height; accessible-label: @tr("{0} terminal background color", root.title); } }
    }
    SettingsRow {
        label: @tr("Selection");
        description: @tr("Terminal text selection background");
        SettingsField { FlatTextInput { text <=> root.terminal-selection-color; height: Theme.settings-control-height; accessible-label: @tr("{0} terminal selection color", root.title); } }
    }
}

export component AppearanceSettingsPage inherits Rectangle {
    in property <int> scroll-revision: 0;
    in property <[string]> application-font-options;
    in-out property <string> draft-application-font-family;
    in-out property <int> draft-application-font-index;
    in-out property <string> draft-renderer-preference;
    in-out property <string> draft-software-presentation;
    in property <bool> apple-platform;
    in-out property <bool> draft-terminal-compact-rendering;
    in-out property <bool> draft-terminal-row-render-cache;
    in-out property <bool> draft-terminal-cursor-blink;
    in-out property <int> draft-focused-terminal-refresh-fps;
    in-out property <int> draft-unfocused-terminal-refresh-fps;
    in-out property <string> draft-theme-mode;
    in-out property <string> draft-theme-palette;
    in-out property <string> draft-theme-light-background;
    in-out property <string> draft-theme-light-panel;
    in-out property <string> draft-theme-light-panel-alt;
    in-out property <string> draft-theme-light-border;
    in-out property <string> draft-theme-light-text;
    in-out property <string> draft-theme-light-muted;
    in-out property <string> draft-theme-light-accent;
    in-out property <string> draft-theme-light-success;
    in-out property <string> draft-theme-light-danger;
    in-out property <string> draft-theme-light-overlay;
    in-out property <string> draft-theme-light-terminal-foreground;
    in-out property <string> draft-theme-light-terminal-background;
    in-out property <string> draft-theme-light-terminal-selection;
    in-out property <string> draft-theme-dark-background;
    in-out property <string> draft-theme-dark-panel;
    in-out property <string> draft-theme-dark-panel-alt;
    in-out property <string> draft-theme-dark-border;
    in-out property <string> draft-theme-dark-text;
    in-out property <string> draft-theme-dark-muted;
    in-out property <string> draft-theme-dark-accent;
    in-out property <string> draft-theme-dark-success;
    in-out property <string> draft-theme-dark-danger;
    in-out property <string> draft-theme-dark-overlay;
    in-out property <string> draft-theme-dark-terminal-foreground;
    in-out property <string> draft-theme-dark-terminal-background;
    in-out property <string> draft-theme-dark-terminal-selection;

    background: Theme.background;

    appearance-scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-width: self.visible-width;
        viewport-height: max(
            self.visible-height,
            appearance-content.preferred-height + 2 * Theme.space-xl,
        );

        appearance-page := Rectangle {
            width: appearance-scroll.visible-width;
            height: max(
                appearance-scroll.visible-height,
                appearance-content.preferred-height + 2 * Theme.space-xl,
            );
            background: Theme.background;

            appearance-content := VerticalLayout {
                x: Theme.page-padding;
                y: Theme.space-xl;
                width: min(
                    Theme.settings-content-width,
                    parent.width - 2 * Theme.page-padding,
                );
                height: self.preferred-height;
                spacing: 0px;

                SettingsSectionHeading { label: @tr("APPLICATION TYPOGRAPHY"); }
                SettingsRow {
                    label: @tr("Font family");
                    description: @tr("Application interface font");
                    SettingsField {
                        ThemedComboBox {
                            width: parent.width;
                            height: Theme.settings-control-height;
                            model: root.application-font-options;
                            current-index <=> root.draft-application-font-index;
                            accessible-label: @tr("Application font family");
                            selected(value, _index) => { root.draft-application-font-family = value; }
                        }
                    }
                }

                SettingsSectionHeading { label: @tr("RENDERING"); }
                SettingsRow {
                    label: @tr("Renderer");
                    description: @tr("Changes take effect after restarting AxSSH");
                    SettingsField {
                        ThemedComboBox {
                            width: parent.width;
                            height: Theme.settings-control-height;
                            model: [@tr("Automatic"), @tr("GPU"), @tr("Software")];
                            current-index: root.draft-renderer-preference == "gpu" ? 1
                                : (root.draft-renderer-preference == "software" ? 2 : 0);
                            accessible-label: @tr("Rendering backend");
                            selected(_value, index) => {
                                root.draft-renderer-preference = index == 1 ? "gpu"
                                    : (index == 2 ? "software" : "automatic");
                            }
                        }
                    }
                }
                if root.apple-platform : SettingsRow {
                    label: @tr("Software presentation");
                    description: @tr("macOS CPU presentation path; changes take effect after restarting AxSSH");
                    SettingsField {
                        ThemedComboBox {
                            width: parent.width;
                            height: Theme.settings-control-height;
                            model: [@tr("Layer images (fallback)"), @tr("Damage backing store (default)")];
                            current-index: root.draft-software-presentation == "damage-backing-store" ? 1 : 0;
                            accessible-label: @tr("Software presentation path");
                            selected(_value, index) => {
                                root.draft-software-presentation = index == 1
                                    ? "damage-backing-store"
                                    : "layer-images";
                            }
                        }
                    }
                }
                SettingsToggleRow {
                    label: @tr("Blink terminal cursor");
                    description: @tr("Show a blinking cursor while the terminal is focused");
                    checked <=> root.draft-terminal-cursor-blink;
                }
                SettingsRow {
                    label: @tr("Focused refresh rate");
                    description: @tr("Terminal updates while the pane is focused");
                    SettingsField {
                        SpinBox {
                            width: Theme.settings-number-width;
                            height: Theme.settings-control-height;
                            minimum: 1;
                            maximum: 120;
                            value <=> root.draft-focused-terminal-refresh-fps;
                            accessible-label: @tr("Focused terminal refresh rate");
                        }
                        Text { text: @tr("FPS"); color: Theme.muted; vertical-alignment: center; }
                    }
                }
                SettingsRow {
                    label: @tr("Unfocused refresh rate");
                    description: @tr("Visible terminal updates while another pane is focused");
                    SettingsField {
                        SpinBox {
                            width: Theme.settings-number-width;
                            height: Theme.settings-control-height;
                            minimum: 1;
                            maximum: 120;
                            value <=> root.draft-unfocused-terminal-refresh-fps;
                            accessible-label: @tr("Unfocused terminal refresh rate");
                        }
                        Text { text: @tr("FPS"); color: Theme.muted; vertical-alignment: center; }
                    }
                }
                SettingsToggleRow {
                    label: @tr("Compact terminal rendering");
                    description: @tr("Reduce terminal items and omit default background rectangles");
                    checked <=> root.draft-terminal-compact-rendering;
                }
                SettingsToggleRow {
                    label: @tr("Cache unchanged terminal rows");
                    description: @tr("Reuse GPU row layers; may increase graphics memory");
                    checked <=> root.draft-terminal-row-render-cache;
                    show-divider: false;
                }

                SettingsSectionHeading { label: @tr("APPLICATION THEME"); }
                SettingsRow {
                    label: @tr("Display mode");
                    description: @tr("Choose system, light, or dark appearance");
                    SettingsField {
                        ThemedComboBox {
                            width: parent.width;
                            height: Theme.settings-control-height;
                            model: [@tr("Follow system"), @tr("Light"), @tr("Dark")];
                            current-index: root.draft-theme-mode == "system" ? 0
                                : (root.draft-theme-mode == "light" ? 1 : 2);
                            accessible-label: @tr("Application display mode");
                            selected(_value, index) => {
                                root.draft-theme-mode = index == 0 ? "system"
                                    : (index == 1 ? "light" : "dark");
                            }
                        }
                    }
                }
                SettingsRow {
                    label: @tr("Color palette");
                    description: @tr("Apply one color family to both display modes");
                    SettingsField {
                        palette-picker := ThemedComboBox {
                            width: parent.width;
                            height: Theme.settings-control-height;
                            model: ["AxSSH", "Solarized", "Arctic", "Tokyo", "Ember", "Forest", @tr("Custom")];
                            current-index: root.draft-theme-palette == "solarized" ? 1
                                : (root.draft-theme-palette == "arctic" ? 2
                                : (root.draft-theme-palette == "tokyo" ? 3
                                : (root.draft-theme-palette == "ember" ? 4
                                : (root.draft-theme-palette == "forest" ? 5
                                : (root.draft-theme-palette == "custom" ? 6 : 0)))));
                            accessible-label: @tr("Application color palette");
                            selected(_value, index) => {
                                root.draft-theme-palette = index == 1 ? "solarized"
                                    : (index == 2 ? "arctic"
                                    : (index == 3 ? "tokyo"
                                    : (index == 4 ? "ember"
                                    : (index == 5 ? "forest"
                                    : (index == 6 ? "custom" : "axssh")))));
                            }
                        }
                    }
                }

                if root.draft-theme-palette == "custom" : Text {
                    height: max(
                        Theme.settings-section-min-height,
                        self.font-metrics.ascent - self.font-metrics.descent
                            + 2 * Theme.settings-section-padding-y,
                    );
                    text: @tr("Enter #RRGGBB or #RRGGBBAA values. Unsafe contrast falls back to readable colors when saved.");
                    color: Theme.muted;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                }
                if root.draft-theme-palette == "custom" : ThemePaletteEditor {
                    title: @tr("CUSTOM LIGHT PALETTE");
                    background-color <=> root.draft-theme-light-background;
                    panel-color <=> root.draft-theme-light-panel;
                    panel-alt-color <=> root.draft-theme-light-panel-alt;
                    border-color-value <=> root.draft-theme-light-border;
                    text-color-value <=> root.draft-theme-light-text;
                    muted-color <=> root.draft-theme-light-muted;
                    accent-color <=> root.draft-theme-light-accent;
                    success-color <=> root.draft-theme-light-success;
                    danger-color <=> root.draft-theme-light-danger;
                    overlay-color <=> root.draft-theme-light-overlay;
                    terminal-foreground-color <=> root.draft-theme-light-terminal-foreground;
                    terminal-background-color <=> root.draft-theme-light-terminal-background;
                    terminal-selection-color <=> root.draft-theme-light-terminal-selection;
                }
                if root.draft-theme-palette == "custom" : ThemePaletteEditor {
                    title: @tr("CUSTOM DARK PALETTE");
                    background-color <=> root.draft-theme-dark-background;
                    panel-color <=> root.draft-theme-dark-panel;
                    panel-alt-color <=> root.draft-theme-dark-panel-alt;
                    border-color-value <=> root.draft-theme-dark-border;
                    text-color-value <=> root.draft-theme-dark-text;
                    muted-color <=> root.draft-theme-dark-muted;
                    accent-color <=> root.draft-theme-dark-accent;
                    success-color <=> root.draft-theme-dark-success;
                    danger-color <=> root.draft-theme-dark-danger;
                    overlay-color <=> root.draft-theme-dark-overlay;
                    terminal-foreground-color <=> root.draft-theme-dark-terminal-foreground;
                    terminal-background-color <=> root.draft-theme-dark-terminal-background;
                    terminal-selection-color <=> root.draft-theme-dark-terminal-selection;
                }

            }
        }
    }

    changed scroll-revision => { appearance-scroll.viewport-y = 0px; }
}
