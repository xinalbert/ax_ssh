import { ScrollView, Slider, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SettingsField, SettingsRow, SettingsSectionHeading, SettingsToggleRow } from "../components/settings-controls.slint";
import { ThemedComboBox } from "../components/themed-combo-box.slint";

export component TerminalSettingsPage inherits Rectangle {
    in property <[string]> terminal-font-options;
    in-out property <string> draft-font-family;
    in-out property <int> draft-font-index;
    in-out property <int> draft-font-size;
    in-out property <int> draft-line-height-percent;
    in-out property <int> draft-brightness-percent;
    in-out property <bool> draft-bright-bold-text;
    in-out property <int> draft-scrollback-lines;
    in-out property <bool> draft-right-click-copy-or-paste;
    in property <bool> apple-platform: false;
    in-out property <bool> draft-option-as-meta;

    background: Theme.background;

    terminal-scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-width: self.visible-width;

        terminal-page := Rectangle {
            width: terminal-scroll.visible-width;
            height: max(
                terminal-scroll.visible-height,
                terminal-content.preferred-height + 2 * Theme.space-xl,
            );
            background: Theme.background;

            terminal-content := VerticalLayout {
                x: Theme.page-padding;
                y: Theme.space-xl;
                width: min(
                    Theme.settings-content-width,
                    parent.width - 2 * Theme.page-padding,
                );
                height: self.preferred-height;
                spacing: 0px;

                SettingsSectionHeading { label: "TYPOGRAPHY"; }
                SettingsRow {
                    label: "Font family";
                    description: "Terminal character-cell font";
                    SettingsField {
                        ThemedComboBox {
                            width: parent.width;
                            height: Theme.settings-control-height;
                            model: root.terminal-font-options;
                            current-index <=> root.draft-font-index;
                            accessible-label: "Terminal font family";
                            selected(value) => { root.draft-font-family = value; }
                        }
                    }
                }
                SettingsRow {
                    label: "Font size";
                    description: "9-32 px";
                    SettingsField {
                        SpinBox {
                            width: Theme.settings-number-width;
                            height: Theme.settings-control-height;
                            minimum: 9;
                            maximum: 32;
                            value <=> root.draft-font-size;
                            accessible-label: "Terminal font size";
                        }
                        Text {
                            width: Theme.settings-unit-width;
                            text: "px";
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                }
                SettingsRow {
                    label: "Line height";
                    description: "100-200 percent";
                    SettingsField {
                        SpinBox {
                            width: Theme.settings-number-width;
                            height: Theme.settings-control-height;
                            minimum: 100;
                            maximum: 200;
                            value <=> root.draft-line-height-percent;
                            accessible-label: "Terminal line height percentage";
                        }
                        Text {
                            width: Theme.settings-unit-width;
                            text: "%";
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                }

                SettingsSectionHeading { label: "DISPLAY"; }
                SettingsRow {
                    label: "Brightness";
                    description: "60-140 percent";
                    SettingsField {
                        Slider {
                            width: Theme.settings-slider-width;
                            height: Theme.settings-control-height;
                            minimum: 60;
                            maximum: 140;
                            step: 5;
                            value: root.draft-brightness-percent;
                            accessible-label: "Terminal brightness";
                            changed(value) => { root.draft-brightness-percent = round(value); }
                        }
                        Text {
                            width: Theme.settings-value-width;
                            text: "\{root.draft-brightness-percent}%";
                            color: Theme.muted;
                            font-size: Theme.font-small;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
                SettingsToggleRow {
                    label: "Bright colors for bold text";
                    description: "Use the bright ANSI palette for bold text";
                    checked <=> root.draft-bright-bold-text;
                    show-divider: false;
                }

                SettingsSectionHeading { label: "BUFFER"; }
                SettingsRow {
                    label: "Scrollback";
                    description: "100-50,000 retained lines";
                    show-divider: false;
                    SettingsField {
                        SpinBox {
                            width: Theme.settings-wide-number-width;
                            height: Theme.settings-control-height;
                            minimum: 100;
                            maximum: 50000;
                            value <=> root.draft-scrollback-lines;
                            accessible-label: "Terminal scrollback lines";
                        }
                        Text {
                            width: Theme.settings-unit-width;
                            text: "lines";
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                }

                SettingsSectionHeading { label: "MOUSE"; }
                SettingsToggleRow {
                    label: "Right-click copy or paste";
                    description: "Copy a selection; otherwise paste";
                    checked <=> root.draft-right-click-copy-or-paste;
                    show-divider: false;
                }

                if root.apple-platform : SettingsSectionHeading { label: "KEYBOARD"; }
                if root.apple-platform : SettingsToggleRow {
                    label: "Option acts as Meta";
                    description: "Send Option+key as an Escape-prefixed Meta key";
                    checked <=> root.draft-option-as-meta;
                    show-divider: false;
                }
            }
        }
    }
}
