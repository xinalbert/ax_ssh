import { ScrollView, Slider, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { FlatTextInput } from "../components/flat-text-input.slint";
import { SettingsField, SettingsRow, SettingsSectionHeading, SettingsToggleRow } from "../components/settings-controls.slint";
import { ThemedComboBox } from "../components/themed-combo-box.slint";

export component TerminalSettingsPage inherits Rectangle {
    in property <int> scroll-revision: 0;
    in property <[string]> terminal-font-options;
    in-out property <string> draft-font-family;
    in-out property <int> draft-font-index;
    in-out property <int> draft-font-size;
    in-out property <int> draft-line-height-percent;
    in-out property <float> draft-minimum-contrast-ratio;
    in-out property <bool> draft-bright-bold-text;
    in-out property <string> draft-semantic-link-color;
    in-out property <string> draft-semantic-success-color;
    in-out property <string> draft-semantic-info-color;
    in-out property <string> draft-semantic-warning-color;
    in-out property <string> draft-semantic-error-color;
    in-out property <int> draft-scrollback-lines;
    in-out property <bool> draft-right-click-copy-or-paste;
    in-out property <bool> draft-copy-selection-on-select;
    in property <bool> apple-platform: false;
    in-out property <bool> draft-option-as-meta;

    background: Theme.background;

    terminal-scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-width: self.visible-width;
        viewport-height: max(
            self.visible-height,
            terminal-content.preferred-height + 2 * Theme.space-xl,
        );

        terminal-page := Rectangle {
            width: terminal-scroll.visible-width;
            height: max(
                terminal-scroll.visible-height,
                terminal-content.preferred-height + 2 * Theme.space-xl,
            );
            background: Theme.background;

            terminal-content := VerticalLayout {
                x: Theme.page-padding;
                y: Theme.space-xl;
                width: min(
                    Theme.settings-content-width,
                    parent.width - 2 * Theme.page-padding,
                );
                height: self.preferred-height;
                spacing: 0px;

                SettingsSectionHeading { label: @tr("TYPOGRAPHY"); }
                SettingsRow {
                    label: @tr("Font family");
                    description: @tr("Terminal character-cell font");
                    SettingsField {
                        ThemedComboBox {
                            width: parent.width;
                            height: Theme.settings-control-height;
                            model: root.terminal-font-options;
                            current-index <=> root.draft-font-index;
                            accessible-label: @tr("Terminal font family");
                            selected(value, _index) => { root.draft-font-family = value; }
                        }
                    }
                }
                SettingsRow {
                    label: @tr("Font size");
                    description: @tr("9-32 px");
                    SettingsField {
                        SpinBox {
                            width: Theme.settings-number-width;
                            height: Theme.settings-control-height;
                            minimum: 9;
                            maximum: 32;
                            value <=> root.draft-font-size;
                            accessible-label: @tr("Terminal font size");
                        }
                        Text {
                            width: Theme.settings-unit-width;
                            text: @tr("px");
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                }
                SettingsRow {
                    label: @tr("Line height");
                    description: @tr("100-200 percent");
                    SettingsField {
                        SpinBox {
                            width: Theme.settings-number-width;
                            height: Theme.settings-control-height;
                            minimum: 100;
                            maximum: 200;
                            value <=> root.draft-line-height-percent;
                            accessible-label: @tr("Terminal line height percentage");
                        }
                        Text {
                            width: Theme.settings-unit-width;
                            text: @tr("%");
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                }

                SettingsSectionHeading { label: @tr("DISPLAY"); }
                SettingsRow {
                    label: @tr("Minimum contrast ratio");
                    description: @tr("1.0-21.0");
                    SettingsField {
                        Slider {
                            width: Theme.settings-slider-width;
                            height: Theme.settings-control-height;
                            minimum: 1;
                            maximum: 21;
                            step: 0.5;
                            value: root.draft-minimum-contrast-ratio;
                            accessible-label: @tr("Terminal minimum contrast ratio");
                            changed(value) => { root.draft-minimum-contrast-ratio = value; }
                        }
                        Text {
                            width: Theme.settings-value-width;
                            text: "\{root.draft-minimum-contrast-ratio}:1";
                            color: Theme.muted;
                            font-size: Theme.font-small;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
                SettingsToggleRow {
                    label: @tr("Bright colors for bold text");
                    description: @tr("Use the bright ANSI palette for bold text");
                    checked <=> root.draft-bright-bold-text;
                    show-divider: false;
                }

                SettingsSectionHeading { label: @tr("SEMANTIC HIGHLIGHTING"); }
                SettingsRow {
                    label: @tr("Link and path");
                    description: @tr("URL and remote path targets");
                    SettingsField {
                        FlatTextInput {
                            text <=> root.draft-semantic-link-color;
                            height: Theme.settings-control-height;
                            placeholder-text: @tr("Theme default");
                            accessible-label: @tr("Terminal link and path highlight color");
                        }
                    }
                }
                SettingsRow {
                    label: @tr("Success");
                    description: @tr("Successful status words and HTTP 2xx");
                    SettingsField {
                        FlatTextInput {
                            text <=> root.draft-semantic-success-color;
                            height: Theme.settings-control-height;
                            placeholder-text: @tr("Theme default");
                            accessible-label: @tr("Terminal success highlight color");
                        }
                    }
                }
                SettingsRow {
                    label: @tr("Information");
                    description: @tr("Informational status words");
                    SettingsField {
                        FlatTextInput {
                            text <=> root.draft-semantic-info-color;
                            height: Theme.settings-control-height;
                            placeholder-text: @tr("Theme default");
                            accessible-label: @tr("Terminal information highlight color");
                        }
                    }
                }
                SettingsRow {
                    label: @tr("Warning");
                    description: @tr("Warnings and HTTP 4xx");
                    SettingsField {
                        FlatTextInput {
                            text <=> root.draft-semantic-warning-color;
                            height: Theme.settings-control-height;
                            placeholder-text: @tr("Theme default");
                            accessible-label: @tr("Terminal warning highlight color");
                        }
                    }
                }
                SettingsRow {
                    label: @tr("Error");
                    description: @tr("Errors and HTTP 5xx");
                    show-divider: false;
                    SettingsField {
                        FlatTextInput {
                            text <=> root.draft-semantic-error-color;
                            height: Theme.settings-control-height;
                            placeholder-text: @tr("Theme default");
                            accessible-label: @tr("Terminal error highlight color");
                        }
                    }
                }

                SettingsSectionHeading { label: @tr("BUFFER"); }
                SettingsRow {
                    label: @tr("Scrollback");
                    description: @tr("100-50,000 retained lines");
                    show-divider: false;
                    SettingsField {
                        SpinBox {
                            width: Theme.settings-wide-number-width;
                            height: Theme.settings-control-height;
                            minimum: 100;
                            maximum: 50000;
                            value <=> root.draft-scrollback-lines;
                            accessible-label: @tr("Terminal scrollback lines");
                        }
                        Text {
                            width: Theme.settings-unit-width;
                            text: @tr("lines");
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                }

                SettingsSectionHeading { label: @tr("MOUSE"); }
                SettingsToggleRow {
                    label: @tr("Right-click copy or paste");
                    description: @tr("Copy a selection; otherwise paste");
                    checked <=> root.draft-right-click-copy-or-paste;
                }
                SettingsToggleRow {
                    label: @tr("Copy selection on select");
                    description: @tr("Right-click always pastes");
                    checked <=> root.draft-copy-selection-on-select;
                    show-divider: false;
                }

                if root.apple-platform : SettingsSectionHeading { label: @tr("KEYBOARD"); }
                if root.apple-platform : SettingsToggleRow {
                    label: @tr("Option acts as Meta");
                    description: @tr("Send Option+key as an Escape-prefixed Meta key");
                    checked <=> root.draft-option-as-meta;
                    show-divider: false;
                }
            }
        }
    }

    changed scroll-revision => { terminal-scroll.viewport-y = 0px; }
}
