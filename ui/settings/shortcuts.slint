import { Theme } from "../theme.slint";
import { ElidedButton } from "../components/elided-controls.slint";
import { SettingsField, SettingsInfoRow, SettingsPage, SettingsRow, SettingsSectionHeading, ShortcutRecorder } from "../components/settings-controls.slint";

export component ShortcutsSettingsPage inherits SettingsPage {
    in-out property <string> draft-open-settings-shortcut;
    in-out property <string> draft-new-session-shortcut;
    in-out property <string> draft-import-sessions-shortcut;
    in-out property <string> draft-export-selected-shortcut;
    in-out property <string> draft-toggle-sidebar-shortcut;
    in-out property <string> draft-copy-selection-shortcut;
    in-out property <string> draft-paste-shortcut;
    in-out property <string> draft-open-sftp-shortcut;
    in property <string> default-open-settings-shortcut;
    in property <string> default-new-session-shortcut;
    in property <string> default-import-sessions-shortcut;
    in property <string> default-export-selected-shortcut;
    in property <string> default-toggle-sidebar-shortcut;
    in property <string> default-copy-selection-shortcut;
    in property <string> default-paste-shortcut;
    in property <string> default-open-sftp-shortcut;
    in property <bool> apple-platform: false;

    private property <string> select-all-shortcut: root.apple-platform ? "Cmd+A" : "Ctrl+Shift+A";
    private property <string> previous-tab-shortcut: root.apple-platform
        ? "Cmd+Shift+[" : "Ctrl+Shift+[";
    private property <string> next-tab-shortcut: root.apple-platform
        ? "Cmd+Shift+]" : "Ctrl+Shift+]";

    callback format-shortcut(string, bool, bool, bool, bool) -> string;
    callback shortcut-recording-changed(bool);
    HorizontalLayout {
        height: Theme.settings-nav-title-height;
        SettingsSectionHeading {
            horizontal-stretch: 1;
            label: @tr("WORKSPACE");
        }
        ElidedButton {
            width: max(Theme.settings-reset-button-width, self.preferred-width);
            height: Theme.settings-control-height;
            text: @tr("Reset defaults");
            clicked => {
                root.draft-open-settings-shortcut = root.default-open-settings-shortcut;
                root.draft-new-session-shortcut = root.default-new-session-shortcut;
                root.draft-import-sessions-shortcut = root.default-import-sessions-shortcut;
                root.draft-export-selected-shortcut = root.default-export-selected-shortcut;
                root.draft-toggle-sidebar-shortcut = root.default-toggle-sidebar-shortcut;
                root.draft-copy-selection-shortcut = root.default-copy-selection-shortcut;
                root.draft-paste-shortcut = root.default-paste-shortcut;
                root.draft-open-sftp-shortcut = root.default-open-sftp-shortcut;
            }
        }
    }
    SettingsRow {
        label: @tr("Open Settings");
        description: @tr("Application command");
        SettingsField {
            open-settings-recorder := ShortcutRecorder {
                width: Theme.settings-field-width;
                shortcut <=> root.draft-open-settings-shortcut;
                accessible-name: @tr("Open Settings shortcut");
                format-shortcut(text, alt, control, meta, shift) => {
                    return root.format-shortcut(text, alt, control, meta, shift);
                }
                recording-changed(recording) => {
                    root.shortcut-recording-changed(recording);
                }
            }
        }
    }
    SettingsRow {
        label: @tr("New Server");
        description: @tr("Workspace command");
        SettingsField {
            ShortcutRecorder {
                width: Theme.settings-field-width;
                shortcut <=> root.draft-new-session-shortcut;
                accessible-name: @tr("New Server shortcut");
                format-shortcut(text, alt, control, meta, shift) => {
                    return root.format-shortcut(text, alt, control, meta, shift);
                }
                recording-changed(recording) => {
                    root.shortcut-recording-changed(recording);
                }
            }
        }
    }
    SettingsRow {
        label: @tr("Import from Clipboard");
        description: @tr("Session transfer command");
        SettingsField {
            ShortcutRecorder {
                width: Theme.settings-field-width;
                shortcut <=> root.draft-import-sessions-shortcut;
                accessible-name: @tr("Import from Clipboard shortcut");
                format-shortcut(text, alt, control, meta, shift) => {
                    return root.format-shortcut(text, alt, control, meta, shift);
                }
                recording-changed(recording) => {
                    root.shortcut-recording-changed(recording);
                }
            }
        }
    }
    SettingsRow {
        label: @tr("Export Selected");
        description: @tr("Session transfer command");
        SettingsField {
            ShortcutRecorder {
                width: Theme.settings-field-width;
                shortcut <=> root.draft-export-selected-shortcut;
                accessible-name: @tr("Export Selected shortcut");
                format-shortcut(text, alt, control, meta, shift) => {
                    return root.format-shortcut(text, alt, control, meta, shift);
                }
                recording-changed(recording) => {
                    root.shortcut-recording-changed(recording);
                }
            }
        }
    }
    SettingsRow {
        label: @tr("Toggle Session Sidebar");
        description: @tr("Workspace command");
        SettingsField {
            toggle-sidebar-recorder := ShortcutRecorder {
                width: Theme.settings-field-width;
                shortcut <=> root.draft-toggle-sidebar-shortcut;
                accessible-name: @tr("Toggle Session Sidebar shortcut");
                format-shortcut(text, alt, control, meta, shift) => {
                    return root.format-shortcut(text, alt, control, meta, shift);
                }
                recording-changed(recording) => {
                    root.shortcut-recording-changed(recording);
                }
            }
        }
    }

    SettingsRow {
        label: @tr("Switch SSH/SFTP Tab");
        description: @tr("Workspace command");
        show-divider: false;
        SettingsField {
            ShortcutRecorder {
                width: Theme.settings-field-width;
                shortcut <=> root.draft-open-sftp-shortcut;
                accessible-name: @tr("Switch SSH/SFTP Tab shortcut");
                format-shortcut(text, alt, control, meta, shift) => {
                    return root.format-shortcut(text, alt, control, meta, shift);
                }
                recording-changed(recording) => {
                    root.shortcut-recording-changed(recording);
                }
            }
        }
    }
    SettingsSectionHeading { label: @tr("TERMINAL"); }
    SettingsRow {
        label: @tr("Copy Terminal Selection");
        description: @tr("Terminal command");
        SettingsField {
            copy-recorder := ShortcutRecorder {
                width: Theme.settings-field-width;
                shortcut <=> root.draft-copy-selection-shortcut;
                accessible-name: @tr("Copy Terminal Selection shortcut");
                format-shortcut(text, alt, control, meta, shift) => {
                    return root.format-shortcut(text, alt, control, meta, shift);
                }
                recording-changed(recording) => {
                    root.shortcut-recording-changed(recording);
                }
            }
        }
    }
    SettingsRow {
        label: @tr("Paste Into Terminal");
        description: @tr("Terminal command");
        SettingsField {
            paste-recorder := ShortcutRecorder {
                width: Theme.settings-field-width;
                shortcut <=> root.draft-paste-shortcut;
                accessible-name: @tr("Paste Into Terminal shortcut");
                format-shortcut(text, alt, control, meta, shift) => {
                    return root.format-shortcut(text, alt, control, meta, shift);
                }
                recording-changed(recording) => {
                    root.shortcut-recording-changed(recording);
                }
            }
        }
    }
    SettingsSectionHeading { label: @tr("DEFAULTS"); }
    SettingsInfoRow {
        label: @tr("Select All");
        description: @tr("Terminal command");
        value: root.select-all-shortcut;
    }
    SettingsInfoRow {
        label: @tr("Previous Tab");
        description: @tr("Workspace command");
        value: root.previous-tab-shortcut;
    }
    SettingsInfoRow {
        label: @tr("Next Tab");
        description: @tr("Workspace command");
        value: root.next-tab-shortcut;
        show-divider: false;
    }
}
