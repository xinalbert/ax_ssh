import { SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { FlatTextInput } from "../components/flat-text-input.slint";
import { SettingsField, SettingsPage, SettingsRow, SettingsSectionHeading } from "../components/settings-controls.slint";

export component WorkspaceSettingsPage inherits SettingsPage {
    in-out property <int> draft-sidebar-width;
    in-out property <int> draft-tab-width;
    in-out property <string> draft-session-mask-character;
    SettingsSectionHeading { label: @tr("LAYOUT"); }
    SettingsRow {
        label: @tr("Session sidebar width");
        description: @tr("180-420 px when sessions are available");
        SettingsField {
            settings-sidebar-width := SpinBox {
                width: Theme.settings-wide-number-width;
                height: Theme.settings-control-height;
                minimum: 180;
                maximum: 420;
                value <=> root.draft-sidebar-width;
                accessible-label: @tr("Session sidebar width");
            }
            Text {
                width: Theme.settings-unit-width;
                text: @tr("px");
                color: Theme.muted;
                vertical-alignment: center;
            }
        }
    }
    SettingsRow {
        label: @tr("Workspace tab width");
        description: @tr("120-260 px");
        SettingsField {
            settings-tab-width := SpinBox {
                width: Theme.settings-wide-number-width;
                height: Theme.settings-control-height;
                minimum: 120;
                maximum: 260;
                value <=> root.draft-tab-width;
                accessible-label: @tr("Workspace tab width");
            }
            Text {
                width: Theme.settings-unit-width;
                text: @tr("px");
                color: Theme.muted;
                vertical-alignment: center;
            }
        }
    }
    SettingsRow {
        label: @tr("Session mask character");
        description: @tr("Masks usernames and the middle IPv4 octets in the session sidebar");
        show-divider: false;
        SettingsField {
            FlatTextInput {
                width: Theme.settings-number-width;
                height: Theme.settings-control-height;
                text <=> root.draft-session-mask-character;
                accessible-label: @tr("Session mask character");
            }
        }
    }
    Rectangle { vertical-stretch: 1; }
}
