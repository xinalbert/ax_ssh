import { Theme } from "../theme.slint";
import { FlatTextInput } from "../components/flat-text-input.slint";
import {
    SettingsField,
    SettingsInfoRow,
    SettingsPage,
    SettingsRow,
    SettingsSectionHeading,
    SettingsToggleRow,
} from "../components/settings-controls.slint";
import { ThemedComboBox } from "../components/themed-combo-box.slint";

export component X11SettingsPage inherits SettingsPage {
    in property <[string]> provider-options;
    in property <[string]> discovered-installations;
    in-out property <string> draft-provider;
    in-out property <int> draft-provider-index;
    in-out property <string> draft-app-path;
    in-out property <bool> draft-launch-on-connect;
    in-out property <bool> draft-allow-no-auth;

    SettingsSectionHeading { label: @tr("LOCAL X SERVER"); }
    SettingsRow {
        label: @tr("Provider");
        description: @tr("X server used by forwarded graphical applications");
        SettingsField {
            ThemedComboBox {
                height: Theme.settings-control-height;
                width: parent.width;
                model: root.provider-options;
                current-index <=> root.draft-provider-index;
                accessible-label: @tr("Local X server provider");
                selected(value, _index) => {
                    root.draft-provider = value == "System DISPLAY" ? "system"
                        : (value == "XQuartz" ? "xquartz"
                        : (value == "MacXServer" ? "macxserver"
                        : (value == "VcXsrv" ? "vcxsrv"
                        : (value == "Xming" ? "xming"
                        : (value == "Custom" ? "custom" : "auto")))));
                }
            }
        }
    }
    if root.discovered-installations.length == 0 : SettingsInfoRow {
        label: @tr("Detected locations");
        value: @tr("No known local X server was found");
    }
    for location[index] in root.discovered-installations : SettingsInfoRow {
        label: index == 0 ? @tr("Detected locations") : "";
        value: location;
    }
    SettingsRow {
        visible: root.draft-provider == "custom";
        label: @tr("Custom executable");
        description: @tr("Choose Custom to launch this path without a command shell");
        SettingsField {
            FlatTextInput {
                height: Theme.settings-control-height;
                text <=> root.draft-app-path;
                placeholder-text: @tr("Executable path");
                accessible-label: @tr("Local X server application path");
            }
        }
    }
    SettingsToggleRow {
        label: @tr("Start for first X11 application");
        description: @tr("Launch the selected X server only when a forwarded graphical app opens");
        checked <=> root.draft-launch-on-connect;
        show-divider: false;
        control-enabled: root.draft-provider != "system";
    }

    SettingsSectionHeading { label: @tr("COMPATIBILITY"); }
    SettingsToggleRow {
        label: @tr("Allow local connections without X authority");
        description: @tr("Loopback only; required by MacXServer and -ac Windows servers");
        checked <=> root.draft-allow-no-auth;
        show-divider: false;
    }
    Rectangle { vertical-stretch: 1; }
}
