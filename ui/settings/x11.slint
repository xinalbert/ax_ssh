import { Theme } from "../theme.slint";
import { FlatTextInput } from "../components/flat-text-input.slint";
import {
    SettingsField,
    SettingsPage,
    SettingsRow,
    SettingsSectionHeading,
    SettingsToggleRow,
} from "../components/settings-controls.slint";
import { ThemedComboBox } from "../components/themed-combo-box.slint";

export component X11SettingsPage inherits SettingsPage {
    in property <[string]> provider-options;
    in-out property <string> draft-provider;
    in-out property <int> draft-provider-index;
    in-out property <string> draft-app-path;
    in-out property <bool> draft-launch-on-connect;
    in-out property <bool> draft-allow-no-auth;

    SettingsSectionHeading { label: "LOCAL X SERVER"; }
    SettingsRow {
        label: "Provider";
        description: "X server used by forwarded graphical applications";
        SettingsField {
            ThemedComboBox {
                height: Theme.settings-control-height;
                model: root.provider-options;
                current-index <=> root.draft-provider-index;
                accessible-label: "Local X server provider";
                selected(value) => {
                    root.draft-provider = value == "System DISPLAY" ? "system"
                        : (value == "XQuartz" ? "xquartz"
                        : (value == "MacXServer" ? "macxserver"
                        : (value == "VcXsrv" ? "vcxsrv"
                        : (value == "Xming" ? "xming"
                        : (value == "Custom" ? "custom" : "auto")))));
                }
            }
        }
    }
    SettingsRow {
        visible: root.draft-provider == "custom";
        label: "Application path";
        description: "Executable launched without a command shell";
        SettingsField {
            FlatTextInput {
                height: Theme.settings-control-height;
                text <=> root.draft-app-path;
                placeholder-text: "Executable path";
                accessible-label: "Local X server application path";
            }
        }
    }
    SettingsToggleRow {
        label: "Start on SSH connect";
        description: "Launch the selected X server when it is not already ready";
        checked <=> root.draft-launch-on-connect;
        show-divider: false;
        control-enabled: root.draft-provider != "system";
    }

    SettingsSectionHeading { label: "COMPATIBILITY"; }
    SettingsToggleRow {
        label: "Allow local connections without X authority";
        description: "Loopback only; required by MacXServer and -ac Windows servers";
        checked <=> root.draft-allow-no-auth;
        show-divider: false;
    }
    Rectangle { vertical-stretch: 1; }
}
