import { AboutSlint, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ElidedButton } from "../components/elided-controls.slint";
import {
    SettingsField,
    SettingsInfoRow,
    SettingsRow,
    SettingsSectionHeading,
} from "../components/settings-controls.slint";

export component AboutSettingsPage inherits Rectangle {
    in property <int> scroll-revision: 0;
    in property <string> app-version;
    callback report-bug();
    callback open-log-directory();
    callback copy-diagnostic-info();
    background: Theme.background;

    about-scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-width: self.visible-width;
        viewport-height: max(
            self.visible-height,
            about-content.preferred-height + 2 * Theme.space-xl,
        );

        about-page := Rectangle {
            width: about-scroll.visible-width;
            height: max(
                about-scroll.visible-height,
                about-content.preferred-height + 2 * Theme.space-xl,
            );
            background: Theme.background;

            about-content := VerticalLayout {
                x: Theme.page-padding;
                y: Theme.space-xl;
                width: min(
                    Theme.settings-content-width,
                    parent.width - 2 * Theme.page-padding,
                );
                height: self.preferred-height;
                spacing: 0px;

                HorizontalLayout {
                    height: Theme.settings-about-header-height;
                    spacing: Theme.space-xxl;
                    Rectangle {
                        width: Theme.settings-about-mark-size;
                        height: Theme.settings-about-mark-size;
                        border-radius: Theme.radius;
                        background: Theme.panel-alt;
                        border-width: Theme.hairline;
                        border-color: Theme.frame-border;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: @tr(">_");
                            color: Theme.accent;
                            font-family: Theme.application-font-family;
                            font-size: Theme.font-section;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.space-xxs;
                        Text {
                            text: @tr("AxSSH");
                            color: Theme.text;
                            font-size: Theme.font-title;
                            font-weight: 700;
                            vertical-alignment: bottom;
                        }
                        Text {
                            text: @tr("Version {0}", root.app-version);
                            color: Theme.muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                        Text {
                            height: Theme.settings-about-description-height;
                            text: @tr("A focused terminal workspace for SSH, Telnet, serial, and local shell sessions.");
                            color: Theme.muted;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                            vertical-alignment: top;
                        }
                    }
                }
                SettingsSectionHeading { label: @tr("APPLICATION"); }
                SettingsInfoRow { label: @tr("Interface"); value: "Slint"; }
                SettingsInfoRow { label: @tr("SSH transport"); value: "russh"; }
                SettingsInfoRow { label: @tr("Telnet protocol"); value: "libmudtelnet-rs"; }
                SettingsInfoRow { label: @tr("Serial transport"); value: "tokio-serial"; }
                SettingsInfoRow { label: @tr("Async runtime"); value: "Tokio"; }
                SettingsInfoRow {
                    label: @tr("License");
                    value: "GPL-3.0-only";
                    show-divider: false;
                }
                SettingsSectionHeading { label: @tr("SUPPORT"); }
                SettingsRow {
                    label: @tr("Bug reports");
                    description: @tr("Open the AxSSH issue tracker");
                    SettingsField {
                        ElidedButton {
                            text: @tr("Report a bug");
                            clicked => { root.report-bug(); }
                            accessible-name: @tr("Report a bug");
                        }
                    }
                }
                SettingsRow {
                    label: @tr("Runtime logs");
                    description: @tr("Review before sharing");
                    SettingsField {
                        ElidedButton {
                            text: @tr("Open log folder");
                            clicked => { root.open-log-directory(); }
                            accessible-name: @tr("Open log folder");
                        }
                    }
                }
                SettingsRow {
                    label: @tr("Diagnostics");
                    description: @tr("Copy version and build information without connection data");
                    show-divider: false;
                    SettingsField {
                        ElidedButton {
                            text: @tr("Copy diagnostics");
                            clicked => { root.copy-diagnostic-info(); }
                            accessible-name: @tr("Copy diagnostics");
                        }
                    }
                }
                SettingsSectionHeading { label: @tr("SLINT"); }
                AboutSlint {
                    width: parent.width;
                    height: Theme.settings-about-slint-height;
                }
            }
        }
    }

    changed scroll-revision => { about-scroll.viewport-y = 0px; }
}
