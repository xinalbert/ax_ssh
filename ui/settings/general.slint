import { SystemIconChoiceRow, SystemIconPicker } from "../components/system-icon-picker.slint";
import { SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SettingsField, SettingsPage, SettingsRow, SettingsSectionHeading } from "../components/settings-controls.slint";
import { ThemedComboBox } from "../components/themed-combo-box.slint";

export component GeneralSettingsPage inherits SettingsPage {
    pure callback system-icon-choices(string) -> [SystemIconChoiceRow];
    pure callback system-icon-choice(string) -> SystemIconChoiceRow;
    in property <int> ui-language-index;
    pure callback ui-language-options(string) -> [string];
    in property <string> local-shell-icon-override;
    in property <string> local-shell-automatic-platform;
    private property <int> selected-ui-language-index: 0;
    in property <[string]> local-shell-options;
    in-out property <string> draft-local-shell;
    in-out property <int> draft-local-shell-index;
    in-out property <int> draft-columns;
    in-out property <int> draft-rows;
    in-out property <string> draft-credential-storage;
    callback save-ui-language(int);
    callback save-local-shell-icon(string);
    init => { root.restore-ui-language-selection(); }
    changed ui-language-index => { root.restore-ui-language-selection(); }
    function restore-ui-language-selection() {
        root.selected-ui-language-index = root.ui-language-index;
    }
    SettingsSectionHeading { label: @tr("INTERFACE"); }
    SettingsRow {
        label: @tr("Language");
        description: @tr("Language used by the AxSSH interface");
        SettingsField {
            ThemedComboBox {
                width: parent.width;
                height: Theme.settings-control-height;
                model: root.ui-language-options(@tr("Follow system"));
                current-index <=> root.selected-ui-language-index;
                accessible-label: @tr("Interface language");
                selected(_value, _index) => {
                    let requested-index = root.selected-ui-language-index;
                    root.restore-ui-language-selection();
                    root.save-ui-language(requested-index);
                }
            }
        }
    }
    SettingsSectionHeading { label: @tr("DEFAULTS"); }
    SettingsRow {
        label: @tr("Local shell");
        description: @tr("Executable used for new local terminal tabs");
        SettingsField {
            ThemedComboBox {
                width: parent.width;
                height: Theme.settings-control-height;
                model: root.local-shell-options;
                current-index <=> root.draft-local-shell-index;
                accessible-label: @tr("Local shell");
                selected(value, _index) => { root.draft-local-shell = value; }
            }
        }
    }
    SettingsRow {
        label: @tr("Local shell icon");
        description: @tr("Uses the host system by default. Changes are saved immediately.");
        SettingsField {
            SystemIconPicker {
                width: parent.width;
                popup-align-end: true;
                icon-id: root.local-shell-icon-override;
                automatic-platform: root.local-shell-automatic-platform.is-empty ? "terminal" : root.local-shell-automatic-platform;
                choices(query) => { return root.system-icon-choices(query); }
                choice(id) => { return root.system-icon-choice(id); }
                selected(id) => { root.save-local-shell-icon(id); }
            }
        }
    }
    SettingsRow {
        label: @tr("Remembered password storage");
        description: @tr("Used for remembered passwords and new passwords entered in the session editor");
        SettingsField {
            ThemedComboBox {
                width: parent.width;
                height: Theme.settings-control-height;
                model: [@tr("System credential store"), @tr("Encrypted application vault")];
                current-index: root.draft-credential-storage == "encrypted-vault" ? 1 : 0;
                accessible-label: @tr("Remembered password storage");
                selected(value, _index) => {
                    root.draft-credential-storage = value == @tr("Encrypted application vault")
                        ? "encrypted-vault"
                        : "system-keyring";
                }
            }
        }
    }
    SettingsRow {
        label: @tr("Default terminal size");
        description: @tr("10-300 columns, 3-100 rows");
        show-divider: false;
        SettingsField {
            settings-columns := SpinBox {
                width: Theme.settings-terminal-size-width;
                height: Theme.settings-control-height;
                minimum: 10;
                maximum: 300;
                value <=> root.draft-columns;
                accessible-label: @tr("Default terminal columns");
            }
            Text { text: "x"; color: Theme.muted; vertical-alignment: center; }
            settings-rows := SpinBox {
                width: Theme.settings-terminal-size-width;
                height: Theme.settings-control-height;
                minimum: 3;
                maximum: 100;
                value <=> root.draft-rows;
                accessible-label: @tr("Default terminal rows");
            }
        }
    }
    Rectangle { vertical-stretch: 1; }
}
