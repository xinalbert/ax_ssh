import { AuthenticationDialog, CredentialAccessDialog, HostKeyDialog } from "security-dialogs.slint";
import { SessionManagementDialog } from "session-management-dialog.slint";
import { SftpTransferConflictDialog } from "sftp-transfer-conflict-dialog.slint";
import { SftpRenameDialog } from "sftp-rename-dialog.slint";
import { OpenSshImportDialog } from "openssh-import-dialog.slint";
import { SshForwardingHistoryRow, SshToolsDialog } from "ssh-tools-dialog.slint";
import { ForwardingRuleDialog } from "forwarding-rule-dialog.slint";
import { ForwardingManagerRow, ForwardingManagerRequest } from "forwarding-manager-page.slint";
import { ServerOption } from "themed-combo-box.slint";
import { WorkspaceFileDialog } from "workspace-file-dialog.slint";
import { TerminalNoticeCard, TerminalNoticeViewState } from "../terminal-pane.slint";
import { Theme } from "../theme.slint";

// Rust remains authoritative for the security prompt. This DTO is deliberately
// read-only so the host cannot dismiss an SSH trust/authentication phase early.
export struct SecurityOverlayViewState {
    host_key_open: bool,
    host_key_endpoint: string,
    host_key_fingerprint: string,
    host_key_changed: bool,
    host_key_revoked: bool,
    password_open: bool,
    password_endpoint: string,
    password_private_key: bool,
    password_vault_storage: bool,
    password_vault_unlock_only: bool,
    password_credential_unavailable: bool,
    password_key_path: string,
    password_prompt_id: string,
    default_credential_storage: string,
}

export component OverlayHost inherits Rectangle {
    in property <SecurityOverlayViewState> security;
    in property <bool> apple-platform;
    in property <string> monospace-font-family;
    in property <TerminalNoticeViewState> terminal-notice;
    in property <string> terminal-notice-pane-id;
    in property <bool> window-active: true;
    in property <bool> transfer-conflict-open: false;
    in property <bool> transfer-conflict-upload: false;
    in property <string> transfer-conflict-id;
    in property <string> transfer-conflict-name;
    in property <string> transfer-conflict-size;
    in property <string> transfer-conflict-modified;

    callback manage-session-action(string, string, string);
    callback terminal-notice-action(string, string);
    callback confirm-host-key();
    callback reject-host-key();
    callback authenticate-session(string, string, bool, string) -> bool;
    callback cancel-password-dialog();
    callback resolve-credential-access(bool);
    callback workspace-file-action(string, string);
    pure callback ssh-tool-history(string) -> [string];
    pure callback ssh-tool-history-entry(string, int) -> SshForwardingHistoryRow;
    callback ssh-tool-action(string, string, string, string, string, int);
    callback forwarding-manager-submit(ForwardingManagerRequest, int);
    callback openssh-import-action(string, string, int);
    callback resolve-sftp-transfer-conflict(string, string, bool);
    callback rename-remote-sftp(string, string, string);

    private property <bool> security-open: root.security.host_key_open || root.security.password_open;
    out property <bool> modal-open: root.security-open
        || root.workspace-file-open || root.session-management-open || root.transfer-conflict-open
        || root.sftp-rename-open || !root.ssh-tool-mode.is-empty || root.openssh-import-open
        || !root.forwarding-manager-action.is-empty;

    private property <string> forwarding-manager-action;
    private property <ForwardingManagerRow> forwarding-manager-rule;
    private property <[ServerOption]> forwarding-manager-profiles;
    private property <int> forwarding-manager-revision;
    private property <bool> forwarding-manager-busy;
    private property <string> forwarding-manager-result;
    private property <string> forwarding-manager-details;

    public function show-forwarding-manager(action: string, row: ForwardingManagerRow,
            profiles: [ServerOption]) {
        if root.modal-open { return; }
        root.forwarding-manager-rule = row;
        root.forwarding-manager-profiles = profiles;
        root.forwarding-manager-result = "";
        root.forwarding-manager-details = "";
        root.forwarding-manager-busy = false;
        root.forwarding-manager-action = action;
        if action == "check" {
            root.submit-forwarding-manager({ action: action, original: row });
        }
    }

    function submit-forwarding-manager(request: ForwardingManagerRequest) {
        root.forwarding-manager-revision += 1;
        root.forwarding-manager-busy = true;
        root.forwarding-manager-result = "";
        root.forwarding-manager-details = "";
        root.forwarding-manager-submit(request, root.forwarding-manager-revision);
    }

    function close-forwarding-manager() {
        root.forwarding-manager-action = "";
        root.forwarding-manager-revision += 1;
    }

    public function finish-forwarding-manager(revision: int, result: string, details: string) {
        if revision != root.forwarding-manager-revision || root.forwarding-manager-action.is-empty { return; }
        root.forwarding-manager-busy = false;
        if result == "saved" { root.close-forwarding-manager(); }
        else {
            root.forwarding-manager-result = result;
            root.forwarding-manager-details = details;
        }
    }

    if !root.security-open && !root.forwarding-manager-action.is-empty : ForwardingRuleDialog {
        action: root.forwarding-manager-action;
        original: root.forwarding-manager-rule;
        profiles: root.forwarding-manager-profiles;
        busy: root.forwarding-manager-busy;
        result: root.forwarding-manager-result;
        details: root.forwarding-manager-details;
        submit(request) => { root.submit-forwarding-manager(request); }
        close => { root.close-forwarding-manager(); }
    }

    private property <string> ssh-tool-mode;
    private property <string> ssh-tool-target;
    private property <int> ssh-tool-revision;
    private property <bool> ssh-tool-busy;
    private property <bool> ssh-tool-alternate;
    private property <string> ssh-tool-action-name;
    private property <string> ssh-tool-result;
    private property <[string]> ssh-tool-history-options;
    private property <int> ssh-tool-history-index: -1;
    private property <bool> ssh-tool-history-enabled: true;
    private property <bool> openssh-import-open;
    private property <bool> openssh-import-busy;
    private property <bool> openssh-import-ready;
    private property <int> openssh-import-revision;
    private property <string> openssh-import-preview;

    public function show-ssh-tool(mode: string, target: string) {
        if root.modal-open || target.is-empty { return; }
        root.ssh-tool-target = target;
        root.ssh-tool-revision += 1;
        root.ssh-tool-mode = mode;
        root.ssh-tool-result = "";
        root.ssh-tool-alternate = false;
        root.ssh-tool-history-options = root.ssh-tool-history(target);
        root.ssh-tool-history-index = -1;
        root.ssh-tool-history-enabled = true;
        root.ssh-tool-action-name = mode == "forward" ? "status" : "";
        root.ssh-tool-busy = mode == "forward";
        if mode == "forward" {
            root.ssh-tool-action(target, "status", "", "", "", root.ssh-tool-revision);
        }
    }

    public function finish-ssh-tool(revision: int, text: string, alternate: bool) {
        if revision == root.ssh-tool-revision && !root.ssh-tool-mode.is-empty {
            root.ssh-tool-result = text;
            root.ssh-tool-busy = false;
            root.ssh-tool-alternate = alternate;
            if root.ssh-tool-mode == "forward" && alternate {
                root.ssh-tool-history-options = root.ssh-tool-history(root.ssh-tool-target);
            }
            if root.ssh-tool-mode == "forward"
                && (root.ssh-tool-action-name == "enable-forward"
                    || root.ssh-tool-action-name == "disable-forward")
                && root.ssh-tool-history-index >= 0 {
                root.ssh-tool-history-enabled = root.ssh-tool-history-entry(
                    root.ssh-tool-target,
                    root.ssh-tool-history-index,
                ).enabled;
            }
        }
    }

    public function show-openssh-import() {
        if root.modal-open { return; }
        root.openssh-import-open = true;
        root.openssh-import-busy = false;
        root.openssh-import-ready = false;
        root.openssh-import-preview = "";
        root.openssh-import-revision += 1;
    }

    public function finish-openssh-import(revision: int, text: string, ready: bool) {
        if revision == root.openssh-import-revision && root.openssh-import-open {
            root.openssh-import-preview = text;
            root.openssh-import-busy = false;
            root.openssh-import-ready = ready;
        }
    }

    if !root.security-open && !root.ssh-tool-mode.is-empty : SshToolsDialog {
        mode: root.ssh-tool-mode;
        result: root.ssh-tool-result;
        busy: root.ssh-tool-busy;
        alternate-available: root.ssh-tool-alternate;
        history-options: root.ssh-tool-history-options;
        history-enabled: root.ssh-tool-history-enabled;
        history-selected(index) => {
            root.ssh-tool-history-index = index;
            root.ssh-tool-history-enabled = root.ssh-tool-history-entry(
                root.ssh-tool-target,
                index,
            ).enabled;
        }
        history-toggle(listen, target, mode, enabled) => {
            root.ssh-tool-revision += 1;
            root.ssh-tool-busy = true;
            root.ssh-tool-alternate = false;
            root.ssh-tool-action-name = enabled ? "enable-forward" : "disable-forward";
            root.ssh-tool-action(
                root.ssh-tool-target,
                enabled ? "enable-forward" : "disable-forward",
                listen,
                target,
                mode,
                root.ssh-tool-revision,
            );
        }
        history-entry(index) => {
            return root.ssh-tool-history-entry(root.ssh-tool-target, index);
        }
        submit(first, second, third) => {
            root.ssh-tool-revision += 1;
            root.ssh-tool-result = "";
            root.ssh-tool-busy = true;
            root.ssh-tool-alternate = root.ssh-tool-mode == "exec";
            root.ssh-tool-action-name = root.ssh-tool-mode;
            root.ssh-tool-action(root.ssh-tool-target, root.ssh-tool-mode, first, second, third, root.ssh-tool-revision);
        }
        alternate => {
            root.ssh-tool-revision += 1;
            root.ssh-tool-busy = true;
            root.ssh-tool-alternate = false;
            root.ssh-tool-action-name = root.ssh-tool-mode == "exec" ? "cancel" : "stop";
            root.ssh-tool-action(root.ssh-tool-target, root.ssh-tool-mode == "exec" ? "cancel" : "stop",
                "", "", "", root.ssh-tool-revision);
        }
        close => {
            if root.ssh-tool-mode == "exec" && root.ssh-tool-alternate {
                root.ssh-tool-action(root.ssh-tool-target, "cancel", "", "", "", root.ssh-tool-revision);
            }
            root.ssh-tool-mode = "";
            root.ssh-tool-history-options = [];
            root.ssh-tool-history-index = -1;
            root.ssh-tool-action-name = "";
            root.ssh-tool-revision += 1;
        }
    }

    if !root.security-open && root.openssh-import-open : OpenSshImportDialog {
        preview: root.openssh-import-preview;
        ready: root.openssh-import-ready;
        busy: root.openssh-import-busy;
        read(path) => {
            root.openssh-import-revision += 1;
            root.openssh-import-ready = false;
            root.openssh-import-preview = "";
            root.openssh-import-busy = true;
            root.openssh-import-action("preview", path, root.openssh-import-revision);
        }
        path-edited => {
            root.openssh-import-ready = false;
            root.openssh-import-preview = "";
        }
        apply => {
            root.openssh-import-busy = true;
            root.openssh-import-ready = false;
            root.openssh-import-action("apply", "", root.openssh-import-revision);
        }
        close => {
            root.openssh-import-open = false;
            root.openssh-import-action("close", "", root.openssh-import-revision);
            root.openssh-import-revision += 1;
        }
    }

    private property <bool> workspace-file-open: false;
    private property <string> workspace-file-mode;
    private property <string> workspace-file-path;

    public function show-workspace-file-dialog(mode: string, path: string) {
        if root.modal-open {
            return;
        }
        root.workspace-file-mode = mode;
        root.workspace-file-path = path;
        root.workspace-file-open = true;
    }

    private property <bool> session-management-open: false;
    private property <string> session-management-action;
    private property <string> session-management-target;
    private property <string> session-management-subject;
    private property <string> session-management-value;
    private property <string> session-management-title:
        root.session-management-action == "new-group" ? @tr("New group")
        : (root.session-management-action == "rename-group" ? @tr("Rename group")
        : (root.session-management-action == "delete-group" ? @tr("Delete group")
        : (root.session-management-action == "clear-saved-password" ? @tr("Clear saved password")
        : @tr("Delete server"))));
    private property <string> session-management-message:
        root.session-management-action == "delete-group"
            ? @tr("Delete {0}? Servers in this group will move to Ungrouped.", root.session-management-subject)
            : (root.session-management-action == "delete-session"
                ? @tr("Delete {0} and its saved credential?", root.session-management-subject)
                : (root.session-management-action == "clear-saved-password"
                    ? @tr("Clear the saved password for {0} now? This takes effect immediately. Your other edits will remain unsaved.", root.session-management-subject)
                    : ""));

    public function show-session-management(action: string, target: string, subject: string) {
        if root.modal-open {
            return;
        }
        root.session-management-action = action;
        root.session-management-target = target;
        root.session-management-subject = subject;
        root.session-management-value = action == "rename-group" ? subject : "";
        root.session-management-open = true;
    }

    private property <bool> sftp-rename-open: false;
    private property <string> sftp-rename-tab-id;
    private property <string> sftp-rename-path;
    private property <string> sftp-rename-value;

    public function show-sftp-rename(tab-id: string, path: string, name: string) {
        if root.modal-open { return; }
        root.sftp-rename-tab-id = tab-id;
        root.sftp-rename-path = path;
        root.sftp-rename-value = name;
        root.sftp-rename-open = true;
    }

    if !root.modal-open && root.terminal-notice.visible
        && !root.terminal-notice-pane-id.is-empty : TerminalNoticeCard {
        width: min(
            Theme.terminal-notice-max-width,
            max(0px, parent.width - 2 * Theme.space-xxl),
        );
        height: min(
            self.width < Theme.terminal-notice-stack-threshold
                ? Theme.terminal-notice-stacked-height
                : Theme.terminal-notice-height,
            max(0px, parent.height - 2 * Theme.space-xxl),
        );
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        notice: root.terminal-notice;
        pane-focused: root.window-active;
        action(command) => {
            root.terminal-notice-action(root.terminal-notice-pane-id, command);
        }
    }

    // Security confirmation always wins. A local dialog stays in state while it
    // is covered, so its user input resumes after the security decision.
    if !root.security-open && root.session-management-open : SessionManagementDialog {
        action: root.session-management-action;
        title: root.session-management-title;
        message: root.session-management-message;
        value <=> root.session-management-value;
        confirm(value) => {
            root.session-management-open = false;
            root.manage-session-action(
                root.session-management-action,
                root.session-management-target,
                value,
            );
        }
        cancel => { root.session-management-open = false; }
    }

    if !root.security-open && root.workspace-file-open : WorkspaceFileDialog {
        mode: root.workspace-file-mode;
        path <=> root.workspace-file-path;
        confirm(value) => {
            root.workspace-file-open = false;
            root.workspace-file-action(root.workspace-file-mode, value);
        }
        cancel => { root.workspace-file-open = false; }
    }

    if !root.security-open && root.sftp-rename-open : SftpRenameDialog {
        value <=> root.sftp-rename-value;
        confirm(value) => {
            root.sftp-rename-open = false;
            root.rename-remote-sftp(root.sftp-rename-tab-id, root.sftp-rename-path, value);
        }
        cancel => { root.sftp-rename-open = false; }
    }

    if !root.security-open && !root.workspace-file-open && !root.session-management-open && !root.sftp-rename-open
        && root.ssh-tool-mode.is-empty && !root.openssh-import-open && root.transfer-conflict-open : SftpTransferConflictDialog {
        upload: root.transfer-conflict-upload;
        conflict-id: root.transfer-conflict-id;
        file-name: root.transfer-conflict-name;
        target-size: root.transfer-conflict-size;
        target-modified: root.transfer-conflict-modified;
        resolve(choice, apply-to-batch) => {
            root.resolve-sftp-transfer-conflict(root.transfer-conflict-id, choice, apply-to-batch);
        }
    }

    if root.security.host_key_open : HostKeyDialog {
        endpoint: root.security.host_key_endpoint;
        fingerprint: root.security.host_key_fingerprint;
        changed: root.security.host_key_changed;
        revoked: root.security.host_key_revoked;
        monospace-font-family: root.monospace-font-family;
        confirm => { root.confirm-host-key(); }
        cancel => { root.reject-host-key(); }
    }

    if !root.security.host_key_open && root.security.password_open && root.security.password_credential_unavailable : CredentialAccessDialog {
        endpoint: root.security.password_endpoint;
        apple-platform: root.apple-platform;
        resolve(retry) => { root.resolve-credential-access(retry); }
        cancel => { root.cancel-password-dialog(); }
    }

    if !root.security.host_key_open && root.security.password_open && !root.security.password_credential_unavailable : AuthenticationDialog {
        endpoint: root.security.password_endpoint;
        apple-platform: root.apple-platform;
        private-key: root.security.password_private_key;
        vault-storage: root.security.password_vault_storage;
        vault-unlock-only: root.security.password_vault_unlock_only;
        prompt-id: root.security.password_prompt_id;
        default-credential-storage: root.security.default_credential_storage;
        key-path: root.security.password_key_path;
        authenticate(secret, vault-password, remember, storage) => {
            return root.authenticate-session(secret, vault-password, remember, storage);
        }
        cancel => { root.cancel-password-dialog(); }
    }
}
