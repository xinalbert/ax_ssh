import { CheckBox, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ElidedButton, ElidedLabel } from "elided-controls.slint";
import { FlatTextInput } from "flat-text-input.slint";

export enum SettingsNavIcon {
    General,
    Appearance,
    Terminal,
    X11,
    Workspace,
    Shortcuts,
    About,
}

export component SettingsNavGlyph inherits Rectangle {
    in property <SettingsNavIcon> icon: SettingsNavIcon.General;
    in property <brush> glyph-color: Theme.text;

    width: Theme.settings-icon-size;
    height: Theme.settings-icon-size;
    background: transparent;

    if root.icon == SettingsNavIcon.General : Rectangle {
        first-line := Rectangle {
            y: parent.height * 0.2;
            width: parent.width;
            height: Theme.settings-icon-stroke;
            border-radius: self.height / 2;
            background: root.glyph-color;
        }
        Rectangle {
            x: parent.width * 0.2;
            y: first-line.y - (self.height - first-line.height) / 2;
            width: Theme.settings-icon-knob-size;
            height: Theme.settings-icon-knob-size;
            border-radius: self.width / 2;
            background: root.glyph-color;
        }

        second-line := Rectangle {
            y: parent.height * 0.5;
            width: parent.width;
            height: Theme.settings-icon-stroke;
            border-radius: self.height / 2;
            background: root.glyph-color;
        }
        Rectangle {
            x: parent.width * 0.62;
            y: second-line.y - (self.height - second-line.height) / 2;
            width: Theme.settings-icon-knob-size;
            height: Theme.settings-icon-knob-size;
            border-radius: self.width / 2;
            background: root.glyph-color;
        }

        third-line := Rectangle {
            y: parent.height * 0.8;
            width: parent.width;
            height: Theme.settings-icon-stroke;
            border-radius: self.height / 2;
            background: root.glyph-color;
        }
        Rectangle {
            x: parent.width * 0.36;
            y: third-line.y - (self.height - third-line.height) / 2;
            width: Theme.settings-icon-knob-size;
            height: Theme.settings-icon-knob-size;
            border-radius: self.width / 2;
            background: root.glyph-color;
        }
    }

    if root.icon == SettingsNavIcon.Appearance : Rectangle {
        Rectangle {
            x: 4px;
            y: 4px;
            width: 10px;
            height: 10px;
            background: transparent;
            border-width: Theme.settings-icon-stroke;
            border-color: root.glyph-color;
            border-radius: self.width / 2;
        }
        Path {
            width: parent.width;
            height: parent.height;
            commands: "M 9 0.5 L 9 2.5 M 9 15.5 L 9 17.5 M 0.5 9 L 2.5 9 M 15.5 9 L 17.5 9 M 3 3 L 4.4 4.4 M 13.6 13.6 L 15 15 M 15 3 L 13.6 4.4 M 4.4 13.6 L 3 15";
            fill: transparent;
            stroke: root.glyph-color;
            stroke-width: Theme.settings-icon-stroke;
            stroke-line-cap: round;
        }
    }

    if root.icon == SettingsNavIcon.Terminal : Rectangle {
        x: 1px;
        y: 2px;
        width: parent.width - 2px;
        height: parent.height - 4px;
        background: transparent;
        border-width: Theme.settings-icon-stroke;
        border-color: root.glyph-color;
        border-radius: Theme.radius-small;

        Path {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            commands: "M 1 3 L 4 6 L 1 9 M 6 9 L 10 9";
            fill: transparent;
            stroke: root.glyph-color;
            stroke-width: Theme.settings-icon-stroke;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
    }

    if root.icon == SettingsNavIcon.Workspace : Rectangle {
        x: 1px;
        y: 2px;
        width: parent.width - 2px;
        height: parent.height - 4px;
        background: transparent;
        border-width: Theme.settings-icon-stroke;
        border-color: root.glyph-color;
        border-radius: Theme.radius-small;

        Path {
            x: 6px;
            y: 2px;
            width: 1px;
            height: parent.height - 4px;
            commands: "M 0 0 L 0 10";
            fill: transparent;
            stroke: root.glyph-color;
            stroke-width: Theme.settings-icon-stroke;
            stroke-line-cap: round;
        }
    }

    if root.icon == SettingsNavIcon.X11 : Rectangle {
        x: 1px;
        y: 2px;
        width: parent.width - 2px;
        height: parent.height - 5px;
        background: transparent;
        border-width: Theme.settings-icon-stroke;
        border-color: root.glyph-color;
        border-radius: Theme.radius-small;

        Path {
            x: 3px;
            y: 2px;
            width: parent.width - 6px;
            height: parent.height - 4px;
            commands: "M 1 1 L 9 7 M 9 1 L 1 7";
            fill: transparent;
            stroke: root.glyph-color;
            stroke-width: Theme.settings-icon-stroke;
            stroke-line-cap: round;
        }
        Rectangle {
            x: (parent.width - 8px) / 2;
            y: parent.height;
            width: 8px;
            height: Theme.settings-icon-stroke;
            background: root.glyph-color;
            border-radius: self.height / 2;
        }
    }

    if root.icon == SettingsNavIcon.Shortcuts : Rectangle {
        x: 1px;
        y: 4px;
        width: parent.width - 2px;
        height: parent.height - 6px;
        background: transparent;
        border-width: Theme.settings-icon-stroke;
        border-color: root.glyph-color;
        border-radius: Theme.radius-small;

        Rectangle {
            x: 3px;
            y: 3px;
            width: 2px;
            height: 2px;
            border-radius: Theme.hairline;
            background: root.glyph-color;
        }
        Rectangle {
            x: 7px;
            y: 3px;
            width: 2px;
            height: 2px;
            border-radius: Theme.hairline;
            background: root.glyph-color;
        }
        Rectangle {
            x: 11px;
            y: 3px;
            width: 2px;
            height: 2px;
            border-radius: Theme.hairline;
            background: root.glyph-color;
        }
        Rectangle {
            x: 5px;
            y: 7px;
            width: 6px;
            height: Theme.settings-icon-stroke;
            border-radius: self.height / 2;
            background: root.glyph-color;
        }
    }

    if root.icon == SettingsNavIcon.About : Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        background: transparent;
        border-width: Theme.settings-icon-stroke;
        border-color: root.glyph-color;
        border-radius: self.width / 2;

        Rectangle {
            x: (parent.width - Theme.settings-icon-stroke) / 2;
            y: 4px;
            width: Theme.settings-icon-stroke;
            height: Theme.settings-icon-stroke;
            border-radius: self.width / 2;
            background: root.glyph-color;
        }
        Rectangle {
            x: (parent.width - Theme.settings-icon-stroke) / 2;
            y: 8px;
            width: Theme.settings-icon-stroke;
            height: 5px;
            border-radius: self.width / 2;
            background: root.glyph-color;
        }
    }
}

export component SettingsNavItem inherits FocusScope {
    in property <SettingsNavIcon> icon: SettingsNavIcon.General;
    in property <string> label;
    in property <string> tooltip-text;
    in property <string> accessible-name: root.label;
    in property <bool> selected;
    callback activated();

    private property <length> label-line-height: nav-label.line-height;

    height: max(
        Theme.settings-nav-item-min-height,
        root.label-line-height + 2 * Theme.settings-nav-item-padding-y,
        Theme.settings-icon-size + 2 * Theme.settings-nav-item-padding-y,
    );
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.accessible-name;

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        border-radius: Theme.radius-small;
        background: root.selected
            ? Theme.hover
            : (nav-touch.has-hover || root.has-focus ? Theme.background : transparent);

        Rectangle {
            x: 0px;
            width: 2 * Theme.hairline;
            height: Theme.settings-nav-indicator-height;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.hairline;
            background: root.selected || root.has-focus ? Theme.accent : transparent;
        }

        nav-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.activated(); }
        }

        HorizontalLayout {
            padding-left: Theme.space-lg;
            padding-right: Theme.space-md;
            spacing: Theme.space-md;
            Rectangle {
                width: Theme.settings-nav-icon-width;
                SettingsNavGlyph {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: root.icon;
                    glyph-color: root.selected ? Theme.accent : Theme.muted;
                }
            }
            nav-label := ElidedLabel {
                horizontal-stretch: 1;
                text: root.label;
                tooltip-text: root.tooltip-text;
                text-color: Theme.text;
                font-size: Theme.font-body;
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <length> content-width: Theme.settings-content-width;
    in property <int> scroll-revision: 0;

    background: Theme.background;

    settings-scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-width: self.visible-width;
        viewport-height: max(
            self.visible-height,
            settings-content.preferred-height + 2 * Theme.space-xl,
        );

        settings-page := Rectangle {
            width: settings-scroll.visible-width;
            height: max(
                settings-scroll.visible-height,
                settings-content.preferred-height + 2 * Theme.space-xl,
            );
            background: Theme.background;

            settings-content := VerticalLayout {
                x: Theme.page-padding;
                y: Theme.space-xl;
                width: min(root.content-width, parent.width - 2 * Theme.page-padding);
                height: self.preferred-height;
                spacing: 0px;

                @children
            }
        }
    }

    changed scroll-revision => { settings-scroll.viewport-y = 0px; }
}

export component SettingsHeader inherits Rectangle {
    in property <string> title;
    in property <length> content-width: Theme.settings-content-width;
    in-out property <string> search-query;
    callback clear-search();

    height: Theme.settings-header-height;
    background: Theme.background;

    HorizontalLayout {
        x: Theme.page-padding;
        y: (parent.height - Theme.hairline - self.height) / 2;
        width: min(root.content-width, parent.width - 2 * Theme.page-padding);
        height: Theme.settings-control-height;
        spacing: Theme.space-md;

        Text {
            width: Theme.settings-search-title-width;
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-header;
            font-weight: 700;
            overflow: elide;
            vertical-alignment: center;
        }
        FlatTextInput {
            horizontal-stretch: 1;
            height: Theme.settings-control-height;
            text <=> root.search-query;
            placeholder-text: @tr("Search settings");
            accessible-label: @tr("Search all settings");
        }
        if !root.search-query.is-empty : ElidedButton {
            width: Theme.settings-search-clear-width;
            height: Theme.settings-control-height;
            text: @tr("Clear");
            clicked => { root.clear-search(); }
            accessible-name: @tr("Clear settings search");
        }
    }
    Rectangle {
        y: parent.height - Theme.hairline;
        width: parent.width;
        height: Theme.hairline;
        background: Theme.divider;
    }
}

export component SettingsSearchResult inherits FocusScope {
    in property <string> section;
    in property <string> title;
    in property <string> description;
    in property <string> section-tooltip-text;
    in property <string> title-tooltip-text;
    in property <string> description-tooltip-text;
    in property <string> accessible-name: @tr("{0}: {1}", root.section, root.title);
    callback activated();

    height: Theme.settings-search-result-height;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.accessible-name;

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    surface := Rectangle {
        background: result-touch.has-hover || root.has-focus ? Theme.hover : transparent;
        border-radius: Theme.radius-small;

        result-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.activated(); }
        }

        HorizontalLayout {
            padding-left: Theme.space-lg;
            padding-right: Theme.space-lg;
            spacing: Theme.space-lg;

            VerticalLayout {
                horizontal-stretch: 1;
                y: (parent.height - self.height) / 2;
                height: self.preferred-height;
                spacing: Theme.space-xxs;

                ElidedLabel {
                    text: root.title;
                    tooltip-text: root.title-tooltip-text;
                    text-color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 600;
                }
                ElidedLabel {
                    text: root.description;
                    tooltip-text: root.description-tooltip-text;
                    text-color: Theme.muted;
                    font-size: Theme.font-caption;
                }
            }

            ElidedLabel {
                width: Theme.settings-search-section-width;
                text: root.section;
                tooltip-text: root.section-tooltip-text;
                text-color: Theme.accent;
                font-size: Theme.font-caption;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
        }

        Rectangle {
            y: parent.height - Theme.hairline;
            width: parent.width;
            height: Theme.hairline;
            background: Theme.divider;
        }
    }
}

export component SettingsSectionHeading inherits Text {
    in property <string> label;
    private property <length> label-line-height:
        root.font-metrics.ascent - root.font-metrics.descent;

    height: max(
        Theme.settings-section-min-height,
        root.label-line-height + 2 * Theme.settings-section-padding-y,
    );
    text: root.label;
    color: Theme.muted;
    font-size: Theme.font-caption;
    font-weight: 700;
    vertical-alignment: center;
}

export component SettingsField inherits Rectangle {
    in property <length> field-width: Theme.settings-field-width;

    width: root.field-width;
    height: max(Theme.settings-row-min-height, field-layout.preferred-height);
    background: transparent;

    field-layout := HorizontalLayout {
        padding-top: Theme.settings-control-vertical-padding;
        padding-bottom: Theme.settings-control-vertical-padding;
        spacing: Theme.space-md;
        alignment: end;

        @children
    }
}

export component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <length> label-width: Theme.settings-label-width;
    in property <bool> show-divider: true;

    height: max(Theme.settings-row-min-height, row-layout.preferred-height);
    background: transparent;

    row-layout := HorizontalLayout {
        spacing: Theme.space-lg;
        label-container := Rectangle {
            width: root.label-width;
            min-height: label-column.preferred-height;

            label-column := VerticalLayout {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: self.preferred-height;
                spacing: root.description.is-empty ? 0px : Theme.space-xxs;

                Text {
                    text: root.label;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if !root.description.is-empty : Text {
                    text: root.description;
                    color: Theme.muted;
                    font-size: Theme.font-caption;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        @children
    }

    Rectangle {
        y: parent.height - Theme.hairline;
        width: parent.width;
        height: Theme.hairline;
        background: root.show-divider ? Theme.divider : transparent;
    }
}

export component SettingsToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in-out property <bool> checked;
    in property <bool> show-divider: true;
    in property <bool> control-enabled: true;

    height: toggle-row.height;

    toggle-row := SettingsRow {
        label: root.label;
        description: root.description;
        show-divider: root.show-divider;
        SettingsField {
            CheckBox {
                height: Theme.settings-control-height;
                checked <=> root.checked;
                enabled: root.control-enabled;
                accessible-label: root.label;
            }
        }
    }
}

export component SettingsInfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> show-divider: true;

    height: info-row.height;

    info-row := SettingsRow {
        label: root.label;
        show-divider: root.show-divider;
        SettingsField {
            Text {
                width: Theme.settings-field-width;
                text: root.value;
                color: Theme.muted;
                font-size: Theme.font-small;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

export component ShortcutRecorder inherits FocusScope {
    in-out property <string> shortcut;
    in property <string> accessible-name;
    private property <string> candidate-shortcut;

    callback format-shortcut(string, bool, bool, bool, bool) -> string;
    callback recording-changed(bool);

    height: Theme.settings-control-height;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: text-input;
    accessible-label: root.accessible-name;

    focus-gained => { root.recording-changed(true); }
    focus-lost => { root.recording-changed(false); }
    key-pressed(event) => {
        if event.text == Key.Escape {
            root.clear-focus();
            return EventResult.accept;
        }
        root.candidate-shortcut = root.format-shortcut(
            event.text,
            event.modifiers.alt,
            event.modifiers.control,
            event.modifiers.meta,
            event.modifiers.shift,
        );
        if !root.candidate-shortcut.is-empty {
            root.shortcut = root.candidate-shortcut;
            root.clear-focus();
        }
        return EventResult.accept;
    }

    Rectangle {
        background: root.has-focus ? Theme.hover : Theme.panel;
        border-width: root.has-focus ? 2 * Theme.hairline : Theme.hairline;
        border-color: root.has-focus ? Theme.focus : Theme.control-border;
        border-radius: Theme.radius-small;
        Text {
            x: Theme.space-lg;
            width: parent.width - 2 * Theme.space-lg;
            height: parent.height;
            text: root.shortcut;
            color: Theme.text;
            font-family: Theme.application-font-family;
            font-size: Theme.font-caption;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
