import { CheckBox } from "std-widgets.slint";
import { ElidedButton, ElidedLabel } from "elided-controls.slint";
import { ModalFrame } from "modal-frame.slint";
import { Theme } from "../theme.slint";

export component SftpTransferConflictDialog inherits ModalFrame {
    in property <bool> upload: true;
    in property <string> conflict-id;
    in property <string> file-name;
    in property <string> target-size;
    in property <string> target-modified;
    callback resolve(string, bool);

    private property <bool> apply-to-batch: false;
    changed conflict-id => { root.apply-to-batch = false; }

    dialog-width: Theme.host-dialog-width;
    dialog-height: 278px;
    dismissed => { root.resolve("skip", false); }

    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: Theme.space-xl;
        Text {
            text: root.upload ? @tr("Remote file already exists") : @tr("Local file already exists");
            color: Theme.text;
            font-size: Theme.font-title;
            font-weight: 700;
        }
        ElidedLabel {
            accessible-role: text;
            accessible-label: self.text;
            text: root.file-name;
            text-color: Theme.text;
            font-size: Theme.font-body;
        }
        Text {
            text: root.upload
                ? @tr("Remote file: {0} - Modified: {1}", root.target-size, root.target-modified)
                : @tr("Local file: {0} - Modified: {1}", root.target-size, root.target-modified);
            color: Theme.muted;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        CheckBox {
            text: root.upload ? @tr("Apply this choice to this upload batch")
                : @tr("Apply this choice to this download batch");
            checked <=> root.apply-to-batch;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-md;
            ElidedButton {
                text: @tr("Skip");
                clicked => { root.resolve("skip", root.apply-to-batch); }
            }
            ElidedButton {
                text: @tr("Keep both");
                clicked => { root.resolve("keep-both", root.apply-to-batch); }
            }
            ElidedButton {
                text: @tr("Overwrite");
                clicked => { root.resolve("overwrite", root.apply-to-batch); }
            }
        }
    }
}
