import { ElidedButton } from "elided-controls.slint";
import { FlatTextInput } from "flat-text-input.slint";
import { ModalFrame } from "modal-frame.slint";
import { Theme } from "../theme.slint";

export component SessionManagementDialog inherits ModalFrame {
    in property <string> action;
    in property <string> title;
    in property <string> message;
    in-out property <string> value;

    callback confirm(string);
    callback cancel();

    private property <bool> accepts-name: root.action == "new-group"
        || root.action == "rename-group";

    dialog-width: Theme.session-management-dialog-width;
    dialog-height: Theme.session-management-dialog-height;
    dialog-border-color: root.action == "delete-group" || root.action == "delete-session"
        ? Theme.danger : Theme.frame-border;
    dismissed => { root.cancel(); }

    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: Theme.space-xl;
        Text {
            text: root.title;
            color: root.action == "delete-group" || root.action == "delete-session"
                ? Theme.danger : Theme.text;
            font-size: Theme.font-title;
            font-weight: 700;
        }
        if !root.message.is-empty : Text {
            text: root.message;
            color: Theme.muted;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        if root.accepts-name : FlatTextInput {
            text <=> root.value;
            placeholder-text: @tr("Group name");
            accessible-label: @tr("Group name");
            accepted(value) => {
                if !value.is-empty {
                    root.confirm(value);
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-md;
            ElidedButton { text: @tr("Cancel"); clicked => { root.cancel(); } }
            ElidedButton {
                text: root.action == "delete-group" || root.action == "delete-session"
                    ? @tr("Delete") : @tr("Save");
                enabled: !root.accepts-name || !root.value.is-empty;
                clicked => { root.confirm(root.value); }
            }
        }
    }
}
