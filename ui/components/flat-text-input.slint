import { FlatActionMenu, MenuActions } from "flat-action-menu.slint";
import { Theme } from "../theme.slint";
import { EditingTextInput } from "editing-text-input.slint";

// A theme-owned single-line input that avoids platform widget chrome.
export component FlatTextInput inherits FocusScope {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <InputType> input-type: InputType.text;
    in property <bool> read-only: false;
    in property <length> font-size: Theme.font-body;
    in property <string> font-family;
    in property <int> font-weight: 400;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <length> control-min-height: Theme.settings-control-height;
    out property <bool> has-input-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);

    min-height: root.visible ? root.control-min-height : 0px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    forward-focus: input;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-read-only: root.read-only;
    accessible-action-set-value(value) => {
        if !root.read-only && root.enabled {
            root.text = value;
            root.edited(value);
        }
    }

    surface := Rectangle {
        background: !root.enabled
            ? Theme.hover
            : (root.has-input-focus ? Theme.hover : Theme.panel);
        border-width: Theme.hairline;
        border-color: root.has-input-focus ? Theme.focus : Theme.control-border;
        border-radius: Theme.radius-small;
        clip: true;
        opacity: root.enabled ? 1 : Theme.combo-box-disabled-opacity;

        placeholder := Text {
            x: Theme.combo-box-horizontal-padding;
            width: parent.width - 2 * Theme.combo-box-horizontal-padding;
            height: parent.height;
            text: root.text.is-empty && input.preedit-text.is-empty
                ? root.placeholder-text
                : "";
            color: Theme.muted;
            font-size: root.font-size;
            font-family: root.font-family;
            font-weight: root.font-weight;
            horizontal-alignment: root.horizontal-alignment;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            mouse-cursor: MouseCursor.text;
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    input.focus();
                    edit-menu.show-at({ x: self.mouse-x, y: self.mouse-y });
                }
            }

            input := EditingTextInput {
                private property <length> computed-x: Theme.combo-box-horizontal-padding;

                x: min(
                    Theme.combo-box-horizontal-padding,
                    max(
                        parent.width
                            - Theme.combo-box-horizontal-padding
                            - self.width
                            - self.text-cursor-width,
                        self.computed-x,
                    ),
                );
                width: max(
                    parent.width - 2 * Theme.combo-box-horizontal-padding - self.text-cursor-width,
                    self.preferred-width,
                );
                height: parent.height;
                text <=> root.text;
                color: Theme.text;
                font-size: root.font-size;
                font-family: root.font-family;
                font-weight: root.font-weight;
                input-type: root.input-type;
                horizontal-alignment: root.horizontal-alignment;
                vertical-alignment: center;
                selection-background-color: Theme.accent.with-alpha(0.35);
                selection-foreground-color: Theme.text;
                enabled: root.enabled;
                read-only: root.read-only;
                accessible-role: none;

                cursor-position-changed(position) => {
                    if position.x + self.computed-x < Theme.combo-box-horizontal-padding {
                        self.computed-x = Theme.combo-box-horizontal-padding - position.x;
                    } else if position.x + self.computed-x
                            > parent.width - Theme.combo-box-horizontal-padding - self.text-cursor-width {
                        self.computed-x = parent.width
                            - Theme.combo-box-horizontal-padding
                            - self.text-cursor-width
                            - position.x;
                    }
                }

                accepted => { root.accepted(root.text); }
                edited => { root.edited(root.text); }
            }
        }
    }

    capture-key-pressed(event) => {
        if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
            edit-menu.show-at({ x: 0px, y: root.height });
            return EventResult.accept;
        }
        return EventResult.reject;
    }
    edit-menu := FlatActionMenu {
        context-enabled: root.enabled;
        actions: [
            MenuActions.item("cut", @tr("Cut"), root.enabled && !root.read-only),
            MenuActions.item("copy", @tr("Copy"), !root.text.is-empty),
            MenuActions.item("paste", @tr("Paste"), root.enabled && !root.read-only),
            MenuActions.item("select-all", @tr("Select All"), !root.text.is-empty),
        ];
        triggered(action) => {
            if action == "cut" { input.cut(); }
            else if action == "copy" { input.copy(); }
            else if action == "paste" { input.paste(); }
            else if action == "select-all" { input.select-all(); }
        }
    }
}
