import { Button, CheckBox } from "std-widgets.slint";
import { SecretTextInput } from "secret-text-input.slint";
import { Theme } from "../theme.slint";

export component HostKeyDialog inherits Rectangle {
    in property <string> endpoint;
    in property <string> fingerprint;
    in property <bool> changed;
    in property <string> monospace-font-family;

    callback confirm();
    callback cancel();

    background: Theme.overlay;
    TouchArea { }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: Theme.host-dialog-width;
        height: Theme.host-dialog-height;
        background: Theme.panel-alt;
        border-width: Theme.hairline;
        border-color: root.changed ? Theme.danger : Theme.frame-border;
        border-radius: Theme.radius;

        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.space-xl;
            Text {
                text: root.changed ? "SSH host key changed" : "Unknown SSH host key";
                color: root.changed ? Theme.danger : Theme.text;
                font-size: Theme.font-title;
                font-weight: 700;
            }
            Text { text: root.endpoint; color: Theme.muted; font-size: Theme.font-body; }
            Text { text: "SHA-256 fingerprint"; color: Theme.muted; font-size: Theme.font-small; }
            Text {
                text: root.fingerprint;
                color: Theme.text;
                font-family: root.monospace-font-family;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                spacing: Theme.space-md;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button {
                    text: root.changed ? "Trust new key" : "Trust and continue";
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}

export component AuthenticationDialog inherits Rectangle {
    in property <string> endpoint;
    in property <bool> private-key;
    in property <bool> vault-storage;
    in property <bool> vault-unlock-only;
    in property <string> default-credential-storage;
    in property <string> key-path;
    in property <string> prompt-id;

    callback authenticate(string, string, bool) -> bool;
    callback cancel();

    function submit() {
        if root.authenticate(
            secret-edit.text,
            vault-password-edit.text,
            remember-password.checked,
        ) {
            secret-edit.clear();
            vault-password-edit.clear();
        }
    }

    function cancel-and-clear() {
        secret-edit.clear();
        vault-password-edit.clear();
        root.cancel();
    }

    changed prompt-id => {
        secret-edit.clear();
        vault-password-edit.clear();
        remember-password.checked = false;
    }

    background: Theme.overlay;
    TouchArea { }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: Theme.password-dialog-width;
        height: root.private-key
            ? Theme.password-private-key-dialog-height
            : (root.vault-storage || root.default-credential-storage == "encrypted-vault"
                ? Theme.password-private-key-dialog-height
                : Theme.password-dialog-height);
        background: Theme.panel-alt;
        border-width: Theme.hairline;
        border-color: Theme.frame-border;
        border-radius: Theme.radius;

        VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.space-xl;
            Text {
                text: root.private-key
                    ? "Private key authentication"
                    : (root.vault-unlock-only ? "Unlock encrypted credentials" : "Password authentication");
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: 700;
            }
            Text {
                text: root.endpoint;
                color: Theme.muted;
                font-size: Theme.font-body;
                overflow: elide;
            }
            if root.private-key : Text {
                text: root.key-path;
                color: Theme.text;
                font-size: Theme.font-small;
                overflow: elide;
            }
            secret-edit := SecretTextInput {
                visible: !root.vault-unlock-only;
                height: self.visible ? Theme.editor-input-row-height : 0px;
                placeholder-text: root.private-key
                    ? "Private key passphrase (optional)"
                    : "Password";
                accessible-label: root.private-key
                    ? "Private key passphrase"
                    : "SSH password";
                accepted => { root.submit(); }
            }
            vault-password-edit := SecretTextInput {
                visible: !root.private-key
                    && (root.vault-storage || root.default-credential-storage == "encrypted-vault");
                height: self.visible ? Theme.editor-input-row-height : 0px;
                placeholder-text: root.vault-unlock-only
                    ? "Vault password"
                    : "Vault password (only needed when remembering)";
                accessible-label: "Vault password";
                accepted => { root.submit(); }
            }
            remember-password := CheckBox {
                visible: !root.private-key && !root.vault-unlock-only;
                height: self.visible ? Theme.editor-check-row-height : 0px;
                text: root.default-credential-storage == "encrypted-vault"
                    ? "Remember password in encrypted application vault"
                    : "Remember password in system credential store";
                checked: false;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Theme.space-md;
                Button { text: "Cancel"; clicked => { root.cancel-and-clear(); } }
                Button {
                    text: "Connect";
                    clicked => {
                        root.submit();
                    }
                }
            }
        }
    }
}
