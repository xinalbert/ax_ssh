import { CheckBox } from "std-widgets.slint";
import { ElidedButton } from "elided-controls.slint";
import { ModalFrame } from "modal-frame.slint";
import { SecretTextInput } from "secret-text-input.slint";
import { ThemedComboBox } from "themed-combo-box.slint";
import { Theme } from "../theme.slint";

export component HostKeyDialog inherits ModalFrame {
    in property <string> endpoint;
    in property <string> fingerprint;
    in property <bool> changed;
    in property <bool> revoked;
    in property <string> monospace-font-family;

    callback confirm();
    callback cancel();

    dialog-width: Theme.host-dialog-width;
    dialog-height: Theme.host-dialog-height;
    dialog-border-color: root.changed ? Theme.danger : Theme.frame-border;
    dismissed => { root.cancel(); }

    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: Theme.space-xl;
        Text {
            text: root.revoked ? @tr("SSH host key revoked") : (root.changed ? @tr("SSH host key changed") : @tr("Unknown SSH host key"));
            color: root.revoked || root.changed ? Theme.danger : Theme.text;
            font-size: Theme.font-title;
            font-weight: 700;
        }
        Text { text: root.endpoint; color: Theme.muted; font-size: Theme.font-body; }
        Text { text: @tr("SHA-256 fingerprint"); color: Theme.muted; font-size: Theme.font-small; }
        Text {
            text: root.fingerprint;
            color: Theme.text;
            font-family: root.monospace-font-family;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-md;
            ElidedButton { text: @tr("Cancel"); clicked => { root.cancel(); } }
            ElidedButton {
                text: root.revoked ? @tr("Remove revoked record") : (root.changed ? @tr("Trust new key") : @tr("Trust and continue"));
                clicked => { root.confirm(); }
            }
        }
    }
}

export component AuthenticationDialog inherits ModalFrame {
    in property <string> endpoint;
    in property <bool> private-key;
    in property <bool> vault-storage;
    in property <bool> vault-unlock-only;
    in property <string> default-credential-storage;
    in property <string> key-path;
    in property <string> prompt-id;

    callback authenticate(string, string, bool, string) -> bool;
    callback cancel();

    private property <[string]> credential-storage-options: [
        @tr("System credential store"),
        @tr("Encrypted application vault"),
    ];
    private property <string> selected-credential-storage: root.default-credential-storage;

    function submit() {
        if root.authenticate(
            secret-edit.text,
            vault-password-edit.text,
            remember-password.checked,
            root.selected-credential-storage,
        ) {
            secret-edit.clear();
            vault-password-edit.clear();
        }
    }

    function cancel-and-clear() {
        secret-edit.clear();
        vault-password-edit.clear();
        root.cancel();
    }

    changed prompt-id => {
        secret-edit.clear();
        vault-password-edit.clear();
        remember-password.checked = false;
        root.selected-credential-storage = root.default-credential-storage;
    }

    dialog-width: Theme.password-dialog-width;
    dialog-height: root.private-key
        ? Theme.password-private-key-dialog-height
        : Theme.password-dialog-height;
    dismissed => { root.cancel-and-clear(); }

    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: Theme.space-xl;
        Text {
            text: root.private-key
                ? @tr("Private key authentication")
                : (root.vault-unlock-only ? @tr("Unlock encrypted credentials") : @tr("Password authentication"));
            color: Theme.text;
            font-size: Theme.font-title;
            font-weight: 700;
        }
        Text {
            text: root.endpoint;
            color: Theme.muted;
            font-size: Theme.font-body;
            overflow: elide;
        }
        if root.private-key : Text {
            text: root.key-path;
            color: Theme.text;
            font-size: Theme.font-small;
            overflow: elide;
        }
        secret-edit := SecretTextInput {
            visible: !root.vault-unlock-only;
            height: self.visible ? Theme.editor-input-row-height : 0px;
            placeholder-text: root.private-key
                ? @tr("Private key passphrase (optional)")
                : @tr("Password");
            accessible-label: root.private-key
                ? @tr("Private key passphrase")
                : @tr("SSH password");
            accepted => { root.submit(); }
        }
        vault-password-edit := SecretTextInput {
            visible: !root.private-key
                && (root.vault-storage
                    || (remember-password.checked
                        && root.selected-credential-storage == "encrypted-vault"));
            height: self.visible ? Theme.editor-input-row-height : 0px;
            placeholder-text: root.vault-unlock-only
                ? @tr("Vault password")
                : @tr("Optional; blank generates a hidden vault key");
            accessible-label: @tr("Vault password");
            accepted => { root.submit(); }
        }
        remember-password := CheckBox {
            visible: !root.private-key && !root.vault-unlock-only;
            height: self.visible ? Theme.editor-check-row-height : 0px;
            text: @tr("Save password (optional)");
            checked: false;
        }
        if !root.private-key && !root.vault-unlock-only : HorizontalLayout {
            height: Theme.combo-box-control-height;
            spacing: Theme.space-md;
            Text {
                width: 132px;
                text: @tr("Save password in");
                color: Theme.muted;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
            credential-storage-picker := ThemedComboBox {
                enabled: remember-password.checked;
                current-index: root.selected-credential-storage == "encrypted-vault" ? 1 : 0;
                model: root.credential-storage-options;
                accessible-label: @tr("Credential storage");
                selected(_value, index) => {
                    root.selected-credential-storage = index == 1
                        ? "encrypted-vault"
                        : "system-keyring";
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-md;
            ElidedButton { text: @tr("Cancel"); clicked => { root.cancel-and-clear(); } }
            ElidedButton {
                text: @tr("Connect");
                clicked => {
                    root.submit();
                }
            }
        }
    }
}
