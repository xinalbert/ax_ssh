// Application-wide keyboard DTO. Logical and physical identity are kept
// separate so shortcut, IME, and text-input semantics stay layout-aware.
export struct KeyboardEvent {
    text: string,
    logical_key: string,
    physical_code: string,
    location: string,
    alt: bool,
    control: bool,
    meta: bool,
    shift: bool,
    is_composing: bool,
    is_repeat: bool,
    is_synthetic: bool,
    is_paste: bool,
    uses_native_modifiers: bool,
}

export struct TerminalKeyboardEvent {
    terminal_id: string,
    event: KeyboardEvent,
}

export struct TerminalDirectKeyboardEvent {
    event: KeyboardEvent,
    option_as_meta: bool,
    preedit_active: bool,
}

export struct KeyboardLogEvent {
    event: KeyboardEvent,
    route: string,
    action: string,
}
