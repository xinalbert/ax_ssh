import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ElidedLabel } from "elided-controls.slint";

export struct WorkspaceTabRow {
    id: string,
    title: string,
    kind: string,
    connected: bool,
}

export struct ConnectableSessionRow {
    id: string,
    name: string,
    endpoint: string,
}

component WindowFrameGlyph inherits Rectangle {
    in property <color> glyph-color: Theme.text;

    background: transparent;

    Rectangle {
        x: Theme.hairline;
        y: Theme.hairline;
        width: parent.width - 2 * Theme.hairline;
        height: parent.height - 2 * Theme.hairline;
        background: transparent;
        border-width: Theme.hairline;
        border-color: root.glyph-color;
        border-radius: Theme.radius-small;
    }
}

component WorkspaceTransferGlyph inherits Rectangle {
    in property <bool> returning;
    in property <color> glyph-color: Theme.text;

    private property <length> frame-offset: 3 * Theme.hairline;
    private property <length> frame-size: root.width - root.frame-offset - Theme.hairline;

    width: Theme.workspace-transfer-glyph-size;
    height: Theme.workspace-transfer-glyph-size;
    background: transparent;

    WindowFrameGlyph {
        x: root.returning ? root.frame-offset : Theme.hairline;
        y: root.returning ? Theme.hairline : root.frame-offset;
        width: root.frame-size;
        height: root.frame-size;
        glyph-color: root.glyph-color.with-alpha(0.52);
    }
    WindowFrameGlyph {
        x: root.returning ? Theme.hairline : root.frame-offset;
        y: root.returning ? root.frame-offset : Theme.hairline;
        width: root.frame-size;
        height: root.frame-size;
        glyph-color: root.glyph-color;
    }
}

component WorkspaceTabContent inherits HorizontalLayout {
    in property <string> title;
    in property <string> kind;
    in property <bool> connected;
    in property <bool> active: false;
    in property <int> order;
    in property <bool> close-enabled: false;
    in property <bool> window-action-enabled: false;
    in property <bool> detached-window: false;
    callback close();
    callback window-action();
    callback scroll-tabs(length, length);

    private property <length> close-glyph-height:
        close-label.font-metrics.ascent - close-label.font-metrics.descent;
    private property <length> close-button-size: max(
        Theme.tab-close-min-size,
        root.close-glyph-height + Theme.tab-close-padding * 2,
    );

    padding-top: Theme.tab-content-padding-y;
    padding-bottom: Theme.tab-content-padding-y;
    padding-left: Theme.tab-content-leading-padding;
    padding-right: Theme.space-xs;
    spacing: Theme.tab-content-spacing;

    Rectangle {
        width: Theme.tab-status-size;
        background: transparent;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: Theme.tab-status-size;
            height: Theme.tab-status-size;
            border-radius: Theme.radius-small;
            background: root.connected
                ? Theme.success
                : (root.kind == "terminal" ? Theme.accent : Theme.muted);
        }
    }
    Text {
        width: Theme.tab-order-width;
        text: "\{root.order}";
        color: Theme.muted;
        font-size: Theme.tab-order-font-size;
        font-weight: Theme.tab-order-font-weight;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    ElidedLabel {
        horizontal-stretch: 1;
        text: root.title;
        text-color: Theme.text;
        font-size: Theme.tab-title-font-size;
        font-weight: root.active
            ? Theme.tab-title-active-font-weight
            : Theme.tab-title-inactive-font-weight;
    }
    if root.window-action-enabled : Rectangle {
        width: root.close-button-size;
        height: root.close-button-size;
        border-radius: Theme.radius;
        background: window-action-touch.has-hover ? Theme.hover : transparent;
        WorkspaceTransferGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            returning: root.detached-window;
            glyph-color: window-action-touch.has-hover ? Theme.text : Theme.muted;
        }
        window-action-touch := TouchArea {
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: root.detached-window
                ? @tr("Return workspace to main window")
                : @tr("Move workspace to new window");
            clicked => { root.window-action(); }
            scroll-event(event) => {
                root.scroll-tabs(event.delta-x, event.delta-y);
                return EventResult.accept;
            }
        }
    }
    Rectangle {
        width: root.close-button-size;
        height: root.close-button-size;
        border-radius: Theme.radius;
        background: close-touch.has-hover && root.close-enabled ? Theme.hover : transparent;
        close-label := Text {
            width: parent.width;
            height: parent.height;
            text: @tr("x");
            color: Theme.muted;
            font-size: Theme.tab-close-font-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        close-touch := TouchArea {
            enabled: root.close-enabled;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: @tr("Close tab");
            clicked => { root.close(); }
            scroll-event(event) => {
                root.scroll-tabs(event.delta-x, event.delta-y);
                return EventResult.accept;
            }
        }
    }
}

component ConnectionPickerRow inherits FocusScope {
    in property <string> id;
    in property <string> name;
    in property <string> endpoint;
    callback connect-session(string);

    private property <length> name-line-height: name-label.line-height;
    private property <length> endpoint-line-height: endpoint-label.line-height;
    private property <length> row-height: max(
        Theme.titlebar-connection-picker-row-min-height,
        root.name-line-height
            + Theme.titlebar-connection-picker-row-spacing
            + root.endpoint-line-height
            + 2 * Theme.titlebar-connection-picker-row-padding-y,
    );

    height: root.row-height;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.name + ", " + root.endpoint;

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.connect-session(root.id);
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        border-radius: Theme.radius-small;
        background: row-touch.has-hover || root.has-focus ? Theme.hover : transparent;

        VerticalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            padding-top: Theme.titlebar-connection-picker-row-padding-y;
            padding-bottom: Theme.titlebar-connection-picker-row-padding-y;
            spacing: Theme.titlebar-connection-picker-row-spacing;

            name-label := ElidedLabel {
                height: root.name-line-height;
                text: root.name;
                text-color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 700;
            }
            endpoint-label := ElidedLabel {
                height: root.endpoint-line-height;
                text: root.endpoint;
                text-color: Theme.muted;
                font-family: Theme.application-font-family;
                font-size: Theme.font-caption;
            }
        }

        row-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.connect-session(root.id); }
        }
    }
}

export component ConnectionPicker inherits FocusScope {
    in property <[ConnectableSessionRow]> sessions;
    callback connect-session(string);
    callback dismiss();

    private property <length> name-line-height:
        name-probe.font-metrics.ascent - name-probe.font-metrics.descent;
    private property <length> endpoint-line-height:
        endpoint-probe.font-metrics.ascent - endpoint-probe.font-metrics.descent;
    private property <length> row-height: max(
        Theme.titlebar-connection-picker-row-min-height,
        root.name-line-height
            + Theme.titlebar-connection-picker-row-spacing
            + root.endpoint-line-height
            + 2 * Theme.titlebar-connection-picker-row-padding-y,
    );

    width: Theme.titlebar-connection-picker-width;
    height: root.sessions.length == 0
        ? Theme.titlebar-connection-picker-empty-height
        : min(
            Theme.titlebar-connection-picker-max-height,
            root.sessions.length * root.row-height
                + 2 * Theme.titlebar-connection-picker-padding,
        );
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: list;
    accessible-label: @tr("Saved connections");

    key-pressed(event) => {
        if event.text == Key.Escape {
            root.dismiss();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    name-probe := Text {
        visible: false;
        text: @tr("Name");
        font-size: Theme.font-body;
        font-weight: 700;
    }
    endpoint-probe := Text {
        visible: false;
        text: @tr("Endpoint");
        font-family: Theme.application-font-family;
        font-size: Theme.font-caption;
    }

    Rectangle {
        background: Theme.panel;
        border-width: Theme.hairline;
        border-color: Theme.frame-border;
        border-radius: Theme.radius;
        clip: true;

        VerticalLayout {
            padding: Theme.titlebar-connection-picker-padding;
            spacing: 0px;

            if root.sessions.length == 0 : Text {
                text: @tr("No saved connections");
                color: Theme.muted;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.sessions.length > 0 : ListView {
                vertical-stretch: 1;
                for session in root.sessions : ConnectionPickerRow {
                    id: session.id;
                    name: session.name;
                    endpoint: session.endpoint;
                    connect-session(id) => { root.connect-session(id); }
                }
            }
        }
    }
}

component TerminalSplitGlyph inherits Rectangle {
    in property <bool> vertical;
    in property <color> glyph-color: Theme.text;

    width: Theme.terminal-split-glyph-size;
    height: Theme.terminal-split-glyph-size;
    background: transparent;

    WindowFrameGlyph {
        width: parent.width;
        height: parent.height;
        glyph-color: root.glyph-color;
    }
    if root.vertical : Rectangle {
        x: parent.width / 2 - Theme.hairline;
        y: 2 * Theme.hairline;
        width: Theme.hairline;
        height: parent.height - 4 * Theme.hairline;
        background: root.glyph-color;
    }
    if !root.vertical : Rectangle {
        x: 2 * Theme.hairline;
        y: parent.height / 2 - Theme.hairline;
        width: parent.width - 4 * Theme.hairline;
        height: Theme.hairline;
        background: root.glyph-color;
    }
}

export component TerminalSplitButton inherits FocusScope {
    in property <bool> vertical;
    in property <string> accessible-name;
    in property <string> tooltip-text;
    callback activated();

    width: Theme.terminal-split-button-size;
    height: Theme.terminal-split-button-size;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.activated();
        }
    }

    key-pressed(event) => {
        if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        background: split-touch.has-hover || root.has-focus ? Theme.hover : transparent;
        border-width: root.has-focus ? Theme.hairline : 0px;
        border-color: Theme.focus;
        border-radius: Theme.radius-small;

        TerminalSplitGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            vertical: root.vertical;
            glyph-color: root.has-focus || split-touch.has-hover ? Theme.text : Theme.muted;
        }

        split-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.activated(); }
        }

        if !root.tooltip-text.is-empty : Tooltip {
            Text {
                text: root.tooltip-text;
                color: Theme.text;
                font-family: Theme.application-font-family;
                font-size: Theme.font-caption;
            }
        }
    }
}

export component WorkspaceTitlebar inherits Rectangle {
    in property <[WorkspaceTabRow]> tabs;
    in property <string> active-tab-id;
    in property <int> tab-width;
    in property <string> active-tab-kind;
    in property <bool> connection-picker-open;
    in property <bool> connection-picker-enabled: true;
    in property <bool> detached-window: false;

    callback activate-tab(string);
    callback close-tab(string);
    callback move-tab(string, int);
    callback detach-workspace(string);
    callback return-workspace(string);
    callback terminal-pane-command(string);
    callback toggle-connection-picker();

    private property <int> drag-source-index: -1;
    private property <int> drag-target-index: -1;
    private property <string> drag-source-id;
    private property <length> drag-pointer-content-x: 0px;
    private property <length> drag-pointer-offset-x: 0px;
    private property <string> drag-title;
    private property <string> drag-kind;
    private property <bool> drag-connected: false;
    private property <int> drag-order: 0;
    changed tabs => {
        if root.drag-source-index >= root.tabs.length {
            root.clear-tab-drag();
        }
    }

    function scroll-tabs(delta-x: length, delta-y: length) {
        let delta = delta-x != 0px ? delta-x : delta-y;
        tabs-flick.viewport-x = max(
            tabs-flick.width - tabs-flick.viewport-width,
            min(0px, tabs-flick.viewport-x + delta),
        );
    }

    function tab-index-at(content-x: length) -> int {
        return max(
            0,
            min(
                root.tabs.length - 1,
                floor(content-x / (root.tab-width * 1px)),
            ),
        );
    }

    function begin-tab-drag(
        id: string, index: int, title: string, kind: string, connected: bool,
        pointer-x: length,
    ) {
        root.drag-source-id = id;
        root.drag-source-index = index;
        root.drag-target-index = index;
        root.drag-pointer-content-x = index * root.tab-width * 1px + pointer-x;
        root.drag-pointer-offset-x = pointer-x;
        root.drag-title = title;
        root.drag-kind = kind;
        root.drag-connected = connected;
        root.drag-order = index + 1;
    }

    function update-tab-drag(index: int, pointer-x: length) {
        root.drag-pointer-content-x = index * root.tab-width * 1px + pointer-x;
        root.drag-target-index = root.tab-index-at(root.drag-pointer-content-x);
    }

    function update-tab-drag-at-content(content-x: length) {
        root.drag-pointer-content-x = content-x;
        root.drag-target-index = root.tab-index-at(content-x);
    }

    function clear-tab-drag() {
        root.drag-source-id = "";
        root.drag-source-index = -1;
        root.drag-target-index = -1;
    }

    function finish-tab-drag-at-content(content-x: length) {
        let id = root.drag-source-id;
        let source-index = root.drag-source-index;
        let target-index = root.tab-index-at(content-x);
        root.clear-tab-drag();
        if source-index < 0 || id.is-empty {
            return;
        }
        if target-index == source-index {
            root.activate-tab(id);
        } else {
            root.move-tab(id, target-index);
        }
    }

    height: Theme.tab-height;
    background: Theme.panel;
    border-width: 0px;
    clip: true;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;

        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            tabs-flick := Flickable {
                width: parent.width;
                height: parent.height;
                interactive: false;
                viewport-width: max(
                    self.width,
                    root.tabs.length * root.tab-width * 1px,
                );
                viewport-height: self.height;

                for tab[index] in root.tabs : Rectangle {
                    x: index * root.tab-width * 1px;
                    y: 0px;
                    width: root.tab-width * 1px;
                    height: parent.height;
                    background: transparent;
                    opacity: root.drag-source-index == index
                        ? Theme.tab-drag-source-opacity
                        : 1;

                    if tab.id == root.active-tab-id
                            || (root.drag-source-index >= 0
                                && root.drag-target-index == index) : Rectangle {
                        y: Theme.tab-surface-inset + Theme.tab-surface-radius;
                        width: parent.width;
                        height: parent.height - self.y;
                        background: tab.kind == "terminal"
                            ? Theme.panel-alt
                            : Theme.background;
                    }
                    if tab.id == root.active-tab-id
                            || (root.drag-source-index >= 0
                                && root.drag-target-index == index) : Rectangle {
                        y: Theme.tab-surface-inset;
                        width: parent.width;
                        height: parent.height - Theme.tab-surface-inset;
                        border-radius: Theme.tab-surface-radius;
                        background: tab.kind == "terminal"
                            ? Theme.panel-alt
                            : Theme.background;
                    }
                    if root.drag-source-index >= 0
                            && root.drag-target-index == index : Rectangle {
                        x: Theme.tab-surface-radius;
                        y: Theme.tab-surface-inset;
                        width: parent.width - 2 * Theme.tab-surface-radius;
                        height: Theme.hairline;
                        background: Theme.accent;
                    }

                    tab-touch := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down
                                    && event.button == PointerEventButton.left {
                                root.begin-tab-drag(
                                    tab.id, index, tab.title, tab.kind, tab.connected,
                                    self.mouse-x,
                                );
                            } else if event.kind == PointerEventKind.up
                                    && root.drag-source-index >= 0 {
                                root.finish-tab-drag-at-content(
                                    index * root.tab-width * 1px + self.mouse-x,
                                );
                            } else if event.kind == PointerEventKind.cancel
                                    && root.drag-source-index >= 0 {
                                root.clear-tab-drag();
                            }
                        }
                        moved => {
                            if root.drag-source-index == index {
                                root.update-tab-drag(index, self.mouse-x);
                            }
                        }
                        scroll-event(event) => {
                            root.scroll-tabs(event.delta-x, event.delta-y);
                            return EventResult.accept;
                        }
                    }
                    WorkspaceTabContent {
                        width: parent.width;
                        height: parent.height;
                        title: tab.title;
                        kind: tab.kind;
                        connected: tab.connected;
                        active: tab.id == root.active-tab-id;
                        order: index + 1;
                        close-enabled: true;
                        window-action-enabled: tab.kind == "terminal" || tab.kind == "sftp";
                        detached-window: root.detached-window;
                        close => { root.close-tab(tab.id); }
                        window-action => {
                            if root.detached-window {
                                root.return-workspace(tab.id);
                            } else {
                                root.detach-workspace(tab.id);
                            }
                        }
                        scroll-tabs(delta-x, delta-y) => {
                            root.scroll-tabs(delta-x, delta-y);
                        }
                    }
                }

            }

            if root.drag-source-index >= 0 : TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.up {
                        root.finish-tab-drag-at-content(
                            self.mouse-x - tabs-flick.viewport-x,
                        );
                    } else if event.kind == PointerEventKind.cancel {
                        root.clear-tab-drag();
                    }
                }
                moved => {
                    root.update-tab-drag-at-content(
                        self.mouse-x - tabs-flick.viewport-x,
                    );
                }
            }

            if root.drag-source-index >= 0 : Rectangle {
                x: max(
                    0px,
                    min(
                        parent.width - self.width,
                        root.drag-pointer-content-x + tabs-flick.viewport-x
                            - root.drag-pointer-offset-x,
                    ),
                );
                y: 0px;
                width: root.tab-width * 1px;
                height: parent.height;
                background: transparent;
                opacity: Theme.tab-drag-ghost-opacity;

                Rectangle {
                    y: Theme.tab-surface-inset + Theme.tab-surface-radius;
                    width: parent.width;
                    height: parent.height - self.y;
                    background: root.drag-kind == "terminal"
                        ? Theme.panel-alt
                        : Theme.background;
                }
                Rectangle {
                    y: Theme.tab-surface-inset;
                    width: parent.width;
                    height: parent.height - Theme.tab-surface-inset;
                    border-radius: Theme.tab-surface-radius;
                    background: root.drag-kind == "terminal"
                        ? Theme.panel-alt
                        : Theme.background;
                }
                Rectangle {
                    x: Theme.tab-surface-radius;
                    y: Theme.tab-surface-inset;
                    width: parent.width - 2 * Theme.tab-surface-radius;
                    height: Theme.hairline;
                    background: Theme.accent;
                }

                WorkspaceTabContent {
                    width: parent.width;
                    height: parent.height;
                    title: root.drag-title;
                    kind: root.drag-kind;
                    connected: root.drag-connected;
                    active: true;
                    order: root.drag-order;
                }
            }
        }
        if root.active-tab-kind == "terminal" : Rectangle {
            width: 2 * Theme.terminal-split-button-size + Theme.terminal-split-button-spacing;
            background: Theme.panel;
            HorizontalLayout {
                y: (parent.height - self.height) / 2;
                height: Theme.terminal-split-button-size;
                spacing: Theme.terminal-split-button-spacing;

                TerminalSplitButton {
                    vertical: true;
                    accessible-name: @tr("Split active terminal vertically");
                    tooltip-text: @tr("Split vertically (Alt+Shift+L)");
                    activated => { root.terminal-pane-command("split-right"); }
                }
                TerminalSplitButton {
                    vertical: false;
                    accessible-name: @tr("Split active terminal horizontally");
                    tooltip-text: @tr("Split horizontally (Alt+Shift+J)");
                    activated => { root.terminal-pane-command("split-down"); }
                }
            }
        }
        if root.connection-picker-enabled : Rectangle {
            width: parent.height;
            background: add-touch.has-hover || root.connection-picker-open
                ? Theme.hover
                : Theme.panel;
            add-label := Text {
                width: parent.width;
                height: parent.height;
                text: @tr("+");
                color: Theme.text;
                font-size: Theme.tab-add-font-size;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            add-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: @tr("Open saved connection");
                clicked => { root.toggle-connection-picker(); }
            }
        }
    }

    // One separator owns the entire titlebar boundary. Keeping it outside the
    // tab/tool segments prevents small segment layout changes from producing
    // multiple adjacent lines or allowing a tab surface to cover the edge.
    Rectangle {
        x: 0px;
        y: parent.height - Theme.hairline;
        width: parent.width;
        height: Theme.hairline;
        background: Theme.tab-divider;
    }
}
