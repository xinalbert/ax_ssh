import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct WorkspaceTabRow {
    id: string,
    title: string,
    kind: string,
    connected: bool,
}

export struct ConnectableSessionRow {
    id: string,
    name: string,
    endpoint: string,
}

component WorkspaceTabContent inherits HorizontalLayout {
    in property <string> title;
    in property <string> kind;
    in property <bool> connected;
    in property <bool> active: false;
    in property <int> order;
    in property <bool> close-enabled: false;
    callback close();
    callback scroll-tabs(length, length);

    private property <length> close-glyph-height:
        close-label.font-metrics.ascent - close-label.font-metrics.descent;
    private property <length> close-button-size: max(
        Theme.tab-close-min-size,
        root.close-glyph-height + Theme.tab-close-padding * 2,
    );

    padding-top: Theme.tab-content-padding-y;
    padding-bottom: Theme.tab-content-padding-y;
    padding-left: Theme.tab-content-leading-padding;
    padding-right: Theme.space-xs;
    spacing: Theme.tab-content-spacing;

    Rectangle {
        width: Theme.tab-status-size;
        background: transparent;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: Theme.tab-status-size;
            height: Theme.tab-status-size;
            border-radius: Theme.radius-small;
            background: root.connected
                ? Theme.success
                : (root.kind == "terminal" ? Theme.accent : Theme.muted);
        }
    }
    Text {
        width: Theme.tab-order-width;
        text: "\{root.order}";
        color: Theme.muted;
        font-size: Theme.tab-order-font-size;
        font-weight: Theme.tab-order-font-weight;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Text {
        horizontal-stretch: 1;
        text: root.title;
        color: Theme.text;
        font-size: Theme.tab-title-font-size;
        font-weight: root.active
            ? Theme.tab-title-active-font-weight
            : Theme.tab-title-inactive-font-weight;
        overflow: elide;
        vertical-alignment: center;
    }
    Rectangle {
        width: root.close-button-size;
        height: root.close-button-size;
        border-radius: Theme.radius;
        background: close-touch.has-hover && root.close-enabled ? Theme.hover : transparent;
        close-label := Text {
            width: parent.width;
            height: parent.height;
            text: "x";
            color: Theme.muted;
            font-size: Theme.tab-close-font-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        close-touch := TouchArea {
            enabled: root.close-enabled;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Close tab";
            clicked => { root.close(); }
            scroll-event(event) => {
                root.scroll-tabs(event.delta-x, event.delta-y);
                return EventResult.accept;
            }
        }
    }
}

component ConnectionPickerRow inherits FocusScope {
    in property <string> id;
    in property <string> name;
    in property <string> endpoint;
    callback connect-session(string);

    private property <length> name-line-height:
        name-label.font-metrics.ascent - name-label.font-metrics.descent;
    private property <length> endpoint-line-height:
        endpoint-label.font-metrics.ascent - endpoint-label.font-metrics.descent;
    private property <length> row-height: max(
        Theme.titlebar-connection-picker-row-min-height,
        root.name-line-height
            + Theme.titlebar-connection-picker-row-spacing
            + root.endpoint-line-height
            + 2 * Theme.titlebar-connection-picker-row-padding-y,
    );

    height: root.row-height;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.name + ", " + root.endpoint;

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.connect-session(root.id);
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        border-radius: Theme.radius-small;
        background: row-touch.has-hover || root.has-focus ? Theme.hover : transparent;

        VerticalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            padding-top: Theme.titlebar-connection-picker-row-padding-y;
            padding-bottom: Theme.titlebar-connection-picker-row-padding-y;
            spacing: Theme.titlebar-connection-picker-row-spacing;

            name-label := Text {
                height: root.name-line-height;
                text: root.name;
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
            endpoint-label := Text {
                height: root.endpoint-line-height;
                text: root.endpoint;
                color: Theme.muted;
                font-family: Theme.application-font-family;
                font-size: Theme.font-caption;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        row-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.connect-session(root.id); }
        }
    }
}

export component ConnectionPicker inherits FocusScope {
    in property <[ConnectableSessionRow]> sessions;
    callback connect-session(string);
    callback dismiss();

    private property <length> name-line-height:
        name-probe.font-metrics.ascent - name-probe.font-metrics.descent;
    private property <length> endpoint-line-height:
        endpoint-probe.font-metrics.ascent - endpoint-probe.font-metrics.descent;
    private property <length> row-height: max(
        Theme.titlebar-connection-picker-row-min-height,
        root.name-line-height
            + Theme.titlebar-connection-picker-row-spacing
            + root.endpoint-line-height
            + 2 * Theme.titlebar-connection-picker-row-padding-y,
    );

    width: Theme.titlebar-connection-picker-width;
    height: root.sessions.length == 0
        ? Theme.titlebar-connection-picker-empty-height
        : min(
            Theme.titlebar-connection-picker-max-height,
            root.sessions.length * root.row-height
                + 2 * Theme.titlebar-connection-picker-padding,
        );
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: list;
    accessible-label: "Saved connections";

    key-pressed(event) => {
        if event.text == Key.Escape {
            root.dismiss();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    name-probe := Text {
        visible: false;
        text: "Name";
        font-size: Theme.font-body;
        font-weight: 700;
    }
    endpoint-probe := Text {
        visible: false;
        text: "Endpoint";
        font-family: Theme.application-font-family;
        font-size: Theme.font-caption;
    }

    Rectangle {
        background: Theme.panel;
        border-width: Theme.hairline;
        border-color: Theme.frame-border;
        border-radius: Theme.radius;
        clip: true;

        VerticalLayout {
            padding: Theme.titlebar-connection-picker-padding;
            spacing: 0px;

            if root.sessions.length == 0 : Text {
                text: "No saved connections";
                color: Theme.muted;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.sessions.length > 0 : ListView {
                vertical-stretch: 1;
                for session in root.sessions : ConnectionPickerRow {
                    id: session.id;
                    name: session.name;
                    endpoint: session.endpoint;
                    connect-session(id) => { root.connect-session(id); }
                }
            }
        }
    }
}

export component WorkspaceTitlebar inherits Rectangle {
    in property <[WorkspaceTabRow]> tabs;
    in property <string> active-tab-id;
    in property <int> tab-width;
    in property <color> terminal-background;
    in property <bool> connection-picker-open;

    callback activate-tab(string);
    callback close-tab(string);
    callback move-tab(string, int);
    callback toggle-connection-picker();

    private property <int> drag-source-index: -1;
    private property <int> drag-target-index: -1;
    private property <length> drag-pointer-content-x: 0px;
    private property <length> drag-pointer-offset-x: 0px;
    private property <string> drag-title;
    private property <string> drag-kind;
    private property <bool> drag-connected: false;
    private property <int> drag-order: 0;
    private property <length> add-glyph-height:
        add-label.font-metrics.ascent - add-label.font-metrics.descent;

    function scroll-tabs(delta-x: length, delta-y: length) {
        let delta = delta-x != 0px ? delta-x : delta-y;
        tabs-flick.viewport-x = max(
            tabs-flick.width - tabs-flick.viewport-width,
            min(0px, tabs-flick.viewport-x + delta),
        );
    }

    function tab-index-at(content-x: length) -> int {
        return max(
            0,
            min(
                root.tabs.length - 1,
                floor(content-x / (root.tab-width * 1px)),
            ),
        );
    }

    function begin-tab-drag(
        index: int, title: string, kind: string, connected: bool, pointer-x: length,
    ) {
        root.drag-source-index = index;
        root.drag-target-index = index;
        root.drag-pointer-content-x = index * root.tab-width * 1px + pointer-x;
        root.drag-pointer-offset-x = pointer-x;
        root.drag-title = title;
        root.drag-kind = kind;
        root.drag-connected = connected;
        root.drag-order = index + 1;
    }

    function update-tab-drag(index: int, pointer-x: length) {
        root.drag-pointer-content-x = index * root.tab-width * 1px + pointer-x;
        root.drag-target-index = root.tab-index-at(root.drag-pointer-content-x);
    }

    function clear-tab-drag() {
        root.drag-source-index = -1;
        root.drag-target-index = -1;
    }

    function finish-tab-drag(id: string, source-index: int, pointer-x: length) {
        let target-index = root.tab-index-at(
            source-index * root.tab-width * 1px + pointer-x,
        );
        root.clear-tab-drag();
        if target-index == source-index {
            root.activate-tab(id);
        } else {
            root.move-tab(id, target-index);
        }
    }

    height: max(
        tab-height-probe.preferred-height,
        root.add-glyph-height + Theme.tab-content-padding-y * 2,
    );
    background: Theme.panel;
    border-width: 0px;

    tab-height-probe := WorkspaceTabContent {
        visible: false;
        width: 0px;
        title: "Tab";
        kind: "terminal";
        connected: true;
        active: true;
        order: 1;
    }

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            // The active tab paints over this separator to join its content pane.
            Rectangle {
                y: parent.height - Theme.hairline;
                width: parent.width;
                height: Theme.hairline;
                background: Theme.divider;
            }

            tabs-flick := Flickable {
                width: parent.width;
                height: parent.height;
                interactive: false;
                viewport-width: max(
                    self.width,
                    root.tabs.length * root.tab-width * 1px,
                );
                viewport-height: self.height;

                for tab[index] in root.tabs : Rectangle {
                    x: index * root.tab-width * 1px;
                    y: 0px;
                    width: root.tab-width * 1px;
                    height: parent.height;
                    background: transparent;
                    opacity: root.drag-source-index == index
                        ? Theme.tab-drag-source-opacity
                        : 1;

                    if tab.id == root.active-tab-id
                            || (root.drag-source-index >= 0
                                && root.drag-target-index == index) : Rectangle {
                        y: Theme.tab-surface-inset + Theme.tab-surface-radius;
                        width: parent.width;
                        height: parent.height - self.y;
                        background: tab.kind == "terminal"
                            ? root.terminal-background
                            : Theme.background;
                    }
                    if tab.id == root.active-tab-id
                            || (root.drag-source-index >= 0
                                && root.drag-target-index == index) : Rectangle {
                        y: Theme.tab-surface-inset;
                        width: parent.width;
                        height: parent.height - Theme.tab-surface-inset;
                        border-radius: Theme.tab-surface-radius;
                        background: tab.kind == "terminal"
                            ? root.terminal-background
                            : Theme.background;
                    }
                    if root.drag-source-index >= 0
                            && root.drag-target-index == index : Rectangle {
                        x: Theme.tab-surface-radius;
                        y: Theme.tab-surface-inset;
                        width: parent.width - 2 * Theme.tab-surface-radius;
                        height: Theme.hairline;
                        background: Theme.accent;
                    }

                    tab-touch := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down
                                    && event.button == PointerEventButton.left {
                                root.begin-tab-drag(
                                    index, tab.title, tab.kind, tab.connected, self.mouse-x,
                                );
                            } else if event.kind == PointerEventKind.up
                                    && root.drag-source-index == index {
                                root.finish-tab-drag(tab.id, index, self.mouse-x);
                            } else if event.kind == PointerEventKind.cancel
                                    && root.drag-source-index == index {
                                root.clear-tab-drag();
                            }
                        }
                        moved => {
                            if root.drag-source-index == index {
                                root.update-tab-drag(index, self.mouse-x);
                            }
                        }
                        scroll-event(event) => {
                            root.scroll-tabs(event.delta-x, event.delta-y);
                            return EventResult.accept;
                        }
                    }
                    WorkspaceTabContent {
                        title: tab.title;
                        kind: tab.kind;
                        connected: tab.connected;
                        active: tab.id == root.active-tab-id;
                        order: index + 1;
                        close-enabled: true;
                        close => { root.close-tab(tab.id); }
                        scroll-tabs(delta-x, delta-y) => {
                            root.scroll-tabs(delta-x, delta-y);
                        }
                    }
                }

            }

            if root.drag-source-index >= 0 : Rectangle {
                x: max(
                    0px,
                    min(
                        parent.width - self.width,
                        root.drag-pointer-content-x + tabs-flick.viewport-x
                            - root.drag-pointer-offset-x,
                    ),
                );
                y: 0px;
                width: root.tab-width * 1px;
                height: parent.height;
                background: transparent;
                opacity: Theme.tab-drag-ghost-opacity;

                Rectangle {
                    y: Theme.tab-surface-inset + Theme.tab-surface-radius;
                    width: parent.width;
                    height: parent.height - self.y;
                    background: root.drag-kind == "terminal"
                        ? root.terminal-background
                        : Theme.background;
                }
                Rectangle {
                    y: Theme.tab-surface-inset;
                    width: parent.width;
                    height: parent.height - Theme.tab-surface-inset;
                    border-radius: Theme.tab-surface-radius;
                    background: root.drag-kind == "terminal"
                        ? root.terminal-background
                        : Theme.background;
                }
                Rectangle {
                    x: Theme.tab-surface-radius;
                    y: Theme.tab-surface-inset;
                    width: parent.width - 2 * Theme.tab-surface-radius;
                    height: Theme.hairline;
                    background: Theme.accent;
                }

                WorkspaceTabContent {
                    title: root.drag-title;
                    kind: root.drag-kind;
                    connected: root.drag-connected;
                    active: true;
                    order: root.drag-order;
                }
            }
        }
        Rectangle {
            width: parent.height;
            background: add-touch.has-hover || root.connection-picker-open
                ? Theme.hover
                : Theme.panel;
            Rectangle {
                y: parent.height - Theme.hairline;
                width: parent.width;
                height: Theme.hairline;
                background: Theme.divider;
            }
            add-label := Text {
                width: parent.width;
                height: parent.height;
                text: "+";
                color: Theme.text;
                font-size: Theme.tab-add-font-size;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            add-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: "Open saved connection";
                clicked => { root.toggle-connection-picker(); }
            }
        }
    }
}
