import { Theme } from "../theme.slint";

export component SidebarTerminalGlyph inherits Rectangle {
    in property <brush> glyph-color: Theme.text;

    width: Theme.sidebar-glyph-size;
    height: Theme.sidebar-glyph-size;
    background: transparent;

    Rectangle {
        x: Theme.sidebar-glyph-inset;
        y: Theme.sidebar-glyph-inset + Theme.space-xxs;
        width: parent.width - 2 * Theme.sidebar-glyph-inset;
        height: parent.height - 2 * Theme.sidebar-glyph-inset - Theme.space-xxs;
        background: transparent;
        border-width: Theme.hairline;
        border-color: root.glyph-color;
        border-radius: Theme.radius-small;

        Text {
            width: parent.width;
            height: parent.height;
            text: ">_";
            color: root.glyph-color;
            font-family: Theme.application-font-family;
            font-size: Theme.font-micro;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component SidebarToggleGlyph inherits Rectangle {
    in property <bool> expanded;

    width: Theme.sidebar-glyph-size;
    height: Theme.sidebar-glyph-size;
    background: transparent;

    Rectangle {
        x: Theme.sidebar-glyph-inset;
        y: Theme.sidebar-glyph-inset;
        width: parent.width - 2 * Theme.sidebar-glyph-inset;
        height: parent.height - 2 * Theme.sidebar-glyph-inset;
        background: transparent;
        border-width: Theme.hairline;
        border-color: Theme.muted;
        border-radius: Theme.radius-small;
    }
    Rectangle {
        x: Theme.sidebar-glyph-inset + 5px;
        y: Theme.sidebar-glyph-inset + 2px;
        width: Theme.hairline;
        height: parent.height - 2 * Theme.sidebar-glyph-inset - 4px;
        background: Theme.muted;
    }
    Path {
        x: Theme.sidebar-glyph-inset + 8px;
        y: Theme.sidebar-glyph-inset + 4px;
        width: 7px;
        height: 10px;
        commands: root.expanded
            ? "M 5 1 L 1 5 L 5 9"
            : "M 2 1 L 6 5 L 2 9";
        fill: transparent;
        stroke: Theme.muted;
        stroke-width: Theme.hairline;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

export component SidebarRailToggle inherits FocusScope {
    in property <bool> expanded;
    in property <bool> full-width: false;
    in property <string> title: "Sessions";
    callback activated();

    height: Theme.sidebar-rail-toggle-row-height;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.expanded
        ? "Collapse session sidebar"
        : "Expand session sidebar";

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    if root.full-width : Text {
        x: Theme.sidebar-card-padding;
        width: toggle-card.x - self.x - Theme.space-sm;
        height: parent.height;
        text: root.title;
        color: Theme.muted;
        font-family: Theme.application-font-family;
        font-size: Theme.font-caption;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }

    toggle-card := Rectangle {
        x: root.full-width
            ? parent.width - self.width - Theme.space-sm
            : (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.sidebar-rail-toggle-size;
        height: Theme.sidebar-rail-toggle-size;
        background: toggle-touch.has-hover || root.has-focus ? Theme.hover : transparent;
        border-width: root.has-focus ? Theme.hairline : 0px;
        border-color: Theme.focus;
        border-radius: Theme.radius-small;

        SidebarToggleGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            expanded: root.expanded;
        }
        toggle-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.activated(); }
        }
    }
}

export component SidebarRailItem inherits FocusScope {
    in property <string> label;
    in property <string> trailing-label;
    in property <string> accessible-name;
    in property <bool> group: false;
    in property <bool> local: false;
    in property <bool> nested: false;
    in property <bool> expandable: false;
    in property <bool> expanded: false;
    in property <bool> expanded-label: false;
    in property <bool> selected: false;
    callback activated();

    private property <length> label-line-height:
        label-probe.font-metrics.ascent - label-probe.font-metrics.descent;
    private property <length> label-content-height: root.label-line-height;
    private property <length> card-height: root.local
        ? Theme.sidebar-rail-local-card-size
        : root.label-content-height + 2 * (root.group
            ? Theme.sidebar-rail-group-card-padding-y
            : Theme.sidebar-rail-session-card-padding-y);
    private property <length> card-width: root.expanded-label
        ? root.width - 2 * Theme.space-xs
        : root.card-height;
    private property <length> row-padding-y: root.local
        ? Theme.sidebar-rail-group-row-padding-y
        : (root.group
            ? Theme.sidebar-rail-group-row-padding-y
            : Theme.sidebar-rail-session-row-padding-y);

    height: max(
        Theme.sidebar-rail-item-min-height,
        root.card-height + 2 * root.row-padding-y,
    );
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-expandable: root.expandable;
    accessible-expanded: root.expanded;

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    label-probe := Text {
        visible: false;
        text: root.label;
        color: transparent;
        font-family: Theme.application-font-family;
        font-size: root.expanded-label && root.group
            ? Theme.sidebar-group-font-size
            : Theme.sidebar-session-font-size;
        font-weight: root.expanded-label && !root.group && !root.local
            ? Theme.sidebar-session-font-weight
            : Theme.sidebar-group-font-weight;
    }

    item-card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.card-width;
        height: root.card-height;
        background: root.selected
            ? Theme.selected
            : ((root.group && !root.expanded-label) || item-touch.has-hover || root.has-focus
                ? Theme.panel
                : transparent);
        border-width: root.selected
                || (root.group && !root.expanded-label)
                || item-touch.has-hover
                || root.has-focus
            ? Theme.hairline
            : 0px;
        border-color: root.has-focus
            ? Theme.focus
            : (root.selected || root.group ? Theme.accent : Theme.control-border);
        border-radius: Theme.radius;

        if root.local && !root.expanded-label : SidebarTerminalGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            glyph-color: Theme.text;
        }

        label-text := Text {
            visible: !root.expanded-label && !root.local;
            width: parent.width;
            height: parent.height;
            text: root.label;
            color: root.selected || root.group ? Theme.accent : Theme.text;
            font-family: Theme.application-font-family;
            font-size: Theme.font-body;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.expanded-label : HorizontalLayout {
            padding-left: root.nested
                ? Theme.sidebar-rail-full-session-indent
                : Theme.sidebar-card-padding;
            padding-right: Theme.sidebar-card-padding;
            spacing: Theme.space-sm;

            if root.local : SidebarTerminalGlyph {
                glyph-color: item-touch.has-hover ? Theme.accent : Theme.text;
            }

            if root.expandable : Path {
                width: Theme.sidebar-group-chevron-size;
                height: Theme.sidebar-group-chevron-size;
                commands: root.expanded
                    ? "M 2 4 L 8 10 L 14 4"
                    : "M 2 10 L 8 4 L 14 10";
                fill: transparent;
                stroke: Theme.muted;
                stroke-width: Theme.sidebar-group-chevron-stroke;
                stroke-line-cap: round;
                stroke-line-join: round;
            }

            Text {
                horizontal-stretch: 1;
                text: root.label;
                color: root.selected ? Theme.accent : Theme.text;
                font-family: Theme.application-font-family;
                font-size: root.group
                    ? Theme.sidebar-group-font-size
                    : Theme.sidebar-session-font-size;
                font-weight: root.group || root.local
                    ? Theme.sidebar-group-font-weight
                    : Theme.sidebar-session-font-weight;
                overflow: elide;
                vertical-alignment: center;
            }

            if !root.trailing-label.is-empty : Text {
                width: Theme.sidebar-group-count-width;
                text: root.trailing-label;
                color: Theme.muted;
                font-family: Theme.application-font-family;
                font-size: Theme.font-caption;
                horizontal-alignment: right;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        item-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.activated(); }
        }
    }
}
