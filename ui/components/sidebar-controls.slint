import { Theme } from "../theme.slint";
import { SystemPlatformIcon } from "system-platform-icon.slint";
import { ElidedLabel, ElidedTooltipContent } from "elided-controls.slint";

export component SidebarTerminalGlyph inherits Rectangle {
    in property <brush> glyph-color: Theme.text;

    width: Theme.sidebar-glyph-size;
    height: Theme.sidebar-glyph-size;
    background: transparent;

    Rectangle {
        x: Theme.sidebar-glyph-inset;
        y: Theme.sidebar-glyph-inset + Theme.space-xxs;
        width: parent.width - 2 * Theme.sidebar-glyph-inset;
        height: parent.height - 2 * Theme.sidebar-glyph-inset - Theme.space-xxs;
        background: transparent;
        border-width: Theme.hairline;
        border-color: root.glyph-color;
        border-radius: Theme.radius-small;

        Text {
            width: parent.width;
            height: parent.height;
            text: @tr(">_");
            color: root.glyph-color;
            font-family: Theme.application-font-family;
            font-size: Theme.font-micro;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component SidebarPlatformGlyph inherits Rectangle {
    in property <string> platform;
    in property <color> glyph-color: Theme.text;

    width: Theme.sidebar-glyph-size;
    height: Theme.sidebar-glyph-size;
    background: transparent;

    if root.platform == "terminal" : SidebarTerminalGlyph {
        glyph-color: root.glyph-color;
    }
    if root.platform == "folder" : Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../../assets/os-icons/ui/folder/material-symbols-folder.svg");
        colorize: root.glyph-color;
        image-fit: contain;
    }
    if !root.platform.is-empty && root.platform != "folder"
            && root.platform != "server" && root.platform != "terminal" : SystemPlatformIcon {
        width: parent.width;
        height: parent.height;
        platform: root.platform;
        glyph-color: root.glyph-color;
    }
    if root.platform == "server" : Rectangle {
        x: Theme.sidebar-glyph-inset + 3px;
        y: Theme.sidebar-glyph-inset + 1px;
        width: parent.width - 2 * (Theme.sidebar-glyph-inset + 3px);
        height: parent.height - 2 * Theme.sidebar-glyph-inset;
        border-width: Theme.hairline;
        border-color: root.glyph-color;
        border-radius: Theme.radius-small;
        background: transparent;

        for row in 3 : Rectangle {
            x: Theme.space-xs;
            y: Theme.space-xs + row * 5px;
            width: parent.width - 2 * Theme.space-xs;
            height: Theme.hairline;
            background: root.glyph-color;
        }
    }
}

// The folder stays centered in the compact rail; both sidebar modes use this
// same trailing disclosure glyph and its dimensions.
export component SidebarGroupGlyph inherits Rectangle {
    in property <bool> expanded;
    in property <color> glyph-color: Theme.text;

    width: Theme.sidebar-group-icon-size
        + Theme.sidebar-group-chevron-gap + Theme.sidebar-group-chevron-size;
    height: Theme.sidebar-group-icon-size;
    background: transparent;

    SidebarPlatformGlyph {
        width: Theme.sidebar-group-icon-size;
        height: Theme.sidebar-group-icon-size;
        platform: "folder";
        glyph-color: root.glyph-color;
    }

    Path {
        x: Theme.sidebar-group-icon-size + Theme.sidebar-group-chevron-gap;
        y: (parent.height - self.height) / 2;
        width: Theme.sidebar-group-chevron-size;
        height: Theme.sidebar-group-chevron-size;
        commands: root.expanded
            ? "M 1 2 L 4 5 L 7 2"
            : "M 2 1 L 5 4 L 2 7";
        fill: transparent;
        stroke: Theme.muted;
        stroke-width: Theme.sidebar-group-chevron-stroke;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

export component SidebarToggleGlyph inherits Rectangle {
    in property <bool> expanded;

    width: Theme.sidebar-glyph-size;
    height: Theme.sidebar-glyph-size;
    background: transparent;

    Rectangle {
        x: Theme.sidebar-glyph-inset;
        y: Theme.sidebar-glyph-inset;
        width: parent.width - 2 * Theme.sidebar-glyph-inset;
        height: parent.height - 2 * Theme.sidebar-glyph-inset;
        background: transparent;
        border-width: Theme.hairline;
        border-color: Theme.muted;
        border-radius: Theme.radius-small;
    }
    Rectangle {
        x: Theme.sidebar-glyph-inset + 5px;
        y: Theme.sidebar-glyph-inset + 2px;
        width: Theme.hairline;
        height: parent.height - 2 * Theme.sidebar-glyph-inset - 4px;
        background: Theme.muted;
    }
    Path {
        x: Theme.sidebar-glyph-inset + 8px;
        y: Theme.sidebar-glyph-inset + 4px;
        width: 7px;
        height: 10px;
        commands: root.expanded
            ? "M 5 1 L 1 5 L 5 9"
            : "M 2 1 L 6 5 L 2 9";
        fill: transparent;
        stroke: Theme.muted;
        stroke-width: Theme.hairline;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

export component SidebarRailToggle inherits FocusScope {
    in property <bool> expanded;
    in property <bool> full-width: false;
    in property <string> title: @tr("Sessions");
    in property <string> tooltip-text;
    callback activated();

    height: Theme.sidebar-rail-toggle-row-height;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.expanded
        ? @tr("Collapse session sidebar")
        : @tr("Expand session sidebar");

    row-background := Rectangle {
        width: parent.width;
        height: parent.height;
        background: row-touch.has-hover || root.has-focus ? Theme.hover : transparent;
    }

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    if root.full-width : ElidedLabel {
        x: Theme.sidebar-card-padding;
        width: toggle-card.x - self.x - Theme.space-sm;
        height: parent.height;
        text: root.title;
        tooltip-text: root.tooltip-text;
        text-color: Theme.muted;
        font-family: Theme.application-font-family;
        font-size: Theme.font-caption;
        font-weight: 700;
    }

    toggle-card := Rectangle {
        x: root.full-width
            ? parent.width - self.width - Theme.space-sm
            : (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.sidebar-rail-toggle-size;
        height: Theme.sidebar-rail-toggle-size;
        background: row-touch.has-hover || root.has-focus ? Theme.hover : transparent;
        border-width: root.has-focus ? Theme.hairline : 0px;
        border-color: Theme.focus;
        border-radius: Theme.radius-small;

        SidebarToggleGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            expanded: root.expanded;
        }
    }

    row-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.focus();
            root.activated();
        }
    }
}

export component SidebarRailItem inherits FocusScope {
    in property <string> label;
    in property <string> icon-kind;
    in property <string> tooltip-text;
    in property <bool> tooltip-enabled: true;
    in property <string> accessible-name;
    in property <bool> group: false;
    in property <bool> local: false;
    in property <bool> expandable: false;
    in property <bool> expanded: false;
    in property <bool> selected: false;
    callback activated();
    callback context-requested(Point);

    private property <length> card-height: root.local
        ? Theme.sidebar-rail-local-card-size
        : Theme.sidebar-glyph-size + 2 * (root.group
            ? Theme.sidebar-rail-group-card-padding-y
            : Theme.sidebar-rail-session-card-padding-y);
    private property <length> card-width: root.group
        ? root.width - 2 * Theme.space-xs
        : root.card-height;
    private property <length> row-padding-y: root.local
        ? Theme.sidebar-rail-group-row-padding-y
        : (root.group
            ? Theme.sidebar-rail-group-row-padding-y
            : Theme.sidebar-rail-session-row-padding-y);

    height: max(
        Theme.sidebar-rail-item-min-height,
        root.card-height + 2 * root.row-padding-y,
    );
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-expandable: root.expandable;
    accessible-expanded: root.expanded;

    key-pressed(event) => {
        if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
            root.context-requested({ x: 0px, y: root.height });
            return EventResult.accept;
        }
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    item-card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.card-width;
        height: root.card-height;
        background: root.selected
            ? Theme.selected
            : (item-touch.has-hover || root.has-focus
                ? Theme.panel
                : transparent);
        border-width: root.has-focus
                || (!root.group && (root.selected || item-touch.has-hover))
            ? Theme.hairline
            : 0px;
        border-color: root.has-focus
            ? Theme.focus
            : (root.selected || root.group ? Theme.accent : Theme.control-border);
        border-radius: Theme.radius;

        if !root.expandable : SidebarPlatformGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            platform: root.icon-kind.is-empty
                ? (root.local ? "terminal" : "server")
                : root.icon-kind;
            glyph-color: root.selected || item-touch.has-hover ? Theme.accent : Theme.text;
        }

        if root.expandable : SidebarGroupGlyph {
            x: (parent.width - Theme.sidebar-group-icon-size) / 2;
            y: (parent.height - self.height) / 2;
            expanded: root.expanded;
            glyph-color: root.selected || item-touch.has-hover ? Theme.accent : Theme.text;
        }

        if root.tooltip-enabled : Tooltip {
            ElidedTooltipContent {
                text: root.tooltip-text.is-empty ? root.label : root.tooltip-text;
            }
        }

        item-touch := TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.context-requested({
                        x: self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                        y: self.absolute-position.y - root.absolute-position.y + self.mouse-y,
                    });
                }
            }
            clicked => {
                root.focus();
                root.activated();
            }
        }
    }
}
