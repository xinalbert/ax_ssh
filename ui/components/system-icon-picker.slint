import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ElidedButton } from "elided-controls.slint";
import { FlatTextInput } from "flat-text-input.slint";
import { SidebarPlatformGlyph } from "sidebar-controls.slint";

export struct SystemIconChoiceRow { id: string, name: string, family: string }

component IconChoiceItem inherits FocusScope {
    in property <SystemIconChoiceRow> choice;
    callback selected(string);
    height: Theme.combo-box-popup-row-height;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.choice.name;
    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " {
            root.selected(root.choice.id);
            return EventResult.accept;
        }
        return EventResult.reject;
    }
    Rectangle {
        background: touch.has-hover || root.has-focus ? Theme.hover : transparent;
        border-width: root.has-focus ? Theme.hairline : 0px;
        border-color: Theme.focus;
        HorizontalLayout {
            padding-left: Theme.space-sm;
            padding-right: Theme.space-sm;
            spacing: Theme.space-sm;
            SidebarPlatformGlyph { platform: root.choice.id; }
            Text {
                text: root.choice.name;
                color: Theme.text;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        touch := TouchArea { clicked => { root.selected(root.choice.id); } }
    }
}

export component SystemIconPicker inherits Rectangle {
    in property <string> icon-id;
    in property <string> automatic-platform: "server";
    pure callback choices(string) -> [SystemIconChoiceRow];
    callback selected(string);
    private property <bool> expanded: false;
    private property <string> query;
    private property <[SystemIconChoiceRow]> filtered: root.choices(root.query);
    horizontal-stretch: 1;
    vertical-stretch: 0;
    height: content.preferred-height;
    content := VerticalLayout {
        spacing: Theme.space-sm;
        HorizontalLayout {
            spacing: Theme.space-sm;
            SidebarPlatformGlyph {
                platform: root.icon-id.is-empty ? root.automatic-platform : root.icon-id;
            }
            ElidedButton {
                text: root.icon-id.is-empty ? @tr("Automatic") : root.icon-id;
                clicked => { root.expanded = !root.expanded; }
            }
        }
        if root.expanded : VerticalLayout {
            spacing: Theme.space-sm;
            ElidedButton {
                text: @tr("Automatic");
                clicked => { root.selected(""); root.expanded = false; root.query = ""; }
            }
            FlatTextInput {
                text <=> root.query;
                placeholder-text: @tr("Search system icons");
                accessible-label: @tr("Search system icons");
            }
            ListView {
                height: Theme.combo-box-popup-row-height * 6;
                for choice in root.filtered : IconChoiceItem {
                    choice: choice;
                    selected(id) => { root.selected(id); root.expanded = false; root.query = ""; }
                }
            }
            if root.filtered.length == 0 : Text {
                text: @tr("No matching system icons");
                color: Theme.muted;
                font-size: Theme.font-small;
            }
        }
    }
}
