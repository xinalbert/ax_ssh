import { Theme } from "../theme.slint";
import { ActionMenuItem, FlatActionMenu } from "flat-action-menu.slint";
import { ElidedLabel } from "elided-controls.slint";
import {
    SidebarRailItem,
    SidebarRailToggle,
    SidebarTerminalGlyph,
} from "sidebar-controls.slint";

export struct SessionProfileRow {
    id: string,
    name: string,
    details: string,
    endpoint: string,
    icon: string,
    sftp-enabled: bool,
}

export struct SessionGroupRow {
    group-name: string,
    name: string,
    icon: string,
    profiles: [SessionProfileRow],
}

enum SessionActionMenuKind {
    list,
    group,
    ungrouped,
    server,
}

// Draw the disclosure chevron so its shape does not depend on font coverage.
component GroupDisclosureChevron inherits Path {
    in property <bool> expanded;

    width: Theme.sidebar-group-chevron-size;
    height: Theme.sidebar-group-chevron-size;
    commands: root.expanded
        ? "M 2 4 L 8 10 L 14 4"
        : "M 2 10 L 8 4 L 14 10";
    fill: transparent;
    stroke: Theme.muted;
    stroke-width: Theme.sidebar-group-chevron-stroke;
    stroke-line-cap: round;
    stroke-line-join: round;
}

component SessionProfileTooltipContent inherits Rectangle {
    in property <string> name;
    in property <string> details;

    private property <length> natural-width: max(
        tooltip-name.preferred-width,
        tooltip-details.preferred-width,
    );

    width: min(
        max(Theme.sidebar-session-tooltip-min-width, root.natural-width),
        Theme.sidebar-session-tooltip-max-width,
    );
    height: tooltip-layout.preferred-height;
    background: transparent;

    tooltip-layout := VerticalLayout {
        width: parent.width;
        spacing: Theme.space-xs;

        tooltip-name := Text {
            text: root.name;
            color: Theme.text;
            font-family: Theme.application-font-family;
            font-size: Theme.font-body;
            font-weight: 700;
            wrap: char-wrap;
        }
        tooltip-details := Text {
            visible: !root.details.is-empty;
            text: root.details;
            color: Theme.muted;
            font-family: Theme.application-font-family;
            font-size: Theme.font-caption;
            wrap: char-wrap;
        }
    }
}

component SessionActionMenu inherits Rectangle {
    in property <SessionActionMenuKind> kind: SessionActionMenuKind.list;
    in property <string> target-id;
    in property <string> group-name;
    in property <string> name;
    in property <bool> sftp-enabled: false;

    callback connect-session(string);
    callback open-sftp(string);
    callback new-group();
    callback new-session();
    callback new-session-in-group(string);
    callback rename-group(string);
    callback delete-group(string);
    callback edit-session(string);
    callback delete-session(string, string);
    callback copy-session(string);
    callback duplicate-session(string);
    callback session-transfer-action(string, string);
    callback select-target(string, string, string);

    function action(action-id: string, title: string, enabled: bool) -> ActionMenuItem {
        {
            action-id: action-id,
            title: title,
            enabled: enabled,
        }
    }

    private property <[ActionMenuItem]> actions:
        root.kind == SessionActionMenuKind.list
            ? [
                root.action("new-group", "New Group", true),
                root.action("new-server", "New Server", true),
            ]
            : (root.kind == SessionActionMenuKind.group
                ? [
                    root.action("add-server", "Add Server", true),
                    root.action("copy-group", "Copy Group", true),
                    root.action("duplicate-group", "Duplicate Group", true),
                    root.action("rename-group", "Rename Group", true),
                    root.action("delete-group", "Delete Group", true),
                ]
                : (root.kind == SessionActionMenuKind.ungrouped
                    ? [
                        root.action("add-server", "Add Server", true),
                    ]
                    : [
                        root.action("connect", "Connect", true),
                        root.action("open-sftp", "Open SFTP", root.sftp-enabled),
                        root.action("copy-address", "Copy Address", true),
                        root.action("copy-server", "Copy Server", true),
                        root.action("duplicate-session", "Duplicate", true),
                        root.action("edit-server", "Edit Server", true),
                        root.action("delete-server", "Delete Server", true),
                    ]));

    public function show-at(position: Point) {
        action-menu.show-at(position);
    }

    action-menu := FlatActionMenu {
        actions: root.actions;
        triggered(action-id) => {
            if root.kind == SessionActionMenuKind.group
                    || root.kind == SessionActionMenuKind.ungrouped {
                root.select-target("group", "", root.group-name);
            } else if root.kind == SessionActionMenuKind.server {
                root.select-target("server", root.target-id, root.group-name);
            }
            if action-id == "new-group" {
                root.new-group();
            } else if action-id == "new-server" {
                root.new-session();
            } else if action-id == "add-server" {
                root.new-session-in-group(root.group-name);
            } else if action-id == "copy-group" {
                root.session-transfer-action("copy-group", root.group-name);
            } else if action-id == "duplicate-group" {
                root.session-transfer-action("duplicate-group", root.group-name);
            } else if action-id == "rename-group" {
                root.rename-group(root.group-name);
            } else if action-id == "delete-group" {
                root.delete-group(root.group-name);
            } else if action-id == "connect" {
                root.connect-session(root.target-id);
            } else if action-id == "open-sftp" {
                root.open-sftp(root.target-id);
            } else if action-id == "copy-address" {
                root.copy-session(root.target-id);
            } else if action-id == "copy-server" {
                root.session-transfer-action("copy-server", root.target-id);
            } else if action-id == "duplicate-session" {
                root.duplicate-session(root.target-id);
            } else if action-id == "edit-server" {
                root.edit-session(root.target-id);
            } else if action-id == "delete-server" {
                root.delete-session(root.target-id, root.name);
            }
        }
    }
}

component SessionNavigationRow inherits FocusScope {
    in property <string> id;
    in property <string> group-name;
    in property <string> name;
    in property <string> details;
    in property <string> endpoint;
    in property <string> icon;
    in property <bool> group;
    in property <bool> expanded;
    in property <bool> sftp-enabled: false;
    in property <bool> selected: false;

    callback connect-session(string);
    callback open-sftp(string);
    callback toggle-expanded();
    callback new-session-in-group(string);
    callback rename-group(string);
    callback delete-group(string);
    callback edit-session(string);
    callback delete-session(string, string);
    callback copy-session(string);
    callback duplicate-session(string);
    callback session-transfer-action(string, string);
    callback select-target(string, string, string);

    private property <length> vertical-padding: root.group
        ? Theme.sidebar-group-row-padding-y
        : Theme.sidebar-session-row-padding-y;
    private property <length> label-line-height: row-label.line-height;
    private property <length> endpoint-line-height: row-endpoint.line-height;

    height: max(
        root.label-line-height,
        root.endpoint-line-height,
        root.group ? Theme.sidebar-group-chevron-size : 0px,
    ) + root.vertical-padding * 2;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.group
        ? (root.expanded
            ? @tr("Collapse {0} group", root.name)
            : @tr("Expand {0} group", root.name))
        : @tr("Connect to {0}", root.name);
    accessible-expandable: root.group;
    accessible-expanded: root.expanded;

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.select-target(
                root.group ? "group" : "server",
                root.id,
                root.group-name,
            );
            if root.group {
                root.toggle-expanded();
            } else {
                root.connect-session(root.id);
            }
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        background: root.selected
            ? Theme.selected
            : (row-touch.has-hover || root.has-focus ? Theme.hover : transparent);
        border-width: root.selected || root.has-focus ? Theme.hairline : 0px;
        border-color: root.has-focus ? Theme.focus : Theme.accent;
        border-radius: Theme.radius-small;

        row-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.select-target(
                    root.group ? "group" : "server",
                    root.id,
                    root.group-name,
                );
                if root.group {
                    root.toggle-expanded();
                } else {
                    root.connect-session(root.id);
                }
            }
        }

        if !root.group && !root.details.is-empty : Tooltip {
            SessionProfileTooltipContent {
                name: root.name;
                details: root.details;
            }
        }

        HorizontalLayout {
            padding-top: root.vertical-padding;
            padding-bottom: root.vertical-padding;
            padding-left: root.group
                ? Theme.sidebar-card-padding
                : Theme.sidebar-session-indent;
            padding-right: Theme.sidebar-card-padding;
            spacing: Theme.space-sm;

            if root.group : Rectangle {
                width: Theme.sidebar-group-chevron-width;
                GroupDisclosureChevron {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    expanded: root.expanded;
                }
            }

            row-label := ElidedLabel {
                horizontal-stretch: 1;
                text: root.name;
                tooltip-enabled: root.group || root.details.is-empty;
                text-color: root.selected ? Theme.accent : Theme.text;
                font-size: root.group
                    ? Theme.sidebar-group-font-size
                    : Theme.sidebar-session-font-size;
                font-weight: root.group
                    ? Theme.sidebar-group-font-weight
                    : Theme.sidebar-session-font-weight;
            }
            row-endpoint := ElidedLabel {
                width: root.group
                    ? Theme.sidebar-group-count-width
                    : min(
                        Theme.sidebar-session-endpoint-width,
                        parent.width * 0.58,
                    );
                text: root.endpoint;
                tooltip-enabled: root.group || root.details.is-empty;
                text-color: Theme.muted;
                font-family: Theme.application-font-family;
                font-size: Theme.font-caption;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
        }

        SessionActionMenu {
            kind: root.group
                ? (root.group-name.is-empty
                    ? SessionActionMenuKind.ungrouped
                    : SessionActionMenuKind.group)
                : SessionActionMenuKind.server;
            target-id: root.id;
            group-name: root.group-name;
            name: root.name;
            sftp-enabled: root.sftp-enabled;
            connect-session(id) => { root.connect-session(id); }
            open-sftp(id) => { root.open-sftp(id); }
            new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
            rename-group(group-name) => { root.rename-group(group-name); }
            delete-group(group-name) => { root.delete-group(group-name); }
            edit-session(id) => { root.edit-session(id); }
            delete-session(id, name) => { root.delete-session(id, name); }
            copy-session(id) => { root.copy-session(id); }
            duplicate-session(id) => { root.duplicate-session(id); }
            select-target(kind, id, group-name) => {
                root.select-target(kind, id, group-name);
            }
            session-transfer-action(action, target) => {
                root.session-transfer-action(action, target);
            }
        }
    }
}

// Each group owns its disclosure state. The Rust model supplies only the
// immutable group/profile snapshot, so expanding a group never crosses the UI
// boundary or mutates application state.
component SessionNavigationGroup inherits Rectangle {
    in property <SessionGroupRow> source;
    in property <string> selected-kind;
    in property <string> selected-id;
    in property <string> selected-group-name;

    callback connect-session(string);
    callback open-sftp(string);
    callback new-session-in-group(string);
    callback rename-group(string);
    callback delete-group(string);
    callback edit-session(string);
    callback delete-session(string, string);
    callback copy-session(string);
    callback duplicate-session(string);
    callback session-transfer-action(string, string);
    callback select-target(string, string, string);

    private property <bool> group-expanded: true;

    height: group-layout.preferred-height;

    group-layout := VerticalLayout {
        spacing: 0px;

        SessionNavigationRow {
            width: parent.width;
            id: "";
            group-name: root.source.group-name;
            name: root.source.name;
            endpoint: "\{root.source.profiles.length}";
            icon: root.source.icon;
            group: true;
            expanded: root.group-expanded;
            selected: root.selected-kind == "group"
                && root.selected-group-name == root.source.group-name;
            toggle-expanded => { root.group-expanded = !root.group-expanded; }
            select-target(kind, id, group-name) => {
                root.select-target(kind, id, group-name);
            }
            connect-session(id) => { root.connect-session(id); }
            new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
            rename-group(group-name) => { root.rename-group(group-name); }
            delete-group(group-name) => { root.delete-group(group-name); }
            edit-session(id) => { root.edit-session(id); }
            delete-session(id, name) => { root.delete-session(id, name); }
            session-transfer-action(action, target) => {
                root.session-transfer-action(action, target);
            }
        }

        if root.group-expanded : Rectangle {
            height: profile-layout.preferred-height;
            vertical-stretch: 0;

            profile-layout := VerticalLayout {
                padding-top: Theme.sidebar-group-to-session-spacing;
                spacing: Theme.sidebar-session-row-spacing;

                for profile in root.source.profiles : SessionNavigationRow {
                    width: parent.width;
                    id: profile.id;
                    group-name: root.source.group-name;
                    name: profile.name;
                    details: profile.details;
                    endpoint: profile.endpoint;
                    icon: profile.icon;
                    sftp-enabled: profile.sftp-enabled;
                    group: false;
                    expanded: false;
                    selected: root.selected-kind == "server"
                        && root.selected-id == profile.id;
                    select-target(kind, id, group-name) => {
                        root.select-target(kind, id, group-name);
                    }
                    connect-session(id) => { root.connect-session(id); }
                    open-sftp(id) => { root.open-sftp(id); }
                    new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
                    rename-group(group-name) => { root.rename-group(group-name); }
                    delete-group(group-name) => { root.delete-group(group-name); }
                    edit-session(id) => { root.edit-session(id); }
                    delete-session(id, name) => { root.delete-session(id, name); }
                    copy-session(id) => { root.copy-session(id); }
                    duplicate-session(id) => { root.duplicate-session(id); }
                    session-transfer-action(action, target) => {
                        root.session-transfer-action(action, target);
                    }
                }
            }
        }

        // The gap belongs to the preceding group, keeping its heading and
        // servers visually together while separating the next group.
        Rectangle {
            height: Theme.sidebar-group-spacing;
            vertical-stretch: 0;
        }
    }
}

component CompactSessionNavigationGroup inherits Rectangle {
    in property <SessionGroupRow> source;
    in property <bool> full-group-label: false;
    in property <string> selected-kind;
    in property <string> selected-id;
    in property <string> selected-group-name;

    callback connect-session(string);
    callback open-sftp(string);
    callback new-session-in-group(string);
    callback rename-group(string);
    callback delete-group(string);
    callback edit-session(string);
    callback delete-session(string, string);
    callback copy-session(string);
    callback duplicate-session(string);
    callback session-transfer-action(string, string);
    callback select-target(string, string, string);

    private property <bool> group-expanded: true;

    height: compact-layout.preferred-height;

    compact-layout := VerticalLayout {
        width: parent.width;
        spacing: root.group-expanded && root.source.profiles.length > 0
            ? Theme.sidebar-rail-group-to-session-spacing : 0px;

        Rectangle {
            width: parent.width;
            height: group-item.height;

            group-item := SidebarRailItem {
                width: parent.width;
                label: root.full-group-label ? root.source.name : root.source.icon;
                trailing-label: root.full-group-label
                    ? "\{root.source.profiles.length}"
                    : "";
                group: true;
                expandable: true;
                expanded: root.group-expanded;
                expanded-label: root.full-group-label;
                tooltip-enabled: false;
                selected: root.selected-kind == "group"
                    && root.selected-group-name == root.source.group-name;
                accessible-name: root.group-expanded
                    ? @tr("Collapse {0} group", root.source.name)
                    : @tr("Expand {0} group", root.source.name);
                activated => {
                    root.select-target("group", "", root.source.group-name);
                    root.group-expanded = !root.group-expanded;
                }
            }
            if root.full-group-label : Tooltip {
                SessionProfileTooltipContent {
                    name: root.source.name;
                    details: "";
                }
            }
            SessionActionMenu {
                group-name: root.source.group-name;
                name: root.source.name;
                kind: root.source.group-name.is-empty
                    ? SessionActionMenuKind.ungrouped
                    : SessionActionMenuKind.group;
                connect-session(id) => { root.connect-session(id); }
                new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
                rename-group(group-name) => { root.rename-group(group-name); }
                delete-group(group-name) => { root.delete-group(group-name); }
                edit-session(id) => { root.edit-session(id); }
                delete-session(id, name) => { root.delete-session(id, name); }
                copy-session(id) => { root.copy-session(id); }
                duplicate-session(id) => { root.duplicate-session(id); }
                select-target(kind, id, group-name) => {
                    root.select-target(kind, id, group-name);
                }
                session-transfer-action(action, target) => {
                    root.session-transfer-action(action, target);
                }
            }
        }

        if root.group-expanded : VerticalLayout {
            spacing: Theme.sidebar-rail-session-spacing;

            for profile in root.source.profiles : Rectangle {
                width: parent.width;
                height: profile-item.height;

                profile-item := SidebarRailItem {
                    width: parent.width;
                    label: root.full-group-label ? profile.name : profile.icon;
                    group: false;
                    nested: root.full-group-label;
                    expanded-label: root.full-group-label;
                    tooltip-enabled: profile.details.is-empty;
                    selected: root.selected-kind == "server"
                        && root.selected-id == profile.id;
                    accessible-name: @tr("Connect to {0}", profile.name);
                    activated => {
                        root.select-target("server", profile.id, root.source.group-name);
                        root.connect-session(profile.id);
                    }
                }
                if !profile.details.is-empty : Tooltip {
                    SessionProfileTooltipContent {
                        name: profile.name;
                        details: profile.details;
                    }
                }
                SessionActionMenu {
                    target-id: profile.id;
                    group-name: root.source.group-name;
                    name: profile.name;
                    kind: SessionActionMenuKind.server;
                    sftp-enabled: profile.sftp-enabled;
                    connect-session(id) => { root.connect-session(id); }
                    open-sftp(id) => { root.open-sftp(id); }
                    new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
                    rename-group(group-name) => { root.rename-group(group-name); }
                    delete-group(group-name) => { root.delete-group(group-name); }
                    edit-session(id) => { root.edit-session(id); }
                    delete-session(id, name) => { root.delete-session(id, name); }
                    copy-session(id) => { root.copy-session(id); }
                    duplicate-session(id) => { root.duplicate-session(id); }
                    select-target(kind, id, group-name) => {
                        root.select-target(kind, id, group-name);
                    }
                    session-transfer-action(action, target) => {
                        root.session-transfer-action(action, target);
                    }
                }
            }
        }
    }
}

export component SessionNavigation inherits Rectangle {
    in property <[SessionGroupRow]> sessions;
    in property <int> sidebar-width;
    in property <int> collapsed-group-label-chars: 2;
    in property <length> divider-top-offset: 0px;
    in-out property <bool> collapsed;
    in property <string> local-shell-title: @tr("Local Shell");
    in property <string> local-shell-description: @tr("Open a new local shell tab");
    in property <string> local-shell-accessible-name: @tr("Open local shell");

    callback open-local-shell();
    callback new-session();
    callback connect-session(string);
    callback open-sftp(string);
    callback new-group();
    callback new-session-in-group(string);
    callback rename-group(string);
    callback delete-group(string);
    callback edit-session(string);
    callback delete-session(string, string);
    callback copy-session(string);
    callback duplicate-session(string);
    callback session-transfer-action(string, string);

    private property <bool> expanded: !root.collapsed;
    in property <string> active-profile-id: "";
    private property <string> selected-kind;
    private property <string> selected-id;
    private property <string> selected-group-name;

    function sync-active-profile-selection() {
        if !root.active-profile-id.is-empty {
            root.select-target("server", root.active-profile-id, "");
        }
    }

    init => { root.sync-active-profile-selection(); }
    changed active-profile-id => { root.sync-active-profile-selection(); }

    public function import-session-config() {
        root.session-transfer-action("import-any", "");
    }

    public function export-selected-session-config() {
        if root.selected-kind == "server" && !root.selected-id.is-empty {
            root.session-transfer-action("copy-server", root.selected-id);
        } else if root.selected-kind == "group" && !root.selected-group-name.is-empty {
            root.session-transfer-action("copy-group", root.selected-group-name);
        } else {
            root.session-transfer-action("export-none", "");
        }
    }

    function select-target(kind: string, id: string, group-name: string) {
        root.selected-kind = kind;
        root.selected-id = id;
        root.selected-group-name = group-name;
    }

    width: root.expanded
        ? root.sidebar-width * 1px
        : (root.collapsed-group-label-chars == 0
            ? Theme.sidebar-rail-full-width
            : Theme.activity-bar-width);

    if !root.expanded : Rectangle {
        background: Theme.panel-alt;
        VerticalLayout {
            padding-top: Theme.space-xs;
            padding-bottom: Theme.space-xs;
            spacing: 0px;

            SidebarRailToggle {
                expanded: false;
                full-width: root.collapsed-group-label-chars == 0;
                activated => { root.collapsed = false; }
            }
            Rectangle { height: Theme.hairline; background: Theme.divider; }

            SidebarRailItem {
                local: true;
                label: root.local-shell-title;
                expanded-label: root.collapsed-group-label-chars == 0;
                accessible-name: root.local-shell-accessible-name;
                activated => { root.open-local-shell(); }
            }
            Rectangle { height: Theme.hairline; background: Theme.divider; }
            Rectangle {
                vertical-stretch: 1;
                background: transparent;

                SessionActionMenu {
                    kind: SessionActionMenuKind.list;
                    new-group => { root.new-group(); }
                    new-session => { root.new-session(); }
                    session-transfer-action(action, target) => {
                        root.session-transfer-action(action, target);
                    }
                }

                if root.sessions.length > 0 : groups-flick := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.width;
                    viewport-height: max(self.height, groups-layout.preferred-height);

                    groups-layout := VerticalLayout {
                        width: parent.width;
                        spacing: Theme.sidebar-rail-group-spacing;

                        for group in root.sessions : CompactSessionNavigationGroup {
                            width: parent.width;
                            source: group;
                            full-group-label: root.collapsed-group-label-chars == 0;
                            selected-kind: root.selected-kind;
                            selected-id: root.selected-id;
                            selected-group-name: root.selected-group-name;
                            select-target(kind, id, group-name) => {
                                root.select-target(kind, id, group-name);
                            }
                            connect-session(id) => { root.connect-session(id); }
                            open-sftp(id) => { root.open-sftp(id); }
                            new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
                            rename-group(group-name) => { root.rename-group(group-name); }
                            delete-group(group-name) => { root.delete-group(group-name); }
                            edit-session(id) => { root.edit-session(id); }
                            delete-session(id, name) => { root.delete-session(id, name); }
                            copy-session(id) => { root.copy-session(id); }
                            duplicate-session(id) => { root.duplicate-session(id); }
                            session-transfer-action(action, target) => {
                                root.session-transfer-action(action, target);
                            }
                        }
                    }
                }
                if root.sessions.length == 0 : Text {
                    text: @tr("No saved servers");
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        // The application frame owns the outer edge; the sidebar contributes
        // only one internal divider on its content side.
        Rectangle {
            x: parent.width - Theme.hairline;
            y: root.divider-top-offset;
            width: Theme.hairline;
            height: max(0px, parent.height - root.divider-top-offset);
            background: Theme.sidebar-divider;
        }
    }

    if root.expanded : Rectangle {
        background: Theme.panel;
        VerticalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            padding-top: 0px;
            padding-bottom: Theme.space-xs;
            spacing: 0px;

            SidebarRailToggle {
                width: parent.width;
                expanded: true;
                full-width: true;
                activated => { root.collapsed = true; }
            }

            Rectangle { height: Theme.hairline; background: Theme.divider; }

            Rectangle {
                height: Theme.sidebar-local-card-height;
                background: local-card-touch.has-hover ? Theme.hover : transparent;
                border-radius: Theme.radius-small;

                local-card-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: root.local-shell-accessible-name;
                    clicked => { root.open-local-shell(); }
                }

                HorizontalLayout {
                    padding-left: Theme.sidebar-card-padding;
                    padding-right: Theme.sidebar-card-padding;
                    spacing: Theme.space-md;

                    // The glyph stays centered within its own leading slot.
                    Rectangle {
                        width: Theme.sidebar-leading-icon-slot-width;
                        SidebarTerminalGlyph {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            glyph-color: local-card-touch.has-hover ? Theme.accent : Theme.text;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding-top: Theme.space-xs;
                        padding-bottom: Theme.space-xs;
                        spacing: 0px;
                        ElidedLabel {
                            text: root.local-shell-title;
                            text-color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: 700;
                        }
                        ElidedLabel {
                            text: root.local-shell-description;
                            text-color: Theme.muted;
                            font-size: Theme.font-caption;
                        }
                    }
                }
            }

            Rectangle { height: Theme.hairline; background: Theme.divider; }

            Rectangle {
                vertical-stretch: 1;
                background: transparent;

                SessionActionMenu {
                    kind: SessionActionMenuKind.list;
                    new-group => { root.new-group(); }
                    new-session => { root.new-session(); }
                    session-transfer-action(action, target) => {
                        root.session-transfer-action(action, target);
                    }
                }

                if root.sessions.length > 0 : expanded-groups-flick := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.width;
                    viewport-height: max(self.height, expanded-groups-layout.preferred-height);

                    expanded-groups-layout := VerticalLayout {
                        width: parent.width;
                        spacing: 0px;

                        for group in root.sessions : SessionNavigationGroup {
                            width: parent.width;
                            source: group;
                            selected-kind: root.selected-kind;
                            selected-id: root.selected-id;
                            selected-group-name: root.selected-group-name;
                            select-target(kind, id, group-name) => {
                                root.select-target(kind, id, group-name);
                            }
                            connect-session(id) => { root.connect-session(id); }
                            open-sftp(id) => { root.open-sftp(id); }
                            new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
                            rename-group(group-name) => { root.rename-group(group-name); }
                            delete-group(group-name) => { root.delete-group(group-name); }
                            edit-session(id) => { root.edit-session(id); }
                            delete-session(id, name) => { root.delete-session(id, name); }
                            copy-session(id) => { root.copy-session(id); }
                            duplicate-session(id) => { root.duplicate-session(id); }
                            session-transfer-action(action, target) => {
                                root.session-transfer-action(action, target);
                            }
                        }
                    }
                }
                if root.sessions.length == 0 : Text {
                    text: @tr("No saved servers");
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        // Avoid a second top/left/bottom frame inside the application frame.
        Rectangle {
            x: parent.width - Theme.hairline;
            y: root.divider-top-offset;
            width: Theme.hairline;
            height: max(0px, parent.height - root.divider-top-offset);
            background: Theme.sidebar-divider;
        }
    }
}
