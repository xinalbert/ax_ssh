import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ActionMenuItem, FlatActionMenu } from "flat-action-menu.slint";
import {
    SidebarRailItem,
    SidebarRailToggle,
    SidebarTerminalGlyph,
} from "sidebar-controls.slint";

export struct SessionRow {
    id: string,
    group-name: string,
    name: string,
    endpoint: string,
    icon: string,
    is-group: bool,
    expanded: bool,
}

enum SessionActionMenuKind {
    list,
    group,
    ungrouped,
    server,
}

// Draw the disclosure chevron so its shape does not depend on font coverage.
component GroupDisclosureChevron inherits Path {
    in property <bool> expanded;

    width: Theme.sidebar-group-chevron-size;
    height: Theme.sidebar-group-chevron-size;
    commands: root.expanded
        ? "M 2 4 L 8 10 L 14 4"
        : "M 2 10 L 8 4 L 14 10";
    fill: transparent;
    stroke: Theme.muted;
    stroke-width: Theme.sidebar-group-chevron-stroke;
    stroke-line-cap: round;
    stroke-line-join: round;
}

component SessionActionMenu inherits Rectangle {
    in property <SessionActionMenuKind> kind: SessionActionMenuKind.list;
    in property <string> target-id;
    in property <string> group-name;
    in property <string> name;

    callback connect-session(string);
    callback new-group();
    callback new-session();
    callback new-session-in-group(string);
    callback rename-group(string);
    callback delete-group(string);
    callback edit-session(string);
    callback delete-session(string, string);

    function action(action-id: string, title: string) -> ActionMenuItem {
        {
            action-id: action-id,
            title: title,
            enabled: true,
        }
    }

    private property <[ActionMenuItem]> actions:
        root.kind == SessionActionMenuKind.list
            ? [
                root.action("new-group", "New Group"),
                root.action("new-server", "New Server"),
            ]
            : (root.kind == SessionActionMenuKind.group
                ? [
                    root.action("add-server", "Add Server"),
                    root.action("rename-group", "Rename Group"),
                    root.action("delete-group", "Delete Group"),
                ]
                : (root.kind == SessionActionMenuKind.ungrouped
                    ? [
                        root.action("add-server", "Add Server"),
                    ]
                    : [
                        root.action("connect", "Connect"),
                        root.action("edit-server", "Edit Server"),
                        root.action("delete-server", "Delete Server"),
                    ]));

    public function show-at(position: Point) {
        action-menu.show-at(position);
    }

    action-menu := FlatActionMenu {
        actions: root.actions;
        triggered(action-id) => {
            if action-id == "new-group" {
                root.new-group();
            } else if action-id == "new-server" {
                root.new-session();
            } else if action-id == "add-server" {
                root.new-session-in-group(root.group-name);
            } else if action-id == "rename-group" {
                root.rename-group(root.group-name);
            } else if action-id == "delete-group" {
                root.delete-group(root.group-name);
            } else if action-id == "connect" {
                root.connect-session(root.target-id);
            } else if action-id == "edit-server" {
                root.edit-session(root.target-id);
            } else if action-id == "delete-server" {
                root.delete-session(root.target-id, root.name);
            }
        }
    }
}

component SessionNavigationRow inherits FocusScope {
    in property <string> id;
    in property <string> group-name;
    in property <string> name;
    in property <string> endpoint;
    in property <string> icon;
    in property <bool> group;
    in property <bool> expanded;

    callback connect-session(string);
    callback toggle-group(string);
    callback new-session-in-group(string);
    callback rename-group(string);
    callback delete-group(string);
    callback edit-session(string);
    callback delete-session(string, string);

    height: root.group
        ? Theme.sidebar-group-card-height
        : Theme.sidebar-session-card-height;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.group
        ? (root.expanded
            ? "Collapse " + root.name + " group"
            : "Expand " + root.name + " group")
        : "Connect to " + root.name;
    accessible-expandable: root.group;
    accessible-expanded: root.expanded;

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            if root.group {
                root.toggle-group(root.group-name);
            } else {
                root.connect-session(root.id);
            }
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        background: row-touch.has-hover || root.has-focus ? Theme.hover : transparent;
        border-width: root.has-focus ? Theme.hairline : 0px;
        border-color: Theme.focus;
        border-radius: Theme.radius-small;

        row-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if root.group {
                    root.toggle-group(root.group-name);
                } else {
                    root.connect-session(root.id);
                }
            }
        }

        if root.group : HorizontalLayout {
            padding-left: Theme.sidebar-card-padding;
            padding-right: Theme.sidebar-card-padding;
            spacing: Theme.space-sm;

            Rectangle {
                width: Theme.sidebar-group-chevron-width;
                GroupDisclosureChevron {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    expanded: root.expanded;
                }
            }

            Text {
                horizontal-stretch: 1;
                text: root.name;
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                text: root.endpoint;
                color: Theme.muted;
                font-family: "JetBrains Mono";
                font-size: Theme.font-caption;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        if !root.group : HorizontalLayout {
            padding-left: Theme.sidebar-session-indent;
            padding-right: Theme.sidebar-card-padding;
            spacing: Theme.space-sm;

            Text {
                horizontal-stretch: 1;
                text: root.name;
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                width: min(
                    Theme.sidebar-session-endpoint-width,
                    parent.width * 0.58,
                );
                text: root.endpoint;
                color: Theme.muted;
                font-family: "JetBrains Mono";
                font-size: Theme.font-caption;
                horizontal-alignment: right;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        SessionActionMenu {
            kind: root.group
                ? (root.group-name.is-empty
                    ? SessionActionMenuKind.ungrouped
                    : SessionActionMenuKind.group)
                : SessionActionMenuKind.server;
            target-id: root.id;
            group-name: root.group-name;
            name: root.name;
            connect-session(id) => { root.connect-session(id); }
            new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
            rename-group(group-name) => { root.rename-group(group-name); }
            delete-group(group-name) => { root.delete-group(group-name); }
            edit-session(id) => { root.edit-session(id); }
            delete-session(id, name) => { root.delete-session(id, name); }
        }
    }
}

export component SessionNavigation inherits Rectangle {
    in property <[SessionRow]> sessions;
    in property <int> sidebar-width;
    in-out property <bool> collapsed;
    in property <string> local-shell-title: "Local Shell";
    in property <string> local-shell-description: "Open a new local shell tab";
    in property <string> local-shell-accessible-name: "Open local shell";

    callback open-local-shell();
    callback new-session();
    callback connect-session(string);
    callback toggle-group(string);
    callback new-group();
    callback new-session-in-group(string);
    callback rename-group(string);
    callback delete-group(string);
    callback edit-session(string);
    callback delete-session(string, string);

    private property <bool> expanded: !root.collapsed;

    width: root.expanded ? root.sidebar-width * 1px : Theme.activity-bar-width;

    if !root.expanded : Rectangle {
        background: Theme.panel-alt;
        border-width: Theme.hairline;
        border-color: Theme.frame-border;

        VerticalLayout {
            padding-top: Theme.space-xs;
            padding-bottom: Theme.space-xs;
            spacing: 0px;

            SidebarRailToggle {
                expanded: false;
                activated => { root.collapsed = false; }
            }
            Rectangle { height: Theme.hairline; background: Theme.divider; }

            SidebarRailItem {
                local: true;
                accessible-name: root.local-shell-accessible-name;
                activated => { root.open-local-shell(); }
            }
            Rectangle { height: Theme.hairline; background: Theme.divider; }
            Rectangle {
                vertical-stretch: 1;
                background: transparent;

                SessionActionMenu {
                    kind: SessionActionMenuKind.list;
                    new-group => { root.new-group(); }
                    new-session => { root.new-session(); }
                }

                if root.sessions.length > 0 : ListView {
                    for row in root.sessions : Rectangle {
                        width: parent.width;
                        height: row.is-group
                            ? Theme.sidebar-rail-group-row-height
                            : Theme.sidebar-rail-session-row-height;
                        background: transparent;

                        SidebarRailItem {
                            width: parent.width;
                            label: row.icon;
                            group: row.is-group;
                            accessible-name: row.is-group
                                ? "Open " + row.name + " group"
                                : "Connect to " + row.name;
                            activated => {
                                if row.is-group {
                                    root.toggle-group(row.group-name);
                                } else {
                                    root.connect-session(row.id);
                                }
                            }
                        }
                        SessionActionMenu {
                            kind: row.is-group
                                ? (row.group-name.is-empty
                                    ? SessionActionMenuKind.ungrouped
                                    : SessionActionMenuKind.group)
                                : SessionActionMenuKind.server;
                            target-id: row.id;
                            group-name: row.group-name;
                            name: row.name;
                            connect-session(id) => { root.connect-session(id); }
                            new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
                            rename-group(group-name) => { root.rename-group(group-name); }
                            delete-group(group-name) => { root.delete-group(group-name); }
                            edit-session(id) => { root.edit-session(id); }
                            delete-session(id, name) => { root.delete-session(id, name); }
                        }
                    }
                }
                if root.sessions.length == 0 : Text {
                    text: "No saved servers";
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }

    if root.expanded : Rectangle {
        background: Theme.panel;
        border-width: Theme.hairline;
        border-color: Theme.frame-border;

        VerticalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            padding-top: 0px;
            padding-bottom: Theme.space-xs;
            spacing: 0px;

            Rectangle {
                height: Theme.sidebar-local-card-height;
                background: local-card-touch.has-hover ? Theme.hover : transparent;
                border-radius: Theme.radius-small;

                local-card-touch := TouchArea {
                    width: parent.width
                        - Theme.sidebar-card-padding
                        - Theme.sidebar-rail-toggle-size;
                    height: parent.height;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: root.local-shell-accessible-name;
                    clicked => { root.open-local-shell(); }
                }

                HorizontalLayout {
                    padding-left: Theme.sidebar-card-padding;
                    padding-right: Theme.sidebar-card-padding;
                    spacing: Theme.space-md;

                    // The glyph stays centered within its own leading slot.
                    Rectangle {
                        width: Theme.sidebar-leading-icon-slot-width;
                        SidebarTerminalGlyph {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            glyph-color: local-card-touch.has-hover ? Theme.accent : Theme.text;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding-top: Theme.space-xs;
                        padding-bottom: Theme.space-xs;
                        spacing: 0px;
                        Text {
                            text: root.local-shell-title;
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: 700;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.local-shell-description;
                            color: Theme.muted;
                            font-size: Theme.font-caption;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: Theme.sidebar-rail-toggle-size;
                        height: parent.height;

                        SidebarRailToggle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: parent.width;
                            height: Theme.sidebar-rail-toggle-size;
                            expanded: true;
                            activated => { root.collapsed = true; }
                        }
                    }
                }
            }

            Rectangle { height: Theme.hairline; background: Theme.divider; }

            Rectangle {
                vertical-stretch: 1;
                background: transparent;

                SessionActionMenu {
                    kind: SessionActionMenuKind.list;
                    new-group => { root.new-group(); }
                    new-session => { root.new-session(); }
                }

                if root.sessions.length > 0 : ListView {
                    for row in root.sessions : SessionNavigationRow {
                        width: parent.width;
                        id: row.id;
                        group-name: row.group-name;
                        name: row.name;
                        endpoint: row.endpoint;
                        icon: row.icon;
                        group: row.is-group;
                        expanded: row.expanded;
                        connect-session(id) => { root.connect-session(id); }
                        toggle-group(group-name) => { root.toggle-group(group-name); }
                        new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
                        rename-group(group-name) => { root.rename-group(group-name); }
                        delete-group(group-name) => { root.delete-group(group-name); }
                        edit-session(id) => { root.edit-session(id); }
                        delete-session(id, name) => { root.delete-session(id, name); }
                    }
                }
                if root.sessions.length == 0 : Text {
                    text: "No saved servers";
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}
