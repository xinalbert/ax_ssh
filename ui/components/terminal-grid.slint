import { Theme } from "../theme.slint";

export struct TerminalRenderRun {
    text: string,
    column: int,
    cells: int,
    foreground: color,
    background: color,
    bold: bool,
    italic: bool,
    underline: bool,
    strikethrough: bool,
}

export struct TerminalRenderLine {
    runs: [TerminalRenderRun],
}

// Rust owns this snapshot. It contains only the bounded visible grid and no
// local interaction state.
export struct TerminalGridView {
    connected: bool,
    render_lines: [TerminalRenderLine],
    content_columns: int,
    cursor_row: int,
    cursor_column: int,
    cursor_visible: bool,
    cursor_text: string,
    font_family: string,
    font_size: length,
    foreground: color,
    background: color,
    selection_background: color,
}

// TerminalPane owns this local selection state and passes only its derived
// display range to the grid.
export struct TerminalSelectionView {
    active: bool,
    first_row: int,
    first_column: int,
    last_row: int,
    last_column: int,
}

export component TerminalGrid inherits Rectangle {
    in property <TerminalGridView> view;
    in property <TerminalSelectionView> selection;
    in property <length> cell-width;
    in property <length> cell-height;
    in property <length> font-cell-height;
    in property <length> top-offset;
    in property <bool> cursor-blink;
    in property <string> preedit-text;
    in property <bool> right-click-pastes;

    callback pointer-down(int, int, bool, bool);
    callback pointer-moved(int, int);
    callback pointer-up();
    callback scrolled(int);
    callback copy-request();
    callback paste-request();
    callback select-all-request();

    background: root.view.background;
    clip: true;

    for line[line-index] in root.view.render_lines : Rectangle {
        x: 0px;
        y: root.top-offset + line-index * root.cell-height;
        width: parent.width;
        height: root.cell-height;
        background: root.view.background;

        for run in line.runs : Rectangle {
            x: run.column * root.cell-width;
            width: run.cells * root.cell-width;
            height: root.cell-height;
            background: run.background;
        }

        if root.selection.active
            && line-index >= root.selection.first_row
            && line-index <= root.selection.last_row : Rectangle {
            property <int> first-column:
                line-index == root.selection.first_row
                    ? root.selection.first_column : 0;
            property <int> last-column:
                line-index == root.selection.last_row
                    ? root.selection.last_column : root.view.content_columns - 1;
            x: max(0, self.first-column) * root.cell-width;
            width: max(0, self.last-column - self.first-column + 1) * root.cell-width;
            height: root.cell-height;
            background: root.view.selection_background.with-alpha(0.72);
        }

        for run in line.runs : Text {
            x: run.column * root.cell-width;
            y: (root.cell-height - root.font-cell-height) / 2;
            width: run.cells * root.cell-width;
            height: root.font-cell-height;
            text: run.text;
            color: run.foreground;
            font-family: root.view.font_family;
            font-size: root.view.font_size;
            font-weight: run.bold ? 700 : 400;
            font-italic: run.italic;
            letter-spacing: 0px;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: clip;
        }

        for run in line.runs : Rectangle {
            x: run.column * root.cell-width;
            width: run.cells * root.cell-width;
            height: root.cell-height;
            background: transparent;
            if run.underline : Rectangle {
                y: parent.height - Theme.terminal-underline-offset;
                width: parent.width;
                height: Theme.hairline;
                background: run.foreground;
            }
            if run.strikethrough : Rectangle {
                y: parent.height / 2;
                width: parent.width;
                height: Theme.hairline;
                background: run.foreground;
            }
        }

        if root.view.connected && root.view.cursor_visible && root.cursor-blink
            && line-index == root.view.cursor_row : Rectangle {
            x: root.view.cursor_column * root.cell-width;
            width: root.cell-width;
            height: root.cell-height;
            background: root.view.foreground;
            Text {
                y: (parent.height - root.font-cell-height) / 2;
                width: parent.width;
                height: root.font-cell-height;
                text: root.view.cursor_text;
                color: root.view.background;
                font-family: root.view.font_family;
                font-size: root.view.font_size;
                letter-spacing: 0px;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: clip;
            }
        }
    }

    if root.view.connected && root.view.cursor_visible && root.preedit-text != "" : preedit-overlay := Rectangle {
        x: max(0px, min(parent.width - root.cell-width,
            root.view.cursor_column * root.cell-width));
        y: max(0px, min(parent.height - root.cell-height,
            root.top-offset + root.view.cursor_row * root.cell-height));
        width: min(parent.width - self.x,
            max(root.cell-width, preedit-value.preferred-width));
        height: root.cell-height;
        background: root.view.background;

        preedit-value := Text {
            y: (parent.height - root.font-cell-height) / 2;
            width: parent.width;
            height: root.font-cell-height;
            text: root.preedit-text;
            color: root.view.foreground;
            font-family: root.view.font_family;
            font-size: root.view.font_size;
            letter-spacing: 0px;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: clip;
        }
        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: Theme.hairline;
            background: root.view.foreground;
        }
    }

    body-touch := TouchArea {
        mouse-cursor: text;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.pointer-down(
                    max(0, min(root.view.render_lines.length - 1,
                        floor((self.mouse-y - root.top-offset) / root.cell-height))),
                    max(0, min(root.view.content_columns - 1,
                        floor(self.mouse-x / root.cell-width))),
                    event.button == PointerEventButton.left,
                    event.button == PointerEventButton.right,
                );
            } else if event.kind == PointerEventKind.up
                && event.button == PointerEventButton.left {
                root.pointer-up();
            }
        }
        moved => {
            root.pointer-moved(
                max(0, min(root.view.render_lines.length - 1,
                    floor((self.mouse-y - root.top-offset) / root.cell-height))),
                max(0, min(root.view.content_columns - 1,
                    floor(self.mouse-x / root.cell-width))),
            );
        }
        scroll-event(event) => {
            root.scrolled(event.delta-y > 0 ? 3 : -3);
            accept
        }
    }

    ContextMenuArea {
        width: parent.width;
        height: parent.height;
        enabled: !root.right-click-pastes;
        Menu {
            MenuItem {
                title: "Copy";
                enabled: root.selection.active;
                activated => { root.copy-request(); }
            }
            MenuItem {
                title: "Paste";
                enabled: root.view.connected;
                activated => { root.paste-request(); }
            }
            MenuItem {
                title: "Select All";
                enabled: root.view.render_lines.length > 0;
                activated => { root.select-all-request(); }
            }
        }
    }
}
