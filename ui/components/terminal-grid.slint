import { Theme } from "../theme.slint";

export struct TerminalRenderRun {
    text: string,
    column: int,
    cells: int,
    foreground: color,
    bold: bool,
    italic: bool,
    centered: bool,
}

export struct TerminalBackgroundRun {
    column: int,
    cells: int,
    background: color,
}

export struct TerminalDecorationRun {
    column: int,
    cells: int,
    foreground: color,
    strikethrough: bool,
}

export struct TerminalRenderLine {
    source_revision_low: int,
    source_revision_high: int,
    render_cache_key_low: int,
    render_cache_key_high: int,
    backgrounds: [TerminalBackgroundRun],
    decorations: [TerminalDecorationRun],
    runs: [TerminalRenderRun],
}

// Rust owns this snapshot. It contains only the bounded visible grid and no
// local interaction state.
export struct TerminalGridView {
    connected: bool,
    render_lines: [TerminalRenderLine],
    row_count: int,
    content_columns: int,
    cursor_row: int,
    cursor_column: int,
    cursor_cells: int,
    cursor_visible: bool,
    cursor_text: string,
    mouse_button_reporting: bool,
    font_family: string,
    font_registry_generation: int,
    font_size: length,
    foreground: color,
    background: color,
    selection_background: color,
    compact_rendering: bool,
    row_render_cache: bool,
}

// TerminalPane owns this local selection state and passes only its derived
// display range to the grid.
export struct TerminalSelectionView {
    active: bool,
    first_row: int,
    first_column: int,
    last_row: int,
    last_column: int,
}

export struct TerminalTargetHighlight {
    active: bool,
    row: int,
    start_column: int,
    end_column: int,
}

export component TerminalGrid inherits Rectangle {
    in property <TerminalGridView> view;
    in property <TerminalSelectionView> selection;
    in property <length> cell-width;
    in property <length> cell-height;
    in property <length> font-cell-height;
    in property <length> top-offset;
    in property <length> cursor-x;
    in property <length> cursor-y;
    in property <bool> cursor-blink;
    in property <bool> cursor-blink-enabled: true;
    in property <string> preedit-text;
    in property <bool> right-click-pastes;
    in property <bool> mouse-local-selection-priority;
    in property <TerminalTargetHighlight> target-highlight;

    // Pointer callbacks carry both the containing cell column and the nearest
    // insertion boundary in 0..=content_columns. Terminal mouse reporting uses
    // the cell; local text selection uses the boundary.
    callback pointer-down(int, int, int, int, bool, bool, bool, bool);
    callback pointer-moved(int, int, int, bool, bool, bool, bool);
    callback pointer-hovered(bool);
    callback pointer-up(int, int, int, int, bool, bool, bool);
    callback pointer-cancel();
    callback semantic-selection-request(int, int);
    callback line-selection-request(int, int);
    callback scrolled(int, int, int, bool, bool, bool);
    callback copy-request();
    callback paste-request();
    callback select-all-request();

    // Runtime font registration can replace a cached fallback face without
    // changing the requested family or weight. Keep the generation in this
    // binding so Slint reshapes the text with the newly registered face.
    function terminal-font-weight(bold: bool, font-generation: int) -> int {
        return bold ? 700 + font-generation * 0 : 400 + font-generation * 0;
    }

    private property <int> click-sequence: 0;
    private property <int> click-timeout-ticks: 0;
    private property <int> click-cell-row: -1;
    private property <int> click-cell-column: -1;
    private property <int> click-boundary-column: -1;
    private property <bool> click-pressed: false;
    // Trackpad scroll events arrive as small pixel deltas. Keep the residual
    // in the grid so a complete terminal row is dispatched as one command.
    private property <length> scroll-accumulator-y: 0px;

    background: root.view.background;
    clip: true;

    // Keep the terminal grid as one bounded row model. Selection remains
    // cell-accurate per-row geometry, while the other interaction overlays
    // below stay outside the row cache with stable item identity.
    for line[line-index] in root.view.render_lines : Rectangle {
        x: 0px;
        y: root.top-offset + line-index * root.cell-height;
        width: parent.width;
        height: root.cell-height;
        background: transparent;
        static-content := Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;
            cache-rendering-hint: root.view.row_render_cache;

            // The renderer omits default-background spans and merges adjacent
            // equal colors, so one stable background model serves both text modes.
            for run in line.backgrounds : Rectangle {
                x: run.column * root.cell-width;
                width: run.cells * root.cell-width;
                height: root.cell-height;
                background: run.background;
            }

            // Keep both text-mode subtrees allocated. Switching the compact
            // renderer only changes visibility, so a settings change does not
            // rebuild every row's item tree.
            noncompact-content := Rectangle {
                visible: !root.view.compact_rendering;
                width: parent.width;
                height: parent.height;
                background: transparent;

                // Match the compact path: the text item owns its cell span
                // directly, so non-compact rendering has no transparent
                // per-run wrapper node.
                for run in line.runs : Text {
                    x: run.column * root.cell-width;
                    y: (root.cell-height - root.font-cell-height) / 2;
                    width: run.cells * root.cell-width;
                    height: root.font-cell-height;
                    text: run.text;
                    color: run.foreground;
                    font-family: root.view.font_family;
                    font-size: root.view.font_size;
                    font-weight: root.terminal-font-weight(
                        run.bold, root.view.font_registry_generation);
                    font-italic: run.italic;
                    letter-spacing: 0px;
                    horizontal-alignment: run.centered ? center : left;
                    vertical-alignment: center;
                    overflow: clip;
                }
            }

            compact-content := Rectangle {
                visible: root.view.compact_rendering;
                width: parent.width;
                height: parent.height;
                background: transparent;

                for run in line.runs : Text {
                    x: run.column * root.cell-width;
                    y: (root.cell-height - root.font-cell-height) / 2;
                    width: run.cells * root.cell-width;
                    height: root.font-cell-height;
                    text: run.text;
                    color: run.foreground;
                    font-family: root.view.font_family;
                    font-size: root.view.font_size;
                    font-weight: root.terminal-font-weight(
                        run.bold, root.view.font_registry_generation);
                    font-italic: run.italic;
                    letter-spacing: 0px;
                    horizontal-alignment: run.centered ? center : left;
                    vertical-alignment: center;
                    overflow: clip;
                }
            }

            // Decorations use one shared, merged model in both rendering modes.
            // This avoids per-run conditional children while preserving the
            // original text-then-decoration draw order.
            for run in line.decorations : Rectangle {
                x: run.column * root.cell-width;
                y: run.strikethrough
                    ? parent.height / 2
                    : parent.height - Theme.terminal-underline-offset;
                width: run.cells * root.cell-width;
                height: Theme.hairline;
                background: run.foreground;
            }
        }

        // Paint selection one terminal cell at a time. Independent cell edges
        // keep fractional logical widths aligned when CJK and Latin share a row.
        selection-overlay := Rectangle {
            visible: root.selection.active
                && line-index >= root.selection.first_row
                && line-index <= root.selection.last_row;
            property <int> first-column:
                line-index == root.selection.first_row
                    ? root.selection.first_column : 0;
            property <int> last-column:
                line-index == root.selection.last_row
                    ? root.selection.last_column : root.view.content_columns - 1;
            width: parent.width;
            height: root.cell-height;
            background: transparent;

            for _[selection-column] in max(
                0, selection-overlay.last-column - selection-overlay.first-column + 1
            ) : Rectangle {
                x: max(0, selection-overlay.first-column + selection-column)
                    * root.cell-width;
                width: root.cell-width;
                height: root.cell-height;
                background: root.view.selection_background.with-alpha(0.72);
            }
        }

    }

    // Keep interaction overlays outside the row repeater. Their identity stays
    // stable while the cursor/target moves between rows, so movement updates
    // geometry and visibility without creating or destroying row children.
    target-overlay := Rectangle {
        x: max(0, root.target-highlight.start_column) * root.cell-width;
        y: root.top-offset + root.target-highlight.row * root.cell-height
            + root.cell-height - Theme.terminal-underline-offset;
        width: max(
            1,
            root.target-highlight.end_column - root.target-highlight.start_column,
        ) * root.cell-width;
        height: Theme.hairline;
        visible: root.target-highlight.active;
        background: Theme.accent;
    }

    cursor-overlay := Rectangle {
        x: root.cursor-x;
        y: root.cursor-y;
        width: max(1, root.view.cursor_cells) * root.cell-width;
        height: root.cell-height;
        visible: root.view.connected && root.view.cursor_visible
            && (!root.cursor-blink-enabled || root.cursor-blink);
        background: root.view.foreground;
        Text {
            y: (parent.height - root.font-cell-height) / 2;
            width: parent.width;
            height: root.font-cell-height;
            text: root.view.cursor_text;
            color: root.view.background;
            font-family: root.view.font_family;
            font-size: root.view.font_size;
            letter-spacing: 0px;
            horizontal-alignment: root.view.cursor_cells > 1 ? center : left;
            vertical-alignment: center;
            overflow: clip;
        }
    }

    preedit-overlay := Rectangle {
        x: max(0px, min(parent.width - root.cell-width,
            root.cursor-x));
        y: root.cursor-y;
        width: self.visible
            ? min(parent.width - self.x,
                max(root.cell-width, preedit-value.preferred-width))
            : 0px;
        height: root.cell-height;
        visible: root.view.connected && root.view.cursor_visible
            && root.preedit-text != "";
        background: root.view.background;

        preedit-value := Text {
            y: (parent.height - root.font-cell-height) / 2;
            width: parent.width;
            height: root.font-cell-height;
            text: root.preedit-text;
            color: root.view.foreground;
            font-family: root.view.font_family;
            font-size: root.view.font_size;
            letter-spacing: 0px;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: clip;
        }
        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: Theme.hairline;
            background: root.view.foreground;
        }
    }

    body-touch := TouchArea {
        mouse-cursor: root.target-highlight.active ? pointer : text;
        changed has-hover => { root.pointer-hovered(self.has-hover); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                let row = max(0, min(root.view.row_count - 1,
                    floor((self.mouse-y - root.top-offset) / root.cell-height)));
                let column = max(0, min(root.view.content_columns - 1,
                    floor(self.mouse-x / root.cell-width)));
                let boundary-column = max(0, min(root.view.content_columns,
                    round(self.mouse-x / root.cell-width)));
                if event.button == PointerEventButton.left {
                    root.click-pressed = true;
                    if root.click-sequence > 0
                        && (root.click-cell-row != row
                            || root.click-cell-column != column
                            || root.click-boundary-column != boundary-column) {
                        root.click-sequence = 0;
                        root.click-timeout-ticks = 0;
                    }
                    root.click-cell-row = row;
                    root.click-cell-column = column;
                    root.click-boundary-column = boundary-column;
                } else {
                    root.click-sequence = 0;
                    root.click-timeout-ticks = 0;
                }
                if event.button == PointerEventButton.right
                    && root.view.mouse_button_reporting
                    && !root.right-click-pastes
                    && (event.modifiers.shift
                        || (root.mouse-local-selection-priority && !event.modifiers.alt)) {
                    terminal-context-menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
                root.pointer-down(
                    row,
                    column,
                    boundary-column,
                    event.button == PointerEventButton.left ? 0
                        : event.button == PointerEventButton.middle ? 1
                        : event.button == PointerEventButton.right ? 2 : 5,
                    event.modifiers.shift,
                    event.modifiers.alt,
                    event.modifiers.control,
                    event.modifiers.meta,
                );
            } else if event.kind == PointerEventKind.up {
                let row = max(0, min(root.view.row_count - 1,
                    floor((self.mouse-y - root.top-offset) / root.cell-height)));
                let column = max(0, min(root.view.content_columns - 1,
                    floor(self.mouse-x / root.cell-width)));
                let boundary-column = max(0, min(root.view.content_columns,
                    round(self.mouse-x / root.cell-width)));
                root.pointer-up(
                    row,
                    column,
                    boundary-column,
                    event.button == PointerEventButton.left ? 0
                    : event.button == PointerEventButton.middle ? 1
                    : event.button == PointerEventButton.right ? 2 : 5,
                    event.modifiers.shift,
                    event.modifiers.alt,
                    event.modifiers.control);
                if event.button == PointerEventButton.left {
                    root.click-pressed = false;
                }
            } else if event.kind == PointerEventKind.move {
                let row = max(0, min(root.view.row_count - 1,
                    floor((self.mouse-y - root.top-offset) / root.cell-height)));
                let column = max(0, min(root.view.content_columns - 1,
                    floor(self.mouse-x / root.cell-width)));
                let boundary-column = max(0, min(root.view.content_columns,
                    round(self.mouse-x / root.cell-width)));
                if root.click-pressed
                    && (root.click-cell-row != row
                        || root.click-cell-column != column
                        || root.click-boundary-column != boundary-column) {
                    root.click-sequence = 0;
                    root.click-timeout-ticks = 0;
                }
                root.pointer-moved(
                    row,
                    column,
                    boundary-column,
                    event.modifiers.shift,
                    event.modifiers.alt,
                    event.modifiers.control,
                    event.modifiers.meta,
                );
            } else if event.kind == PointerEventKind.cancel {
                root.click-pressed = false;
                root.click-sequence = 0;
                root.click-timeout-ticks = 0;
                root.pointer-cancel();
            }
        }
        clicked => {
            // Slint emits clicked before double-clicked, so the third click
            // can replace the ordinary selection with a logical line range.
            root.click-sequence = root.click-sequence >= 3
                ? 4 : root.click-sequence + 1;
            root.click-timeout-ticks = 5;
            if root.click-sequence == 3 {
                root.line-selection-request(root.click-cell-row, root.click-cell-column);
            }
        }
        double-clicked => {
            if root.click-sequence == 2 {
                root.semantic-selection-request(
                    max(0, min(root.view.row_count - 1,
                        floor((self.mouse-y - root.top-offset) / root.cell-height))),
                    max(0, min(root.view.content_columns - 1,
                        floor(self.mouse-x / root.cell-width))),
                );
            }
        }
        scroll-event(event) => {
            if event.delta-y == 0px {
                return EventResult.reject;
            }
            root.scroll-accumulator-y += event.delta-y;
            let lines = round(root.scroll-accumulator-y / max(1px, root.cell-height));
            if lines == 0 {
                return EventResult.accept;
            }
            root.scroll-accumulator-y -= lines * root.cell-height;
            root.scrolled(
                max(0, min(root.view.row_count - 1,
                    floor((self.mouse-y - root.top-offset) / root.cell-height))),
                max(0, min(root.view.content_columns - 1,
                    floor(self.mouse-x / root.cell-width))),
                lines,
                event.modifiers.shift, event.modifiers.alt, event.modifiers.control);
            accept
        }
    }

    // Match Slint's 500ms platform double-click interval without exposing a
    // framework-specific click counter to the rest of the selection chain.
    Timer {
        running: root.click-timeout-ticks > 0;
        interval: 100ms;
        triggered => {
            if root.click-timeout-ticks <= 1 {
                root.click-timeout-ticks = 0;
                root.click-sequence = 0;
            } else {
                root.click-timeout-ticks -= 1;
            }
        }
    }

    terminal-context-menu := ContextMenuArea {
        width: root.view.mouse_button_reporting ? 0px : parent.width;
        height: root.view.mouse_button_reporting ? 0px : parent.height;
        enabled: !root.right-click-pastes;
        Menu {
            MenuItem {
                title: @tr("Copy");
                enabled: root.selection.active;
                activated => { root.copy-request(); }
            }
            MenuItem {
                title: @tr("Paste");
                enabled: root.view.connected;
                activated => { root.paste-request(); }
            }
            MenuItem {
                title: @tr("Select All");
                enabled: root.view.row_count > 0;
                activated => { root.select-all-request(); }
            }
        }
    }
}
