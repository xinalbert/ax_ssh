import { Theme } from "../theme.slint";

// A password-only input keeps the value out of accessibility and clipboard paths.
export component SecretTextInput inherits FocusScope {
    in-out property <string> text;
    in property <string> placeholder-text;
    out property <bool> has-input-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);

    min-height: root.visible ? Theme.settings-control-height : 0px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    forward-focus: input;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-placeholder-text: root.placeholder-text;
    accessible-read-only: false;
    accessible-action-set-value(value) => {
        if root.enabled {
            root.text = value;
            root.edited(value);
        }
    }

    public function clear() {
        root.text = "";
    }

    surface := Rectangle {
        background: !root.enabled
            ? Theme.hover
            : (root.has-input-focus ? Theme.hover : Theme.panel);
        border-width: Theme.hairline;
        border-color: root.has-input-focus ? Theme.focus : Theme.control-border;
        border-radius: Theme.radius-small;
        clip: true;
        opacity: root.enabled ? 1 : Theme.combo-box-disabled-opacity;

        placeholder := Text {
            x: Theme.combo-box-horizontal-padding;
            width: parent.width - 2 * Theme.combo-box-horizontal-padding;
            height: parent.height;
            text: root.text.is-empty && input.preedit-text.is-empty
                ? root.placeholder-text
                : "";
            color: Theme.muted;
            font-size: Theme.font-body;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        input := TextInput {
            private property <length> computed-x: Theme.combo-box-horizontal-padding;

            x: min(
                Theme.combo-box-horizontal-padding,
                max(
                    parent.width
                        - Theme.combo-box-horizontal-padding
                        - self.width
                        - self.text-cursor-width,
                    self.computed-x,
                ),
            );
            width: max(
                parent.width - 2 * Theme.combo-box-horizontal-padding - self.text-cursor-width,
                self.preferred-width,
            );
            height: parent.height;
            text <=> root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            input-type: InputType.password;
            horizontal-alignment: left;
            vertical-alignment: center;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
            enabled: root.enabled;
            accessible-role: none;

            cursor-position-changed(position) => {
                if position.x + self.computed-x < Theme.combo-box-horizontal-padding {
                    self.computed-x = Theme.combo-box-horizontal-padding - position.x;
                } else if position.x + self.computed-x
                        > parent.width - Theme.combo-box-horizontal-padding - self.text-cursor-width {
                    self.computed-x = parent.width
                        - Theme.combo-box-horizontal-padding
                        - self.text-cursor-width
                        - position.x;
                }
            }

            key-pressed(event) => {
                // Run before TextInput's standard clipboard shortcuts.
                if (event.modifiers.control || event.modifiers.meta)
                        && (event.text == "a" || event.text == "A" || event.text == "c" || event.text == "C" || event.text == "x" || event.text == "X") {
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            accepted => { root.accepted(root.text); }
            edited => { root.edited(root.text); }
        }

        // Keep mouse selection out of the platform selection clipboard.
        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }
    }
}
