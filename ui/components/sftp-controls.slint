import { Theme } from "../theme.slint";
import { ElidedLabel, ElidedTooltipContent } from "elided-controls.slint";

export component SftpActionButton inherits FocusScope {
    in property <string> text;
    in property <string> tooltip-text;
    in property <string> accessible-name: root.text;
    in property <image> icon;
    in property <bool> show-icon: false;
    in property <bool> icon-only: false;
    in property <bool> subtle: false;
    in property <bool> prominent: false;
    in property <bool> active: false;
    in property <length> font-size: Theme.sftp-control-font-size;
    in property <int> font-weight: Theme.sftp-control-font-weight;
    callback clicked();
    callback context-requested(Point);

    private property <length> text-height: label.line-height;
    // Keep enough room for the measured label and both horizontal insets.
    // Callers may still provide a larger width for stable toolbar geometry.
    private property <length> natural-width: max(
        Theme.sftp-control-min-width,
        root.icon-only ? Theme.sftp-nav-icon-button-width
            : label.natural-width + 2 * Theme.space-md
                + (root.show-icon ? Theme.sftp-control-icon-size + Theme.space-sm : 0px),
    );
    out property <length> control-height: max(
        Theme.sftp-control-min-height,
        root.text-height + 2 * Theme.sftp-control-padding-y,
    );

    height: root.control-height;
    min-width: root.natural-width;
    preferred-width: root.natural-width;
    horizontal-stretch: 0;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    key-pressed(event) => {
        if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
            root.context-requested({ x: 0px, y: root.height });
            return EventResult.accept;
        }
        if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
            root.clicked();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        border-width: root.has-focus
            ? Theme.hairline
            : (root.active || !root.subtle ? Theme.hairline : 0px);
        border-color: root.has-focus
            ? Theme.focus
            : (root.active ? Theme.accent.with-alpha(0.72) : Theme.control-border);
        border-radius: Theme.radius-small;
        background: !root.enabled
            ? Theme.hover
            : (root.prominent
                ? (touch.has-hover || root.has-focus ? Theme.accent : Theme.accent.with-alpha(0.86))
                : (root.active
                    ? (touch.has-hover || root.has-focus
                        ? Theme.accent.with-alpha(0.28)
                        : Theme.accent.with-alpha(0.16))
                    : (touch.has-hover || root.has-focus ? Theme.hover : (root.subtle ? transparent : Theme.panel-alt))));
        opacity: root.enabled ? 1 : Theme.combo-box-disabled-opacity;

        label := ElidedLabel {
            visible: !root.icon-only;
            x: Theme.space-md + (root.show-icon ? Theme.sftp-control-icon-size + Theme.space-sm : 0px);
            width: max(0px, parent.width - self.x - Theme.space-md);
            height: parent.height;
            text: root.text;
            tooltip-text: root.tooltip-text;
            text-color: !root.enabled ? Theme.muted : root.prominent
                ? Theme.background
                : (root.active ? Theme.accent : Theme.text);
            font-size: root.font-size;
            font-weight: root.font-weight;
            horizontal-alignment: TextHorizontalAlignment.center;
        }
        Image {
            visible: root.show-icon;
            x: root.icon-only ? (parent.width - self.width) / 2 : Theme.space-md;
            y: (parent.height - self.height) / 2;
            width: Theme.sftp-control-icon-size;
            height: Theme.sftp-control-icon-size;
            source: root.icon;
            image-fit: contain;
            colorize: !root.enabled ? Theme.muted : (root.prominent ? Theme.background : Theme.text);
        }
        touch := TouchArea {
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.context-requested({ x: self.mouse-x, y: self.mouse-y });
                }
            }
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.clicked(); }
        }
        if root.icon-only : Tooltip {
            ElidedTooltipContent {
                text: root.tooltip-text.is-empty ? root.accessible-name : root.tooltip-text;
            }
        }
    }
}
export component SftpIconButton inherits SftpActionButton {
    show-icon: true;
    icon-only: true;
    subtle: true;
    width: Theme.sftp-nav-icon-button-width;
}

export component SftpPathCopyButton inherits SftpIconButton {
    accessible-name: @tr("Copy current path");
    icon: @image-url("../icons/sftp-copy.svg");
}
