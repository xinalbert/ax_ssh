import { Theme } from "../theme.slint";
import { ElidedLabel } from "elided-controls.slint";

export component SftpActionButton inherits FocusScope {
    in property <string> text;
    in property <string> tooltip-text;
    in property <string> accessible-name: root.text;
    in property <bool> subtle: false;
    in property <bool> prominent: false;
    in property <bool> active: false;
    in property <length> font-size: Theme.sftp-control-font-size;
    in property <int> font-weight: Theme.sftp-control-font-weight;
    callback clicked();

    private property <length> text-height: label.line-height;
    // Keep enough room for the measured label and both horizontal insets.
    // Callers may still provide a larger width for stable toolbar geometry.
    private property <length> natural-width: max(
        Theme.sftp-control-min-width,
        label.natural-width + 2 * Theme.space-md,
    );
    out property <length> control-height: max(
        Theme.sftp-control-min-height,
        root.text-height + 2 * Theme.sftp-control-padding-y,
    );

    height: root.control-height;
    min-width: root.natural-width;
    preferred-width: root.natural-width;
    horizontal-stretch: 0;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    key-pressed(event) => {
        if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
            root.clicked();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        border-width: root.has-focus
            ? Theme.hairline
            : (root.active || !root.subtle ? Theme.hairline : 0px);
        border-color: root.has-focus
            ? Theme.focus
            : (root.active ? Theme.accent.with-alpha(0.72) : Theme.control-border);
        border-radius: Theme.radius-small;
        background: !root.enabled
            ? Theme.hover
            : (root.prominent
                ? (touch.has-hover || root.has-focus ? Theme.accent : Theme.accent.with-alpha(0.86))
                : (root.active
                    ? (touch.has-hover || root.has-focus
                        ? Theme.accent.with-alpha(0.28)
                        : Theme.accent.with-alpha(0.16))
                    : (touch.has-hover || root.has-focus ? Theme.hover : (root.subtle ? transparent : Theme.panel-alt))));
        opacity: root.enabled ? 1 : Theme.combo-box-disabled-opacity;

        label := ElidedLabel {
            x: Theme.space-md;
            width: parent.width - 2 * Theme.space-md;
            height: parent.height;
            text: root.text;
            tooltip-text: root.tooltip-text;
            text-color: root.prominent
                ? Theme.background
                : (root.active ? Theme.accent : Theme.text);
            font-size: root.font-size;
            font-weight: root.font-weight;
            horizontal-alignment: TextHorizontalAlignment.center;
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.clicked(); }
        }
    }
}
