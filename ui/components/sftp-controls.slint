import { Theme } from "../theme.slint";
import { ActionButtonSurface, ElidedLabel, ElidedTooltipContent } from "elided-controls.slint";

export component SftpActionButton inherits FocusScope {
    in property <string> text;
    in property <string> tooltip-text;
    in property <string> accessible-name: root.text;
    in property <image> icon;
    in property <bool> show-icon: false;
    in property <bool> icon-only: false;
    in property <bool> subtle: false;
    in property <bool> prominent: false;
    in property <bool> active: false;
    in property <length> font-size: Theme.sftp-control-font-size;
    in property <int> font-weight: Theme.sftp-control-font-weight;
    callback clicked();
    callback context-requested(Point);

    private property <length> text-height: label.line-height;
    // Keep enough room for the measured label and both horizontal insets.
    // Callers may still provide a larger width for stable toolbar geometry.
    private property <length> natural-width: max(
        Theme.sftp-control-min-width,
        root.icon-only ? Theme.sftp-nav-icon-button-width
            : label.natural-width + 2 * Theme.action-button-padding-x
                + (root.show-icon ? Theme.sftp-control-icon-size + Theme.space-sm : 0px),
    );
    out property <length> control-height: max(
        Theme.sftp-control-min-height,
        root.text-height + 2 * Theme.sftp-control-padding-y,
    );
    private property <length> icon-slot-width: root.show-icon && !root.icon-only
        ? Theme.sftp-control-icon-size + Theme.space-sm : 0px;
    private property <length> content-width: min(
        max(0px, root.width - 2 * Theme.action-button-padding-x),
        root.icon-slot-width + label.natural-width,
    );

    height: root.control-height;
    min-width: root.natural-width;
    preferred-width: root.natural-width;
    horizontal-stretch: 0;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    key-pressed(event) => {
        if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
            root.context-requested({ x: 0px, y: root.height });
            return EventResult.accept;
        }
        if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
            root.clicked();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    surface := ActionButtonSurface {
        enabled: root.enabled;
        hovered: touch.has-hover;
        pressed: touch.pressed;
        focused: root.has-focus;
        primary: root.prominent;
        active: root.active;
        subtle: root.subtle;

        label := ElidedLabel {
            visible: !root.icon-only;
            x: (parent.width - root.content-width) / 2 + root.icon-slot-width;
            width: max(0px, root.content-width - root.icon-slot-width);
            height: parent.height;
            text: root.text;
            tooltip-text: root.tooltip-text;
            text-color: surface.foreground;
            font-size: root.font-size;
            font-weight: root.font-weight;
            horizontal-alignment: TextHorizontalAlignment.center;
        }
        Image {
            visible: root.show-icon;
            x: root.icon-only ? (parent.width - self.width) / 2
                : (parent.width - root.content-width) / 2;
            y: (parent.height - self.height) / 2;
            width: Theme.sftp-control-icon-size;
            height: Theme.sftp-control-icon-size;
            source: root.icon;
            image-fit: contain;
            colorize: surface.foreground;
        }
        touch := TouchArea {
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.context-requested({ x: self.mouse-x, y: self.mouse-y });
                }
            }
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.clicked(); }
        }
        if root.icon-only : Tooltip {
            ElidedTooltipContent {
                text: root.tooltip-text.is-empty ? root.accessible-name : root.tooltip-text;
            }
        }
    }
}
export component SftpIconButton inherits SftpActionButton {
    show-icon: true;
    icon-only: true;
    subtle: true;
    width: Theme.sftp-nav-icon-button-width;
}

export component SftpPathCopyButton inherits SftpIconButton {
    accessible-name: @tr("Copy current path");
    icon: @image-url("../icons/sftp-copy.svg");
}
