import { FlatActionMenu, MenuActions } from "flat-action-menu.slint";
import { Theme } from "../theme.slint";
import { ElidedLabel, ElidedTooltipContent } from "elided-controls.slint";
import { SidebarPlatformGlyph } from "sidebar-controls.slint";

component MenuTitleButton inherits FocusScope {
    in property <string> label;
    in property <bool> active;
    callback activated();

    width: Theme.desktop-menu-button-width;
    height: Theme.desktop-titlebar-height;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.label;

    Rectangle {
        background: root.active || touch.has-hover || root.has-focus ? Theme.hover : Theme.panel;
    }

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Text {
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

enum WindowControlIcon {
    Minimize,
    Maximize,
    Restore,
    Close,
    Return,
}

// Fixed path coordinates keep every action independent of the application font.
component WindowControlGlyph inherits Path {
    in property <WindowControlIcon> icon;
    in property <color> glyph-color: Theme.text;

    width: Theme.desktop-window-glyph-size;
    height: Theme.desktop-window-glyph-size;
    viewbox-width: 16;
    viewbox-height: 16;
    commands: root.icon == WindowControlIcon.Minimize ? "M 2 8.5 L 14 8.5"
        : root.icon == WindowControlIcon.Maximize ? "M 2.5 2.5 H 13.5 V 13.5 H 2.5 Z"
        : root.icon == WindowControlIcon.Restore
            ? "M 5.5 5.5 V 2.5 H 13.5 V 10.5 H 10.5 M 2.5 5.5 H 10.5 V 13.5 H 2.5 Z"
        : root.icon == WindowControlIcon.Close ? "M 3 3 L 13 13 M 13 3 L 3 13"
        : "M 13 8 H 3 M 3 8 L 8 3 M 3 8 L 8 13";
    fill: transparent;
    stroke: root.glyph-color;
    stroke-width: Theme.hairline;
    accessible-role: none;
}

component WindowControl inherits FocusScope {
    in property <WindowControlIcon> icon;
    in property <string> label;
    in property <bool> destructive: false;
    callback activated();

    // Reserve the whole hit area even when the titlebar has little free space.
    width: Theme.desktop-window-control-width;
    height: Theme.desktop-titlebar-height;
    horizontal-stretch: 0;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }

    Rectangle {
        background: touch.has-hover || root.has-focus
            ? (root.destructive ? Theme.danger : Theme.panel-alt)
            : Theme.panel;
    }

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    WindowControlGlyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        glyph-color: root.destructive && (touch.has-hover || root.has-focus)
            ? Theme.background : Theme.text;
    }
    if root.has-focus : Rectangle {
        x: Theme.space-xxs;
        y: Theme.space-xxs;
        width: parent.width - 2 * Theme.space-xxs;
        height: parent.height - 2 * Theme.space-xxs;
        background: transparent;
        border-width: Theme.hairline;
        border-color: Theme.focus;
    }
    touch := TouchArea {
        clicked => { root.activated(); }
    }
    Tooltip {
        ElidedTooltipContent { text: root.label; }
    }
}

export component DesktopMenuTitlebar inherits Rectangle {
    in property <bool> main-window;
    in property <string> connection-title;
    in property <string> system-platform;
    in property <string> system-release;
    in property <bool> actions-enabled;
    in property <bool> terminal-active;
    in property <bool> multiple-tabs;
    in property <bool> has-active-tab;
    in property <bool> maximized;
    in property <[string]> recent-paths;
    callback command(string, string);
    callback minimize();
    callback toggle-maximize();
    callback close();
    callback return-workspace();
    callback start-native-window-drag();

    height: Theme.desktop-titlebar-height;
    background: Theme.panel;

    HorizontalLayout {
        spacing: 0px;

        if root.main-window : Rectangle {
            width: Theme.desktop-menu-button-width;
            MenuTitleButton {
                label: @tr("File");
                active: file-menu.is-open;
                activated => {
                    if file-menu.is-open { file-menu.close(); }
                    else { file-menu.show-at({ x: 0px, y: root.height }); }
                }
            }
            file-menu := FlatActionMenu {
                actions: [
                    MenuActions.item("new-session", @tr("New Server"), root.actions-enabled),
                    MenuActions.separator(),
                    MenuActions.item("open-workspace", @tr("Open Workspace"), root.actions-enabled),
                    MenuActions.item("open-recent", @tr("Open Recent"), root.actions-enabled && root.recent-paths.length > 0),
                    MenuActions.item("save-workspace", @tr("Save Workspace"), root.actions-enabled),
                    MenuActions.separator(),
                    MenuActions.item("import-sessions", @tr("Import from Clipboard"), root.actions-enabled),
                    MenuActions.item("export-selected", @tr("Export Selected to Clipboard"), root.actions-enabled),
                ];
                submenu-id: "open-recent";
                submenu-actions: MenuActions.recent-items(root.recent-paths, root.actions-enabled, @tr("Clear Recent"));
                submenu-triggered(action, index) => {
                    if action == "clear-recent-workspaces" {
                        root.command(action, "");
                    } else if index >= 0 && index < root.recent-paths.length {
                        root.command("open-recent-workspace", root.recent-paths[index]);
                    }
                }
                triggered(action) => { root.command(action, ""); }
            }
        }
        if root.main-window : Rectangle {
            width: Theme.desktop-menu-button-width;
            MenuTitleButton {
                label: @tr("Edit");
                active: edit-menu.is-open;
                activated => {
                    if edit-menu.is-open { edit-menu.close(); }
                    else { edit-menu.show-at({ x: 0px, y: root.height }); }
                }
            }
            edit-menu := FlatActionMenu {
                actions: [
                    MenuActions.item("copy-terminal", @tr("Copy"), root.actions-enabled && root.terminal-active),
                    MenuActions.item("paste-terminal", @tr("Paste"), root.actions-enabled && root.terminal-active),
                    MenuActions.separator(),
                    MenuActions.item("select-all-terminal", @tr("Select All"), root.actions-enabled && root.terminal-active),
                    MenuActions.separator(),
                    MenuActions.item("open-settings", @tr("Settings..."), root.actions-enabled),
                ];
                triggered(action) => { root.command(action, ""); }
            }
        }
        if root.main-window : Rectangle {
            width: Theme.desktop-menu-button-width;
            MenuTitleButton {
                label: @tr("View");
                active: view-menu.is-open;
                activated => {
                    if view-menu.is-open { view-menu.close(); }
                    else { view-menu.show-at({ x: 0px, y: root.height }); }
                }
            }
            view-menu := FlatActionMenu {
                actions: [
                    MenuActions.item("toggle-sidebar", @tr("Toggle Session Sidebar"), root.actions-enabled),
                ];
                triggered(action) => { root.command(action, ""); }
            }
        }
        if root.main-window : Rectangle {
            width: Theme.desktop-menu-button-width;
            MenuTitleButton {
                label: @tr("Pane");
                active: pane-menu.is-open;
                activated => {
                    if pane-menu.is-open { pane-menu.close(); }
                    else { pane-menu.show-at({ x: 0px, y: root.height }); }
                }
            }
            pane-menu := FlatActionMenu {
                actions: [
                    MenuActions.item("new-local-shell", @tr("New Local Shell"), root.actions-enabled),
                    MenuActions.item("switch-ssh-sftp", @tr("Switch SSH/SFTP Tab"), root.actions-enabled),
                ];
                triggered(action) => { root.command(action, ""); }
            }
        }
        if root.main-window : Rectangle {
            width: Theme.desktop-menu-button-width;
            MenuTitleButton {
                label: @tr("Window");
                active: window-menu.is-open;
                activated => {
                    if window-menu.is-open { window-menu.close(); }
                    else { window-menu.show-at({ x: 0px, y: root.height }); }
                }
            }
            window-menu := FlatActionMenu {
                actions: [
                    MenuActions.item("previous-tab", @tr("Previous Tab"), root.actions-enabled && root.multiple-tabs),
                    MenuActions.item("next-tab", @tr("Next Tab"), root.actions-enabled && root.multiple-tabs),
                    MenuActions.separator(),
                    MenuActions.item("detach-workspace", @tr("Move Current Workspace to New Window"), root.actions-enabled && root.has-active-tab),
                    MenuActions.separator(),
                    MenuActions.item("close-tab", @tr("Close Current Tab"), root.actions-enabled && root.has-active-tab),
                ];
                triggered(action) => { root.command(action, ""); }
            }
        }
        if root.main-window : Rectangle {
            width: Theme.desktop-menu-button-width;
            MenuTitleButton {
                label: @tr("Help");
                active: help-menu.is-open;
                activated => {
                    if help-menu.is-open { help-menu.close(); }
                    else { help-menu.show-at({ x: 0px, y: root.height }); }
                }
            }
            help-menu := FlatActionMenu {
                actions: [
                    MenuActions.item("open-shortcuts", @tr("Keyboard Shortcuts"), root.actions-enabled),
                    MenuActions.item("open-about", @tr("About AxSSH"), root.actions-enabled),
                ];
                triggered(action) => { root.command(action, ""); }
            }
        }
        if !root.main-window : WindowControl {
            icon: WindowControlIcon.Return;
            label: @tr("Return Workspace to Main Window");
            activated => { root.return-workspace(); }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.panel;
            if !root.main-window : HorizontalLayout {
                accessible-role: text;
                accessible-label: root.connection-title;
                padding-left: Theme.space-xs;
                padding-right: Theme.space-xs;
                spacing: Theme.space-xs;
                Rectangle {
                    width: Theme.tab-platform-icon-size;
                    horizontal-stretch: 0;
                    background: transparent;
                    SidebarPlatformGlyph {
                        y: (parent.height - self.height) / 2;
                        width: Theme.tab-platform-icon-size;
                        height: Theme.tab-platform-icon-size;
                        platform: root.system-platform.is-empty ? "server" : root.system-platform;
                        accessible-role: none;
                    }
                }
                ElidedLabel {
                    text: root.connection-title;
                    tooltip-enabled: false;
                    text-color: Theme.text;
                    font-size: Theme.font-body;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            TouchArea {
                width: parent.width;
                height: parent.height;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down
                            && event.button == PointerEventButton.left {
                        root.start-native-window-drag();
                    }
                }
                double-clicked => { root.toggle-maximize(); }
            }
            if !root.main-window : Tooltip {
                ElidedTooltipContent {
                    text: root.system-release.is-empty ? root.connection-title
                        : root.connection-title + "\n" + root.system-release;
                }
            }
        }
        WindowControl {
            icon: WindowControlIcon.Minimize;
            label: @tr("Minimize Window");
            activated => { root.minimize(); }
        }
        WindowControl {
            icon: root.maximized ? WindowControlIcon.Restore : WindowControlIcon.Maximize;
            label: root.maximized ? @tr("Restore Window") : @tr("Maximize Window");
            activated => { root.toggle-maximize(); }
        }
        WindowControl {
            icon: WindowControlIcon.Close;
            label: @tr("Close Window");
            destructive: true;
            activated => { root.close(); }
        }
    }
}
