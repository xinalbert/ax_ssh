import { Theme } from "../theme.slint";
import { ElidedTooltipContent } from "elided-controls.slint";

component MenuTitleButton inherits FocusScope {
    in property <string> label;
    callback activated();

    width: Theme.desktop-menu-button-width;
    height: Theme.desktop-titlebar-height;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.label;

    Rectangle {
        background: touch.has-hover || root.has-focus ? Theme.panel-alt : Theme.panel;
    }

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Text {
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

enum WindowControlIcon {
    Minimize,
    Maximize,
    Restore,
    Close,
    Return,
}

// Fixed path coordinates keep every action independent of the application font.
component WindowControlGlyph inherits Path {
    in property <WindowControlIcon> icon;
    in property <color> glyph-color: Theme.text;

    width: Theme.desktop-window-glyph-size;
    height: Theme.desktop-window-glyph-size;
    viewbox-width: 16;
    viewbox-height: 16;
    commands: root.icon == WindowControlIcon.Minimize ? "M 2 8.5 L 14 8.5"
        : root.icon == WindowControlIcon.Maximize ? "M 2.5 2.5 H 13.5 V 13.5 H 2.5 Z"
        : root.icon == WindowControlIcon.Restore
            ? "M 5.5 5.5 V 2.5 H 13.5 V 10.5 H 10.5 M 2.5 5.5 H 10.5 V 13.5 H 2.5 Z"
        : root.icon == WindowControlIcon.Close ? "M 3 3 L 13 13 M 13 3 L 3 13"
        : "M 13 8 H 3 M 3 8 L 8 3 M 3 8 L 8 13";
    fill: transparent;
    stroke: root.glyph-color;
    stroke-width: Theme.hairline;
    accessible-role: none;
}

component WindowControl inherits FocusScope {
    in property <WindowControlIcon> icon;
    in property <string> label;
    in property <bool> destructive: false;
    callback activated();

    // Reserve the whole hit area even when the titlebar has little free space.
    width: Theme.desktop-window-control-width;
    height: Theme.desktop-titlebar-height;
    horizontal-stretch: 0;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }

    Rectangle {
        background: touch.has-hover || root.has-focus
            ? (root.destructive ? Theme.danger : Theme.panel-alt)
            : Theme.panel;
    }

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    WindowControlGlyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        glyph-color: root.destructive && (touch.has-hover || root.has-focus)
            ? Theme.background : Theme.text;
    }
    if root.has-focus : Rectangle {
        x: Theme.space-xxs;
        y: Theme.space-xxs;
        width: parent.width - 2 * Theme.space-xxs;
        height: parent.height - 2 * Theme.space-xxs;
        background: transparent;
        border-width: Theme.hairline;
        border-color: Theme.focus;
    }
    touch := TouchArea {
        clicked => { root.activated(); }
    }
    Tooltip {
        ElidedTooltipContent { text: root.label; }
    }
}

export component DesktopMenuTitlebar inherits Rectangle {
    in property <bool> main-window;
    in property <bool> actions-enabled;
    in property <bool> terminal-active;
    in property <bool> multiple-tabs;
    in property <bool> has-active-tab;
    in property <bool> maximized;
    in property <[string]> recent-paths;
    callback command(string, string);
    callback minimize();
    callback toggle-maximize();
    callback close();
    callback return-workspace();
    callback start-native-window-drag();

    height: Theme.desktop-titlebar-height;
    background: Theme.panel;

    HorizontalLayout {
        spacing: 0px;

        if root.main-window : Rectangle {
            width: Theme.desktop-menu-button-width;
            background: Theme.panel;
            trigger := MenuTitleButton {
                label: @tr("File");
                activated => { file-menu.show({ x: 0px, y: root.height }); }
            }
            file-menu := ContextMenuArea {
                Menu {
                    MenuItem {
                        title: @tr("New Server");
                        enabled: root.actions-enabled;
                        activated => { root.command("new-session", ""); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: @tr("Open Workspace");
                        enabled: root.actions-enabled;
                        activated => { root.command("open-workspace", ""); }
                    }
                    Menu {
                        title: @tr("Open Recent");
                        enabled: root.actions-enabled && root.recent-paths.length > 0;
                        for path in root.recent-paths : MenuItem {
                            title: path;
                            enabled: root.actions-enabled;
                            activated => { root.command("open-recent-workspace", path); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Clear Recent");
                            enabled: root.actions-enabled;
                            activated => { root.command("clear-recent-workspaces", ""); }
                        }
                    }
                    MenuItem {
                        title: @tr("Save Workspace");
                        enabled: root.actions-enabled;
                        activated => { root.command("save-workspace", ""); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: @tr("Import from Clipboard");
                        enabled: root.actions-enabled;
                        activated => { root.command("import-sessions", ""); }
                    }
                    MenuItem {
                        title: @tr("Export Selected to Clipboard");
                        enabled: root.actions-enabled;
                        activated => { root.command("export-selected", ""); }
                    }
                }
            }
        }
        if root.main-window : Rectangle {
            width: Theme.desktop-menu-button-width;
            MenuTitleButton {
                label: @tr("Edit");
                activated => { edit-menu.show({ x: 0px, y: root.height }); }
            }
            edit-menu := ContextMenuArea {
                Menu {
                    MenuItem {
                        title: @tr("Copy");
                        enabled: root.actions-enabled && root.terminal-active;
                        activated => { root.command("copy-terminal", ""); }
                    }
                    MenuItem {
                        title: @tr("Paste");
                        enabled: root.actions-enabled && root.terminal-active;
                        activated => { root.command("paste-terminal", ""); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: @tr("Select All");
                        enabled: root.actions-enabled && root.terminal-active;
                        activated => { root.command("select-all-terminal", ""); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: @tr("Settings...");
                        enabled: root.actions-enabled;
                        activated => { root.command("open-settings", ""); }
                    }
                }
            }
        }
        if root.main-window : Rectangle {
            width: Theme.desktop-menu-button-width;
            MenuTitleButton {
                label: @tr("View");
                activated => { view-menu.show({ x: 0px, y: root.height }); }
            }
            view-menu := ContextMenuArea {
                Menu {
                    MenuItem {
                        title: @tr("Toggle Session Sidebar");
                        enabled: root.actions-enabled;
                        activated => { root.command("toggle-sidebar", ""); }
                    }
                }
            }
        }
        if root.main-window : Rectangle {
            width: Theme.desktop-menu-button-width;
            MenuTitleButton {
                label: @tr("Pane");
                activated => { pane-menu.show({ x: 0px, y: root.height }); }
            }
            pane-menu := ContextMenuArea {
                Menu {
                    MenuItem {
                        title: @tr("New Local Shell");
                        enabled: root.actions-enabled;
                        activated => { root.command("new-local-shell", ""); }
                    }
                    MenuItem {
                        title: @tr("Switch SSH/SFTP Tab");
                        enabled: root.actions-enabled;
                        activated => { root.command("switch-ssh-sftp", ""); }
                    }
                }
            }
        }
        if root.main-window : Rectangle {
            width: Theme.desktop-menu-button-width;
            MenuTitleButton {
                label: @tr("Window");
                activated => { window-menu.show({ x: 0px, y: root.height }); }
            }
            window-menu := ContextMenuArea {
                Menu {
                    MenuItem {
                        title: @tr("Previous Tab");
                        enabled: root.actions-enabled && root.multiple-tabs;
                        activated => { root.command("previous-tab", ""); }
                    }
                    MenuItem {
                        title: @tr("Next Tab");
                        enabled: root.actions-enabled && root.multiple-tabs;
                        activated => { root.command("next-tab", ""); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: @tr("Move Current Workspace to New Window");
                        enabled: root.actions-enabled && root.has-active-tab;
                        activated => { root.command("detach-workspace", ""); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: @tr("Close Current Tab");
                        enabled: root.actions-enabled && root.has-active-tab;
                        activated => { root.command("close-tab", ""); }
                    }
                }
            }
        }
        if root.main-window : Rectangle {
            width: Theme.desktop-menu-button-width;
            MenuTitleButton {
                label: @tr("Help");
                activated => { help-menu.show({ x: 0px, y: root.height }); }
            }
            help-menu := ContextMenuArea {
                Menu {
                    MenuItem {
                        title: @tr("Keyboard Shortcuts");
                        enabled: root.actions-enabled;
                        activated => { root.command("open-shortcuts", ""); }
                    }
                    MenuItem {
                        title: @tr("About AxSSH");
                        enabled: root.actions-enabled;
                        activated => { root.command("open-about", ""); }
                    }
                }
            }
        }
        if !root.main-window : WindowControl {
            icon: WindowControlIcon.Return;
            label: @tr("Return Workspace to Main Window");
            activated => { root.return-workspace(); }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.panel;
            TouchArea {
                width: parent.width;
                height: parent.height;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down
                            && event.button == PointerEventButton.left {
                        root.start-native-window-drag();
                    }
                }
                double-clicked => { root.toggle-maximize(); }
            }
        }
        WindowControl {
            icon: WindowControlIcon.Minimize;
            label: @tr("Minimize Window");
            activated => { root.minimize(); }
        }
        WindowControl {
            icon: root.maximized ? WindowControlIcon.Restore : WindowControlIcon.Maximize;
            label: root.maximized ? @tr("Restore Window") : @tr("Maximize Window");
            activated => { root.toggle-maximize(); }
        }
        WindowControl {
            icon: WindowControlIcon.Close;
            label: @tr("Close Window");
            destructive: true;
            activated => { root.close(); }
        }
    }
}
