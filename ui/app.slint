            credential_storage: root.credential-storage, sidebar_width: root.sidebar-width,
            tab_width: root.tab-width, session_mask_character: root.session-mask-character,
            collapsed_group_label_chars: root.collapsed-group-label-chars,
            open_settings_shortcut: root.open-settings-shortcut,
            new_session_shortcut: root.new-session-shortcut,
            import_sessions_shortcut: root.import-sessions-shortcut,
            export_selected_shortcut: root.export-selected-shortcut,
            toggle_sidebar_shortcut: root.toggle-sidebar-shortcut,
            copy_selection_shortcut: root.copy-selection-shortcut, paste_shortcut: root.paste-shortcut,
            open_sftp_shortcut: root.open-sftp-shortcut,
            default_open_settings_shortcut: root.default-open-settings-shortcut,
            default_new_session_shortcut: root.default-new-session-shortcut,
            default_import_sessions_shortcut: root.default-import-sessions-shortcut,
            default_export_selected_shortcut: root.default-export-selected-shortcut,
            default_toggle_sidebar_shortcut: root.default-toggle-sidebar-shortcut,
            default_copy_selection_shortcut: root.default-copy-selection-shortcut,
            default_paste_shortcut: root.default-paste-shortcut,
            default_open_sftp_shortcut: root.default-open-sftp-shortcut,
            app_version: root.app-version, status: root.status,
        },
        session_editor: {
            draft_id: root.editor-draft-id, profile_id: root.editor-profile-id, name: root.editor-name,
            group_name: root.editor-group-name, protocol: root.editor-protocol,
            host: root.editor-host, port: root.editor-port,
            username: root.editor-username, auth_method: root.editor-auth-method,
            private_key_path: root.editor-private-key-path, x11_forwarding: root.editor-x11-forwarding,
