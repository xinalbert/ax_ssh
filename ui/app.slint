import "../assets/fonts/JetBrainsMono-Regular.ttf";
import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
import { TerminalPane, TerminalRenderLine } from "terminal-pane.slint";
import { SettingsPane } from "settings.slint";
import { SessionEditorPane } from "session-editor.slint";
import { SessionNavigation, SessionRow } from "components/session-navigation.slint";
import { AuthenticationDialog, HostKeyDialog } from "components/security-dialogs.slint";
import {
    ConnectableSessionRow,
    ConnectionPicker,
    WorkspaceTitlebar,
    WorkspaceTabRow,
} from "components/workspace-titlebar.slint";

export component AppWindow inherits Window {
    title: "AxSSH";
    min-width: Theme.window-min-width;
    min-height: Theme.window-min-height;
    preferred-width: Theme.window-preferred-width;
    preferred-height: Theme.window-preferred-height;
    background: Theme.background;
    private property <ColorScheme> standard-widget-color-scheme: Theme.widget-color-scheme;

    in property <[SessionRow]> sessions;
    in property <[WorkspaceTabRow]> workspace-tabs;
    in property <[ConnectableSessionRow]> connection-options;
    in property <[string]> group-options;
    in property <[string]> private-key-options;
    in property <[string]> local-shell-options;
    in property <string> status: "";
    in property <string> active-tab-id: "";
    in property <string> active-tab-kind: "empty";
    in property <string> active-tab-title: "Workspace";
    in property <string> active-tab-status: "";
    in property <bool> host-key-dialog-open: false;
    in property <string> host-key-endpoint: "";
    in property <string> host-key-fingerprint: "";
    in property <bool> host-key-changed: false;
    in property <bool> password-dialog-open: false;
    in property <string> password-endpoint: "";
    in property <bool> password-remember-default: false;
    in property <bool> password-private-key: false;
    in property <string> password-key-path: "";
    in property <bool> worker-running: false;
    in property <bool> connected: false;
    in property <[TerminalRenderLine]> terminal-render-lines;
    in property <int> terminal-content-columns: 0;
    in property <int> terminal-cursor-row: 0;
    in property <int> terminal-cursor-column: 0;
    in property <bool> terminal-cursor-visible: false;
    in property <string> terminal-cursor-text: " ";
    in property <string> terminal-font-family: "JetBrains Mono";
    in property <int> terminal-font-size: 14;
    in property <int> terminal-line-height-percent: 120;
    out property <string> terminal-color-scheme: Theme.terminal-color-scheme;
    in property <int> terminal-brightness-percent: 100;
    in property <bool> bright-bold-text: true;
    in property <bool> right-click-copy-or-paste: false;
    in property <color> terminal-render-foreground: Theme.terminal-foreground;
    in property <color> terminal-render-background: Theme.terminal-background;
    in property <color> terminal-render-selection-background: Theme.terminal-selection;
    out property <color> terminal-foreground: terminal-render-foreground;
    out property <color> terminal-background: terminal-render-background;
    out property <color> terminal-selection-background: terminal-render-selection-background;
    out property <color> theme-terminal-foreground: Theme.terminal-foreground;
    out property <color> theme-terminal-background: Theme.terminal-background;
    out property <color> theme-terminal-selection: Theme.terminal-selection;
    in property <int> theme-revision: 0;
    in property <string> theme-mode: "dark";
    in property <string> theme-palette: "axssh";
    in property <string> theme-light-background: "#F7F8F7";
    in property <string> theme-light-panel: "#FFFFFF";
    in property <string> theme-light-panel-alt: "#EDF1EE";
    in property <string> theme-light-border: "#6D7972";
    in property <string> theme-light-text: "#1C2520";
    in property <string> theme-light-muted: "#526058";
    in property <string> theme-light-accent: "#116B54";
    in property <string> theme-light-success: "#126A43";
    in property <string> theme-light-danger: "#A72C28";
    in property <string> theme-light-overlay: "#10201899";
    in property <string> theme-light-terminal-foreground: "#333333";
    in property <string> theme-light-terminal-background: "#FFFFFF";
    in property <string> theme-light-terminal-selection: "#ADD6FF";
    in property <string> theme-dark-background: "#171918";
    in property <string> theme-dark-panel: "#202321";
    in property <string> theme-dark-panel-alt: "#292D2A";
    in property <string> theme-dark-border: "#727C76";
    in property <string> theme-dark-text: "#EDF1EE";
    in property <string> theme-dark-muted: "#A8B2AC";
    in property <string> theme-dark-accent: "#52C7A5";
    in property <string> theme-dark-success: "#63D6A9";
    in property <string> theme-dark-danger: "#FF8E88";
    in property <string> theme-dark-overlay: "#00000099";
    in property <string> theme-dark-terminal-foreground: "#CCCCCC";
    in property <string> theme-dark-terminal-background: "#1E1E1E";
    in property <string> theme-dark-terminal-selection: "#264F78";
    in property <int> scrollback-lines: 2000;
    in property <int> default-terminal-columns: 120;
    in property <int> default-terminal-rows: 36;
    in property <string> local-shell: "System default";
    in property <int> local-shell-index: 0;
    in property <int> sidebar-width: 220;
    in property <int> tab-width: 172;
    in property <string> session-mask-character: "*";
    in property <string> open-settings-shortcut;
    in property <string> toggle-sidebar-shortcut;
    in property <string> copy-selection-shortcut;
    in property <string> paste-shortcut;
    in property <string> default-open-settings-shortcut;
    in property <string> default-toggle-sidebar-shortcut;
    in property <string> default-copy-selection-shortcut;
    in property <string> default-paste-shortcut;
    in property <bool> apple-platform: false;
    in property <string> app-version;

    private property <bool> sidebar-collapsed: false;
    private property <bool> connection-picker-open: false;
    in-out property <string> settings-section: "General";
    private property <bool> shortcut-recording: false;

    callback new-session();
    callback open-local-shell();
    callback open-settings();
    callback activate-tab(string);
    callback close-tab(string);
    callback move-tab(string, int);
    callback save-settings(
        string, int, int, int, bool, string, string,
        string, string, string, string, string, string, string, string, string, string, string, string, string,
        string, string, string, string, string, string, string, string, string, string, string, string, string,
        bool, string, int, int, int, int, int, string, string, string, string, string,
    );
    callback cancel-settings();
    callback connect-session(string);
    callback toggle-group(string);
    callback save-session(string, string, string, string, string, string, string, string, bool);
    callback cancel-session-dialog();
    callback confirm-host-key();
    callback reject-host-key();
    callback authenticate-session(string, bool);
    callback cancel-password-dialog();
    callback disconnect-session();
    callback terminal-key(string, bool, bool, bool, bool) -> bool;
    callback resize-terminal(int, int);
    callback scroll-terminal(int);
    callback terminal-selection-text(int, int, int, int) -> string;
    callback format-shortcut(string, bool, bool, bool, bool) -> string;
    callback write-clipboard(string);
    callback read-clipboard() -> string;
    callback refresh-terminal-appearance();

    init => { Palette.color-scheme = root.standard-widget-color-scheme; }
    changed standard-widget-color-scheme => {
        Palette.color-scheme = root.standard-widget-color-scheme;
    }
    changed terminal-color-scheme => { root.refresh-terminal-appearance(); }
    changed theme-revision => { root.refresh-terminal-appearance(); }

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "New Session";
                activated => { root.new-session(); }
            }
        }
        Menu {
            title: "Edit";
            MenuItem {
                title: "Undo";
                enabled: false;
            }
            if !root.apple-platform : MenuItem {
                title: "Settings...";
                activated => {
                    root.settings-section = "General";
                    root.open-settings();
                }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Toggle Session Sidebar";
                activated => { root.sidebar-collapsed = !root.sidebar-collapsed; }
            }
        }
        Menu {
            title: "Pane";
            MenuItem {
                title: "New Local Shell";
                activated => { root.open-local-shell(); }
            }
        }
        Menu {
            title: "Window";
            if root.apple-platform : MenuItem {
                title: "Close Current Tab";
                activated => { root.close-tab(root.active-tab-id); }
            }
            if !root.apple-platform : MenuItem {
                title: "Close Current Tab";
                enabled: !root.active-tab-id.is-empty;
                activated => { root.close-tab(root.active-tab-id); }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "Keyboard Shortcuts";
                activated => {
                    root.settings-section = "Shortcuts";
                    root.open-settings();
                }
            }
            if !root.apple-platform : MenuItem {
                title: "About AxSSH";
                activated => {
                    root.settings-section = "About";
                    root.open-settings();
                }
            }
        }
    }

    shortcut-scope := FocusScope {
        capture-key-pressed(event) => {
            if root.shortcut-recording || root.host-key-dialog-open || root.password-dialog-open {
                return EventResult.reject;
            }
            if root.connection-picker-open && event.text == Key.Escape {
                root.connection-picker-open = false;
                return EventResult.accept;
            }
            // Slint swaps Command and Control on Apple platforms for Qt compatibility.
            let physical-control = root.apple-platform
                ? event.modifiers.meta : event.modifiers.control;
            let physical-meta = root.apple-platform
                ? event.modifiers.control : event.modifiers.meta;
            if root.active-tab-kind == "terminal"
                    && physical-control
                    && !physical-meta {
                return EventResult.reject;
            }
            if root.format-shortcut(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
            ) == root.open-settings-shortcut {
                root.settings-section = "General";
                root.open-settings();
                return EventResult.accept;
            }
            if root.format-shortcut(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
            ) == root.toggle-sidebar-shortcut {
                root.sidebar-collapsed = !root.sidebar-collapsed;
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        HorizontalLayout {
            spacing: 0px;

            SessionNavigation {
                sessions: root.sessions;
                sidebar-width: root.sidebar-width;
                collapsed <=> root.sidebar-collapsed;
                open-local-shell => { root.open-local-shell(); }
                new-session => { root.new-session(); }
                connect-session(id) => { root.connect-session(id); }
                toggle-group(group-name) => { root.toggle-group(group-name); }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                WorkspaceTitlebar {
                    tabs: root.workspace-tabs;
                    active-tab-id: root.active-tab-id;
                    tab-width: root.tab-width;
                    terminal-background: root.terminal-background;
                    connection-picker-open: root.connection-picker-open;
                    activate-tab(id) => {
                        root.connection-picker-open = false;
                        root.activate-tab(id);
                    }
                    close-tab(id) => {
                        root.connection-picker-open = false;
                        root.close-tab(id);
                    }
                    move-tab(id, target-index) => {
                        root.connection-picker-open = false;
                        root.move-tab(id, target-index);
                    }
                    toggle-connection-picker => {
                        root.connection-picker-open = !root.connection-picker-open;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.background;

                if root.active-tab-kind == "terminal" : terminal-pane := TerminalPane {
                    connected: root.connected;
                    terminal-id: root.active-tab-id;
                    render-lines: root.terminal-render-lines;
                    content-columns: root.terminal-content-columns;
                    cursor-row: root.terminal-cursor-row;
                    cursor-column: root.terminal-cursor-column;
                    cursor-visible: root.terminal-cursor-visible;
                    cursor-text: root.terminal-cursor-text;
                    terminal-font-family: root.terminal-font-family;
                    terminal-font-size: root.terminal-font-size * 1px;
                    terminal-line-height-percent: root.terminal-line-height-percent;
                    terminal-foreground: root.terminal-foreground;
                    terminal-background: root.terminal-background;
                    terminal-selection-background: root.terminal-selection-background;
                    right-click-copy-or-paste: root.right-click-copy-or-paste;
                    copy-selection-shortcut: root.copy-selection-shortcut;
                    paste-shortcut: root.paste-shortcut;
                    format-shortcut(text, alt, control, meta, shift) => {
                        return root.format-shortcut(text, alt, control, meta, shift);
                    }
                    terminal-key(text, alt, control, meta, shift) => {
                        return root.terminal-key(text, alt, control, meta, shift);
                    }
                    resized(columns, rows) => { root.resize-terminal(columns, rows); }
                    scrolled(lines) => { root.scroll-terminal(lines); }
                    selection-text(anchor-row, anchor-column, focus-row, focus-column) => {
                        return root.terminal-selection-text(
                            anchor-row, anchor-column, focus-row, focus-column,
                        );
                    }
                    write-clipboard(text) => { root.write-clipboard(text); }
                    read-clipboard() => { return root.read-clipboard(); }
                }

                if root.active-tab-kind == "settings" : SettingsPane {
                    selected-section <=> root.settings-section;
                    app-version: root.app-version;
                    local-shell-options: root.local-shell-options;
                    terminal-font-family: root.terminal-font-family;
                    terminal-font-size: root.terminal-font-size;
                    terminal-line-height-percent: root.terminal-line-height-percent;
                    terminal-brightness-percent: root.terminal-brightness-percent;
                    bright-bold-text: root.bright-bold-text;
                    theme-mode: root.theme-mode;
                    theme-palette: root.theme-palette;
                    theme-light-background: root.theme-light-background;
                    theme-light-panel: root.theme-light-panel;
                    theme-light-panel-alt: root.theme-light-panel-alt;
                    theme-light-border: root.theme-light-border;
                    theme-light-text: root.theme-light-text;
                    theme-light-muted: root.theme-light-muted;
                    theme-light-accent: root.theme-light-accent;
                    theme-light-success: root.theme-light-success;
                    theme-light-danger: root.theme-light-danger;
                    theme-light-overlay: root.theme-light-overlay;
                    theme-light-terminal-foreground: root.theme-light-terminal-foreground;
                    theme-light-terminal-background: root.theme-light-terminal-background;
                    theme-light-terminal-selection: root.theme-light-terminal-selection;
                    theme-dark-background: root.theme-dark-background;
                    theme-dark-panel: root.theme-dark-panel;
                    theme-dark-panel-alt: root.theme-dark-panel-alt;
                    theme-dark-border: root.theme-dark-border;
                    theme-dark-text: root.theme-dark-text;
                    theme-dark-muted: root.theme-dark-muted;
                    theme-dark-accent: root.theme-dark-accent;
                    theme-dark-success: root.theme-dark-success;
                    theme-dark-danger: root.theme-dark-danger;
                    theme-dark-overlay: root.theme-dark-overlay;
                    theme-dark-terminal-foreground: root.theme-dark-terminal-foreground;
                    theme-dark-terminal-background: root.theme-dark-terminal-background;
                    theme-dark-terminal-selection: root.theme-dark-terminal-selection;
                    right-click-copy-or-paste: root.right-click-copy-or-paste;
                    scrollback-lines: root.scrollback-lines;
                    default-terminal-columns: root.default-terminal-columns;
                    default-terminal-rows: root.default-terminal-rows;
                    local-shell: root.local-shell;
                    local-shell-index: root.local-shell-index;
                    sidebar-width: root.sidebar-width;
                    tab-width: root.tab-width;
                    session-mask-character: root.session-mask-character;
                    open-settings-shortcut: root.open-settings-shortcut;
                    toggle-sidebar-shortcut: root.toggle-sidebar-shortcut;
                    copy-selection-shortcut: root.copy-selection-shortcut;
                    paste-shortcut: root.paste-shortcut;
                    default-open-settings-shortcut: root.default-open-settings-shortcut;
                    default-toggle-sidebar-shortcut: root.default-toggle-sidebar-shortcut;
                    default-copy-selection-shortcut: root.default-copy-selection-shortcut;
                    default-paste-shortcut: root.default-paste-shortcut;
                    status: root.status;
                    save(font, size, line-height, brightness, bright-bold, theme-mode, theme-palette,
                         theme-light-background, theme-light-panel, theme-light-panel-alt, theme-light-border,
                         theme-light-text, theme-light-muted, theme-light-accent, theme-light-success,
                         theme-light-danger, theme-light-overlay, theme-light-terminal-foreground,
                         theme-light-terminal-background, theme-light-terminal-selection, theme-dark-background,
                         theme-dark-panel, theme-dark-panel-alt, theme-dark-border, theme-dark-text,
                         theme-dark-muted, theme-dark-accent, theme-dark-success, theme-dark-danger,
                         theme-dark-overlay, theme-dark-terminal-foreground, theme-dark-terminal-background,
                         theme-dark-terminal-selection, right-click-copy, shell,
                         scrollback, columns, rows, sidebar, tab-size, mask-character, open-settings-key,
                         toggle-sidebar-key, copy-key, paste-key) => {
                        root.save-settings(
                            font,
                            size,
                            line-height,
                            brightness,
                            bright-bold,
                            theme-mode,
                            theme-palette,
                            theme-light-background,
                            theme-light-panel,
                            theme-light-panel-alt,
                            theme-light-border,
                            theme-light-text,
                            theme-light-muted,
                            theme-light-accent,
                            theme-light-success,
                            theme-light-danger,
                            theme-light-overlay,
                            theme-light-terminal-foreground,
                            theme-light-terminal-background,
                            theme-light-terminal-selection,
                            theme-dark-background,
                            theme-dark-panel,
                            theme-dark-panel-alt,
                            theme-dark-border,
                            theme-dark-text,
                            theme-dark-muted,
                            theme-dark-accent,
                            theme-dark-success,
                            theme-dark-danger,
                            theme-dark-overlay,
                            theme-dark-terminal-foreground,
                            theme-dark-terminal-background,
                            theme-dark-terminal-selection,
                            right-click-copy,
                            shell,
                            scrollback,
                            columns,
                            rows,
                            sidebar,
                            tab-size,
                            mask-character,
                            open-settings-key,
                            toggle-sidebar-key,
                            copy-key,
                            paste-key,
                        );
                    }
                    format-shortcut(text, alt, control, meta, shift) => {
                        return root.format-shortcut(text, alt, control, meta, shift);
                    }
                    shortcut-recording-changed(recording) => {
                        root.shortcut-recording = recording;
                    }
                    cancel => { root.cancel-settings(); }
                }

                if root.active-tab-kind == "session-editor" : SessionEditorPane {
                    group-options: root.group-options;
                    private-key-options: root.private-key-options;
                    status: root.status;
                    save(name, group, host, port, username, auth, key-path, password, remember) => {
                        root.save-session(name, group, host, port, username, auth, key-path, password, remember);
                    }
                    cancel => { root.cancel-session-dialog(); }
                }

                if root.active-tab-kind == "empty" : VerticalLayout {
                    padding: Theme.empty-page-padding;
                    spacing: Theme.space-lg;
                    Text {
                        text: "Workspace";
                        color: Theme.text;
                        font-size: Theme.font-page-title;
                        font-weight: 700;
                    }
                    Text {
                        text: "Open a saved session or create a new tab.";
                        color: Theme.muted;
                        font-size: Theme.font-body;
                    }
                    Rectangle { vertical-stretch: 1; }
                    if !root.status.is-empty : Text {
                        text: root.status;
                        color: Theme.accent;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
    }

    if root.connection-picker-open : TouchArea {
        y: Theme.titlebar-fallback-height;
        width: parent.width;
        height: parent.height - self.y;
        clicked => { root.connection-picker-open = false; }
    }

    if root.connection-picker-open : ConnectionPicker {
        x: max(
            Theme.space-xs,
            parent.width - self.width,
        );
        y: Theme.titlebar-fallback-height;
        sessions: root.connection-options;
        connect-session(id) => {
            root.connection-picker-open = false;
            root.connect-session(id);
        }
        dismiss => { root.connection-picker-open = false; }
    }

    if root.host-key-dialog-open : HostKeyDialog {
        endpoint: root.host-key-endpoint;
        fingerprint: root.host-key-fingerprint;
        changed: root.host-key-changed;
        monospace-font-family: root.terminal-font-family;
        confirm => { root.confirm-host-key(); }
        cancel => { root.reject-host-key(); }
    }

    if root.password-dialog-open : AuthenticationDialog {
        endpoint: root.password-endpoint;
        remember-default: root.password-remember-default;
        private-key: root.password-private-key;
        key-path: root.password-key-path;
        authenticate(secret, remember) => { root.authenticate-session(secret, remember); }
        cancel => { root.cancel-password-dialog(); }
    }

}
