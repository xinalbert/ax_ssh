    in property <bool> worker-running: false;
    in property <bool> connected: false;
    in property <bool> sftp-available: false;
    in property <bool> sftp-open: false;
    in property <bool> sftp-loading: false;
    in property <string> sftp-home: "";
    in property <string> sftp-path: "";
    in property <[SftpEntryRow]> sftp-entries;
