    in property <string> theme-light-terminal-selection: "#ADD6FF";
    in property <string> theme-dark-background: "#171918";
    in property <string> theme-dark-panel: "#202321";
    in property <string> theme-dark-panel-alt: "#292D2A";
    in property <string> theme-dark-border: "#727C76";
    in property <string> theme-dark-text: "#EDF1EE";
    in property <string> theme-dark-muted: "#A8B2AC";
    in property <string> theme-dark-accent: "#52C7A5";
    in property <string> theme-dark-success: "#63D6A9";
    in property <string> theme-dark-danger: "#FF8E88";
    in property <string> theme-dark-overlay: "#00000099";
    in property <string> theme-dark-terminal-foreground: "#CCCCCC";
    in property <string> theme-dark-terminal-background: "#1E1E1E";
    in property <string> theme-dark-terminal-selection: "#264F78";
    in property <int> scrollback-lines: 2000;
