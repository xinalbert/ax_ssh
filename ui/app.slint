import "../assets/fonts/JetBrainsMono-Regular.ttf";
import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
import { SessionGroupRow } from "components/session-navigation.slint";
import { ConnectableSessionRow, WorkspaceTabRow } from "components/workspace-titlebar.slint";
import { TerminalRenderLine } from "components/terminal-grid.slint";
import { OverlayHost, SecurityOverlayViewState } from "components/overlay-host.slint";
import { WorkspaceShell, WorkspaceViewState } from "workspace-shell.slint";

// AppWindow is the Slint/Rust boundary. It maps the flat generated Rust API to
// read-only component DTOs; local interaction state belongs to child components.
export component AppWindow inherits Window {
    title: "AxSSH";
    min-width: Theme.window-min-width;
    min-height: Theme.window-min-height;
    preferred-width: Theme.window-preferred-width;
    preferred-height: Theme.window-preferred-height;
    background: Theme.background;
    private property <ColorScheme> standard-widget-color-scheme: Theme.widget-color-scheme;

    in property <[SessionGroupRow]> sessions;
    in property <[WorkspaceTabRow]> workspace-tabs;
    in property <[ConnectableSessionRow]> connection-options;
    in property <[string]> group-options;
    in property <[string]> private-key-options;
    in property <string> editor-draft-id;
    in property <string> editor-profile-id;
    in property <string> editor-name;
    in property <string> editor-group-name;
    in property <string> editor-host;
    in property <string> editor-port: "22";
    in property <string> editor-username;
    in property <string> editor-auth-method: "Password";
    in property <string> editor-private-key-path;
    in property <[string]> local-shell-options;
    in property <string> status: "";
    in property <string> active-tab-id: "";
    in property <string> active-tab-kind: "empty";
    in property <string> active-tab-title: "Workspace";
    in property <string> active-tab-status: "";
    in property <bool> host-key-dialog-open: false;
    in property <string> host-key-endpoint: "";
    in property <string> host-key-fingerprint: "";
    in property <bool> host-key-changed: false;
    in property <bool> password-dialog-open: false;
    in property <string> password-endpoint: "";
    in property <bool> password-private-key: false;
    in property <bool> password-vault-storage: false;
    in property <bool> password-vault-unlock-only: false;
    in property <string> password-key-path: "";
    in property <string> password-dialog-tab-id: "";
    in property <bool> worker-running: false;
    in property <bool> connected: false;
    in property <[TerminalRenderLine]> terminal-render-lines;
    in property <int> terminal-content-columns: 0;
    in property <int> terminal-cursor-row: 0;
    in property <int> terminal-cursor-column: 0;
    in property <bool> terminal-cursor-visible: false;
    in property <string> terminal-cursor-text: " ";
    in property <string> terminal-font-family: "JetBrains Mono";
    in property <int> terminal-font-size: 14;
    in property <int> terminal-line-height-percent: 120;
    out property <string> terminal-color-scheme: Theme.terminal-color-scheme;
    in property <int> terminal-brightness-percent: 100;
    in property <bool> bright-bold-text: true;
    in property <bool> right-click-copy-or-paste: false;
    in property <bool> option-as-meta: false;
    in property <color> terminal-render-foreground: Theme.terminal-foreground;
    in property <color> terminal-render-background: Theme.terminal-background;
    in property <color> terminal-render-selection-background: Theme.terminal-selection;
    out property <color> terminal-foreground: terminal-render-foreground;
    out property <color> terminal-background: terminal-render-background;
    out property <color> terminal-selection-background: terminal-render-selection-background;
    out property <color> theme-terminal-foreground: Theme.terminal-foreground;
    out property <color> theme-terminal-background: Theme.terminal-background;
    out property <color> theme-terminal-selection: Theme.terminal-selection;
    in property <int> theme-revision: 0;
    in property <string> theme-mode: "dark";
    in property <string> theme-palette: "axssh";
    in property <string> theme-light-background: "#F7F8F7";
    in property <string> theme-light-panel: "#FFFFFF";
    in property <string> theme-light-panel-alt: "#EDF1EE";
    in property <string> theme-light-border: "#6D7972";
    in property <string> theme-light-text: "#1C2520";
    in property <string> theme-light-muted: "#526058";
    in property <string> theme-light-accent: "#116B54";
    in property <string> theme-light-success: "#126A43";
    in property <string> theme-light-danger: "#A72C28";
    in property <string> theme-light-overlay: "#10201899";
    in property <string> theme-light-terminal-foreground: "#333333";
    in property <string> theme-light-terminal-background: "#FFFFFF";
    in property <string> theme-light-terminal-selection: "#ADD6FF";
    in property <string> theme-dark-background: "#171918";
    in property <string> theme-dark-panel: "#202321";
    in property <string> theme-dark-panel-alt: "#292D2A";
    in property <string> theme-dark-border: "#727C76";
    in property <string> theme-dark-text: "#EDF1EE";
    in property <string> theme-dark-muted: "#A8B2AC";
    in property <string> theme-dark-accent: "#52C7A5";
    in property <string> theme-dark-success: "#63D6A9";
    in property <string> theme-dark-danger: "#FF8E88";
    in property <string> theme-dark-overlay: "#00000099";
    in property <string> theme-dark-terminal-foreground: "#CCCCCC";
    in property <string> theme-dark-terminal-background: "#1E1E1E";
    in property <string> theme-dark-terminal-selection: "#264F78";
    in property <int> scrollback-lines: 2000;
    in property <int> default-terminal-columns: 120;
    in property <int> default-terminal-rows: 36;
    in property <string> local-shell: "System default";
    in property <int> local-shell-index: 0;
    in property <string> credential-storage: "system-keyring";
    in property <int> sidebar-width: 220;
    in property <int> tab-width: 172;
    in property <string> session-mask-character: "*";
    in property <string> open-settings-shortcut;
    in property <string> toggle-sidebar-shortcut;
    in property <string> copy-selection-shortcut;
    in property <string> paste-shortcut;
    in property <string> default-open-settings-shortcut;
    in property <string> default-toggle-sidebar-shortcut;
    in property <string> default-copy-selection-shortcut;
    in property <string> default-paste-shortcut;
    in property <bool> apple-platform: false;
    in property <string> app-version;
    private property <string> settings-section: "General";
    private property <int> settings-section-request-revision: 0;
    private property <WorkspaceViewState> workspace-view: {
        sessions: root.sessions,
        workspace_tabs: root.workspace-tabs,
        connection_options: root.connection-options,
        active_tab_id: root.active-tab-id,
        active_tab_kind: root.active-tab-kind,
        status: root.status,
        sidebar_width: root.sidebar-width,
        tab_width: root.tab-width,
        terminal_background: root.terminal-background,
        terminal: {
            terminal_id: root.active-tab-id, connected: root.connected,
            render_lines: root.terminal-render-lines, content_columns: root.terminal-content-columns,
            cursor_row: root.terminal-cursor-row, cursor_column: root.terminal-cursor-column,
            cursor_visible: root.terminal-cursor-visible, cursor_text: root.terminal-cursor-text,
            font_family: root.terminal-font-family, font_size: root.terminal-font-size * 1px,
            line_height_percent: root.terminal-line-height-percent, foreground: root.terminal-foreground,
            background: root.terminal-background, selection_background: root.terminal-selection-background,
            right_click_copy_or_paste: root.right-click-copy-or-paste,
            option_as_meta: root.option-as-meta,
            copy_selection_shortcut: root.copy-selection-shortcut, paste_shortcut: root.paste-shortcut,
        },
        settings: {
            local_shell_options: root.local-shell-options, terminal_font_family: root.terminal-font-family,
            terminal_font_size: root.terminal-font-size, terminal_line_height_percent: root.terminal-line-height-percent,
            terminal_brightness_percent: root.terminal-brightness-percent, bright_bold_text: root.bright-bold-text,
            theme_mode: root.theme-mode, theme_palette: root.theme-palette,
            theme_light_background: root.theme-light-background, theme_light_panel: root.theme-light-panel,
            theme_light_panel_alt: root.theme-light-panel-alt, theme_light_border: root.theme-light-border,
            theme_light_text: root.theme-light-text, theme_light_muted: root.theme-light-muted,
            theme_light_accent: root.theme-light-accent, theme_light_success: root.theme-light-success,
            theme_light_danger: root.theme-light-danger, theme_light_overlay: root.theme-light-overlay,
            theme_light_terminal_foreground: root.theme-light-terminal-foreground,
            theme_light_terminal_background: root.theme-light-terminal-background,
            theme_light_terminal_selection: root.theme-light-terminal-selection,
            theme_dark_background: root.theme-dark-background, theme_dark_panel: root.theme-dark-panel,
            theme_dark_panel_alt: root.theme-dark-panel-alt, theme_dark_border: root.theme-dark-border,
            theme_dark_text: root.theme-dark-text, theme_dark_muted: root.theme-dark-muted,
            theme_dark_accent: root.theme-dark-accent, theme_dark_success: root.theme-dark-success,
            theme_dark_danger: root.theme-dark-danger, theme_dark_overlay: root.theme-dark-overlay,
            theme_dark_terminal_foreground: root.theme-dark-terminal-foreground,
            theme_dark_terminal_background: root.theme-dark-terminal-background,
            theme_dark_terminal_selection: root.theme-dark-terminal-selection,
            right_click_copy_or_paste: root.right-click-copy-or-paste, option_as_meta: root.option-as-meta,
            apple_platform: root.apple-platform, scrollback_lines: root.scrollback-lines,
            default_terminal_columns: root.default-terminal-columns, default_terminal_rows: root.default-terminal-rows,
            local_shell: root.local-shell, local_shell_index: root.local-shell-index,
            credential_storage: root.credential-storage, sidebar_width: root.sidebar-width,
            tab_width: root.tab-width, session_mask_character: root.session-mask-character,
            open_settings_shortcut: root.open-settings-shortcut,
            toggle_sidebar_shortcut: root.toggle-sidebar-shortcut,
            copy_selection_shortcut: root.copy-selection-shortcut, paste_shortcut: root.paste-shortcut,
            default_open_settings_shortcut: root.default-open-settings-shortcut,
            default_toggle_sidebar_shortcut: root.default-toggle-sidebar-shortcut,
            default_copy_selection_shortcut: root.default-copy-selection-shortcut,
            default_paste_shortcut: root.default-paste-shortcut, app_version: root.app-version, status: root.status,
        },
        session_editor: {
            draft_id: root.editor-draft-id, profile_id: root.editor-profile-id, name: root.editor-name,
            group_name: root.editor-group-name, host: root.editor-host, port: root.editor-port,
            username: root.editor-username, auth_method: root.editor-auth-method,
            private_key_path: root.editor-private-key-path, group_options: root.group-options,
            private_key_options: root.private-key-options, status: root.status,
        },
    };
    private property <SecurityOverlayViewState> security-overlay: {
        host_key_open: root.host-key-dialog-open, host_key_endpoint: root.host-key-endpoint,
        host_key_fingerprint: root.host-key-fingerprint, host_key_changed: root.host-key-changed,
        password_open: root.password-dialog-open, password_endpoint: root.password-endpoint,
        password_private_key: root.password-private-key, password_vault_storage: root.password-vault-storage,
        password_vault_unlock_only: root.password-vault-unlock-only, password_key_path: root.password-key-path,
        password_prompt_id: root.password-dialog-tab-id, default_credential_storage: root.credential-storage,
    };

    callback new-session();
    callback new-session-in-group(string);
    callback edit-session(string);
    callback manage-session-action(string, string, string);
    callback open-local-shell();
    callback open-settings();
    callback activate-tab(string);
    callback close-tab(string);
    callback move-tab(string, int);
    callback save-settings(
        string, int, int, int, bool, string, string,
        string, string, string, string, string, string, string, string, string, string, string, string, string,
        string, string, string, string, string, string, string, string, string, string, string, string, string,
        bool, bool, string, int, int, int, int, int, string, string, string, string, string, string,
    );
    callback cancel-settings();
    callback connect-session(string);
    callback save-session(string, string, string, string, string, string, string);
    callback cancel-session-dialog();
    callback confirm-host-key();
    callback reject-host-key();
    callback authenticate-session(string, string, bool) -> bool;
    callback cancel-password-dialog();
    callback disconnect-session();
    callback terminal-key(string, bool, bool, bool, bool, bool) -> bool;
    callback terminal-key-direct(string, bool, bool, bool, bool, bool, bool) -> bool;
    callback terminal-key-is-control(bool, bool, bool, bool) -> bool;
    callback resize-terminal(int, int);
    callback scroll-terminal(int);
    callback terminal-selection-text(int, int, int, int) -> string;
    callback format-shortcut(string, bool, bool, bool, bool) -> string;
    callback write-clipboard(string);
    callback read-clipboard() -> string;
    callback refresh-terminal-appearance();

    public function request-settings-section(section: string) {
        root.settings-section = section;
        root.settings-section-request-revision += 1;
    }

    init => { Palette.color-scheme = root.standard-widget-color-scheme; }
    changed standard-widget-color-scheme => {
        Palette.color-scheme = root.standard-widget-color-scheme;
    }
    changed terminal-color-scheme => { root.refresh-terminal-appearance(); }
    changed theme-revision => { root.refresh-terminal-appearance(); }
    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "New Session"; activated => { root.new-session(); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Undo"; enabled: false; }
            if !root.apple-platform : MenuItem {
                title: "Settings...";
                activated => { root.request-settings-section("General"); root.open-settings(); }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Toggle Session Sidebar";
                activated => { workspace-shell.toggle-sidebar(); }
            }
        }
        Menu {
            title: "Pane";
            MenuItem { title: "New Local Shell"; activated => { root.open-local-shell(); } }
        }
        Menu {
            title: "Window";
            if root.apple-platform : MenuItem {
                title: "Close Current Tab";
                activated => { root.close-tab(root.active-tab-id); }
            }
            if !root.apple-platform : MenuItem {
                title: "Close Current Tab";
                enabled: !root.active-tab-id.is-empty;
                activated => { root.close-tab(root.active-tab-id); }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "Keyboard Shortcuts";
                activated => { root.request-settings-section("Shortcuts"); root.open-settings(); }
            }
            if !root.apple-platform : MenuItem {
                title: "About AxSSH";
                activated => { root.request-settings-section("About"); root.open-settings(); }
            }
        }
    }

    shortcut-scope := FocusScope {
        capture-key-pressed(event) => {
            if workspace-shell.shortcut-recording || root.host-key-dialog-open || root.password-dialog-open {
                return EventResult.reject;
            }
            if event.text == Key.Escape && workspace-shell.dismiss-transient-controls() {
                return EventResult.accept;
            }
            if root.active-tab-kind == "terminal"
                    && root.terminal-key-is-control(
                        event.modifiers.alt,
                        event.modifiers.control,
                        event.modifiers.meta,
                        event.modifiers.shift,
                    ) {
                return EventResult.reject;
            }
            if root.format-shortcut(event.text, event.modifiers.alt, event.modifiers.control,
                                    event.modifiers.meta, event.modifiers.shift)
                    == root.open-settings-shortcut {
                root.request-settings-section("General");
                root.open-settings();
                return EventResult.accept;
            }
            if root.format-shortcut(event.text, event.modifiers.alt, event.modifiers.control,
                                    event.modifiers.meta, event.modifiers.shift)
                    == root.toggle-sidebar-shortcut {
                workspace-shell.toggle-sidebar();
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        workspace-shell := WorkspaceShell {
            width: parent.width;
            height: parent.height;
            view: root.workspace-view;
            requested-settings-section: root.settings-section;
            settings-section-request-revision: root.settings-section-request-revision;
            new-session => { root.new-session(); }
            new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
            edit-session(id) => { root.edit-session(id); }
            request-session-management(action, target, subject) => {
                overlay-host.show-session-management(action, target, subject);
            }
            open-local-shell => { root.open-local-shell(); }
            activate-tab(id) => { root.activate-tab(id); }
            close-tab(id) => { root.close-tab(id); }
            move-tab(id, target-index) => { root.move-tab(id, target-index); }
            save-settings(font, size, line-height, brightness, bright-bold, theme-mode, theme-palette,
                          theme-light-background, theme-light-panel, theme-light-panel-alt, theme-light-border,
                          theme-light-text, theme-light-muted, theme-light-accent, theme-light-success,
                          theme-light-danger, theme-light-overlay, theme-light-terminal-foreground,
                          theme-light-terminal-background, theme-light-terminal-selection, theme-dark-background,
                          theme-dark-panel, theme-dark-panel-alt, theme-dark-border, theme-dark-text,
                          theme-dark-muted, theme-dark-accent, theme-dark-success, theme-dark-danger,
                          theme-dark-overlay, theme-dark-terminal-foreground, theme-dark-terminal-background,
                          theme-dark-terminal-selection, right-click-copy, option-as-meta, shell, scrollback, columns, rows,
                          sidebar, tab-size, mask-character, open-settings-key, toggle-sidebar-key, copy-key,
                          paste-key, credential-storage) => {
                root.save-settings(font, size, line-height, brightness, bright-bold, theme-mode, theme-palette,
                    theme-light-background, theme-light-panel, theme-light-panel-alt, theme-light-border,
                    theme-light-text, theme-light-muted, theme-light-accent, theme-light-success,
                    theme-light-danger, theme-light-overlay, theme-light-terminal-foreground,
                    theme-light-terminal-background, theme-light-terminal-selection, theme-dark-background,
                    theme-dark-panel, theme-dark-panel-alt, theme-dark-border, theme-dark-text,
                    theme-dark-muted, theme-dark-accent, theme-dark-success, theme-dark-danger,
                    theme-dark-overlay, theme-dark-terminal-foreground, theme-dark-terminal-background,
                    theme-dark-terminal-selection, right-click-copy, option-as-meta, shell, scrollback, columns, rows, sidebar,
                    tab-size, mask-character, open-settings-key, toggle-sidebar-key, copy-key, paste-key,
                    credential-storage);
            }
            cancel-settings => { root.cancel-settings(); }
            connect-session(id) => { root.connect-session(id); }
            save-session(name, group, host, port, username, auth, key-path) => {
                root.save-session(name, group, host, port, username, auth, key-path);
            }
            cancel-session-dialog => { root.cancel-session-dialog(); }
            terminal-key(text, alt, control, meta, shift, physical-key-event) => {
                return root.terminal-key(text, alt, control, meta, shift, physical-key-event);
            }
            terminal-key-direct(text, alt, control, meta, shift, option-as-meta, preedit-active) => {
                return root.terminal-key-direct(
                    text, alt, control, meta, shift, option-as-meta, preedit-active,
                );
            }
            resize-terminal(columns, rows) => { root.resize-terminal(columns, rows); }
            scroll-terminal(lines) => { root.scroll-terminal(lines); }
            terminal-selection-text(anchor-row, anchor-column, focus-row, focus-column) => {
                return root.terminal-selection-text(anchor-row, anchor-column, focus-row, focus-column);
            }
            format-shortcut(text, alt, control, meta, shift) => {
                return root.format-shortcut(text, alt, control, meta, shift);
            }
            write-clipboard(text) => { root.write-clipboard(text); }
            read-clipboard() => { return root.read-clipboard(); }
        }
    }

    overlay-host := OverlayHost {
        width: parent.width;
        height: parent.height;
        security: root.security-overlay;
        monospace-font-family: root.terminal-font-family;
        manage-session-action(action, target, value) => {
            root.manage-session-action(action, target, value);
        }
        confirm-host-key => { root.confirm-host-key(); }
        reject-host-key => { root.reject-host-key(); }
        authenticate-session(secret, vault-password, remember) => {
            return root.authenticate-session(secret, vault-password, remember);
        }
        cancel-password-dialog => { root.cancel-password-dialog(); }
    }
}
