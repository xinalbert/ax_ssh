import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
import { SessionGroupRow } from "components/session-navigation.slint";
import { ConnectableSessionRow, WorkspaceTabRow } from "components/workspace-titlebar.slint";
import { TerminalRenderLine } from "components/terminal-grid.slint";
import { OverlayHost, SecurityOverlayViewState } from "components/overlay-host.slint";
import { SftpEntryRow, SftpViewState } from "sftp-pane.slint";
import { WorkspaceShell, WorkspaceViewState } from "workspace-shell.slint";

// AppWindow is the Slint/Rust boundary. It maps the flat generated Rust API to
// read-only component DTOs; local interaction state belongs to child components.
export component AppWindow inherits Window {
    title: "AxSSH";
    icon: @image-url("../assets/ion/terminal_icon_all_formats/terminal_icon_256.png");
    min-width: Theme.window-min-width;
    min-height: Theme.window-min-height;
    preferred-width: Theme.window-preferred-width;
    preferred-height: Theme.window-preferred-height;
    default-font-family: Theme.application-font-family;
    background: Theme.background;
    private property <ColorScheme> standard-widget-color-scheme: Theme.widget-color-scheme;

    in property <[SessionGroupRow]> sessions;
    in property <[WorkspaceTabRow]> workspace-tabs;
    in property <[ConnectableSessionRow]> connection-options;
    in property <[string]> group-options;
    in property <[string]> private-key-options;
    in property <string> editor-draft-id;
    in property <string> editor-profile-id;
    in property <string> editor-name;
    in property <string> editor-group-name;
    in property <string> editor-protocol: "SSH";
    in property <string> editor-host;
    in property <string> editor-port: "22";
    in property <string> editor-username;
    in property <string> editor-auth-method: "Password";
    in property <string> editor-private-key-path;
    in property <string> editor-credential-storage;
    in property <string> editor-default-credential-storage: "system-keyring";
    in property <bool> editor-x11-forwarding: false;
    in property <string> editor-serial-port;
    in property <string> editor-serial-baud-rate: "115200";
    in property <string> editor-serial-data-bits: "8";
    in property <string> editor-serial-stop-bits: "1";
