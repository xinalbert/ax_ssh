    callback pause-selected-sftp-transfers();
    callback resume-selected-sftp-transfers();
    callback cancel-selected-sftp-transfers();
    callback remove-selected-remote-sftp();
    callback load-remote-sftp-file(string);
    callback save-remote-sftp-file(string, string);
    callback editor-text-changed-sftp(string);
    callback toggle-editor-auto-upload-sftp(bool);
    callback dropped-local-files-sftp(data-transfer);
    pure callback drag-local-file-sftp(string) -> data-transfer;
    callback upload-selected-local-sftp();
    callback rename-remote-sftp(string);
    callback edit-remote-sftp();
    callback close-sftp();
    callback terminal-key(string, string, bool, bool, bool, bool, bool) -> bool;
    callback terminal-key-direct(string, bool, bool, bool, bool, bool, bool) -> bool;
    callback resize-terminal(string, int, int);
    callback terminal-presentation-layout(string, length, length, length, length, length);
    callback terminal-presentation-layout-reset();
    callback scroll-terminal(string, int);
    callback mouse-event(string, int, int, int, int, bool, bool, bool);
    callback terminal-selection-text(string, int, int, int, int) -> string;
    callback terminal-semantic-selection-range(string, int, int) -> TerminalSemanticSelection;
    callback terminal-line-selection-range(string, int, int) -> TerminalSemanticSelection;
    callback terminal-target-at-cell(string, int, int, bool, bool) -> TerminalTargetHighlight;
    callback activate-terminal-target(string, int, int, bool, bool) -> bool;
    callback terminal-pane-focus(string);
    callback terminal-pane-command(string, string) -> bool;
    callback resize-terminal-divider(int, float) -> bool;
    callback format-shortcut(string, bool, bool, bool, bool) -> string;
    callback log-keyboard-event(string, bool, bool, bool, bool, string, string);
    callback menu-action(string);
    callback workspace-file-action(string, string);
    callback workspace-file-loaded();
    callback menu-state-changed();
    callback modal-state-changed(bool);
    callback write-clipboard(string);
    callback read-clipboard() -> string;
    callback report-bug();
    callback open-log-directory();
    callback copy-diagnostic-info();
    pure callback settings-search-results(string, string) -> [SettingsSearchEntry];
    callback refresh-terminal-appearance();
    callback detach-workspace(string);
    callback return-workspace(string);

    public function request-settings-section(section: string) {
        root.settings-section = section;
        root.settings-section-request-revision += 1;
    }

    init => { Palette.color-scheme = root.standard-widget-color-scheme; }
    function schedule-terminal-appearance-refresh() {
        root.terminal-appearance-refresh-pending = true;
    }
    changed standard-widget-color-scheme => {
        Palette.color-scheme = root.standard-widget-color-scheme;
    }
    changed terminal-color-scheme => { root.schedule-terminal-appearance-refresh(); }
    changed terminal-appearance-revision => { root.schedule-terminal-appearance-refresh(); }
    changed menu-shortcuts-enabled => { root.menu-state-changed(); }
    changed modal-open => { root.modal-state-changed(root.modal-open); }
    changed menu-terminal-active => { root.menu-state-changed(); }
    changed menu-has-multiple-tabs => { root.menu-state-changed(); }
    changed menu-has-active-tab => { root.menu-state-changed(); }
    Timer {
        running: root.terminal-appearance-refresh-pending;
        interval: 1ms;
        triggered => {
            root.terminal-appearance-refresh-pending = false;
            root.refresh-terminal-appearance();
        }
    }
    if !root.detached-window : MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("New Server");
                enabled: root.menu-shortcuts-enabled;
                shortcut: root.new-session-menu-shortcut;
                activated => { root.menu-action("new-session"); root.new-session(); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Open Workspace");
                enabled: root.menu-shortcuts-enabled;
                activated => {
                    root.menu-action("open-workspace");
                    overlay-host.show-workspace-file-dialog("open", root.workspace-default-path);
                }
            }
            MenuItem {
                title: @tr("Save Workspace");
                enabled: root.menu-shortcuts-enabled;
                activated => {
                    root.menu-action("save-workspace");
                    overlay-host.show-workspace-file-dialog("save", root.workspace-default-path);
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Import from Clipboard");
                enabled: root.menu-shortcuts-enabled;
                shortcut: root.import-sessions-menu-shortcut;
                activated => {
                    root.menu-action("import-sessions");
                    workspace-shell.import-session-config();
                }
            }
            MenuItem {
                title: @tr("Export Selected to Clipboard");
                enabled: root.menu-shortcuts-enabled;
                shortcut: root.export-selected-menu-shortcut;
                activated => {
                    root.menu-action("export-selected");
                    workspace-shell.export-selected-session-config();
                }
            }
        }
        Menu {
            title: @tr("Edit");
            MenuItem {
                title: @tr("Copy");
                enabled: root.menu-shortcuts-enabled && root.menu-terminal-active;
                shortcut: root.copy-selection-menu-shortcut;
                activated => {
                    root.menu-action("copy-terminal");
                    workspace-shell.terminal-edit-action("copy");
                }
            }
            MenuItem {
                title: @tr("Paste");
                enabled: root.menu-shortcuts-enabled && root.menu-terminal-active;
                shortcut: root.paste-menu-shortcut;
                activated => {
                    root.menu-action("paste-terminal");
                    workspace-shell.terminal-edit-action("paste");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Select All");
                enabled: root.menu-shortcuts-enabled && root.menu-terminal-active;
                shortcut: root.select-all-menu-shortcut;
                activated => {
                    root.menu-action("select-all-terminal");
                    workspace-shell.terminal-edit-action("select-all");
                }
            }
            if !root.apple-platform : MenuSeparator { }
            if !root.apple-platform : MenuItem {
                title: @tr("Settings...");
                enabled: root.menu-shortcuts-enabled;
                shortcut: root.open-settings-menu-shortcut;
                activated => {
                    root.menu-action("open-settings");
                    root.request-settings-section("General");
                    root.open-settings();
                }
            }
        }
        Menu {
            title: @tr("View");
            MenuItem {
                title: @tr("Toggle Session Sidebar");
                enabled: root.menu-shortcuts-enabled;
                shortcut: root.toggle-sidebar-menu-shortcut;
                activated => {
                    root.menu-action("toggle-sidebar");
                    workspace-shell.toggle-sidebar();
                }
            }
        }
        Menu {
            title: @tr("Pane");
            MenuItem {
                title: @tr("New Local Shell");
                enabled: root.menu-shortcuts-enabled;
                activated => { root.menu-action("new-local-shell"); root.open-local-shell(); }
            }
            MenuItem {
                title: @tr("Switch SSH/SFTP Tab");
                enabled: root.menu-shortcuts-enabled;
                shortcut: root.open-sftp-menu-shortcut;
                activated => {
                    root.menu-action("switch-ssh-sftp");
                    root.open-sftp();
                }
            }
        }
        Menu {
            title: @tr("Window");
            MenuItem {
                title: @tr("Previous Tab");
                enabled: root.menu-shortcuts-enabled && root.menu-has-multiple-tabs;
                shortcut: root.previous-tab-menu-shortcut;
                activated => { root.menu-action("previous-tab"); root.cycle-tab(false); }
            }
            MenuItem {
                title: @tr("Next Tab");
                enabled: root.menu-shortcuts-enabled && root.menu-has-multiple-tabs;
                shortcut: root.next-tab-menu-shortcut;
                activated => { root.menu-action("next-tab"); root.cycle-tab(true); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Move Current Workspace to New Window");
                enabled: root.menu-shortcuts-enabled
                    && !root.detached-window
                    && root.menu-has-active-tab;
                activated => {
                    root.menu-action("detach-workspace");
                    root.detach-workspace(root.active-tab-id);
                }
            }
            MenuItem {
                title: @tr("Return Workspace to Main Window");
                enabled: root.menu-shortcuts-enabled && root.detached-window;
                activated => {
                    root.menu-action("return-workspace");
                    root.return-workspace(root.active-tab-id);
                }
            }
            MenuSeparator { }
            if root.apple-platform : MenuItem {
                title: @tr("Close Current Tab");
                enabled: root.menu-shortcuts-enabled && root.menu-has-active-tab;
                activated => {
                    root.menu-action("close-tab");
                    workspace-shell.request-close-tab(root.active-tab-id);
                }
            }
            if !root.apple-platform : MenuItem {
                title: @tr("Close Current Tab");
                enabled: root.menu-shortcuts-enabled && root.menu-has-active-tab;
                activated => {
                    root.menu-action("close-tab");
                    workspace-shell.request-close-tab(root.active-tab-id);
                }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Keyboard Shortcuts");
                enabled: root.menu-shortcuts-enabled;
                activated => {
                    root.menu-action("open-shortcuts");
                    root.request-settings-section("Shortcuts");
                    root.open-settings();
                }
            }
            if !root.apple-platform : MenuItem {
                title: @tr("About AxSSH");
                enabled: root.menu-shortcuts-enabled;
                activated => {
                    root.menu-action("open-about");
                    root.request-settings-section("About");
                    root.open-settings();
                }
            }
        }
    }

    shortcut-scope := FocusScope {
        width: parent.width;
        height: parent.height;

        capture-key-pressed(event) => {
            if workspace-shell.shortcut-recording || root.modal-open {
                return EventResult.reject;
            }
            if event.text == Key.Escape && workspace-shell.dismiss-transient-controls() {
                root.log-keyboard-event(
                    event.text, event.modifiers.alt, event.modifiers.control,
                    event.modifiers.meta, event.modifiers.shift,
                    "transient-control", "dismiss-transient",
                );
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        workspace-shell := WorkspaceShell {
            width: parent.width;
            height: parent.height;
            view: root.workspace-view;
            detached-window: root.detached-window;
            terminal-cursor-blink: root.terminal-cursor-blink;
            software-presentation-enabled: root.software-presentation-enabled;
            requested-settings-section: root.settings-section;
            settings-section-request-revision: root.settings-section-request-revision;
            new-session => { root.new-session(); }
            new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
            edit-session(id) => { root.edit-session(id); }
            copy-session(id) => { root.copy-session(id); }
            duplicate-session(id) => { root.duplicate-session(id); }
            session-transfer-action(action, target) => {
                root.session-transfer-action(action, target);
            }
            request-session-management(action, target, subject) => {
                overlay-host.show-session-management(action, target, subject);
            }
            open-local-shell => { root.open-local-shell(); }
            activate-tab(id) => { root.activate-tab(id); }
            close-tab(id) => { root.close-tab(id); }
            move-tab(id, target-index) => { root.move-tab(id, target-index); }
            detach-workspace(id) => {
                root.detach-workspace(id);
            }
            return-workspace(id) => {
                root.return-workspace(id);
            }
            save-settings(application-font, renderer-preference, software-presentation, terminal-font, size, line-height, software-block-rows, text-brightness, bright-bold, semantic-highlighting, compact-rendering, row-render-cache, cursor-blink, focused-refresh-fps, unfocused-refresh-fps,
                          semantic-link-color, semantic-success-color, semantic-info-color, semantic-warning-color, semantic-error-color,
                          theme-mode, theme-palette,
                          theme-light-background, theme-light-panel, theme-light-panel-alt, theme-light-border,
                          theme-light-text, theme-light-muted, theme-light-accent, theme-light-success,
                          theme-light-danger, theme-light-overlay, theme-light-terminal-foreground,
                          theme-light-terminal-background, theme-light-terminal-selection, theme-dark-background,
                          theme-dark-panel, theme-dark-panel-alt, theme-dark-border, theme-dark-text,
                          theme-dark-muted, theme-dark-accent, theme-dark-success, theme-dark-danger,
                          theme-dark-overlay, theme-dark-terminal-foreground, theme-dark-terminal-background,
                          theme-dark-terminal-selection, right-click-copy, copy-selection-on-select, terminal-mouse-local-selection-priority, option-as-meta,
                          x11-provider, x11-app-path, x11-launch, x11-no-auth, shell, scrollback, columns, rows,
                          sidebar, tab-size, mask-character, collapsed-label-chars, open-settings-key, new-session-key,
                          import-key, export-key, toggle-sidebar-key, copy-key, paste-key, open-sftp-key, credential-storage,
                          settings-tab-id, close-after-save) => {
                root.save-settings(application-font, renderer-preference, software-presentation, terminal-font, size, line-height, software-block-rows, text-brightness, bright-bold, semantic-highlighting, compact-rendering, row-render-cache, cursor-blink, focused-refresh-fps, unfocused-refresh-fps,
                    semantic-link-color, semantic-success-color, semantic-info-color, semantic-warning-color, semantic-error-color,
                    theme-mode, theme-palette,
                    theme-light-background, theme-light-panel, theme-light-panel-alt, theme-light-border,
                    theme-light-text, theme-light-muted, theme-light-accent, theme-light-success,
                    theme-light-danger, theme-light-overlay, theme-light-terminal-foreground,
                    theme-light-terminal-background, theme-light-terminal-selection, theme-dark-background,
                    theme-dark-panel, theme-dark-panel-alt, theme-dark-border, theme-dark-text,
                    theme-dark-muted, theme-dark-accent, theme-dark-success, theme-dark-danger,
                    theme-dark-overlay, theme-dark-terminal-foreground, theme-dark-terminal-background,
                    theme-dark-terminal-selection, right-click-copy, copy-selection-on-select, terminal-mouse-local-selection-priority, option-as-meta,
                    x11-provider, x11-app-path, x11-launch, x11-no-auth, shell, scrollback, columns, rows, sidebar,
                    tab-size, mask-character, collapsed-label-chars, open-settings-key, new-session-key, import-key, export-key,
                    toggle-sidebar-key, copy-key, paste-key,
                    open-sftp-key, credential-storage, settings-tab-id, close-after-save);
            }
            save-ui-language(index) => { root.save-ui-language(index); }
            connect-session(id) => { root.connect-session(id); }
            open-sftp-session(id) => { root.open-sftp-session(id); }
            save-session(name, group, protocol, host, port, username, auth, key-path, sftp-remote-path, sftp-local-path, password, remember-password, credential-storage, vault-password, x11-forwarding,
                         serial-port, baud-rate, data-bits, stop-bits, parity, flow-control,
                         connect-after-save) => {
                root.save-session(
                    name, group, protocol, host, port, username, auth, key-path, sftp-remote-path, sftp-local-path, password, remember-password, credential-storage, vault-password, x11-forwarding,
                    serial-port, baud-rate, data-bits, stop-bits, parity, flow-control,
                    connect-after-save,
                );
            }
            refresh-serial-ports => { root.refresh-serial-ports(); }
            serial-mode-changed(enabled) => { root.serial-mode-changed(enabled); }
            private-key-mode-changed(enabled) => { root.private-key-mode-changed(enabled); }
            cancel-session-dialog => { root.cancel-session-dialog(); }
            open-sftp => { root.open-sftp(); }
            list-sftp-directory(path) => { root.list-sftp-directory(path); }
            load-more-sftp => { root.load-more-sftp(); }
            list-local-sftp-directory(path) => { root.list-local-sftp-directory(path); }
            navigate-sftp-back => { root.navigate-sftp-back(); }
            navigate-sftp-forward => { root.navigate-sftp-forward(); }
            toggle-remote-sftp-selection(path, selected) => {
                root.toggle-remote-sftp-selection(path, selected);
            }
            select-all-remote-sftp(selected) => { root.select-all-remote-sftp(selected); }
            toggle-local-sftp-selection(path, selected) => {
                root.toggle-local-sftp-selection(path, selected);
            }
            select-all-local-sftp(selected) => { root.select-all-local-sftp(selected); }
            open-remote-sftp-file(path) => { root.open-remote-sftp-file(path); }
            download-selected-remote-sftp => { root.download-selected-remote-sftp(); }
            open-local-sftp-file(path) => { root.open-local-sftp-file(path); }
            toggle-sftp-transfer-selection(id, selected) => {
                root.toggle-sftp-transfer-selection(id, selected);
            }
            pause-sftp-transfer(id) => { root.pause-sftp-transfer(id); }
            resume-sftp-transfer(id) => { root.resume-sftp-transfer(id); }
            cancel-sftp-transfer(id) => { root.cancel-sftp-transfer(id); }
            pause-selected-sftp-transfers => { root.pause-selected-sftp-transfers(); }
            resume-selected-sftp-transfers => { root.resume-selected-sftp-transfers(); }
            cancel-selected-sftp-transfers => { root.cancel-selected-sftp-transfers(); }
            remove-selected-remote-sftp => { root.remove-selected-remote-sftp(); }
            load-remote-sftp-file(path) => { root.load-remote-sftp-file(path); }
            save-remote-sftp-file(path, text) => { root.save-remote-sftp-file(path, text); }
            editor-text-changed-sftp(text) => { root.editor-text-changed-sftp(text); }
            toggle-editor-auto-upload-sftp(enabled) => { root.toggle-editor-auto-upload-sftp(enabled); }
            dropped-local-files-sftp(data) => { root.dropped-local-files-sftp(data); }
            drag-local-file-sftp(path) => { return root.drag-local-file-sftp(path); }
            upload-selected-local-sftp => { root.upload-selected-local-sftp(); }
            rename-remote-sftp(name) => { root.rename-remote-sftp(name); }
            edit-remote-sftp => { root.edit-remote-sftp(); }
            close-sftp => { root.close-sftp(); }
            terminal-key(id, text, alt, control, meta, shift, physical-key-event) => {
                return root.terminal-key(id, text, alt, control, meta, shift, physical-key-event);
            }
            terminal-key-direct(text, alt, control, meta, shift, option-as-meta, preedit-active) => {
                return root.terminal-key-direct(
                    text, alt, control, meta, shift, option-as-meta, preedit-active,
                );
            }
        resize-terminal(id, columns, rows) => { root.resize-terminal(id, columns, rows); }
        terminal-presentation-layout(id, x, y, width, height, cell-height) => {
            root.terminal-presentation-layout(id, x, y, width, height, cell-height);
        }
        terminal-presentation-layout-reset => { root.terminal-presentation-layout-reset(); }
        scroll-terminal(id, lines) => { root.scroll-terminal(id, lines); }
        mouse-event(id, row, column, button, kind, shift, alt, control) => {
                root.mouse-event(id, row, column, button, kind, shift, alt, control);
        }
            terminal-selection-text(id, anchor-row, anchor-column, focus-row, focus-column) => {
                return root.terminal-selection-text(
                    id, anchor-row, anchor-column, focus-row, focus-column,
                );
            }
            terminal-semantic-selection-range(id, row, column) => {
                return root.terminal-semantic-selection-range(id, row, column);
            }
            terminal-line-selection-range(id, row, column) => {
                return root.terminal-line-selection-range(id, row, column);
            }
            terminal-target-at-cell(id, row, column, control, meta) => {
                return root.terminal-target-at-cell(id, row, column, control, meta);
            }
            activate-terminal-target(id, row, column, control, meta) => {
                return root.activate-terminal-target(id, row, column, control, meta);
            }
            terminal-pane-focus(id) => { root.terminal-pane-focus(id); }
            terminal-pane-command(id, command) => { return root.terminal-pane-command(id, command); }
            resize-terminal-divider(id, ratio) => {
                return root.resize-terminal-divider(id, ratio);
            }
            format-shortcut(text, alt, control, meta, shift) => {
                return root.format-shortcut(text, alt, control, meta, shift);
            }
            write-clipboard(text) => { root.write-clipboard(text); }
            read-clipboard() => { return root.read-clipboard(); }
            report-bug => { root.report-bug(); }
            open-log-directory => { root.open-log-directory(); }
            copy-diagnostic-info => { root.copy-diagnostic-info(); }
            settings-search-results(query, language) => {
                return root.settings-search-results(query, language);
            }
        }
    }

    overlay-host := OverlayHost {
        width: parent.width;
        height: parent.height;
        security: root.security-overlay;
        monospace-font-family: root.application-font-family;
        manage-session-action(action, target, value) => {
            root.manage-session-action(action, target, value);
        }
        confirm-host-key => { root.confirm-host-key(); }
        reject-host-key => { root.reject-host-key(); }
        authenticate-session(secret, vault-password, remember, storage) => {
            return root.authenticate-session(secret, vault-password, remember, storage);
        }
        cancel-password-dialog => { root.cancel-password-dialog(); }
        workspace-file-action(mode, path) => { root.workspace-file-action(mode, path); }
    }

}
