    in property <int> default-terminal-rows: 36;
    in property <string> local-shell: "System default";
    in property <int> local-shell-index: 0;
    in property <string> credential-storage: "system-keyring";
    in property <int> sidebar-width: 220;
    in property <int> tab-width: 172;
    in property <string> session-mask-character: "*";
    in property <int> collapsed-group-label-chars: 2;
    in property <string> open-settings-shortcut;
    in property <string> new-session-shortcut;
    in property <string> import-sessions-shortcut;
    in property <string> export-selected-shortcut;
    in property <string> toggle-sidebar-shortcut;
    in property <string> copy-selection-shortcut;
    in property <string> paste-shortcut;
    in property <string> open-sftp-shortcut;
    in property <keys> open-settings-menu-shortcut;
    in property <keys> new-session-menu-shortcut;
    in property <keys> import-sessions-menu-shortcut;
    in property <keys> export-selected-menu-shortcut;
    in property <keys> toggle-sidebar-menu-shortcut;
    in property <keys> open-sftp-menu-shortcut;
    in property <string> default-open-settings-shortcut;
    in property <string> default-new-session-shortcut;
    in property <string> default-import-sessions-shortcut;
