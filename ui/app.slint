import "../assets/fonts/JetBrainsMono-Regular.ttf";
import { Button, CheckBox, LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TerminalPane, TerminalRenderLine } from "terminal-pane.slint";
import { SettingsPane } from "settings.slint";
import { SidebarFolderGlyph, SidebarRailItem, SidebarTerminalGlyph } from "components/sidebar-controls.slint";
import { SessionEditorPane } from "session-editor.slint";

export struct SessionRow {
    id: string,
    group-name: string,
    name: string,
    endpoint: string,
    icon: string,
    is-group: bool,
    expanded: bool,
}

export struct WorkspaceTabRow {
    id: string,
    title: string,
    kind: string,
    connected: bool,
}

export component AppWindow inherits Window {
    title: "AxSSH";
    min-width: Theme.window-min-width;
    min-height: Theme.window-min-height;
    preferred-width: Theme.window-preferred-width;
    preferred-height: Theme.window-preferred-height;
    background: Theme.background;

    in property <[SessionRow]> sessions;
    in property <[WorkspaceTabRow]> workspace-tabs;
    in property <[string]> group-options;
    in property <[string]> private-key-options;
    in property <[string]> local-shell-options;
    in property <string> status: "Ready";
    in property <string> active-tab-id: "";
    in property <string> active-tab-kind: "empty";
    in property <string> active-tab-title: "Workspace";
    in property <string> active-tab-status: "Ready";
    in property <bool> host-key-dialog-open: false;
    in property <string> host-key-endpoint: "";
    in property <string> host-key-fingerprint: "";
    in property <bool> host-key-changed: false;
    in property <bool> password-dialog-open: false;
    in property <string> password-endpoint: "";
    in property <bool> password-remember-default: false;
    in property <bool> password-private-key: false;
    in property <string> password-key-path: "";
    in property <bool> worker-running: false;
    in property <bool> connected: false;
    in property <[TerminalRenderLine]> terminal-render-lines;
    in property <int> terminal-content-columns: 0;
    in property <int> terminal-cursor-row: 0;
    in property <int> terminal-cursor-column: 0;
    in property <bool> terminal-cursor-visible: false;
    in property <string> terminal-cursor-text: " ";
    in property <string> terminal-font-family: "JetBrains Mono";
    in property <int> terminal-font-size: 14;
    in property <int> terminal-line-height-percent: 120;
    in property <string> terminal-color-scheme: "dark";
    in property <int> terminal-brightness-percent: 100;
    in property <bool> bright-bold-text: true;
    in property <bool> right-click-copy-or-paste: false;
    in property <color> terminal-foreground: Theme.terminal-foreground;
    in property <color> terminal-background: Theme.terminal-background;
    in property <color> terminal-selection-background: Theme.terminal-selection;
    in property <int> scrollback-lines: 2000;
    in property <int> default-terminal-columns: 120;
    in property <int> default-terminal-rows: 36;
    in property <string> local-shell: "System default";
    in property <int> local-shell-index: 0;
    in property <int> sidebar-width: 220;
    in property <int> tab-width: 172;
    in property <string> open-settings-shortcut;
    in property <string> toggle-sidebar-shortcut;
    in property <string> copy-selection-shortcut;
    in property <string> paste-shortcut;
    in property <string> default-open-settings-shortcut;
    in property <string> default-toggle-sidebar-shortcut;
    in property <string> default-copy-selection-shortcut;
    in property <string> default-paste-shortcut;
    in property <bool> apple-platform: false;
    in property <bool> unified-titlebar: false;
    in property <string> app-version;

    private property <bool> sidebar-collapsed: false;
    private property <bool> sidebar-group-selected: false;
    private property <string> active-sidebar-group: "";
    in-out property <string> settings-section: "General";
    private property <bool> shortcut-recording: false;
    private property <length> activity-bar-width: Theme.activity-bar-width;
    private property <length> titlebar-drag-width:
        root.unified-titlebar ? Theme.titlebar-drag-width : 0px;
    private property <bool> sidebar-content-visible:
        !root.sidebar-collapsed && root.sessions.length > 0;
    private property <length> navigation-width:
        root.sidebar-content-visible ? root.sidebar-width * 1px : root.activity-bar-width;

    callback new-session();
    callback open-local-shell();
    callback open-settings();
    callback drag-window();
    callback activate-tab(string);
    callback close-tab(string);
    callback save-settings(
        string, int, int, string, int, bool, bool, string, int, int, int, int, int,
        string, string, string, string,
    );
    callback cancel-settings();
    callback connect-session(string);
    callback toggle-group(string);
    callback activate-group(string);
    callback save-session(string, string, string, string, string, string, string, string, bool);
    callback cancel-session-dialog();
    callback confirm-host-key();
    callback reject-host-key();
    callback authenticate-session(string, bool);
    callback cancel-password-dialog();
    callback disconnect-session();
    callback terminal-key(string, bool, bool, bool, bool) -> bool;
    callback resize-terminal(int, int);
    callback scroll-terminal(int);
    callback terminal-selection-text(int, int, int, int) -> string;
    callback format-shortcut(string, bool, bool, bool, bool) -> string;
    callback write-clipboard(string);
    callback read-clipboard() -> string;

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "New Session";
                activated => { root.new-session(); }
            }
        }
        Menu {
            title: "Edit";
            MenuItem {
                title: "Undo";
                enabled: false;
            }
            if !root.apple-platform : MenuItem {
                title: "Settings...";
                activated => {
                    root.settings-section = "General";
                    root.open-settings();
                }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Toggle Session Sidebar";
                activated => { root.sidebar-collapsed = !root.sidebar-collapsed; }
            }
        }
        Menu {
            title: "Pane";
            MenuItem {
                title: "New Local Shell";
                activated => { root.open-local-shell(); }
            }
        }
        Menu {
            title: "Window";
            MenuItem {
                title: "Close Current Tab";
                enabled: !root.active-tab-id.is-empty && root.active-tab-kind != "settings";
                activated => { root.close-tab(root.active-tab-id); }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "Keyboard Shortcuts";
                activated => {
                    root.settings-section = "Shortcuts";
                    root.open-settings();
                }
            }
            if !root.apple-platform : MenuItem {
                title: "About AxSSH";
                activated => {
                    root.settings-section = "About";
                    root.open-settings();
                }
            }
        }
    }

    function scroll-tabs(delta-x: length, delta-y: length) {
        let delta = delta-x != 0px ? delta-x : delta-y;
        tabs-flick.viewport-x = max(
            tabs-flick.width - tabs-flick.viewport-width,
            min(0px, tabs-flick.viewport-x + delta),
        );
    }

    shortcut-scope := FocusScope {
        capture-key-pressed(event) => {
            if root.shortcut-recording || root.host-key-dialog-open || root.password-dialog-open {
                return EventResult.reject;
            }
            // Slint swaps Command and Control on Apple platforms for Qt compatibility.
            let physical-control = root.apple-platform
                ? event.modifiers.meta : event.modifiers.control;
            let physical-meta = root.apple-platform
                ? event.modifiers.control : event.modifiers.meta;
            if root.active-tab-kind == "terminal"
                    && physical-control
                    && !physical-meta {
                return EventResult.reject;
            }
            if root.format-shortcut(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
            ) == root.open-settings-shortcut {
                root.settings-section = "General";
                root.open-settings();
                return EventResult.accept;
            }
            if root.format-shortcut(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
            ) == root.toggle-sidebar-shortcut {
                root.sidebar-collapsed = !root.sidebar-collapsed;
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: root.unified-titlebar
                    ? Theme.titlebar-height : Theme.titlebar-fallback-height;
                background: Theme.panel;
                border-width: Theme.hairline;
                border-color: Theme.border;

                HorizontalLayout {
                    spacing: 0px;

                    Rectangle {
                        width: root.unified-titlebar
                            ? Theme.titlebar-leading-width : root.navigation-width;
                        background: Theme.panel;
                    }

                    if root.active-tab-kind == "settings" : Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.panel;
                        settings-titlebar-touch := TouchArea {
                            pointer-event(event) => {
                                if root.unified-titlebar
                                        && event.kind == PointerEventKind.down
                                        && event.button == PointerEventButton.left {
                                    root.drag-window();
                                }
                            }
                        }
                    }

                    Rectangle {
                        visible: root.active-tab-kind != "settings";
                        horizontal-stretch: 1;
                        clip: true;
                        tabs-flick := Flickable {
                            width: parent.width;
                            height: parent.height;
                            interactive: false;
                            viewport-width: max(
                                self.width,
                                root.workspace-tabs.length * root.tab-width * 1px,
                            );
                            viewport-height: self.height;

                            for tab[index] in root.workspace-tabs : Rectangle {
                                x: index * root.tab-width * 1px;
                                y: 0px;
                                width: root.tab-width * 1px;
                                height: parent.height;
                                background: tab.id == root.active-tab-id ? Theme.background : Theme.panel;
                                border-width: Theme.hairline;
                                border-color: Theme.border;

                                tab-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.activate-tab(tab.id); }
                                    scroll-event(event) => {
                                        root.scroll-tabs(event.delta-x, event.delta-y);
                                        return EventResult.accept;
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: Theme.space-lg;
                                    padding-right: Theme.space-xs;
                                    spacing: Theme.space-sm;
                                    Rectangle {
                                        width: Theme.tab-status-size;
                                        background: transparent;
                                        Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            width: Theme.tab-status-size;
                                            height: Theme.tab-status-size;
                                            border-radius: Theme.radius-small;
                                            background: tab.connected ? Theme.success : (tab.kind == "terminal" ? Theme.accent : Theme.muted);
                                        }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: tab.title;
                                        color: Theme.text;
                                        font-size: Theme.font-small;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        width: Theme.tab-close-size;
                                        height: Theme.tab-close-size;
                                        border-radius: Theme.radius;
                                        background: close-touch.has-hover ? Theme.panel-alt : transparent;
                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "x";
                                            color: Theme.muted;
                                            font-size: Theme.font-small;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        close-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            accessible-role: button;
                                            accessible-label: "Close tab";
                                            clicked => { root.close-tab(tab.id); }
                                            scroll-event(event) => {
                                                root.scroll-tabs(event.delta-x, event.delta-y);
                                                return EventResult.accept;
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                x: root.workspace-tabs.length * root.tab-width * 1px;
                                y: 0px;
                                width: max(0px, tabs-flick.width - self.x);
                                height: parent.height;
                                background: Theme.panel;
                                titlebar-empty-touch := TouchArea {
                                    pointer-event(event) => {
                                        if root.unified-titlebar
                                                && root.workspace-tabs.length == 0
                                                && event.kind == PointerEventKind.down
                                                && event.button == PointerEventButton.left {
                                            root.drag-window();
                                        }
                                    }
                                    scroll-event(event) => {
                                        root.scroll-tabs(event.delta-x, event.delta-y);
                                        return EventResult.accept;
                                    }
                                }
                            }
                        }
                    }
                    if root.active-tab-kind != "settings" : Rectangle {
                        width: parent.height;
                        background: add-touch.has-hover ? Theme.panel-alt : Theme.panel;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "+";
                            color: Theme.text;
                            font-size: Theme.font-page-title;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        add-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "New session tab";
                            clicked => { root.new-session(); }
                        }
                    }
                    Rectangle {
                        width: root.titlebar-drag-width;
                        background: Theme.panel;
                        titlebar-trailing-touch := TouchArea {
                            pointer-event(event) => {
                                if root.unified-titlebar
                                        && event.kind == PointerEventKind.down
                                        && event.button == PointerEventButton.left {
                                    root.drag-window();
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;

                if !root.sidebar-content-visible : Rectangle {
                    width: root.activity-bar-width;
                    background: Theme.panel-alt;
                    border-width: Theme.hairline;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding-top: Theme.space-sm;
                        padding-bottom: Theme.space-sm;
                        spacing: Theme.space-xs;

                        SidebarRailItem {
                            local: true;
                            accessible-name: "Open local shell";
                            activated => { root.open-local-shell(); }
                        }
                        Rectangle { height: Theme.hairline; background: Theme.border; }
                        ListView {
                            vertical-stretch: 1;
                            for row in root.sessions : SidebarRailItem {
                                label: row.icon;
                                group: row.is-group;
                                selected: row.is-group
                                    && root.sidebar-group-selected
                                    && root.active-sidebar-group == row.group-name;
                                accessible-name: row.is-group
                                    ? "Open " + row.name + " group"
                                    : "Connect to " + row.name;
                                activated => {
                                    if row.is-group {
                                        root.sidebar-group-selected = true;
                                        root.active-sidebar-group = row.group-name;
                                        root.sidebar-collapsed = false;
                                        root.activate-group(row.group-name);
                                    } else {
                                        root.connect-session(row.id);
                                    }
                                }
                            }
                        }
                        Rectangle { height: Theme.hairline; background: Theme.border; }
                        SidebarRailItem {
                            label: "+";
                            accessible-name: "New session tab";
                            activated => { root.new-session(); }
                        }
                    }
                }

                if root.sidebar-content-visible : Rectangle {
                    width: root.sidebar-width * 1px;
                    background: Theme.panel;
                    border-width: Theme.hairline;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding-left: Theme.space-md;
                        padding-right: Theme.space-md;
                        padding-top: Theme.space-sm;
                        padding-bottom: Theme.space-sm;
                        spacing: Theme.space-xs;

                        local-card := Rectangle {
                            height: Theme.sidebar-local-card-height;
                            background: Theme.panel-alt;
                            border-width: Theme.hairline;
                            border-color: local-card-touch.has-hover ? Theme.accent : Theme.border;
                            border-radius: Theme.radius;

                            HorizontalLayout {
                                padding-left: Theme.sidebar-card-padding;
                                padding-right: Theme.sidebar-card-padding;
                                spacing: Theme.space-lg;

                                SidebarTerminalGlyph {
                                    glyph-color: local-card-touch.has-hover ? Theme.accent : Theme.text;
                                }
                                VerticalLayout {
                                    padding-top: Theme.space-lg;
                                    padding-bottom: Theme.space-lg;
                                    spacing: Theme.space-xxs;
                                    Text {
                                        text: "Local Shell";
                                        color: Theme.text;
                                        font-size: Theme.font-body-strong;
                                        font-weight: 700;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "Open a new local shell tab";
                                        color: Theme.muted;
                                        font-size: Theme.font-caption;
                                        overflow: elide;
                                    }
                                }
                            }
                            local-card-touch := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: "Open local shell";
                                clicked => { root.open-local-shell(); }
                            }
                        }

                        ListView {
                            vertical-stretch: 1;
                            for row in root.sessions : Rectangle {
                                height: row.is-group
                                    ? Theme.sidebar-group-card-height + Theme.space-xs
                                    : Theme.sidebar-session-card-height + Theme.space-xs;
                                background: transparent;

                                session-card := Rectangle {
                                    width: parent.width;
                                    height: parent.height - Theme.space-xs;
                                    background: Theme.panel-alt;
                                    border-width: Theme.hairline;
                                    border-color: session-touch.has-hover ? Theme.accent : Theme.border;
                                    border-radius: Theme.radius;

                                session-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    accessible-role: button;
                                    accessible-label: row.is-group
                                        ? "Toggle " + row.name + " group"
                                        : "Connect to " + row.name;
                                    clicked => {
                                        if row.is-group {
                                            root.sidebar-group-selected = true;
                                            root.active-sidebar-group = row.group-name;
                                            root.toggle-group(row.group-name);
                                        } else {
                                            root.connect-session(row.id);
                                        }
                                    }
                                }

                                if row.is-group : HorizontalLayout {
                                    padding-left: Theme.sidebar-card-padding;
                                    padding-right: Theme.sidebar-card-padding;
                                    spacing: Theme.space-sm;

                                    Text {
                                        width: Theme.space-lg;
                                        text: row.expanded ? "v" : ">";
                                        color: Theme.muted;
                                        font-size: Theme.font-small;
                                        vertical-alignment: center;
                                    }
                                    SidebarFolderGlyph {
                                        glyph-color: root.sidebar-group-selected
                                                && root.active-sidebar-group == row.group-name
                                            ? Theme.accent : Theme.muted;
                                        surface-color: session-card.background;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: row.name;
                                        color: Theme.text;
                                        font-size: Theme.font-body-strong;
                                        font-weight: 700;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: row.endpoint;
                                        color: Theme.muted;
                                        font-size: Theme.font-caption;
                                        vertical-alignment: center;
                                    }
                                }

                                if !row.is-group : HorizontalLayout {
                                    padding-left: Theme.sidebar-card-padding + Theme.space-lg;
                                    padding-right: Theme.sidebar-card-padding;
                                    spacing: Theme.space-md;

                                    Text {
                                        width: Theme.sidebar-session-name-width;
                                        text: row.name;
                                        color: Theme.text;
                                        font-family: "JetBrains Mono";
                                        font-size: Theme.font-body;
                                        font-weight: 700;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: row.endpoint;
                                        color: Theme.muted;
                                        font-family: "JetBrains Mono";
                                        font-size: Theme.font-caption;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                                    if !row.is-group : Tooltip { text: @markdown("\{row.endpoint}"); }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.background;

                if root.active-tab-kind == "terminal" : terminal-pane := TerminalPane {
                    connected: root.connected;
                    render-lines: root.terminal-render-lines;
                    content-columns: root.terminal-content-columns;
                    cursor-row: root.terminal-cursor-row;
                    cursor-column: root.terminal-cursor-column;
                    cursor-visible: root.terminal-cursor-visible;
                    cursor-text: root.terminal-cursor-text;
                    terminal-font-family: root.terminal-font-family;
                    terminal-font-size: root.terminal-font-size * 1px;
                    terminal-line-height-percent: root.terminal-line-height-percent;
                    terminal-foreground: root.terminal-foreground;
                    terminal-background: root.terminal-background;
                    terminal-selection-background: root.terminal-selection-background;
                    right-click-copy-or-paste: root.right-click-copy-or-paste;
                    copy-selection-shortcut: root.copy-selection-shortcut;
                    paste-shortcut: root.paste-shortcut;
                    format-shortcut(text, alt, control, meta, shift) => {
                        return root.format-shortcut(text, alt, control, meta, shift);
                    }
                    terminal-key(text, alt, control, meta, shift) => {
                        return root.terminal-key(text, alt, control, meta, shift);
                    }
                    resized(columns, rows) => { root.resize-terminal(columns, rows); }
                    scrolled(lines) => { root.scroll-terminal(lines); }
                    selection-text(anchor-row, anchor-column, focus-row, focus-column) => {
                        return root.terminal-selection-text(
                            anchor-row, anchor-column, focus-row, focus-column,
                        );
                    }
                    write-clipboard(text) => { root.write-clipboard(text); }
                    read-clipboard() => { return root.read-clipboard(); }
                }

                if root.active-tab-kind == "settings" : SettingsPane {
                    selected-section <=> root.settings-section;
                    app-version: root.app-version;
                    local-shell-options: root.local-shell-options;
                    terminal-font-family: root.terminal-font-family;
                    terminal-font-size: root.terminal-font-size;
                    terminal-line-height-percent: root.terminal-line-height-percent;
                    terminal-color-scheme: root.terminal-color-scheme;
                    terminal-brightness-percent: root.terminal-brightness-percent;
                    bright-bold-text: root.bright-bold-text;
                    right-click-copy-or-paste: root.right-click-copy-or-paste;
                    scrollback-lines: root.scrollback-lines;
                    default-terminal-columns: root.default-terminal-columns;
                    default-terminal-rows: root.default-terminal-rows;
                    local-shell: root.local-shell;
                    local-shell-index: root.local-shell-index;
                    sidebar-width: root.sidebar-width;
                    tab-width: root.tab-width;
                    open-settings-shortcut: root.open-settings-shortcut;
                    toggle-sidebar-shortcut: root.toggle-sidebar-shortcut;
                    copy-selection-shortcut: root.copy-selection-shortcut;
                    paste-shortcut: root.paste-shortcut;
                    default-open-settings-shortcut: root.default-open-settings-shortcut;
                    default-toggle-sidebar-shortcut: root.default-toggle-sidebar-shortcut;
                    default-copy-selection-shortcut: root.default-copy-selection-shortcut;
                    default-paste-shortcut: root.default-paste-shortcut;
                    status: root.status;
                    save(font, size, line-height, color-scheme, brightness, bright-bold, right-click-copy, shell,
                         scrollback, columns, rows, sidebar, tab-size, open-settings-key,
                         toggle-sidebar-key, copy-key, paste-key) => {
                        root.save-settings(
                            font,
                            size,
                            line-height,
                            color-scheme,
                            brightness,
                            bright-bold,
                            right-click-copy,
                            shell,
                            scrollback,
                            columns,
                            rows,
                            sidebar,
                            tab-size,
                            open-settings-key,
                            toggle-sidebar-key,
                            copy-key,
                            paste-key,
                        );
                    }
                    format-shortcut(text, alt, control, meta, shift) => {
                        return root.format-shortcut(text, alt, control, meta, shift);
                    }
                    shortcut-recording-changed(recording) => {
                        root.shortcut-recording = recording;
                    }
                    cancel => { root.cancel-settings(); }
                }

                if root.active-tab-kind == "session-editor" : SessionEditorPane {
                    group-options: root.group-options;
                    private-key-options: root.private-key-options;
                    status: root.status;
                    save(name, group, host, port, username, auth, key-path, password, remember) => {
                        root.save-session(name, group, host, port, username, auth, key-path, password, remember);
                    }
                    cancel => { root.cancel-session-dialog(); }
                }

                if root.active-tab-kind == "empty" : VerticalLayout {
                    padding: Theme.empty-page-padding;
                    spacing: Theme.space-lg;
                    Text {
                        text: "Workspace";
                        color: Theme.text;
                        font-size: Theme.font-page-title;
                        font-weight: 700;
                    }
                    Text {
                        text: "Open a saved session or create a new tab.";
                        color: Theme.muted;
                        font-size: Theme.font-body;
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        text: root.status;
                        color: Theme.accent;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    if root.host-key-dialog-open : Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.overlay;
        TouchArea { }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: Theme.host-dialog-width;
            height: Theme.host-dialog-height;
            background: Theme.panel-alt;
            border-width: Theme.hairline;
            border-color: root.host-key-changed ? Theme.danger : Theme.border;
            border-radius: Theme.radius;

            VerticalLayout {
                padding: Theme.dialog-padding;
                spacing: Theme.space-xl;
                Text {
                    text: root.host-key-changed ? "SSH host key changed" : "Unknown SSH host key";
                    color: root.host-key-changed ? Theme.danger : Theme.text;
                    font-size: Theme.font-title;
                    font-weight: 700;
                }
                Text { text: root.host-key-endpoint; color: Theme.muted; font-size: Theme.font-body; }
                Text { text: "SHA-256 fingerprint"; color: Theme.muted; font-size: Theme.font-small; }
                Text {
                    text: root.host-key-fingerprint;
                    color: Theme.text;
                    font-family: root.terminal-font-family;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-md;
                    Button { text: "Cancel"; clicked => { root.reject-host-key(); } }
                    Button {
                        text: root.host-key-changed ? "Trust new key" : "Trust and continue";
                        clicked => { root.confirm-host-key(); }
                    }
                }
            }
        }
    }

    if root.password-dialog-open : Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.overlay;
        TouchArea { }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: Theme.password-dialog-width;
            height: root.password-private-key
                ? Theme.password-private-key-dialog-height
                : Theme.password-dialog-height;
            background: Theme.panel-alt;
            border-width: Theme.hairline;
            border-color: Theme.border;
            border-radius: Theme.radius;

            VerticalLayout {
                padding: Theme.dialog-padding;
                spacing: Theme.space-xl;
                Text {
                    text: root.password-private-key ? "Private key authentication" : "Password authentication";
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: 700;
                }
                Text {
                    text: root.password-endpoint;
                    color: Theme.muted;
                    font-size: Theme.font-body;
                    overflow: elide;
                }
                if root.password-private-key : Text {
                    text: root.password-key-path;
                    color: Theme.text;
                    font-size: Theme.font-small;
                    overflow: elide;
                }
                password-edit := LineEdit {
                    placeholder-text: root.password-private-key ? "Private key passphrase (optional)" : "Password";
                    input-type: InputType.password;
                    accepted(value) => { root.authenticate-session(value, remember-password.checked); }
                }
                remember-password := CheckBox {
                    visible: !root.password-private-key;
                    height: self.visible ? Theme.editor-check-row-height : 0px;
                    text: "Save password in system credential store";
                    checked: root.password-remember-default;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-md;
                    Button { text: "Cancel"; clicked => { root.cancel-password-dialog(); } }
                    Button {
                        text: "Connect";
                        clicked => { root.authenticate-session(password-edit.text, remember-password.checked); }
                    }
                }
            }
        }
    }
}
}
