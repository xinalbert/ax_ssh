import "../assets/fonts/JetBrainsMono-Regular.ttf";
import { Button, CheckBox, LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TerminalPane } from "terminal-pane.slint";
import { SettingsPane } from "settings.slint";
import { SessionEditorPane } from "session-editor.slint";

export struct SessionRow {
    id: string,
    group-name: string,
    name: string,
    endpoint: string,
    is-group: bool,
    expanded: bool,
}

export struct WorkspaceTabRow {
    id: string,
    title: string,
    kind: string,
    connected: bool,
}

export component AppWindow inherits Window {
    title: "AxSSH";
    min-width: 940px;
    min-height: 580px;
    preferred-width: 1180px;
    preferred-height: 740px;
    background: Theme.background;

    in property <[SessionRow]> sessions;
    in property <[WorkspaceTabRow]> workspace-tabs;
    in property <[string]> group-options;
    in property <[string]> private-key-options;
    in property <[string]> terminal-font-options;
    in property <string> status: "Ready";
    in property <string> active-tab-id: "";
    in property <string> active-tab-kind: "empty";
    in property <string> active-tab-title: "Workspace";
    in property <string> active-tab-status: "Ready";
    in property <bool> host-key-dialog-open: false;
    in property <string> host-key-endpoint: "";
    in property <string> host-key-fingerprint: "";
    in property <bool> host-key-changed: false;
    in property <bool> password-dialog-open: false;
    in property <string> password-endpoint: "";
    in property <bool> password-remember-default: false;
    in property <bool> password-private-key: false;
    in property <string> password-key-path: "";
    in property <bool> worker-running: false;
    in property <bool> connected: false;
    in property <string> terminal-output: "";
    in property <string> terminal-font-family: "JetBrains Mono";
    in property <int> terminal-font-size: 14;
    in property <int> scrollback-lines: 2000;
    in property <int> default-terminal-columns: 120;
    in property <int> default-terminal-rows: 36;
    in property <int> sidebar-width: 260;
    in property <int> tab-width: 172;

    callback new-session();
    callback open-settings();
    callback activate-tab(string);
    callback close-tab(string);
    callback save-settings(string, int, int, int, int, int, int);
    callback cancel-settings();
    callback connect-session(string);
    callback toggle-group(string);
    callback save-session(string, string, string, string, string, string, string, string, bool);
    callback cancel-session-dialog();
    callback confirm-host-key();
    callback reject-host-key();
    callback authenticate-session(string, bool);
    callback cancel-password-dialog();
    callback disconnect-session();
    callback terminal-key(string, bool, bool, bool, bool) -> bool;
    callback resize-terminal(int, int);

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 42px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                spacing: 0px;

                Rectangle {
                    width: root.sidebar-width * 1px;
                    background: Theme.panel;
                    Text {
                        x: 16px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: "AxSSH";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    tabs-flick := Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: max(self.width, root.workspace-tabs.length * root.tab-width * 1px);
                        viewport-height: self.height;

                        for tab[index] in root.workspace-tabs : Rectangle {
                            x: index * root.tab-width * 1px;
                            y: 0px;
                            width: root.tab-width * 1px;
                            height: parent.height;
                            background: tab.id == root.active-tab-id ? Theme.background : Theme.panel;
                            border-width: 1px;
                            border-color: Theme.border;

                            tab-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.activate-tab(tab.id); }
                            }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 6px;
                                spacing: 7px;
                                Rectangle {
                                    width: 7px;
                                    background: transparent;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 7px;
                                        height: 7px;
                                        border-radius: 4px;
                                        background: tab.connected ? Theme.success : (tab.kind == "terminal" ? Theme.accent : Theme.muted);
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: tab.title;
                                    color: Theme.text;
                                    font-size: 12px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: Theme.radius;
                                    background: close-touch.has-hover ? Theme.panel-alt : transparent;
                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: "x";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    close-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        accessible-role: button;
                                        accessible-label: "Close tab";
                                        clicked => { root.close-tab(tab.id); }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    width: 42px;
                    background: add-touch.has-hover ? Theme.panel-alt : Theme.panel;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "+";
                        color: Theme.text;
                        font-size: 20px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    add-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "New session tab";
                        clicked => { root.new-session(); }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: root.sidebar-width * 1px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            horizontal-stretch: 1;
                            text: "+ New session";
                            clicked => { root.new-session(); }
                        }
                        Button {
                            width: 42px;
                            text: "S";
                            accessible-label: "Settings";
                            clicked => { root.open-settings(); }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.sessions : Rectangle {
                            height: row.is-group ? 40px : 56px;
                            background: session-touch.has-hover ? Theme.panel-alt : transparent;
                            border-radius: Theme.radius;
                            session-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if row.is-group {
                                        root.toggle-group(row.group-name);
                                    } else {
                                        root.connect-session(row.id);
                                    }
                                }
                            }
                            if row.is-group : HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 7px;
                                Text {
                                    width: 10px;
                                    text: row.expanded ? "v" : ">";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: row.name;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 700;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: row.endpoint;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                            if !row.is-group : VerticalLayout {
                                padding-left: 28px;
                                padding-right: 10px;
                                padding-top: 7px;
                                padding-bottom: 7px;
                                spacing: 3px;
                                Text {
                                    text: row.name;
                                    color: Theme.text;
                                    font-size: 14px;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.endpoint;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: Theme.background;

                if root.active-tab-kind == "terminal" : VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text {
                            horizontal-stretch: 1;
                            text: root.active-tab-title;
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if root.worker-running : Button {
                            text: root.connected ? "Disconnect" : "Cancel connection";
                            clicked => { root.disconnect-session(); }
                        }
                    }
                    terminal-pane := TerminalPane {
                        vertical-stretch: 1;
                        connected: root.connected;
                        output: root.terminal-output;
                        status: root.active-tab-status;
                        terminal-font-family: root.terminal-font-family;
                        terminal-font-size: root.terminal-font-size * 1px;
                        terminal-key(text, alt, control, meta, shift) => {
                            return root.terminal-key(text, alt, control, meta, shift);
                        }
                        resized(columns, rows) => { root.resize-terminal(columns, rows); }
                    }
                }

                if root.active-tab-kind == "settings" : SettingsPane {
                    terminal-font-options: root.terminal-font-options;
                    terminal-font-family: root.terminal-font-family;
                    terminal-font-size: root.terminal-font-size;
                    scrollback-lines: root.scrollback-lines;
                    default-terminal-columns: root.default-terminal-columns;
                    default-terminal-rows: root.default-terminal-rows;
                    sidebar-width: root.sidebar-width;
                    tab-width: root.tab-width;
                    status: root.status;
                    save(font, size, scrollback, columns, rows, sidebar, tab-size) => {
                        root.save-settings(font, size, scrollback, columns, rows, sidebar, tab-size);
                    }
                    cancel => { root.cancel-settings(); }
                }

                if root.active-tab-kind == "session-editor" : SessionEditorPane {
                    group-options: root.group-options;
                    private-key-options: root.private-key-options;
                    status: root.status;
                    save(name, group, host, port, username, auth, key-path, password, remember) => {
                        root.save-session(name, group, host, port, username, auth, key-path, password, remember);
                    }
                    cancel => { root.cancel-session-dialog(); }
                }

                if root.active-tab-kind == "empty" : VerticalLayout {
                    padding: 28px;
                    spacing: 10px;
                    Text {
                        text: "Workspace";
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Open a saved session or create a new tab.";
                        color: Theme.muted;
                        font-size: 13px;
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        text: root.status;
                        color: Theme.accent;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    if root.host-key-dialog-open : Rectangle {
        width: root.width;
        height: root.height;
        background: #00000099;
        TouchArea { }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 500px;
            height: 320px;
            background: Theme.panel-alt;
            border-width: 1px;
            border-color: root.host-key-changed ? Theme.danger : Theme.border;
            border-radius: Theme.radius;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: root.host-key-changed ? "SSH host key changed" : "Unknown SSH host key";
                    color: root.host-key-changed ? Theme.danger : Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text { text: root.host-key-endpoint; color: Theme.muted; font-size: 13px; }
                Text { text: "SHA-256 fingerprint"; color: Theme.muted; font-size: 12px; }
                Text {
                    text: root.host-key-fingerprint;
                    color: Theme.text;
                    font-family: root.terminal-font-family;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.reject-host-key(); } }
                    Button {
                        text: root.host-key-changed ? "Trust new key" : "Trust and continue";
                        clicked => { root.confirm-host-key(); }
                    }
                }
            }
        }
    }

    if root.password-dialog-open : Rectangle {
        width: root.width;
        height: root.height;
        background: #00000099;
        TouchArea { }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 430px;
            height: root.password-private-key ? 310px : 270px;
            background: Theme.panel-alt;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: root.password-private-key ? "Private key authentication" : "Password authentication";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.password-endpoint;
                    color: Theme.muted;
                    font-size: 13px;
                    overflow: elide;
                }
                if root.password-private-key : Text {
                    text: root.password-key-path;
                    color: Theme.text;
                    font-size: 12px;
                    overflow: elide;
                }
                password-edit := LineEdit {
                    placeholder-text: root.password-private-key ? "Private key passphrase (optional)" : "Password";
                    input-type: InputType.password;
                    accepted(value) => { root.authenticate-session(value, remember-password.checked); }
                }
                remember-password := CheckBox {
                    visible: !root.password-private-key;
                    height: self.visible ? 32px : 0px;
                    text: "Save password in system credential store";
                    checked: root.password-remember-default;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.cancel-password-dialog(); } }
                    Button {
                        text: "Connect";
                        clicked => { root.authenticate-session(password-edit.text, remember-password.checked); }
                    }
                }
            }
        }
    }
}
