            theme_light_background: root.theme-light-background, theme_light_panel: root.theme-light-panel,
            theme_light_panel_alt: root.theme-light-panel-alt, theme_light_border: root.theme-light-border,
            theme_light_text: root.theme-light-text, theme_light_muted: root.theme-light-muted,
            theme_light_accent: root.theme-light-accent, theme_light_success: root.theme-light-success,
            theme_light_danger: root.theme-light-danger, theme_light_overlay: root.theme-light-overlay,
            theme_light_terminal_foreground: root.theme-light-terminal-foreground,
            theme_light_terminal_background: root.theme-light-terminal-background,
            theme_light_terminal_selection: root.theme-light-terminal-selection,
            theme_dark_background: root.theme-dark-background, theme_dark_panel: root.theme-dark-panel,
            theme_dark_panel_alt: root.theme-dark-panel-alt, theme_dark_border: root.theme-dark-border,
            theme_dark_text: root.theme-dark-text, theme_dark_muted: root.theme-dark-muted,
            theme_dark_accent: root.theme-dark-accent, theme_dark_success: root.theme-dark-success,
            theme_dark_danger: root.theme-dark-danger, theme_dark_overlay: root.theme-dark-overlay,
            theme_dark_terminal_foreground: root.theme-dark-terminal-foreground,
            theme_dark_terminal_background: root.theme-dark-terminal-background,
            theme_dark_terminal_selection: root.theme-dark-terminal-selection,
            right_click_copy_or_paste: root.right-click-copy-or-paste, option_as_meta: root.option-as-meta,
