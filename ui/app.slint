            terminal_id: root.active-tab-id, connected: root.connected,
            render_lines: root.terminal-render-lines, content_columns: root.terminal-content-columns,
            cursor_row: root.terminal-cursor-row, cursor_column: root.terminal-cursor-column,
            cursor_visible: root.terminal-cursor-visible, cursor_text: root.terminal-cursor-text,
            font_family: root.terminal-font-family, font_size: root.terminal-font-size * 1px,
            line_height_percent: root.terminal-line-height-percent, foreground: root.terminal-foreground,
            background: root.terminal-background, selection_background: root.terminal-selection-background,
            right_click_copy_or_paste: root.right-click-copy-or-paste,
            option_as_meta: root.option-as-meta,
            copy_selection_shortcut: root.copy-selection-shortcut, paste_shortcut: root.paste-shortcut,
        },
        sftp: {
            available: root.sftp-available, open: root.sftp-open, loading: root.sftp-loading,
            home: root.sftp-home, path: root.sftp-path, entries: root.sftp-entries,
            has_more: root.sftp-has-more, truncated: root.sftp-truncated, status: root.sftp-status,
            can_go_back: root.sftp-can-go-back, can_go_forward: root.sftp-can-go-forward,
            selected_count: root.sftp-selected-count, all_selected: root.sftp-all-selected,
            local_loading: root.local-sftp-loading, local_path: root.local-sftp-path,
            local_entries: root.local-sftp-entries, local_truncated: root.local-sftp-truncated,
            local_status: root.local-sftp-status, local_selected_count: root.local-sftp-selected-count,
            local_all_selected: root.local-sftp-all-selected,
        },
        settings: {
            local_shell_options: root.local-shell-options,
            application_font_family: root.application-font-family,
            application_font_options: root.application-font-options,
            application_font_index: root.application-font-index,
            terminal_font_family: root.terminal-font-family,
            terminal_font_options: root.terminal-font-options, terminal_font_index: root.terminal-font-index,
            terminal_font_size: root.terminal-font-size, terminal_line_height_percent: root.terminal-line-height-percent,
