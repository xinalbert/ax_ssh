import { Button, LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct SessionRow {
    id: string,
    name: string,
    endpoint: string,
}

export component AppWindow inherits Window {
    title: "AxSSH";
    min-width: 900px;
    min-height: 560px;
    preferred-width: 1100px;
    preferred-height: 700px;
    background: Theme.background;

    in property <[SessionRow]> sessions;
    in property <string> status: "Ready";
    in property <bool> new-session-dialog-open: false;
    in property <bool> host-key-dialog-open: false;
    in property <string> host-key-endpoint: "";
    in property <string> host-key-fingerprint: "";
    in property <bool> host-key-changed: false;
    in property <bool> password-dialog-open: false;
    in property <string> password-endpoint: "";
    in property <bool> probe-running: false;
    in property <bool> worker-running: false;
    in property <bool> connected: false;
    in property <string> active-session-name: "";

    callback new-session();
    callback connect-session(string);
    callback save-session(string, string, string, string);
    callback cancel-session-dialog();
    callback confirm-host-key();
    callback reject-host-key();
    callback authenticate-session(string);
    callback cancel-password-dialog();
    callback disconnect-session();

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 260px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text {
                    text: "AxSSH";
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                }
                Text {
                    text: "SSH workspace";
                    color: Theme.muted;
                    font-size: 12px;
                }
                Button {
                    text: "+  New session";
                    clicked => { root.new-session(); }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ListView {
                    vertical-stretch: 1;
                    for row[i] in root.sessions : Rectangle {
                        height: 58px;
                        background: touch.has-hover ? Theme.panel-alt : transparent;
                        border-radius: Theme.radius;
                        touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.connect-session(row.id); }
                        }
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 3px;
                            Text {
                                text: row.name;
                                color: Theme.text;
                                font-size: 14px;
                                overflow: elide;
                            }
                            Text {
                                text: row.endpoint;
                                color: Theme.muted;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            padding: 24px;
            spacing: 14px;

            HorizontalLayout {
                Text {
                    text: root.worker-running || root.probe-running ? root.active-session-name : "Workspace";
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.worker-running || root.probe-running : Button {
                    text: root.connected ? "Disconnect" : "Cancel";
                    clicked => { root.disconnect-session(); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.radius;

                VerticalLayout {
                    padding: 24px;
                    spacing: 10px;
                    Text {
                        text: root.connected ? "SSH session connected" : "Select a saved session";
                        color: root.connected ? Theme.success : Theme.text;
                        font-size: 16px;
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        text: root.status;
                        color: root.connected ? Theme.success : Theme.accent;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    if root.new-session-dialog-open : Rectangle {
        width: root.width;
        height: root.height;
        background: #00000099;
        TouchArea { }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 430px;
            height: 340px;
            background: Theme.panel-alt;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius;

            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: "New SSH session";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                name-edit := LineEdit { placeholder-text: "Name"; }
                host-edit := LineEdit { placeholder-text: "Host"; }
                port-edit := LineEdit { text: "22"; placeholder-text: "Port"; }
                user-edit := LineEdit { placeholder-text: "Username"; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.cancel-session-dialog(); }
                    }
                    Button {
                        text: "Save";
                        clicked => {
                            root.save-session(
                                name-edit.text,
                                host-edit.text,
                                port-edit.text,
                                user-edit.text,
                            );
                        }
                    }
                }
            }
        }
    }

    if root.host-key-dialog-open : Rectangle {
        width: root.width;
        height: root.height;
        background: #00000099;
        TouchArea { }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 500px;
            height: 320px;
            background: Theme.panel-alt;
            border-width: 1px;
            border-color: root.host-key-changed ? Theme.danger : Theme.border;
            border-radius: Theme.radius;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: root.host-key-changed ? "SSH host key changed" : "Verify SSH host key";
                    color: root.host-key-changed ? Theme.danger : Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.host-key-endpoint;
                    color: Theme.text;
                    font-size: 14px;
                }
                Text {
                    text: "SHA-256 fingerprint";
                    color: Theme.muted;
                    font-size: 12px;
                }
                Rectangle {
                    height: 72px;
                    background: Theme.background;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius;
                    Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        text: root.host-key-fingerprint;
                        color: Theme.text;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.reject-host-key(); }
                    }
                    Button {
                        text: root.host-key-changed ? "Trust new key" : "Trust and continue";
                        clicked => { root.confirm-host-key(); }
                    }
                }
            }
        }
    }

    if root.password-dialog-open : Rectangle {
        width: root.width;
        height: root.height;
        background: #00000099;
        TouchArea { }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 430px;
            height: 230px;
            background: Theme.panel-alt;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Authenticate";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.password-endpoint;
                    color: Theme.muted;
                    font-size: 13px;
                    overflow: elide;
                }
                password-edit := LineEdit {
                    placeholder-text: "Password";
                    input-type: InputType.password;
                    accepted(value) => { root.authenticate-session(value); }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.cancel-password-dialog(); }
                    }
                    Button {
                        text: "Connect";
                        clicked => { root.authenticate-session(password-edit.text); }
                    }
                }
            }
        }
    }
}
