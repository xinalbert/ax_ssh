    in property <color> terminal-render-background: Theme.terminal-background;
    in property <color> terminal-render-selection-background: Theme.terminal-selection;
    out property <color> terminal-foreground: terminal-render-foreground;
    out property <color> terminal-background: terminal-render-background;
    out property <color> terminal-selection-background: terminal-render-selection-background;
    out property <color> theme-terminal-foreground: Theme.terminal-foreground;
    out property <color> theme-terminal-background: Theme.terminal-background;
    out property <color> theme-terminal-selection: Theme.terminal-selection;
