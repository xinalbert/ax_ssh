    in property <string> default-copy-selection-shortcut;
    in property <string> default-paste-shortcut;
    in property <string> default-open-sftp-shortcut;
    in property <bool> apple-platform: false;
    in property <string> app-version;
    private property <string> settings-section: "General";
    private property <int> settings-section-request-revision: 0;
    out property <bool> menu-shortcuts-enabled:
        !workspace-shell.shortcut-recording
        && !root.host-key-dialog-open
        && !root.password-dialog-open;
    private property <WorkspaceViewState> workspace-view: {
        sessions: root.sessions,
        workspace_tabs: root.workspace-tabs,
        connection_options: root.connection-options,
        active_tab_id: root.active-tab-id,
        settings_tab_id: root.settings-tab-id,
