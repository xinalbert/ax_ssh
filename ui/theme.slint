export global Theme {
    // Semantic palette. Pages consume roles instead of literal colors.
    out property <brush> background: #171918;
    out property <brush> panel: #202321;
    out property <brush> panel-alt: #292d2a;
    out property <brush> border: #3b423e;
    out property <brush> text: #edf1ee;
    out property <brush> muted: #a8b2ac;
    out property <brush> accent: #52c7a5;
    out property <brush> success: #63d6a9;
    out property <brush> danger: #ff8e88;
    out property <brush> overlay: #00000099;
    out property <color> terminal-foreground: #cccccc;
    out property <color> terminal-background: #1e1e1e;
    out property <color> terminal-selection: #264f78;

    // Type scale.
    out property <length> font-micro: 10px;
    out property <length> font-caption: 11px;
    out property <length> font-small: 12px;
    out property <length> font-body: 13px;
    out property <length> font-body-strong: 14px;
    out property <length> font-activity: 15px;
    out property <length> font-section: 16px;
    out property <length> font-header: 17px;
    out property <length> font-title: 18px;
    out property <length> font-page-title: 20px;

    // Shared geometry.
    out property <length> hairline: 1px;
    out property <length> radius-small: 4px;
    out property <length> radius: 6px;
    out property <length> space-xxs: 2px;
    out property <length> space-xs: 4px;
    out property <length> space-sm: 6px;
    out property <length> space-md: 8px;
    out property <length> space-lg: 10px;
    out property <length> space-xl: 12px;
    out property <length> space-xxl: 16px;
    out property <length> page-padding: 24px;
    out property <length> empty-page-padding: 28px;

    // Main workspace geometry.
    out property <length> window-min-width: 520px;
    out property <length> window-min-height: 360px;
    out property <length> window-preferred-width: 1180px;
    out property <length> window-preferred-height: 740px;
    out property <length> titlebar-fallback-height: 38px;
    out property <length> activity-bar-width: 52px;
    out property <length> tab-status-size: 7px;
    out property <length> tab-order-width: 20px;
    out property <length> tab-close-size: 24px;
    out property <length> tab-content-leading-padding: 8px;
    out property <length> tab-content-spacing: 4px;
    out property <length> tab-surface-inset: 3px;
    out property <length> tab-surface-radius: 8px;
    out property <float> tab-drag-source-opacity: 0.32;
    out property <float> tab-drag-ghost-opacity: 0.96;
    out property <length> titlebar-connection-picker-width: 300px;
    out property <length> titlebar-connection-picker-padding: 6px;
    out property <length> titlebar-connection-picker-row-height: 42px;
    out property <length> titlebar-connection-picker-empty-height: 56px;
    out property <length> titlebar-connection-picker-max-height: 264px;
    out property <length> sidebar-rail-toggle-row-height: 36px;
    out property <length> sidebar-rail-toggle-size: 26px;
    out property <length> sidebar-rail-local-row-height: 46px;
    out property <length> sidebar-rail-local-card-size: 36px;
    out property <length> sidebar-rail-group-row-height: 40px;
    out property <length> sidebar-rail-group-card-size: 32px;
    out property <length> sidebar-rail-session-row-height: 34px;
    out property <length> sidebar-rail-session-card-size: 26px;
    out property <length> sidebar-glyph-size: 20px;
    out property <length> sidebar-glyph-inset: 1px;
    out property <length> sidebar-local-card-height: 46px;
    out property <length> sidebar-group-card-height: 34px;
    out property <length> sidebar-session-card-height: 36px;
    out property <length> sidebar-card-padding: 10px;
    out property <length> sidebar-leading-icon-slot-width: 20px;
    out property <length> sidebar-group-chevron-width: 20px;
    out property <length> sidebar-group-chevron-size: 14px;
    out property <length> sidebar-group-chevron-stroke: 1.5px;
    out property <length> sidebar-session-indent: 42px;
    out property <length> sidebar-session-endpoint-width: 132px;

    // Settings workbench geometry.
    out property <length> settings-nav-width: 212px;
    out property <length> settings-content-width: 900px;
    out property <length> settings-nav-item-height: 34px;
    out property <length> settings-nav-indicator-height: 20px;
    out property <length> settings-nav-icon-width: 22px;
    out property <length> settings-nav-title-height: 38px;
    out property <length> settings-header-height: 52px;
    out property <length> settings-icon-size: 18px;
    out property <length> settings-icon-stroke: 2px;
    out property <length> settings-icon-knob-size: 5px;
    out property <length> settings-section-height: 32px;
    out property <length> settings-row-height: 56px;
    out property <length> settings-info-row-height: 48px;
    out property <length> settings-label-width: 250px;
    out property <length> settings-row-text-top: 10px;
    out property <length> settings-row-title-height: 18px;
    out property <length> settings-row-description-height: 15px;
    out property <length> settings-control-height: 32px;
    out property <length> settings-control-vertical-padding: 12px;
    out property <length> settings-field-width: 280px;
    out property <length> settings-terminal-size-width: 128px;
    out property <length> settings-number-width: 128px;
    out property <length> settings-slider-width: 220px;
    out property <length> settings-value-width: 40px;
    out property <length> settings-wide-number-width: 144px;
    out property <length> settings-unit-width: 36px;
    out property <length> settings-reset-button-width: 112px;
    out property <length> settings-action-button-width: 80px;
    out property <length> settings-about-header-height: 104px;
    out property <length> settings-about-mark-size: 52px;
    out property <length> settings-about-description-height: 34px;
    // Editor and overlay geometry.
    out property <length> editor-content-width: 680px;
    out property <length> editor-section-gap: 16px;
    out property <length> editor-title-height: 28px;
    out property <length> editor-subtitle-height: 20px;
    out property <length> editor-section-heading-height: 40px;
    out property <length> editor-section-title-height: 20px;
    out property <length> editor-section-description-height: 18px;
    out property <length> editor-label-height: 16px;
    out property <length> editor-port-width: 104px;
    out property <length> editor-secondary-picker-width: 124px;
    out property <length> editor-detected-key-width: 360px;
    out property <length> editor-auth-indicator-height: 2px;
    out property <length> editor-input-row-height: 32px;
    out property <length> editor-check-row-height: 32px;
    out property <length> editor-status-height: 28px;
    out property <length> editor-action-row-height: 32px;
    out property <length> dialog-padding: 20px;
    out property <length> host-dialog-width: 500px;
    out property <length> host-dialog-height: 320px;
    out property <length> password-dialog-width: 430px;
    out property <length> password-dialog-height: 270px;
    out property <length> password-private-key-dialog-height: 310px;
    out property <length> terminal-underline-offset: 2px;
    // Keep these non-zero floors aligned with config.rs and terminal.rs.
    out property <int> terminal-grid-min-columns: 10;
    out property <int> terminal-grid-max-columns: 300;
    out property <int> terminal-grid-min-rows: 3;
    out property <int> terminal-grid-max-rows: 100;
}
