import { Theme } from "../theme.slint";
import { MiddleElidedPath } from "../components/middle-elided-path.slint";
import { FlatTextInput } from "../components/flat-text-input.slint";
import { FlatActionMenu, MenuActions } from "../components/flat-action-menu.slint";
import { SftpIconButton } from "../components/sftp-controls.slint";

export component SftpPathBar inherits FocusScope {
    in property <string> path;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> can-go-up;
    in property <length> control-height: Theme.sftp-control-min-height;
    callback navigate(string);
    callback copy-path(string);
    callback back();
    callback forward();
    callback up();
    private property <bool> editing: false;
    private property <bool> return-focus: false;
    private property <string> draft: root.path;
    changed path => { root.draft = root.path; root.editing = false; }
    changed enabled => {
        if root.enabled && root.return-focus {
            root.return-focus = false;
            settings-button.focus();
        }
    }
    function edit-path() {
        root.editing = true;
        path-input.focus();
    }
    function restore-focus() {
        if root.enabled {
            root.return-focus = false;
            settings-button.focus();
        }
    }
    function submit-path() {
        if root.enabled && !root.draft.is-empty {
            root.editing = false;
            root.return-focus = true;
            root.navigate(root.draft);
            root.restore-focus();
        }
    }
    capture-key-pressed(event) => {
        if root.enabled && (event.modifiers.control || event.modifiers.meta)
            && (event.text == "l" || event.text == "L") {
            root.edit-path();
            return EventResult.accept;
        }
        if root.editing && event.text == Key.Escape {
            root.draft = root.path;
            root.editing = false;
            settings-button.focus();
            return EventResult.accept;
        }
        return EventResult.reject;
    }
    min-width: 0px;
    height: root.control-height;
    horizontal-stretch: 1;

    HorizontalLayout {
        spacing: Theme.space-xs;
        path-surface := Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            background: Theme.sftp-path-surface;
            border-radius: Theme.radius-small;
            border-width: Theme.hairline;
            border-color: display-focus.has-focus ? Theme.focus : Theme.divider.with-alpha(0.45);
            clip: true;
            display-focus := FocusScope {
                visible: !root.editing;
                width: parent.width;
                height: parent.height;
                focus-on-click: true;
                focus-on-tab-navigation: !root.editing;
                accessible-role: button;
                accessible-label: @tr("Edit path") + ": " + root.path;
                accessible-enabled: root.enabled;
                accessible-action-default => { if root.enabled { root.edit-path(); } }
                key-pressed(event) => {
                    if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
                        root.edit-path();
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
                MiddleElidedPath {
                    width: parent.width;
                    height: parent.height;
                    text: root.path;
                }
                TouchArea {
                    enabled: root.enabled;
                    mouse-cursor: root.enabled ? text : default;
                    clicked => { root.edit-path(); }
                }
            }
            path-input := FlatTextInput {
                visible: root.editing;
                focus-on-tab-navigation: root.editing;
                width: parent.width;
                height: parent.height;
                text <=> root.draft;
                placeholder-text: @tr("Path");
                control-min-height: root.control-height;
                enabled: root.enabled;
                accepted(path) => { root.submit-path(); }
            }
        }
        settings-button := SftpIconButton {
            icon: @image-url("../icons/sftp-settings.svg");
            height: root.control-height;
            accessible-name: @tr("Path") + ": " + @tr("Settings");
            enabled: root.enabled;
            clicked => { path-menu.show-at({ x: self.x, y: root.height }); }
        }
    }
    path-menu := FlatActionMenu {
        context-enabled: root.enabled;
        actions: [
            MenuActions.item("edit", root.editing ? @tr("Open") : @tr("Edit path"),
                !root.editing || !root.draft.is-empty),
            MenuActions.item("copy", @tr("Copy current path"), !root.path.is-empty),
            MenuActions.separator(),
            MenuActions.item("back", @tr("Back"), root.can-go-back),
            MenuActions.item("forward", @tr("Forward"), root.can-go-forward),
            MenuActions.item("up", @tr("Parent directory"), root.can-go-up),
        ];
        triggered(action) => {
            if action == "edit" {
                if root.editing { root.submit-path(); } else { root.edit-path(); }
            } else if action == "copy" {
                root.copy-path(root.path);
                settings-button.focus();
            } else {
                root.return-focus = true;
                if action == "back" { root.back(); }
                else if action == "forward" { root.forward(); }
                else if action == "up" { root.up(); }
                root.restore-focus();
            }
        }
    }
}
