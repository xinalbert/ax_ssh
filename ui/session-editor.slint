import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AuthenticationMethodSelector } from "components/authentication-method-selector.slint";
import { SessionEditorField, SessionEditorSectionHeading } from "components/session-editor-controls.slint";
import { ThemedComboBox } from "components/themed-combo-box.slint";

export component SessionEditorPane inherits Rectangle {
    in property <[string]> group-options;
    in property <[string]> private-key-options;
    in property <string> status;
    in property <string> draft-id;
    in property <string> profile-id;
    in-out property <string> name-draft;
    in-out property <string> group-draft;
    in-out property <string> host-draft;
    in-out property <string> port-draft: "22";
    in-out property <string> username-draft;
    in-out property <string> auth-method: "Password";
    in-out property <string> private-key-draft;
    in-out property <bool> remember-password-draft;

    callback save(string, string, string, string, string, string, string, string, bool);
    callback cancel();

    private property <string> password-draft;
    private property <bool> editing: !root.profile-id.is-empty;

    changed draft-id => { root.password-draft = ""; }

    background: Theme.background;

    editor-scroll := ScrollView {
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-width: self.visible-width;

        editor-page := Rectangle {
            width: editor-scroll.visible-width;
            height: max(
                editor-scroll.visible-height,
                editor-content.preferred-height + 2 * Theme.page-padding,
            );
            background: Theme.background;

            editor-content := VerticalLayout {
                x: max(Theme.page-padding, (parent.width - self.width) / 2);
                y: Theme.page-padding;
                width: min(
                    Theme.editor-content-width,
                    parent.width - 2 * Theme.page-padding,
                );
                height: self.preferred-height;
                spacing: Theme.editor-section-gap;

                VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-xs;
                    Text {
                        height: Theme.editor-title-height;
                        text: root.editing ? "Edit SSH session" : "New SSH session";
                        color: Theme.text;
                        font-size: Theme.font-page-title;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        height: Theme.editor-subtitle-height;
                        text: root.editing
                            ? "Update this reusable connection profile."
                            : "Save a reusable connection profile.";
                        color: Theme.muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-md;
                    SessionEditorSectionHeading {
                        label: "Identity";
                        description: "Choose how this connection appears in the workspace.";
                    }
                    HorizontalLayout {
                        height: Theme.editor-label-height
                            + Theme.space-xs
                            + Theme.editor-input-row-height;
                        vertical-stretch: 0;
                        spacing: Theme.space-xl;
                        SessionEditorField {
                            horizontal-stretch: 3;
                            label: "Name";
                            name-edit := LineEdit {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                placeholder-text: "Production server";
                                text <=> root.name-draft;
                                accessible-label: "Session name";
                            }
                        }
                        SessionEditorField {
                            horizontal-stretch: 2;
                            label: "Group";
                            HorizontalLayout {
                                height: Theme.editor-input-row-height;
                                spacing: Theme.space-md;
                                group-edit := LineEdit {
                                    horizontal-stretch: 1;
                                    height: Theme.editor-input-row-height;
                                    placeholder-text: "Optional";
                                    text <=> root.group-draft;
                                    accessible-label: "Session group";
                                }
                                if root.group-options.length > 0 : ThemedComboBox {
                                    width: Theme.editor-secondary-picker-width;
                                    height: Theme.editor-input-row-height;
                                    model: root.group-options;
                                    accessible-label: "Existing session groups";
                                    selected(value) => {
                                        group-edit.text = value == "Ungrouped" ? "" : value;
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-md;
                    SessionEditorSectionHeading {
                        label: "Endpoint";
                        description: "Enter the host address and SSH account.";
                    }
                    HorizontalLayout {
                        height: Theme.editor-label-height
                            + Theme.space-xs
                            + Theme.editor-input-row-height;
                        vertical-stretch: 0;
                        spacing: Theme.space-xl;
                        SessionEditorField {
                            horizontal-stretch: 1;
                            label: "Host";
                            host-edit := LineEdit {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                placeholder-text: "server.example.com";
                                text <=> root.host-draft;
                                accessible-label: "SSH host";
                            }
                        }
                        SessionEditorField {
                            width: Theme.editor-port-width;
                            horizontal-stretch: 0;
                            label: "Port";
                            port-edit := LineEdit {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                text <=> root.port-draft;
                                placeholder-text: "22";
                                accessible-label: "SSH port";
                            }
                        }
                    }
                    SessionEditorField {
                        label: "Username";
                        user-edit := LineEdit {
                            width: parent.width;
                            height: Theme.editor-input-row-height;
                            placeholder-text: "root";
                            text <=> root.username-draft;
                            accessible-label: "SSH username";
                        }
                    }
                }

                VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-md;
                    SessionEditorSectionHeading {
                        label: "Authentication";
                        description: "Credentials are passed to the SSH worker only when connecting.";
                    }
                    AuthenticationMethodSelector {
                        options: [
                            { label: "Password", value: "Password" },
                            { label: "Private key", value: "Private key" },
                        ];
                        selected-method <=> root.auth-method;
                        accessible-name: "SSH authentication method";
                    }

                    if root.auth-method == "Password" : VerticalLayout {
                        vertical-stretch: 0;
                        spacing: Theme.space-xs;
                        SessionEditorField {
                            label: "Password";
                            new-password-edit := LineEdit {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                text <=> root.password-draft;
                                placeholder-text: root.editing && root.remember-password-draft
                                    ? "Leave blank to keep saved password"
                                    : "Password";
                                input-type: InputType.password;
                                accessible-label: "SSH password";
                            }
                        }
                        remember-new-password := CheckBox {
                            height: Theme.editor-check-row-height;
                            text: "Save password in system credential store";
                            checked <=> root.remember-password-draft;
                            accessible-label: self.text;
                        }
                    }

                    if root.auth-method == "Private key" : VerticalLayout {
                        vertical-stretch: 0;
                        spacing: Theme.space-md;
                        SessionEditorField {
                            label: "Private key path";
                            key-edit := LineEdit {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                text <=> root.private-key-draft;
                                placeholder-text: "~/.ssh/id_ed25519";
                                accessible-label: "Private key path";
                            }
                        }
                        if root.private-key-options.length > 0 : SessionEditorField {
                            label: "Detected key";
                            ThemedComboBox {
                                width: min(parent.width, Theme.editor-detected-key-width);
                                height: Theme.editor-input-row-height;
                                model: root.private-key-options;
                                accessible-label: "Detected private keys";
                                selected(value) => { root.private-key-draft = value; }
                            }
                        }
                    }
                }

                if !root.status.is-empty : Text {
                    height: Theme.editor-status-height;
                    text: root.status;
                    color: Theme.accent;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    min-height: Theme.editor-action-row-height;
                    max-height: Theme.editor-action-row-height;
                    vertical-stretch: 0;
                    alignment: end;
                    spacing: Theme.space-md;
                    Button {
                        height: Theme.editor-input-row-height;
                        text: "Cancel";
                        clicked => { root.cancel(); }
                    }
                    Button {
                        height: Theme.editor-input-row-height;
                        text: root.editing ? "Update session" : "Save session";
                        clicked => {
                            root.save(
                                name-edit.text,
                                group-edit.text,
                                host-edit.text,
                                port-edit.text,
                                user-edit.text,
                                root.auth-method,
                                root.private-key-draft,
                                root.password-draft,
                                root.remember-password-draft,
                            );
                        }
                    }
                }
            }
        }
    }
}
