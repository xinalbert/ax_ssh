import { CheckBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AuthenticationMethodSelector } from "components/authentication-method-selector.slint";
import { ElidedButton } from "components/elided-controls.slint";
import { FlatTextInput } from "components/flat-text-input.slint";
import { SecretTextInput } from "components/secret-text-input.slint";
import { SessionEditorField, SessionEditorSectionHeading } from "components/session-editor-controls.slint";
import { ThemedComboBox } from "components/themed-combo-box.slint";

// This is a read-only snapshot from the workspace. Edits remain local until
// the user explicitly saves, so changing input never mutates Rust state.
export struct SessionEditorViewState {
    draft_id: string,
    profile_id: string,
    name: string,
    group_name: string,
    protocol: string,
    host: string,
    port: string,
    username: string,
    auth_method: string,
    private_key_path: string,
    sftp_remote_path: string,
    sftp_local_path: string,
    credential_storage: string,
    default_credential_storage: string,
    x11_forwarding: bool,
    serial_port: string,
    serial_baud_rate: string,
    serial_data_bits: string,
    serial_stop_bits: string,
    serial_parity: string,
    serial_flow_control: string,
    serial_port_options: [string],
    group_options: [string],
    private_key_options: [string],
    status: string,
}

export component SessionEditorPane inherits Rectangle {
    in property <SessionEditorViewState> source;
    callback save(
        string, string, string, string, string, string, string, string,
        string, string, string, bool, string, string, bool, string, string, string, string, string, string, bool,
    );
    callback refresh-serial-ports();
    callback serial-mode-changed(bool);
    callback private-key-mode-changed(bool);
    callback cancel();

    private property <string> incoming-draft-id: root.source.draft_id;
    private property <bool> editing: !root.source.profile_id.is-empty;
    private property <[string]> group-options: root.source.group_options;
    private property <[string]> private-key-options: root.source.private_key_options;
    private property <string> status: root.source.status;
    private property <string> name-draft;
    private property <string> group-draft;
    private property <string> protocol: "SSH";
    private property <string> host-draft;
    private property <string> port-draft: "22";
    private property <string> username-draft;
    private property <string> auth-method: "Password";
    private property <string> private-key-draft;
    private property <string> sftp-remote-path-draft: "~";
    private property <string> sftp-local-path-draft;
    private property <string> password-draft;
    private property <bool> remember-password-draft: false;
    private property <string> credential-storage-draft: "system-keyring";
    private property <string> vault-password-draft;
    private property <[string]> credential-storage-options: [
        @tr("System credential store"),
        @tr("Encrypted application vault"),
    ];
    private property <bool> x11-forwarding-draft: false;
    private property <string> serial-port-draft;
    private property <string> serial-baud-rate: "115200";
    private property <string> serial-data-bits: "8";
    private property <string> serial-stop-bits: "1";
    private property <string> serial-parity: "none";
    private property <string> serial-flow-control: "none";
    private property <bool> initial-focus-pending: false;

    function submit(connect-after-save: bool) {
        root.save(
            root.name-draft,
            root.group-draft,
            root.protocol,
            root.host-draft,
            root.port-draft,
            root.username-draft,
            root.auth-method,
            root.private-key-draft,
            root.sftp-remote-path-draft,
            root.sftp-local-path-draft,
            root.password-draft,
            root.remember-password-draft,
            root.credential-storage-draft,
            root.vault-password-draft,
            root.x11-forwarding-draft,
            root.serial-port-draft,
            root.serial-baud-rate,
            root.serial-data-bits,
            root.serial-stop-bits,
            root.serial-parity,
            root.serial-flow-control,
            connect-after-save,
        );
        root.password-draft = "";
        root.vault-password-draft = "";
    }

    function reset-draft() {
        root.name-draft = root.source.name;
        root.group-draft = root.source.group_name;
        root.protocol = root.source.protocol;
        root.host-draft = root.source.host;
        root.port-draft = root.source.port;
        root.username-draft = root.source.username;
        root.auth-method = root.source.auth_method;
        root.private-key-draft = root.source.private_key_path;
        root.sftp-remote-path-draft = root.source.sftp_remote_path;
        root.sftp-local-path-draft = root.source.sftp_local_path;
        // Passwords are intentionally never part of the source snapshot.
        root.password-draft = "";
        root.remember-password-draft = false;
        root.credential-storage-draft = root.source.credential_storage.is-empty
            ? root.source.default_credential_storage
            : root.source.credential_storage;
        root.vault-password-draft = "";
        root.x11-forwarding-draft = root.source.x11_forwarding;
        root.serial-port-draft = root.source.serial_port;
        root.serial-baud-rate = root.source.serial_baud_rate;
        root.serial-data-bits = root.source.serial_data_bits;
        root.serial-stop-bits = root.source.serial_stop_bits;
        root.serial-parity = root.source.serial_parity;
        root.serial-flow-control = root.source.serial_flow_control;
    }

    init => {
        root.reset-draft();
        root.initial-focus-pending = true;
    }
    changed incoming-draft-id => {
        root.reset-draft();
        root.initial-focus-pending = true;
    }
    changed protocol => {
        if root.protocol != "SSH" {
            root.password-draft = "";
            root.remember-password-draft = false;
            root.vault-password-draft = "";
        }
        if root.protocol == "Telnet" && root.port-draft == "22" {
            root.port-draft = "23";
        } else if root.protocol == "SSH" && root.port-draft == "23" {
            root.port-draft = "22";
        }
        root.serial-mode-changed(root.protocol == "Serial");
        root.private-key-mode-changed(root.protocol == "SSH" && root.auth-method == "Private key");
    }
    changed auth-method => {
        if root.auth-method != "Password" {
            root.password-draft = "";
            root.remember-password-draft = false;
            root.vault-password-draft = "";
        }
        root.private-key-mode-changed(root.protocol == "SSH" && root.auth-method == "Private key");
    }
    changed password-draft => {
        if root.password-draft.is-empty {
            root.remember-password-draft = false;
            root.vault-password-draft = "";
        }
    }
    changed remember-password-draft => {
        if !root.remember-password-draft {
            root.vault-password-draft = "";
        }
    }
    changed credential-storage-draft => {
        if root.credential-storage-draft != "encrypted-vault" {
            root.vault-password-draft = "";
        }
    }

    Timer {
        running: root.initial-focus-pending;
        interval: 16ms;
        triggered => {
            root.initial-focus-pending = false;
            if root.visible {
                name-edit.focus();
            }
        }
    }

    background: Theme.background;

    editor-scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-width: self.visible-width;
        viewport-height: max(
            self.visible-height,
            editor-content.preferred-height + 2 * Theme.page-padding,
        );

        editor-page := Rectangle {
            width: editor-scroll.visible-width;
            height: max(
                editor-scroll.visible-height,
                editor-content.preferred-height + 2 * Theme.page-padding,
            );
            background: Theme.background;

            editor-content := VerticalLayout {
                x: max(Theme.page-padding, (parent.width - self.width) / 2);
                y: Theme.page-padding;
                width: min(
                    Theme.editor-content-width,
                    parent.width - 2 * Theme.page-padding,
                );
                height: self.preferred-height;
                spacing: Theme.editor-section-gap;

                VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-md;
                    SessionEditorSectionHeading {
                        label: @tr("Protocol");
                        description: @tr("Select the transport used by this saved connection.");
                    }
                    AuthenticationMethodSelector {
                        options: [
                            { label: @tr("SSH"), value: "SSH" },
                            { label: @tr("Telnet"), value: "Telnet" },
                            { label: @tr("Serial"), value: "Serial" },
                        ];
                        selected-method <=> root.protocol;
                        accessible-name: @tr("Connection protocol");
                    }
                    if root.protocol == "Telnet" : Text {
                        text: @tr("Telnet sends terminal traffic without encryption or host identity verification.");
                        color: Theme.danger;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-md;
                    SessionEditorSectionHeading {
                        label: @tr("Identity");
                        description: @tr("Choose how this connection appears in the workspace.");
                    }
                    HorizontalLayout {
                        height: self.preferred-height;
                        vertical-stretch: 0;
                        spacing: Theme.space-xl;
                        SessionEditorField {
                            horizontal-stretch: 3;
                            label: @tr("Name");
                            name-edit := FlatTextInput {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                placeholder-text: @tr("Production server");
                                text <=> root.name-draft;
                                accessible-label: @tr("Session name");
                            }
                        }
                        SessionEditorField {
                            horizontal-stretch: 2;
                            label: @tr("Group");
                            HorizontalLayout {
                                height: Theme.editor-input-row-height;
                                spacing: Theme.space-md;
                                group-edit := FlatTextInput {
                                    horizontal-stretch: 1;
                                    height: Theme.editor-input-row-height;
                                    placeholder-text: @tr("Optional");
                                    text <=> root.group-draft;
                                    accessible-label: @tr("Session group");
                                }
                                if root.group-options.length > 0 : ThemedComboBox {
                                    width: Theme.editor-secondary-picker-width;
                                    height: Theme.editor-input-row-height;
                                    model: root.group-options;
                                    accessible-label: @tr("Existing session groups");
                                    selected(value, _index) => {
                                        group-edit.text = value == "Ungrouped" ? "" : value;
                                    }
                                }
                            }
                        }
                    }
                }

                if root.protocol != "Serial" : VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-md;
                    SessionEditorSectionHeading {
                        label: @tr("Endpoint");
                        description: root.protocol == "SSH"
                            ? @tr("Enter the host address and SSH account.")
                            : @tr("Enter the Telnet server address.");
                    }
                    HorizontalLayout {
                        height: self.preferred-height;
                        vertical-stretch: 0;
                        spacing: Theme.space-xl;
                        SessionEditorField {
                            horizontal-stretch: 1;
                            label: @tr("Host");
                            host-edit := FlatTextInput {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                placeholder-text: @tr("server.example.com");
                                text <=> root.host-draft;
                                accessible-label: root.protocol + " host";
                            }
                        }
                        SessionEditorField {
                            width: Theme.editor-port-width;
                            horizontal-stretch: 0;
                            label: @tr("Port");
                            port-edit := FlatTextInput {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                text <=> root.port-draft;
                                placeholder-text: @tr("22");
                                accessible-label: root.protocol + " port";
                            }
                        }
                    }
                    if root.protocol == "SSH" : SessionEditorField {
                        label: @tr("Username");
                        user-edit := FlatTextInput {
                            width: parent.width;
                            height: Theme.editor-input-row-height;
                            placeholder-text: @tr("root");
                            text <=> root.username-draft;
                            accessible-label: @tr("SSH username");
                        }
                    }
                }

                if root.protocol == "Serial" : VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-md;
                    SessionEditorSectionHeading {
                        label: @tr("Serial port");
                        description: @tr("Select a detected device or enter its port name manually.");
                    }
                    SessionEditorField {
                        label: @tr("Port");
                        HorizontalLayout {
                            height: Theme.editor-input-row-height;
                            spacing: Theme.space-md;
                            serial-port-edit := FlatTextInput {
                                horizontal-stretch: 1;
                                height: Theme.editor-input-row-height;
                                text <=> root.serial-port-draft;
                                placeholder-text: @tr("/dev/cu.usbserial or COM3");
                                accessible-label: @tr("Serial port name");
                            }
                            if root.source.serial_port_options.length > 0 : ThemedComboBox {
                                width: Theme.editor-detected-key-width;
                                height: Theme.editor-input-row-height;
                                model: root.source.serial_port_options;
                                accessible-label: @tr("Detected serial ports");
                                selected(value, _index) => { root.serial-port-draft = value; }
                            }
                            ElidedButton {
                                height: Theme.editor-input-row-height;
                                text: @tr("Refresh");
                                accessible-name: @tr("Refresh serial ports");
                                clicked => { root.refresh-serial-ports(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: self.preferred-height;
                        vertical-stretch: 0;
                        spacing: Theme.space-xl;
                        SessionEditorField {
                            horizontal-stretch: 1;
                            label: @tr("Baud rate");
                            FlatTextInput {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                text <=> root.serial-baud-rate;
                                placeholder-text: @tr("115200");
                                accessible-label: @tr("Serial baud rate");
                            }
                        }
                        SessionEditorField {
                            horizontal-stretch: 1;
                            label: @tr("Data bits");
                            ThemedComboBox {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                model: ["8", "7", "6", "5"];
                                current-index: root.serial-data-bits == "8" ? 0
                                    : (root.serial-data-bits == "7" ? 1
                                    : (root.serial-data-bits == "6" ? 2 : 3));
                                accessible-label: @tr("Serial data bits");
                                selected(value, _index) => { root.serial-data-bits = value; }
                            }
                        }
                        SessionEditorField {
                            horizontal-stretch: 1;
                            label: @tr("Stop bits");
                            ThemedComboBox {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                model: ["1", "2"];
                                current-index: root.serial-stop-bits == "2" ? 1 : 0;
                                accessible-label: @tr("Serial stop bits");
                                selected(value, _index) => { root.serial-stop-bits = value; }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: self.preferred-height;
                        vertical-stretch: 0;
                        spacing: Theme.space-xl;
                        SessionEditorField {
                            horizontal-stretch: 1;
                            label: @tr("Parity");
                            ThemedComboBox {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                model: ["none", "odd", "even"];
                                current-index: root.serial-parity == "odd" ? 1
                                    : (root.serial-parity == "even" ? 2 : 0);
                                accessible-label: @tr("Serial parity");
                                selected(value, _index) => { root.serial-parity = value; }
                            }
                        }
                        SessionEditorField {
                            horizontal-stretch: 1;
                            label: @tr("Flow control");
                            ThemedComboBox {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                model: ["none", "software", "hardware"];
                                current-index: root.serial-flow-control == "software" ? 1
                                    : (root.serial-flow-control == "hardware" ? 2 : 0);
                                accessible-label: @tr("Serial flow control");
                                selected(value, _index) => { root.serial-flow-control = value; }
                            }
                        }
                    }
                }

                if root.protocol == "SSH" : VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-md;
                    SessionEditorSectionHeading {
                        label: @tr("SFTP directories");
                        description: @tr("Choose the remote and local directories opened by new SFTP tabs.");
                    }
                    HorizontalLayout {
                        height: self.preferred-height;
                        vertical-stretch: 0;
                        spacing: Theme.space-xl;
                        SessionEditorField {
                            horizontal-stretch: 1;
                            label: @tr("Remote default directory");
                            FlatTextInput {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                text <=> root.sftp-remote-path-draft;
                                placeholder-text: @tr("~");
                                accessible-label: @tr("SFTP remote default directory");
                            }
                        }
                        SessionEditorField {
                            horizontal-stretch: 1;
                            label: @tr("Local default directory");
                            FlatTextInput {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                text <=> root.sftp-local-path-draft;
                                placeholder-text: @tr("Platform home directory");
                                accessible-label: @tr("SFTP local default directory");
                            }
                        }
                    }
                }

                if root.protocol == "SSH" : VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-md;
                    SessionEditorSectionHeading {
                        label: @tr("Authentication");
                        description: @tr("Credentials used for this SSH connection.");
                    }
                    AuthenticationMethodSelector {
                        options: [
                            { label: @tr("Password"), value: "Password" },
                            { label: @tr("Private key"), value: "Private key" },
                            { label: @tr("SSH agent"), value: "SSH agent" },
                        ];
                        selected-method <=> root.auth-method;
                        accessible-name: @tr("SSH authentication method");
                    }

                    if root.auth-method == "Password" : VerticalLayout {
                        vertical-stretch: 0;
                        spacing: Theme.space-md;
                        SessionEditorField {
                            label: @tr("Password");
                            password-edit := SecretTextInput {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                text <=> root.password-draft;
                                placeholder-text: root.editing && !root.source.credential_storage.is-empty
                                    ? @tr("Leave blank to keep saved password")
                                    : @tr("Optional; enter only when connecting or saving");
                                accessible-label: @tr("SSH password");
                            }
                        }
                        CheckBox {
                            text: @tr("Save password (optional)");
                            enabled: !root.password-draft.is-empty;
                            checked <=> root.remember-password-draft;
                            accessible-label: @tr("Save SSH password for future connections");
                        }
                        if root.remember-password-draft : SessionEditorField {
                            label: @tr("Credential storage");
                            ThemedComboBox {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                model: root.credential-storage-options;
                                current-index: root.credential-storage-draft == "encrypted-vault" ? 1 : 0;
                                accessible-label: @tr("Credential storage");
                                selected(_value, index) => {
                                    root.credential-storage-draft = index == 1
                                        ? "encrypted-vault"
                                        : "system-keyring";
                                }
                            }
                        }
                        if root.remember-password-draft
                                && root.credential-storage-draft == "encrypted-vault" : SessionEditorField {
                            label: @tr("Vault password");
                            vault-password-edit := SecretTextInput {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                text <=> root.vault-password-draft;
                                placeholder-text: @tr("Required for encrypted application vault");
                                accessible-label: @tr("Credential vault password");
                            }
                        }
                    }

                    CheckBox {
                        text: @tr("Forward X11 applications");
                        checked <=> root.x11-forwarding-draft;
                        accessible-label: @tr("Enable SSH X11 forwarding");
                    }

                    if root.auth-method == "Private key" : VerticalLayout {
                        vertical-stretch: 0;
                        spacing: Theme.space-md;
                        SessionEditorField {
                            label: @tr("Private key path");
                            key-edit := FlatTextInput {
                                width: parent.width;
                                height: Theme.editor-input-row-height;
                                text <=> root.private-key-draft;
                                placeholder-text: @tr("~/.ssh/id_ed25519");
                                accessible-label: @tr("Private key path");
                            }
                        }
                        if root.private-key-options.length > 0 : SessionEditorField {
                            label: @tr("Detected key");
                            ThemedComboBox {
                                width: min(parent.width, Theme.editor-detected-key-width);
                                height: Theme.editor-input-row-height;
                                model: root.private-key-options;
                                accessible-label: @tr("Detected private keys");
                                selected(value, _index) => { root.private-key-draft = value; }
                            }
                        }
                    }
                }

                if !root.status.is-empty : Text {
                    height: Theme.editor-status-height;
                    text: root.status;
                    color: Theme.accent;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    min-height: Theme.editor-action-row-height;
                    max-height: Theme.editor-action-row-height;
                    vertical-stretch: 0;
                    alignment: end;
                    spacing: Theme.space-md;
                    ElidedButton {
                        height: Theme.editor-input-row-height;
                        text: @tr("Cancel");
                        clicked => { root.cancel(); }
                    }
                    if !root.editing && root.protocol == "SSH" : ElidedButton {
                        height: Theme.editor-input-row-height;
                        text: @tr("Save & connect");
                        clicked => { root.submit(true); }
                    }
                    ElidedButton {
                        height: Theme.editor-input-row-height;
                        text: root.editing ? @tr("Update session") : @tr("Save session");
                        clicked => { root.submit(false); }
                    }
                }
            }
        }
    }
}
