import { Theme } from "theme.slint";
import { SessionEditorPane, SessionEditorViewState } from "session-editor.slint";
import { SettingsPane, SettingsViewState } from "settings.slint";
import { TerminalPane, TerminalViewState } from "terminal-pane.slint";
import { SftpPane, SftpViewState } from "sftp-pane.slint";
import { SessionGroupRow, SessionNavigation } from "components/session-navigation.slint";
import {
    ConnectableSessionRow,
    ConnectionPicker,
    WorkspaceTabRow,
    WorkspaceTitlebar,
} from "components/workspace-titlebar.slint";

export struct TerminalPaneView {
    terminal: TerminalViewState,
    x: float,
    y: float,
    width: float,
    height: float,
    focused: bool,
}

export struct TerminalPaneDividerView {
    id: int,
    x: float,
    y: float,
    width: float,
    height: float,
    ratio: float,
    vertical: bool,
}

// This is the only AppWindow-to-workspace visual contract. Rust-owned values
// arrive as immutable data; all sidebar, picker, and page-local state stays here.
export struct WorkspaceViewState {
    sessions: [SessionGroupRow],
    workspace_tabs: [WorkspaceTabRow],
    connection_options: [ConnectableSessionRow],
    active_tab_id: string,
    active_pane_id: string,
    settings_tab_id: string,
    active_tab_kind: string,
    status: string,
    sidebar_width: int,
    tab_width: int,
    collapsed_group_label_chars: int,
    terminal_background: color,
    terminal: TerminalViewState,
    terminal_panes: [TerminalPaneView],
    terminal_dividers: [TerminalPaneDividerView],
    sftp: SftpViewState,
    settings: SettingsViewState,
    session_editor: SessionEditorViewState,
}

component TerminalPaneDivider inherits FocusScope {
    in property <bool> vertical;
    in property <float> ratio;
    in property <length> available-length;
    callback set-value(float);
    callback reset();

    private property <float> minimum: Theme.terminal-pane-divider-min-ratio;
    private property <float> maximum: 1.0 - Theme.terminal-pane-divider-min-ratio;
    private property <float> drag-start-ratio: root.ratio;
    private property <length> drag-start-position: 0px;
    private property <bool> active: root.has-focus || divider-touch.has-hover || divider-touch.pressed;

    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: slider;
    accessible-label: root.vertical ? "Terminal pane widths" : "Terminal pane heights";
    accessible-enabled: root.enabled;
    accessible-orientation: root.vertical ? Orientation.horizontal : Orientation.vertical;
    accessible-value: root.ratio;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: Theme.terminal-pane-divider-step;
    accessible-action-set-value(candidate) => {
        if candidate.is-float() {
            root.set-value(max(root.minimum, min(root.maximum, candidate.to-float())));
        }
    }
    accessible-action-increment => {
        root.set-value(min(root.maximum, root.ratio + Theme.terminal-pane-divider-step));
    }
    accessible-action-decrement => {
        root.set-value(max(root.minimum, root.ratio - Theme.terminal-pane-divider-step));
    }
    accessible-action-default => { root.reset(); }

    key-pressed(event) => {
        if root.vertical && event.text == Key.RightArrow {
            root.set-value(min(root.maximum, root.ratio + Theme.terminal-pane-divider-step));
            return EventResult.accept;
        }
        if root.vertical && event.text == Key.LeftArrow {
            root.set-value(max(root.minimum, root.ratio - Theme.terminal-pane-divider-step));
            return EventResult.accept;
        }
        if !root.vertical && event.text == Key.DownArrow {
            root.set-value(min(root.maximum, root.ratio + Theme.terminal-pane-divider-step));
            return EventResult.accept;
        }
        if !root.vertical && event.text == Key.UpArrow {
            root.set-value(max(root.minimum, root.ratio - Theme.terminal-pane-divider-step));
            return EventResult.accept;
        }
        if event.text == Key.Home {
            root.set-value(root.minimum);
            return EventResult.accept;
        }
        if event.text == Key.End {
            root.set-value(root.maximum);
            return EventResult.accept;
        }
        if event.text == Key.Return || event.text == Key.Space {
            root.reset();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        x: root.vertical ? (parent.width - self.width) / 2 : 0px;
        y: root.vertical ? 0px : (parent.height - self.height) / 2;
        width: root.vertical
            ? (root.active ? Theme.terminal-pane-divider-active-thickness : Theme.hairline)
            : parent.width;
        height: root.vertical
            ? parent.height
            : (root.active ? Theme.terminal-pane-divider-active-thickness : Theme.hairline);
        background: root.active ? Theme.accent : Theme.divider;
    }

    divider-touch := TouchArea {
        mouse-cursor: root.vertical ? ew-resize : ns-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.drag-start-ratio = root.ratio;
                root.drag-start-position = root.vertical
                    ? root.x + self.mouse-x
                    : root.y + self.mouse-y;
                root.focus();
            }
        }
        moved => {
            if self.pressed && root.available-length > 0px {
                let pointer-position = root.vertical
                    ? root.x + self.mouse-x
                    : root.y + self.mouse-y;
                root.set-value(max(
                    root.minimum,
                    min(
                        root.maximum,
                        root.drag-start-ratio
                            + (pointer-position - root.drag-start-position)
                                / root.available-length,
                    ),
                ));
            }
        }
        double-clicked => { root.reset(); }
    }
}

component TerminalPaneGroup inherits Rectangle {
    in property <[TerminalPaneView]> panes;
    in property <[TerminalPaneDividerView]> dividers;
    in property <string> terminal-edit-command;
    in property <int> terminal-edit-command-revision: 0;

    callback terminal-key(string, string, bool, bool, bool, bool, bool) -> bool;
    callback terminal-key-direct(string, bool, bool, bool, bool, bool, bool) -> bool;
    callback resize-terminal(string, int, int);
    callback scroll-terminal(string, int);
    callback terminal-selection-text(string, int, int, int, int) -> string;
    callback terminal-pane-focus(string);
    callback terminal-pane-command(string, string) -> bool;
    callback resize-terminal-divider(int, float) -> bool;
    callback format-shortcut(string, bool, bool, bool, bool) -> string;
    callback write-clipboard(string);
    callback read-clipboard() -> string;

    for pane in root.panes : TerminalPane {
        x: pane.x * parent.width;
        y: pane.y * parent.height;
        width: pane.width * parent.width;
        height: pane.height * parent.height;
        view: pane.terminal;
        focused: pane.focused;
        edit-command: root.terminal-edit-command;
        edit-command-revision: root.terminal-edit-command-revision;
        terminal-key(text, alt, control, meta, shift, physical-key-event) => {
            return root.terminal-key(
                pane.terminal.terminal_id, text, alt, control, meta, shift, physical-key-event,
            );
        }
        terminal-key-direct(text, alt, control, meta, shift, option-as-meta, preedit-active) => {
            return root.terminal-key-direct(
                text, alt, control, meta, shift, option-as-meta, preedit-active,
            );
        }
        resized(columns, rows) => { root.resize-terminal(pane.terminal.terminal_id, columns, rows); }
        scrolled(lines) => { root.scroll-terminal(pane.terminal.terminal_id, lines); }
        selection-text(anchor-row, anchor-column, focus-row, focus-column) => {
            return root.terminal-selection-text(
                pane.terminal.terminal_id, anchor-row, anchor-column, focus-row, focus-column,
            );
        }
        pane-focus(id) => { root.terminal-pane-focus(id); }
        pane-command(id, command) => { return root.terminal-pane-command(id, command); }
        format-shortcut(text, alt, control, meta, shift) => {
            return root.format-shortcut(text, alt, control, meta, shift);
        }
        write-clipboard(text) => { root.write-clipboard(text); }
        read-clipboard() => { return root.read-clipboard(); }
    }

    for divider in root.dividers : TerminalPaneDivider {
        x: divider.vertical
            ? (divider.x + divider.width * divider.ratio) * parent.width - self.width / 2
            : divider.x * parent.width;
        y: divider.vertical
            ? divider.y * parent.height
            : (divider.y + divider.height * divider.ratio) * parent.height - self.height / 2;
        width: divider.vertical
            ? Theme.terminal-pane-divider-size
            : divider.width * parent.width;
        height: divider.vertical
            ? divider.height * parent.height
            : Theme.terminal-pane-divider-size;
        vertical: divider.vertical;
        ratio: divider.ratio;
        available-length: divider.vertical
            ? divider.width * parent.width
            : divider.height * parent.height;
        set-value(candidate) => { root.resize-terminal-divider(divider.id, candidate); }
        reset => { root.resize-terminal-divider(divider.id, 0.5); }
    }
}

// The detached rendering path contains only the transferable Terminal/SFTP
// surface. Its title and return control belong to the native window chrome.
component DetachedWorkspaceContent inherits Rectangle {
    in property <WorkspaceViewState> view;
    in property <string> terminal-edit-command;
    in property <int> terminal-edit-command-revision: 0;

    callback close-tab(string);
    callback list-sftp-directory(string);
    callback load-more-sftp();
    callback list-local-sftp-directory(string);
    callback navigate-sftp-back();
    callback navigate-sftp-forward();
    callback toggle-remote-sftp-selection(string, bool);
    callback select-all-remote-sftp(bool);
    callback toggle-local-sftp-selection(string, bool);
    callback select-all-local-sftp(bool);
    callback open-remote-sftp-file(string);
    callback open-local-sftp-file(string);
    callback cancel-sftp-transfer(string);
    callback terminal-key(string, string, bool, bool, bool, bool, bool) -> bool;
    callback terminal-key-direct(string, bool, bool, bool, bool, bool, bool) -> bool;
    callback resize-terminal(string, int, int);
    callback scroll-terminal(string, int);
    callback terminal-selection-text(string, int, int, int, int) -> string;
    callback terminal-pane-focus(string);
    callback terminal-pane-command(string, string) -> bool;
    callback resize-terminal-divider(int, float) -> bool;
    callback format-shortcut(string, bool, bool, bool, bool) -> string;
    callback write-clipboard(string);
    callback read-clipboard() -> string;

    private property <float> sftp-directory-split-ratio: 0.5;
    private property <float> sftp-files-split-ratio: 0.7;
    private property <bool> sftp-transfers-collapsed: false;

    background: Theme.background;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.background;

        if root.view.active_tab_kind == "terminal" : TerminalPaneGroup {
            width: parent.width;
            height: parent.height;
            panes: root.view.terminal_panes;
            dividers: root.view.terminal_dividers;
            terminal-edit-command: root.terminal-edit-command;
            terminal-edit-command-revision: root.terminal-edit-command-revision;
            format-shortcut(text, alt, control, meta, shift) => {
                return root.format-shortcut(text, alt, control, meta, shift);
            }
            terminal-key(id, text, alt, control, meta, shift, physical-key-event) => {
                return root.terminal-key(
                    id, text, alt, control, meta, shift, physical-key-event,
                );
            }
            terminal-key-direct(text, alt, control, meta, shift, option-as-meta, preedit-active) => {
                return root.terminal-key-direct(
                    text, alt, control, meta, shift, option-as-meta, preedit-active,
                );
            }
            resize-terminal(id, columns, rows) => { root.resize-terminal(id, columns, rows); }
            scroll-terminal(id, lines) => { root.scroll-terminal(id, lines); }
            terminal-selection-text(id, anchor-row, anchor-column, focus-row, focus-column) => {
                return root.terminal-selection-text(
                    id, anchor-row, anchor-column, focus-row, focus-column,
                );
            }
            terminal-pane-focus(id) => { root.terminal-pane-focus(id); }
            terminal-pane-command(id, command) => { return root.terminal-pane-command(id, command); }
            resize-terminal-divider(id, ratio) => {
                return root.resize-terminal-divider(id, ratio);
            }
            write-clipboard(text) => { root.write-clipboard(text); }
            read-clipboard() => { return root.read-clipboard(); }
        }

        if root.view.active_tab_kind == "sftp" : SftpPane {
            width: parent.width;
            height: parent.height;
            standalone: true;
            view: root.view.sftp;
            directory-split-ratio <=> root.sftp-directory-split-ratio;
            files-split-ratio <=> root.sftp-files-split-ratio;
            transfers-collapsed <=> root.sftp-transfers-collapsed;
            list-directory(path) => { root.list-sftp-directory(path); }
            load-more => { root.load-more-sftp(); }
            list-local-directory(path) => { root.list-local-sftp-directory(path); }
            navigate-back => { root.navigate-sftp-back(); }
            navigate-forward => { root.navigate-sftp-forward(); }
            toggle-remote-selection(path, selected) => {
                root.toggle-remote-sftp-selection(path, selected);
            }
            select-all-remote(selected) => { root.select-all-remote-sftp(selected); }
            toggle-local-selection(path, selected) => {
                root.toggle-local-sftp-selection(path, selected);
            }
            select-all-local(selected) => { root.select-all-local-sftp(selected); }
            open-remote-file(path) => { root.open-remote-sftp-file(path); }
            open-local-file(path) => { root.open-local-sftp-file(path); }
            cancel-transfer(id) => { root.cancel-sftp-transfer(id); }
            close => { root.close-tab(root.view.active_tab_id); }
        }
    }
}

export component WorkspaceShell inherits Rectangle {
    in property <WorkspaceViewState> view;
    in property <string> requested-settings-section: "General";
    in property <int> settings-section-request-revision: 0;
    in property <bool> detached-window: false;

    out property <bool> shortcut-recording: false;
    private property <bool> sidebar-collapsed: false;
    private property <bool> connection-picker-open: false;
    private property <float> sftp-directory-split-ratio: 0.5;
    private property <float> sftp-files-split-ratio: 0.7;
    private property <bool> sftp-transfers-collapsed: false;
    private property <string> terminal-edit-command: "";
    private property <int> terminal-edit-command-revision: 0;

    callback new-session();
    callback new-session-in-group(string);
    callback edit-session(string);
    callback copy-session(string);
    callback duplicate-session(string);
    callback session-transfer-action(string, string);
    callback request-session-management(string, string, string);
    callback open-local-shell();
    callback activate-tab(string);
    callback close-tab(string);
    callback move-tab(string, int);
    callback detach-workspace(string);
    callback return-workspace(string);
    callback save-settings(
        string, string, int, int, float, bool, string, string,
        string, string, string, string, string, string, string, string, string, string, string, string, string,
        string, string, string, string, string, string, string, string, string, string, string, string, string,
        bool, bool, string, string, bool, bool, string, int, int, int, int, int, string, int, string, string, string, string, string, string, string, string,
        string, string, bool,
    );
    callback connect-session(string);
    callback open-sftp-session(string);
    callback save-session(
        string, string, string, string, string, string, string, string,
        string, bool, string, string, bool, string, string, string, string, string, string, bool,
    );
    callback refresh-serial-ports();
    callback serial-mode-changed(bool);
    callback private-key-mode-changed(bool);
    callback cancel-session-dialog();
    callback open-sftp();
    callback list-sftp-directory(string);
    callback load-more-sftp();
    callback list-local-sftp-directory(string);
    callback navigate-sftp-back();
    callback navigate-sftp-forward();
    callback toggle-remote-sftp-selection(string, bool);
    callback select-all-remote-sftp(bool);
    callback toggle-local-sftp-selection(string, bool);
    callback select-all-local-sftp(bool);
    callback open-remote-sftp-file(string);
    callback open-local-sftp-file(string);
    callback cancel-sftp-transfer(string);
    callback close-sftp();
    callback terminal-key(string, string, bool, bool, bool, bool, bool) -> bool;
    callback terminal-key-direct(string, bool, bool, bool, bool, bool, bool) -> bool;
    callback resize-terminal(string, int, int);
    callback scroll-terminal(string, int);
    callback terminal-selection-text(string, int, int, int, int) -> string;
    callback terminal-pane-focus(string);
    callback terminal-pane-command(string, string) -> bool;
    callback resize-terminal-divider(int, float) -> bool;
    callback format-shortcut(string, bool, bool, bool, bool) -> string;
    callback write-clipboard(string);
    callback read-clipboard() -> string;
    callback report-bug();
    callback open-log-directory();
    callback copy-diagnostic-info();

    public function toggle-sidebar() {
        root.sidebar-collapsed = !root.sidebar-collapsed;
    }

    public function import-session-config() {
        session-navigation.import-session-config();
    }

    public function export-selected-session-config() {
        session-navigation.export-selected-session-config();
    }

    public function terminal-edit-action(command: string) {
        if command == "copy" || command == "paste" || command == "select-all" {
            root.terminal-edit-command = command;
            root.terminal-edit-command-revision = root.terminal-edit-command-revision == 2147483647
                ? 1
                : root.terminal-edit-command-revision + 1;
        }
    }

    public function dismiss-transient-controls() -> bool {
        if root.connection-picker-open {
            root.connection-picker-open = false;
            return true;
        }
        return false;
    }

    public function request-close-tab(id: string) {
        root.connection-picker-open = false;
        if !root.view.settings_tab_id.is-empty && id == root.view.settings_tab_id {
            settings-pane.request-close();
        } else {
            root.close-tab(id);
        }
    }

    if root.detached-window : DetachedWorkspaceContent {
        width: parent.width;
        height: parent.height;
        view: root.view;
        terminal-edit-command: root.terminal-edit-command;
        terminal-edit-command-revision: root.terminal-edit-command-revision;
        close-tab(id) => { root.close-tab(id); }
        list-sftp-directory(path) => { root.list-sftp-directory(path); }
        load-more-sftp => { root.load-more-sftp(); }
        list-local-sftp-directory(path) => { root.list-local-sftp-directory(path); }
        navigate-sftp-back => { root.navigate-sftp-back(); }
        navigate-sftp-forward => { root.navigate-sftp-forward(); }
        toggle-remote-sftp-selection(path, selected) => {
            root.toggle-remote-sftp-selection(path, selected);
        }
        select-all-remote-sftp(selected) => { root.select-all-remote-sftp(selected); }
        toggle-local-sftp-selection(path, selected) => {
            root.toggle-local-sftp-selection(path, selected);
        }
        select-all-local-sftp(selected) => { root.select-all-local-sftp(selected); }
        open-remote-sftp-file(path) => { root.open-remote-sftp-file(path); }
        open-local-sftp-file(path) => { root.open-local-sftp-file(path); }
        cancel-sftp-transfer(id) => { root.cancel-sftp-transfer(id); }
        terminal-key(id, text, alt, control, meta, shift, physical-key-event) => {
            return root.terminal-key(id, text, alt, control, meta, shift, physical-key-event);
        }
        terminal-key-direct(text, alt, control, meta, shift, option-as-meta, preedit-active) => {
            return root.terminal-key-direct(
                text, alt, control, meta, shift, option-as-meta, preedit-active,
            );
        }
        resize-terminal(id, columns, rows) => { root.resize-terminal(id, columns, rows); }
        scroll-terminal(id, lines) => { root.scroll-terminal(id, lines); }
        terminal-selection-text(id, anchor-row, anchor-column, focus-row, focus-column) => {
            return root.terminal-selection-text(
                id, anchor-row, anchor-column, focus-row, focus-column,
            );
        }
        terminal-pane-focus(id) => { root.terminal-pane-focus(id); }
        terminal-pane-command(id, command) => { return root.terminal-pane-command(id, command); }
        resize-terminal-divider(id, ratio) => {
            return root.resize-terminal-divider(id, ratio);
        }
        format-shortcut(text, alt, control, meta, shift) => {
            return root.format-shortcut(text, alt, control, meta, shift);
        }
        write-clipboard(text) => { root.write-clipboard(text); }
        read-clipboard() => { return root.read-clipboard(); }
    }

    workspace-main := HorizontalLayout {
        visible: !root.detached-window;
        width: parent.width;
        height: parent.height;
        spacing: 0px;

        session-navigation := SessionNavigation {
            sessions: root.view.sessions;
            sidebar-width: root.view.sidebar_width;
            collapsed-group-label-chars: root.view.collapsed_group_label_chars;
            collapsed <=> root.sidebar-collapsed;
            open-local-shell => { root.open-local-shell(); }
            new-session => { root.new-session(); }
            connect-session(id) => { root.connect-session(id); }
            open-sftp(id) => { root.open-sftp-session(id); }
            new-group => { root.request-session-management("new-group", "", ""); }
            new-session-in-group(group-name) => { root.new-session-in-group(group-name); }
            rename-group(group-name) => {
                root.request-session-management("rename-group", group-name, group-name);
            }
            delete-group(group-name) => {
                root.request-session-management("delete-group", group-name, group-name);
            }
            edit-session(id) => { root.edit-session(id); }
            copy-session(id) => { root.copy-session(id); }
            duplicate-session(id) => { root.duplicate-session(id); }
            session-transfer-action(action, target) => {
                root.session-transfer-action(action, target);
            }
            delete-session(id, name) => {
                root.request-session-management("delete-session", id, name);
            }
        }

        workspace-area := Rectangle {
            horizontal-stretch: 1;
            background: Theme.background;

            VerticalLayout {
                spacing: 0px;

                workspace-titlebar := WorkspaceTitlebar {
                    tabs: root.view.workspace_tabs;
                    active-tab-id: root.view.active_tab_id;
                    active-tab-kind: root.view.active_tab_kind;
                    tab-width: root.view.tab_width;
                    terminal-background: root.view.terminal_background;
                    connection-picker-open: root.connection-picker-open;
                    detached-window: root.detached-window;
                    activate-tab(id) => {
                        root.connection-picker-open = false;
                        root.activate-tab(id);
                    }
                    close-tab(id) => {
                        root.request-close-tab(id);
                    }
                    move-tab(id, target-index) => {
                        root.connection-picker-open = false;
                        root.move-tab(id, target-index);
                    }
                    detach-workspace(id) => {
                        root.connection-picker-open = false;
                        root.detach-workspace(id);
                    }
                    return-workspace(id) => {
                        root.connection-picker-open = false;
                        root.return-workspace(id);
                    }
                    terminal-pane-command(command) => {
                        root.terminal-pane-command(root.view.active_pane_id, command);
                    }
                    toggle-connection-picker => {
                        root.connection-picker-open = !root.connection-picker-open;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.background;

                    if root.view.active_tab_kind == "terminal" : TerminalPaneGroup {
                        width: parent.width;
                        height: parent.height;
                        panes: root.view.terminal_panes;
                        dividers: root.view.terminal_dividers;
                        terminal-edit-command: root.terminal-edit-command;
                        terminal-edit-command-revision: root.terminal-edit-command-revision;
                        format-shortcut(text, alt, control, meta, shift) => {
                            return root.format-shortcut(text, alt, control, meta, shift);
                        }
                        terminal-key(id, text, alt, control, meta, shift, physical-key-event) => {
                            return root.terminal-key(
                                id, text, alt, control, meta, shift, physical-key-event,
                            );
                        }
                        terminal-key-direct(text, alt, control, meta, shift, option-as-meta, preedit-active) => {
                            return root.terminal-key-direct(
                                text, alt, control, meta, shift, option-as-meta, preedit-active,
                            );
                        }
                        resize-terminal(id, columns, rows) => { root.resize-terminal(id, columns, rows); }
                        scroll-terminal(id, lines) => { root.scroll-terminal(id, lines); }
                        terminal-selection-text(id, anchor-row, anchor-column, focus-row, focus-column) => {
                            return root.terminal-selection-text(
                                id, anchor-row, anchor-column, focus-row, focus-column,
                            );
                        }
                        terminal-pane-focus(id) => { root.terminal-pane-focus(id); }
                        terminal-pane-command(id, command) => {
                            return root.terminal-pane-command(id, command);
                        }
                        resize-terminal-divider(id, ratio) => {
                            return root.resize-terminal-divider(id, ratio);
                        }
                        write-clipboard(text) => { root.write-clipboard(text); }
                        read-clipboard() => { return root.read-clipboard(); }
                    }

                    if root.view.active_tab_kind == "sftp" : SftpPane {
                        width: parent.width;
                        height: parent.height;
                        standalone: true;
                        view: root.view.sftp;
                        directory-split-ratio <=> root.sftp-directory-split-ratio;
                        files-split-ratio <=> root.sftp-files-split-ratio;
                        transfers-collapsed <=> root.sftp-transfers-collapsed;
                        list-directory(path) => { root.list-sftp-directory(path); }
                        load-more => { root.load-more-sftp(); }
                        list-local-directory(path) => { root.list-local-sftp-directory(path); }
                        navigate-back => { root.navigate-sftp-back(); }
                        navigate-forward => { root.navigate-sftp-forward(); }
                        toggle-remote-selection(path, selected) => {
                            root.toggle-remote-sftp-selection(path, selected);
                        }
                        select-all-remote(selected) => { root.select-all-remote-sftp(selected); }
                        toggle-local-selection(path, selected) => {
                            root.toggle-local-sftp-selection(path, selected);
                        }
                        select-all-local(selected) => { root.select-all-local-sftp(selected); }
                        open-remote-file(path) => { root.open-remote-sftp-file(path); }
                        open-local-file(path) => { root.open-local-sftp-file(path); }
                        cancel-transfer(id) => { root.cancel-sftp-transfer(id); }
                        close => { root.close-tab(root.view.active_tab_id); }
                    }

                    settings-pane := SettingsPane {
                        visible: root.view.active_tab_kind == "settings";
                        width: parent.width;
                        height: parent.height;
                        source: root.view.settings;
                        tab-id: root.view.settings_tab_id;
                        requested-section: root.requested-settings-section;
                        requested-section-revision: root.settings-section-request-revision;
                        save(application-font, terminal-font, size, line-height, minimum-contrast-ratio, bright-bold, theme-mode, theme-palette,
                             theme-light-background, theme-light-panel, theme-light-panel-alt, theme-light-border,
                             theme-light-text, theme-light-muted, theme-light-accent, theme-light-success,
                             theme-light-danger, theme-light-overlay, theme-light-terminal-foreground,
                             theme-light-terminal-background, theme-light-terminal-selection, theme-dark-background,
                             theme-dark-panel, theme-dark-panel-alt, theme-dark-border, theme-dark-text,
                             theme-dark-muted, theme-dark-accent, theme-dark-success, theme-dark-danger,
                             theme-dark-overlay, theme-dark-terminal-foreground, theme-dark-terminal-background,
                             theme-dark-terminal-selection, right-click-copy, option-as-meta,
                             x11-provider, x11-app-path, x11-launch, x11-no-auth, shell,
                             scrollback, columns, rows, sidebar, tab-size, mask-character, collapsed-label-chars, open-settings-key,
                             new-session-key, import-key, export-key, toggle-sidebar-key, copy-key, paste-key, open-sftp-key, credential-storage,
                             settings-tab-id, close-after-save) => {
                            root.save-settings(
                                application-font, terminal-font, size, line-height, minimum-contrast-ratio, bright-bold, theme-mode, theme-palette,
                                theme-light-background, theme-light-panel, theme-light-panel-alt, theme-light-border,
                                theme-light-text, theme-light-muted, theme-light-accent, theme-light-success,
                                theme-light-danger, theme-light-overlay, theme-light-terminal-foreground,
                                theme-light-terminal-background, theme-light-terminal-selection, theme-dark-background,
                                theme-dark-panel, theme-dark-panel-alt, theme-dark-border, theme-dark-text,
                                theme-dark-muted, theme-dark-accent, theme-dark-success, theme-dark-danger,
                                theme-dark-overlay, theme-dark-terminal-foreground, theme-dark-terminal-background,
                                theme-dark-terminal-selection, right-click-copy, option-as-meta,
                                x11-provider, x11-app-path, x11-launch, x11-no-auth, shell, scrollback, columns, rows,
                                sidebar, tab-size, mask-character, collapsed-label-chars, open-settings-key, new-session-key, import-key, export-key,
                                toggle-sidebar-key, copy-key,
                                paste-key, open-sftp-key, credential-storage, settings-tab-id, close-after-save,
                            );
                        }
                        format-shortcut(text, alt, control, meta, shift) => {
                            return root.format-shortcut(text, alt, control, meta, shift);
                        }
                        shortcut-recording-changed(recording) => {
                            root.shortcut-recording = recording;
                        }
                        report-bug => { root.report-bug(); }
                        open-log-directory => { root.open-log-directory(); }
                        copy-diagnostic-info => { root.copy-diagnostic-info(); }
                    }

                    if root.view.active_tab_kind == "session-editor" : SessionEditorPane {
                        source: root.view.session_editor;
                        save(name, group, protocol, host, port, username, auth, key-path, password, remember-password, credential-storage, vault-password, x11-forwarding,
                             serial-port, baud-rate, data-bits, stop-bits, parity, flow-control,
                             connect-after-save) => {
                            root.save-session(
                                name, group, protocol, host, port, username, auth, key-path, password, remember-password, credential-storage, vault-password, x11-forwarding,
                                serial-port, baud-rate, data-bits, stop-bits, parity, flow-control,
                                connect-after-save,
                            );
                        }
                        refresh-serial-ports => { root.refresh-serial-ports(); }
                        serial-mode-changed(enabled) => { root.serial-mode-changed(enabled); }
                        private-key-mode-changed(enabled) => { root.private-key-mode-changed(enabled); }
                        cancel => { root.cancel-session-dialog(); }
                    }

                    if root.view.active_tab_kind == "empty" : VerticalLayout {
                        padding: Theme.empty-page-padding;
                        spacing: Theme.space-lg;
                        Text {
                            text: "Workspace";
                            color: Theme.text;
                            font-size: Theme.font-page-title;
                            font-weight: 700;
                        }
                        Text {
                            text: "Open a saved session or create a new tab.";
                            color: Theme.muted;
                            font-size: Theme.font-body;
                        }
                        Rectangle { vertical-stretch: 1; }
                        if !root.view.status.is-empty : Text {
                            text: root.view.status;
                            color: Theme.accent;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if root.connection-picker-open : TouchArea {
                y: workspace-titlebar.height;
                width: parent.width;
                height: parent.height - self.y;
                clicked => { root.connection-picker-open = false; }
            }

            if root.connection-picker-open : ConnectionPicker {
                x: max(Theme.space-xs, parent.width - self.width);
                y: workspace-titlebar.height;
                sessions: root.view.connection_options;
                connect-session(id) => {
                    root.connection-picker-open = false;
                    root.connect-session(id);
                }
                dismiss => { root.connection-picker-open = false; }
            }
        }
    }
}
