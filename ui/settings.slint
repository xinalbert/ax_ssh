            root.draft-terminal-row-render-cache,
            root.draft-terminal-cursor-blink,
            root.draft-focused-terminal-refresh-fps,
            root.draft-unfocused-terminal-refresh-fps,
            root.draft-semantic-link-color,
            root.draft-semantic-success-color,
            root.draft-semantic-info-color,
            root.draft-semantic-warning-color,
            root.draft-semantic-error-color,
            root.draft-theme-mode,
            root.draft-theme-palette,
            root.draft-theme-light-background,
            root.draft-theme-light-panel,
            root.draft-theme-light-panel-alt,
            root.draft-theme-light-border,
            root.draft-theme-light-text,
            root.draft-theme-light-muted,
            root.draft-theme-light-accent,
            root.draft-theme-light-success,
            root.draft-theme-light-danger,
            root.draft-theme-light-overlay,
            root.draft-theme-light-terminal-foreground,
            root.draft-theme-light-terminal-background,
            root.draft-theme-light-terminal-selection,
            root.draft-theme-dark-background,
            root.draft-theme-dark-panel,
            root.draft-theme-dark-panel-alt,
            root.draft-theme-dark-border,
            root.draft-theme-dark-text,
            root.draft-theme-dark-muted,
            root.draft-theme-dark-accent,
            root.draft-theme-dark-success,
            root.draft-theme-dark-danger,
            root.draft-theme-dark-overlay,
            root.draft-theme-dark-terminal-foreground,
            root.draft-theme-dark-terminal-background,
            root.draft-theme-dark-terminal-selection,
            root.draft-right-click-copy-or-paste,
            root.draft-copy-selection-on-select,
            root.draft-terminal-mouse-local-selection-priority,
            root.draft-option-as-meta,
            root.draft-x11-server-provider,
            root.draft-x11-server-app-path,
            root.draft-x11-launch-on-connect,
            root.draft-x11-allow-no-auth,
            root.draft-local-shell,
            root.draft-scrollback-lines,
            root.draft-columns,
            root.draft-rows,
            root.draft-sidebar-width,
            root.draft-tab-width,
            root.draft-session-mask-character,
            root.draft-collapsed-group-label-chars,
            root.draft-open-settings-shortcut,
            root.draft-new-session-shortcut,
            root.draft-import-sessions-shortcut,
            root.draft-export-selected-shortcut,
            root.draft-toggle-sidebar-shortcut,
            root.draft-copy-selection-shortcut,
            root.draft-paste-shortcut,
            root.draft-open-sftp-shortcut,
            root.draft-credential-storage,
            root.tab-id,
            close-after-save,
        );
    }

    changed draft-application-font-family => { root.schedule-preview(); }
    changed draft-renderer-preference => { root.schedule-preview(); }
    changed draft-font-family => { root.schedule-preview(); }
    changed draft-font-size => { root.schedule-preview(); }
    changed draft-line-height-percent => { root.schedule-preview(); }
    changed draft-text-brightness => { root.schedule-preview(); }
    changed draft-bright-bold-text => { root.schedule-preview(); }
    changed draft-semantic-highlighting => { root.schedule-preview(); }
    changed draft-terminal-compact-rendering => { root.schedule-preview(); }
    changed draft-terminal-row-render-cache => { root.schedule-preview(); }
    changed draft-terminal-cursor-blink => { root.schedule-preview(); }
    changed draft-focused-terminal-refresh-fps => { root.schedule-preview(); }
    changed draft-unfocused-terminal-refresh-fps => { root.schedule-preview(); }
    changed draft-semantic-link-color => { root.schedule-preview(); }
    changed draft-semantic-success-color => { root.schedule-preview(); }
    changed draft-semantic-info-color => { root.schedule-preview(); }
    changed draft-semantic-warning-color => { root.schedule-preview(); }
    changed draft-semantic-error-color => { root.schedule-preview(); }
    changed draft-theme-mode => { root.schedule-preview(); }
    changed draft-theme-palette => { root.schedule-preview(); }
    changed draft-theme-light-background => { root.schedule-preview(); }
    changed draft-theme-light-panel => { root.schedule-preview(); }
    changed draft-theme-light-panel-alt => { root.schedule-preview(); }
    changed draft-theme-light-border => { root.schedule-preview(); }
    changed draft-theme-light-text => { root.schedule-preview(); }
    changed draft-theme-light-muted => { root.schedule-preview(); }
    changed draft-theme-light-accent => { root.schedule-preview(); }
    changed draft-theme-light-success => { root.schedule-preview(); }
    changed draft-theme-light-danger => { root.schedule-preview(); }
    changed draft-theme-light-overlay => { root.schedule-preview(); }
    changed draft-theme-light-terminal-foreground => { root.schedule-preview(); }
    changed draft-theme-light-terminal-background => { root.schedule-preview(); }
    changed draft-theme-light-terminal-selection => { root.schedule-preview(); }
    changed draft-theme-dark-background => { root.schedule-preview(); }
    changed draft-theme-dark-panel => { root.schedule-preview(); }
    changed draft-theme-dark-panel-alt => { root.schedule-preview(); }
    changed draft-theme-dark-border => { root.schedule-preview(); }
    changed draft-theme-dark-text => { root.schedule-preview(); }
    changed draft-theme-dark-muted => { root.schedule-preview(); }
    changed draft-theme-dark-accent => { root.schedule-preview(); }
    changed draft-theme-dark-success => { root.schedule-preview(); }
    changed draft-theme-dark-danger => { root.schedule-preview(); }
    changed draft-theme-dark-overlay => { root.schedule-preview(); }
    changed draft-theme-dark-terminal-foreground => { root.schedule-preview(); }
    changed draft-theme-dark-terminal-background => { root.schedule-preview(); }
    changed draft-theme-dark-terminal-selection => { root.schedule-preview(); }
    changed draft-right-click-copy-or-paste => { root.schedule-preview(); }
    changed draft-copy-selection-on-select => { root.schedule-preview(); }
    changed draft-terminal-mouse-local-selection-priority => { root.schedule-preview(); }
    changed draft-option-as-meta => { root.schedule-preview(); }
    changed draft-x11-server-provider => { root.schedule-preview(); }
    changed draft-x11-server-app-path => { root.schedule-preview(); }
    changed draft-x11-launch-on-connect => { root.schedule-preview(); }
    changed draft-x11-allow-no-auth => { root.schedule-preview(); }
    changed draft-scrollback-lines => { root.schedule-preview(); }
    changed draft-columns => { root.schedule-preview(); }
    changed draft-rows => { root.schedule-preview(); }
    changed draft-local-shell => { root.schedule-preview(); }
    changed draft-credential-storage => { root.schedule-preview(); }
    changed draft-sidebar-width => { root.schedule-preview(); }
    changed draft-tab-width => { root.schedule-preview(); }
    changed draft-session-mask-character => { root.schedule-preview(); }
    changed draft-collapsed-group-label-chars => { root.schedule-preview(); }
    changed draft-open-settings-shortcut => { root.schedule-preview(); }
    changed draft-new-session-shortcut => { root.schedule-preview(); }
    changed draft-import-sessions-shortcut => { root.schedule-preview(); }
    changed draft-export-selected-shortcut => { root.schedule-preview(); }
    changed draft-toggle-sidebar-shortcut => { root.schedule-preview(); }
    changed draft-copy-selection-shortcut => { root.schedule-preview(); }
    changed draft-paste-shortcut => { root.schedule-preview(); }
    changed draft-open-sftp-shortcut => { root.schedule-preview(); }

    Timer {
        running: root.preview-pending;
        interval: 1ms;
        triggered => {
            root.preview-pending = false;
            root.preview-settings();
        }
    }

    background: Theme.background;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: Theme.settings-nav-width;
            background: Theme.panel;

            Rectangle {
                x: parent.width - Theme.hairline;
                width: Theme.hairline;
                height: parent.height;
                background: Theme.divider;
            }

            VerticalLayout {
                padding-left: Theme.space-lg;
                padding-right: Theme.space-lg;
                padding-top: Theme.space-lg;
                padding-bottom: Theme.space-lg;
                spacing: Theme.space-xs;

                Text {
                    height: Theme.settings-nav-title-height;
                    text: @tr("Settings");
                    color: Theme.text;
                    font-size: Theme.font-section;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                SettingsNavItem {
                    icon: SettingsNavIcon.General;
                    label: @tr("General");
                    selected: root.selected-section == "General";
                    activated => { root.select-section("General"); }
                }
                SettingsNavItem {
                    icon: SettingsNavIcon.Appearance;
                    label: @tr("Appearance");
                    selected: root.selected-section == "Appearance";
                    activated => { root.select-section("Appearance"); }
                }
                SettingsNavItem {
                    icon: SettingsNavIcon.Terminal;
                    label: @tr("Terminal");
                    selected: root.selected-section == "Terminal";
                    activated => { root.select-section("Terminal"); }
                }
                SettingsNavItem {
                    icon: SettingsNavIcon.X11;
                    label: @tr("X11");
                    selected: root.selected-section == "X11";
                    activated => { root.select-section("X11"); }
                }
                SettingsNavItem {
                    icon: SettingsNavIcon.Workspace;
                    label: @tr("Workspace");
                    selected: root.selected-section == "Workspace";
                    activated => { root.select-section("Workspace"); }
                }
                SettingsNavItem {
                    icon: SettingsNavIcon.Shortcuts;
                    label: @tr("Shortcuts");
                    selected: root.selected-section == "Shortcuts";
                    activated => { root.select-section("Shortcuts"); }
                }

                Rectangle { vertical-stretch: 1; }
                Rectangle { height: Theme.hairline; background: Theme.divider; }
                SettingsNavItem {
                    icon: SettingsNavIcon.About;
                    label: @tr("About");
                    selected: root.selected-section == "About";
                    activated => { root.select-section("About"); }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.background;

            VerticalLayout {
                spacing: 0px;

                SettingsHeader {
                    title: root.section-title;
                    search-query <=> root.settings-search-query;
                    clear-search => { root.clear-settings-search(); }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.background;

                    if !root.settings-search-query.is-empty : ScrollView {
                        width: parent.width;
                        height: parent.height;
                        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        viewport-width: self.visible-width;
                        viewport-height: max(
                            self.visible-height,
                            search-results.preferred-height + 2 * Theme.space-xl,
                        );

                        search-page := Rectangle {
                            width: parent.visible-width;
                            height: max(
                                parent.visible-height,
                                search-results.preferred-height + 2 * Theme.space-xl,
                            );
                            background: Theme.background;

                            search-results := VerticalLayout {
                                x: Theme.page-padding;
                                y: Theme.space-xl;
                                width: min(
                                    Theme.settings-content-width,
                                    parent.width - 2 * Theme.page-padding,
                                );
                                height: self.preferred-height;
                                spacing: 0px;

                                Text {
                                    height: Theme.settings-section-min-height;
                                    text: @tr("Search results");
                                    color: Theme.muted;
                                    font-size: Theme.font-caption;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                for entry in root.settings-search-entries : SettingsSearchResult {
                                    section: entry.section;
                                    title: entry.title;
                                    description: entry.description;
                                    activated => {
                                        root.select-section(entry.section);
                                    }
                                }
                                Text {
                                    visible: root.settings-search-entries.length == 0;
                                    height: Theme.settings-row-min-height;
                                    text: @tr("No settings match this search.");
                                    color: Theme.muted;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if root.settings-search-query.is-empty && root.selected-section == "General" : GeneralSettingsPage {
                        width: parent.width;
                        height: parent.height;
                        scroll-revision: root.section-scroll-revision;
                        local-shell-options: root.local-shell-options;
                        draft-local-shell <=> root.draft-local-shell;
                        draft-local-shell-index <=> root.draft-local-shell-index;
                        draft-columns <=> root.draft-columns;
                        draft-rows <=> root.draft-rows;
                        draft-credential-storage <=> root.draft-credential-storage;
                        ui-language: root.ui-language;
                        save-ui-language(index) => { root.save-ui-language(index); }
                    }

                    if root.settings-search-query.is-empty && root.selected-section == "Appearance" : AppearanceSettingsPage {
                        width: parent.width;
                        height: parent.height;
                        scroll-revision: root.section-scroll-revision;
                        application-font-options: root.application-font-options;
                        draft-application-font-family <=> root.draft-application-font-family;
                        draft-application-font-index <=> root.draft-application-font-index;
                        draft-renderer-preference <=> root.draft-renderer-preference;
                        draft-terminal-compact-rendering <=> root.draft-terminal-compact-rendering;
                        draft-terminal-row-render-cache <=> root.draft-terminal-row-render-cache;
                        draft-terminal-cursor-blink <=> root.draft-terminal-cursor-blink;
                        draft-focused-terminal-refresh-fps <=> root.draft-focused-terminal-refresh-fps;
                        draft-unfocused-terminal-refresh-fps <=> root.draft-unfocused-terminal-refresh-fps;
                        draft-theme-mode <=> root.draft-theme-mode;
                        draft-theme-palette <=> root.draft-theme-palette;
                        draft-theme-light-background <=> root.draft-theme-light-background;
                        draft-theme-light-panel <=> root.draft-theme-light-panel;
                        draft-theme-light-panel-alt <=> root.draft-theme-light-panel-alt;
                        draft-theme-light-border <=> root.draft-theme-light-border;
                        draft-theme-light-text <=> root.draft-theme-light-text;
                        draft-theme-light-muted <=> root.draft-theme-light-muted;
                        draft-theme-light-accent <=> root.draft-theme-light-accent;
                        draft-theme-light-success <=> root.draft-theme-light-success;
                        draft-theme-light-danger <=> root.draft-theme-light-danger;
                        draft-theme-light-overlay <=> root.draft-theme-light-overlay;
                        draft-theme-light-terminal-foreground <=> root.draft-theme-light-terminal-foreground;
                        draft-theme-light-terminal-background <=> root.draft-theme-light-terminal-background;
                        draft-theme-light-terminal-selection <=> root.draft-theme-light-terminal-selection;
                        draft-theme-dark-background <=> root.draft-theme-dark-background;
                        draft-theme-dark-panel <=> root.draft-theme-dark-panel;
                        draft-theme-dark-panel-alt <=> root.draft-theme-dark-panel-alt;
                        draft-theme-dark-border <=> root.draft-theme-dark-border;
                        draft-theme-dark-text <=> root.draft-theme-dark-text;
                        draft-theme-dark-muted <=> root.draft-theme-dark-muted;
                        draft-theme-dark-accent <=> root.draft-theme-dark-accent;
                        draft-theme-dark-success <=> root.draft-theme-dark-success;
                        draft-theme-dark-danger <=> root.draft-theme-dark-danger;
                        draft-theme-dark-overlay <=> root.draft-theme-dark-overlay;
                        draft-theme-dark-terminal-foreground <=> root.draft-theme-dark-terminal-foreground;
                        draft-theme-dark-terminal-background <=> root.draft-theme-dark-terminal-background;
                        draft-theme-dark-terminal-selection <=> root.draft-theme-dark-terminal-selection;
                    }

                    if root.settings-search-query.is-empty && root.selected-section == "Terminal" : TerminalSettingsPage {
                        width: parent.width;
                        height: parent.height;
                        scroll-revision: root.section-scroll-revision;
                        terminal-font-options: root.terminal-font-options;
                        draft-font-family <=> root.draft-font-family;
                        draft-font-index <=> root.draft-font-index;
                        draft-font-size <=> root.draft-font-size;
                        draft-line-height-percent <=> root.draft-line-height-percent;
                        draft-text-brightness <=> root.draft-text-brightness;
                        draft-bright-bold-text <=> root.draft-bright-bold-text;
                        draft-semantic-highlighting <=> root.draft-semantic-highlighting;
                        draft-semantic-link-color <=> root.draft-semantic-link-color;
                        draft-semantic-success-color <=> root.draft-semantic-success-color;
                        draft-semantic-info-color <=> root.draft-semantic-info-color;
                        draft-semantic-warning-color <=> root.draft-semantic-warning-color;
                        draft-semantic-error-color <=> root.draft-semantic-error-color;
                        draft-scrollback-lines <=> root.draft-scrollback-lines;
                        draft-right-click-copy-or-paste <=> root.draft-right-click-copy-or-paste;
                        draft-copy-selection-on-select <=> root.draft-copy-selection-on-select;
                        draft-terminal-mouse-local-selection-priority <=> root.draft-terminal-mouse-local-selection-priority;
                        apple-platform: root.apple-platform;
                        draft-option-as-meta <=> root.draft-option-as-meta;
                    }

                    if root.settings-search-query.is-empty && root.selected-section == "X11" : X11SettingsPage {
                        width: parent.width;
                        height: parent.height;
                        scroll-revision: root.section-scroll-revision;
                        provider-options: root.x11-server-provider-options;
                        discovered-installations: root.x11-server-installations;
                        draft-provider <=> root.draft-x11-server-provider;
                        draft-provider-index <=> root.draft-x11-server-provider-index;
                        draft-app-path <=> root.draft-x11-server-app-path;
                        draft-launch-on-connect <=> root.draft-x11-launch-on-connect;
                        draft-allow-no-auth <=> root.draft-x11-allow-no-auth;
                    }

                    if root.settings-search-query.is-empty && root.selected-section == "Workspace" : WorkspaceSettingsPage {
                        width: parent.width;
                        height: parent.height;
                        scroll-revision: root.section-scroll-revision;
                        draft-sidebar-width <=> root.draft-sidebar-width;
                        draft-tab-width <=> root.draft-tab-width;
                        draft-session-mask-character <=> root.draft-session-mask-character;
                        draft-collapsed-group-label-chars <=> root.draft-collapsed-group-label-chars;
                    }

                    if root.settings-search-query.is-empty && root.selected-section == "Shortcuts" : ShortcutsSettingsPage {
                        width: parent.width;
                        height: parent.height;
                        scroll-revision: root.section-scroll-revision;
                        draft-open-settings-shortcut <=> root.draft-open-settings-shortcut;
                        draft-new-session-shortcut <=> root.draft-new-session-shortcut;
                        draft-import-sessions-shortcut <=> root.draft-import-sessions-shortcut;
                        draft-export-selected-shortcut <=> root.draft-export-selected-shortcut;
                        draft-toggle-sidebar-shortcut <=> root.draft-toggle-sidebar-shortcut;
                        draft-copy-selection-shortcut <=> root.draft-copy-selection-shortcut;
                        draft-paste-shortcut <=> root.draft-paste-shortcut;
                        draft-open-sftp-shortcut <=> root.draft-open-sftp-shortcut;
                        default-open-settings-shortcut: root.default-open-settings-shortcut;
                        default-new-session-shortcut: root.default-new-session-shortcut;
                        default-import-sessions-shortcut: root.default-import-sessions-shortcut;
                        default-export-selected-shortcut: root.default-export-selected-shortcut;
                        default-toggle-sidebar-shortcut: root.default-toggle-sidebar-shortcut;
                        default-copy-selection-shortcut: root.default-copy-selection-shortcut;
                        default-paste-shortcut: root.default-paste-shortcut;
                        default-open-sftp-shortcut: root.default-open-sftp-shortcut;
                        format-shortcut(text, alt, control, meta, shift) => {
                            return root.format-shortcut(text, alt, control, meta, shift);
                        }
                        shortcut-recording-changed(recording) => {
                            root.shortcut-recording-changed(recording);
                        }
                    }

                    if root.settings-search-query.is-empty && root.selected-section == "About" : AboutSettingsPage {
                        width: parent.width;
                        height: parent.height;
                        scroll-revision: root.section-scroll-revision;
                        app-version: root.app-version;
                        report-bug => { root.report-bug(); }
                        open-log-directory => { root.open-log-directory(); }
                        copy-diagnostic-info => { root.copy-diagnostic-info(); }
                    }
                }

            }
        }
    }
}
