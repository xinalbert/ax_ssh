import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import {
    SettingsHeader,
    SettingsNavIcon,
    SettingsNavItem,
    SettingsSearchResult,
} from "components/settings-controls.slint";
import { GeneralSettingsPage } from "settings/general.slint";
import { AppearanceSettingsPage } from "settings/appearance.slint";
