    pure function localized-section-title(section: string) -> string {
        if section == "Appearance" { return @tr("Appearance"); }
        if section == "Terminal" { return @tr("Terminal"); }
        if section == "X11" { return @tr("X11"); }
        if section == "Workspace" { return @tr("Workspace"); }
        if section == "Shortcuts" { return @tr("Shortcuts"); }
        if section == "About" { return @tr("About"); }
        return @tr("General");
    }

    function select-section(section: string) {
        root.shortcut-recording-changed(false);
        root.clear-settings-search();
        root.selected-section = section;
        root.section-scroll-revision = root.section-scroll-revision == 2147483647
            ? 1
            : root.section-scroll-revision + 1;
    }

    function clear-settings-search() {
        root.settings-search-query = "";
    }

    changed requested-section => { root.select-section(root.requested-section); }
    changed requested-section-revision => { root.select-section(root.requested-section); }

    public function request-close() {
        root.commit-settings(true);
    }

    function schedule-preview() {
        root.preview-pending = true;
    }

    function preview-settings() {
        root.save(
            root.draft-application-font-family,
            root.draft-renderer-preference,
            root.draft-font-family,
            root.draft-font-size,
            root.draft-line-height-percent,
            root.draft-text-brightness,
            root.draft-bright-bold-text,
            root.draft-semantic-highlighting,
            root.draft-terminal-compact-rendering,
            root.draft-terminal-row-render-cache,
            root.draft-terminal-cursor-blink,
            root.draft-focused-terminal-refresh-fps,
            root.draft-unfocused-terminal-refresh-fps,
            root.draft-semantic-link-color,
            root.draft-semantic-success-color,
            root.draft-semantic-info-color,
            root.draft-semantic-warning-color,
            root.draft-semantic-error-color,
            root.draft-theme-mode,
            root.draft-theme-palette,
            root.draft-theme-light-background,
            root.draft-theme-light-panel,
            root.draft-theme-light-panel-alt,
            root.draft-theme-light-border,
            root.draft-theme-light-text,
            root.draft-theme-light-muted,
            root.draft-theme-light-accent,
            root.draft-theme-light-success,
            root.draft-theme-light-danger,
            root.draft-theme-light-overlay,
            root.draft-theme-light-terminal-foreground,
            root.draft-theme-light-terminal-background,
            root.draft-theme-light-terminal-selection,
            root.draft-theme-dark-background,
            root.draft-theme-dark-panel,
            root.draft-theme-dark-panel-alt,
            root.draft-theme-dark-border,
            root.draft-theme-dark-text,
            root.draft-theme-dark-muted,
            root.draft-theme-dark-accent,
            root.draft-theme-dark-success,
            root.draft-theme-dark-danger,
            root.draft-theme-dark-overlay,
            root.draft-theme-dark-terminal-foreground,
            root.draft-theme-dark-terminal-background,
            root.draft-theme-dark-terminal-selection,
            root.draft-right-click-copy-or-paste,
            root.draft-copy-selection-on-select,
            root.draft-terminal-mouse-local-selection-priority,
            root.draft-option-as-meta,
            root.draft-x11-server-provider,
            root.draft-x11-server-app-path,
            root.draft-x11-launch-on-connect,
            root.draft-x11-allow-no-auth,
            root.draft-local-shell,
            root.draft-scrollback-lines,
            root.draft-columns,
            root.draft-rows,
            root.draft-sidebar-width,
            root.draft-tab-width,
            root.draft-session-mask-character,
            root.draft-collapsed-group-label-chars,
            root.draft-open-settings-shortcut,
            root.draft-new-session-shortcut,
            root.draft-import-sessions-shortcut,
            root.draft-export-selected-shortcut,
            root.draft-toggle-sidebar-shortcut,
            root.draft-copy-selection-shortcut,
            root.draft-paste-shortcut,
            root.draft-open-sftp-shortcut,
            root.draft-credential-storage,
            "",
            false,
        );
    }

    function commit-settings(close-after-save: bool) {
        root.shortcut-recording-changed(false);
        root.save(
            root.draft-application-font-family,
            root.draft-renderer-preference,
            root.draft-font-family,
            root.draft-font-size,
            root.draft-line-height-percent,
            root.draft-text-brightness,
            root.draft-bright-bold-text,
            root.draft-semantic-highlighting,
