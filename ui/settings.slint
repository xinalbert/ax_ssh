import { Theme } from "theme.slint";
import {
    SettingsHeader,
    SettingsNavIcon,
    SettingsNavItem,
} from "components/settings-controls.slint";
import { GeneralSettingsPage } from "settings/general.slint";
import { AppearanceSettingsPage } from "settings/appearance.slint";
import { TerminalSettingsPage } from "settings/terminal.slint";
import { WorkspaceSettingsPage } from "settings/workspace.slint";
import { ShortcutsSettingsPage } from "settings/shortcuts.slint";
import { AboutSettingsPage } from "settings/about.slint";

export component SettingsPane inherits Rectangle {
    in property <[string]> local-shell-options;
    in property <string> terminal-font-family;
    in property <int> terminal-font-size;
    in property <int> terminal-line-height-percent;
    in property <int> terminal-brightness-percent;
    in property <bool> bright-bold-text;
    in property <string> theme-mode;
    in property <string> theme-palette;
    in property <string> theme-light-background;
    in property <string> theme-light-panel;
    in property <string> theme-light-panel-alt;
    in property <string> theme-light-border;
    in property <string> theme-light-text;
    in property <string> theme-light-muted;
    in property <string> theme-light-accent;
    in property <string> theme-light-success;
    in property <string> theme-light-danger;
    in property <string> theme-light-overlay;
    in property <string> theme-light-terminal-foreground;
    in property <string> theme-light-terminal-background;
    in property <string> theme-light-terminal-selection;
    in property <string> theme-dark-background;
    in property <string> theme-dark-panel;
    in property <string> theme-dark-panel-alt;
    in property <string> theme-dark-border;
    in property <string> theme-dark-text;
    in property <string> theme-dark-muted;
    in property <string> theme-dark-accent;
    in property <string> theme-dark-success;
    in property <string> theme-dark-danger;
    in property <string> theme-dark-overlay;
    in property <string> theme-dark-terminal-foreground;
    in property <string> theme-dark-terminal-background;
    in property <string> theme-dark-terminal-selection;
    in property <bool> right-click-copy-or-paste;
    in property <int> scrollback-lines;
    in property <int> default-terminal-columns;
    in property <int> default-terminal-rows;
    in property <string> local-shell;
    in property <int> local-shell-index;
    in property <int> sidebar-width;
    in property <int> tab-width;
    in property <string> session-mask-character;
    in property <string> open-settings-shortcut;
    in property <string> toggle-sidebar-shortcut;
    in property <string> copy-selection-shortcut;
    in property <string> paste-shortcut;
    in property <string> default-open-settings-shortcut;
    in property <string> default-toggle-sidebar-shortcut;
    in property <string> default-copy-selection-shortcut;
    in property <string> default-paste-shortcut;
    in property <string> app-version;
    in property <string> status;

    callback save(
        string, int, int, int, bool, string, string,
        string, string, string, string, string, string, string, string, string, string, string, string, string,
        string, string, string, string, string, string, string, string, string, string, string, string, string,
        bool, string, int, int, int, int, int, string, string, string, string, string,
    );
    callback cancel();
    callback format-shortcut(string, bool, bool, bool, bool) -> string;
    callback shortcut-recording-changed(bool);

    in-out property <string> selected-section: "General";
    private property <string> section-title:
        root.selected-section == "Appearance" ? "Appearance"
        : (root.selected-section == "Terminal" ? "Terminal"
        : (root.selected-section == "Workspace" ? "Workspace"
        : (root.selected-section == "Shortcuts" ? "Shortcuts"
        : (root.selected-section == "About" ? "About" : "General"))));
    private property <string> draft-font-family: root.terminal-font-family;
    private property <int> draft-font-size: root.terminal-font-size;
    private property <int> draft-line-height-percent: root.terminal-line-height-percent;
    private property <int> draft-brightness-percent: root.terminal-brightness-percent;
    private property <bool> draft-bright-bold-text: root.bright-bold-text;
    private property <string> draft-theme-mode: root.theme-mode;
    private property <string> draft-theme-palette: root.theme-palette;
    private property <string> draft-theme-light-background: root.theme-light-background;
    private property <string> draft-theme-light-panel: root.theme-light-panel;
    private property <string> draft-theme-light-panel-alt: root.theme-light-panel-alt;
    private property <string> draft-theme-light-border: root.theme-light-border;
    private property <string> draft-theme-light-text: root.theme-light-text;
    private property <string> draft-theme-light-muted: root.theme-light-muted;
    private property <string> draft-theme-light-accent: root.theme-light-accent;
    private property <string> draft-theme-light-success: root.theme-light-success;
    private property <string> draft-theme-light-danger: root.theme-light-danger;
    private property <string> draft-theme-light-overlay: root.theme-light-overlay;
    private property <string> draft-theme-light-terminal-foreground: root.theme-light-terminal-foreground;
    private property <string> draft-theme-light-terminal-background: root.theme-light-terminal-background;
    private property <string> draft-theme-light-terminal-selection: root.theme-light-terminal-selection;
    private property <string> draft-theme-dark-background: root.theme-dark-background;
    private property <string> draft-theme-dark-panel: root.theme-dark-panel;
    private property <string> draft-theme-dark-panel-alt: root.theme-dark-panel-alt;
    private property <string> draft-theme-dark-border: root.theme-dark-border;
    private property <string> draft-theme-dark-text: root.theme-dark-text;
    private property <string> draft-theme-dark-muted: root.theme-dark-muted;
    private property <string> draft-theme-dark-accent: root.theme-dark-accent;
    private property <string> draft-theme-dark-success: root.theme-dark-success;
    private property <string> draft-theme-dark-danger: root.theme-dark-danger;
    private property <string> draft-theme-dark-overlay: root.theme-dark-overlay;
    private property <string> draft-theme-dark-terminal-foreground: root.theme-dark-terminal-foreground;
    private property <string> draft-theme-dark-terminal-background: root.theme-dark-terminal-background;
    private property <string> draft-theme-dark-terminal-selection: root.theme-dark-terminal-selection;
    private property <bool> draft-right-click-copy-or-paste:
        root.right-click-copy-or-paste;
    private property <int> draft-scrollback-lines: root.scrollback-lines;
    private property <int> draft-columns: root.default-terminal-columns;
    private property <int> draft-rows: root.default-terminal-rows;
    private property <string> draft-local-shell: root.local-shell;
    private property <int> draft-local-shell-index: root.local-shell-index;
    private property <int> draft-sidebar-width: root.sidebar-width;
    private property <int> draft-tab-width: root.tab-width;
    private property <string> draft-session-mask-character: root.session-mask-character;
    private property <string> draft-open-settings-shortcut: root.open-settings-shortcut;
    private property <string> draft-toggle-sidebar-shortcut: root.toggle-sidebar-shortcut;
    private property <string> draft-copy-selection-shortcut: root.copy-selection-shortcut;
    private property <string> draft-paste-shortcut: root.paste-shortcut;

    function select-section(section: string) {
        root.shortcut-recording-changed(false);
        root.selected-section = section;
    }

    function commit-settings() {
        root.shortcut-recording-changed(false);
        root.save(
            root.draft-font-family,
            root.draft-font-size,
            root.draft-line-height-percent,
            root.draft-brightness-percent,
            root.draft-bright-bold-text,
            root.draft-theme-mode,
            root.draft-theme-palette,
            root.draft-theme-light-background,
            root.draft-theme-light-panel,
            root.draft-theme-light-panel-alt,
            root.draft-theme-light-border,
            root.draft-theme-light-text,
            root.draft-theme-light-muted,
            root.draft-theme-light-accent,
            root.draft-theme-light-success,
            root.draft-theme-light-danger,
            root.draft-theme-light-overlay,
            root.draft-theme-light-terminal-foreground,
            root.draft-theme-light-terminal-background,
            root.draft-theme-light-terminal-selection,
            root.draft-theme-dark-background,
            root.draft-theme-dark-panel,
            root.draft-theme-dark-panel-alt,
            root.draft-theme-dark-border,
            root.draft-theme-dark-text,
            root.draft-theme-dark-muted,
            root.draft-theme-dark-accent,
            root.draft-theme-dark-success,
            root.draft-theme-dark-danger,
            root.draft-theme-dark-overlay,
            root.draft-theme-dark-terminal-foreground,
            root.draft-theme-dark-terminal-background,
            root.draft-theme-dark-terminal-selection,
            root.draft-right-click-copy-or-paste,
            root.draft-local-shell,
            root.draft-scrollback-lines,
            root.draft-columns,
            root.draft-rows,
            root.draft-sidebar-width,
            root.draft-tab-width,
            root.draft-session-mask-character,
            root.draft-open-settings-shortcut,
            root.draft-toggle-sidebar-shortcut,
            root.draft-copy-selection-shortcut,
            root.draft-paste-shortcut,
        );
    }

    background: Theme.background;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: Theme.settings-nav-width;
            background: Theme.panel;

            Rectangle {
                x: parent.width - Theme.hairline;
                width: Theme.hairline;
                height: parent.height;
                background: Theme.divider;
            }

            VerticalLayout {
                padding-left: Theme.space-lg;
                padding-right: Theme.space-lg;
                padding-top: Theme.space-lg;
                padding-bottom: Theme.space-lg;
                spacing: Theme.space-xs;

                Text {
                    height: Theme.settings-nav-title-height;
                    text: "Settings";
                    color: Theme.text;
                    font-size: Theme.font-section;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                SettingsNavItem {
                    icon: SettingsNavIcon.General;
                    label: "General";
                    selected: root.selected-section == "General";
                    activated => { root.select-section("General"); }
                }
                SettingsNavItem {
                    icon: SettingsNavIcon.Appearance;
                    label: "Appearance";
                    selected: root.selected-section == "Appearance";
                    activated => { root.select-section("Appearance"); }
                }
                SettingsNavItem {
                    icon: SettingsNavIcon.Terminal;
                    label: "Terminal";
                    selected: root.selected-section == "Terminal";
                    activated => { root.select-section("Terminal"); }
                }
                SettingsNavItem {
                    icon: SettingsNavIcon.Workspace;
                    label: "Workspace";
                    selected: root.selected-section == "Workspace";
                    activated => { root.select-section("Workspace"); }
                }
                SettingsNavItem {
                    icon: SettingsNavIcon.Shortcuts;
                    label: "Shortcuts";
                    selected: root.selected-section == "Shortcuts";
                    activated => { root.select-section("Shortcuts"); }
                }

                Rectangle { vertical-stretch: 1; }
                Rectangle { height: Theme.hairline; background: Theme.divider; }
                SettingsNavItem {
                    icon: SettingsNavIcon.About;
                    label: "About";
                    selected: root.selected-section == "About";
                    activated => { root.select-section("About"); }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.background;

            VerticalLayout {
                spacing: 0px;

                SettingsHeader {
                    title: root.section-title;
                    status: root.status;
                    close => {
                        root.shortcut-recording-changed(false);
                        root.cancel();
                    }
                    save => { root.commit-settings(); }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.background;

                    if root.selected-section == "General" : GeneralSettingsPage {
                        width: parent.width;
                        height: parent.height;
                        local-shell-options: root.local-shell-options;
                        draft-local-shell <=> root.draft-local-shell;
                        draft-local-shell-index <=> root.draft-local-shell-index;
                        draft-columns <=> root.draft-columns;
                        draft-rows <=> root.draft-rows;
                    }

                    if root.selected-section == "Appearance" : AppearanceSettingsPage {
                        width: parent.width;
                        height: parent.height;
                        draft-font-family <=> root.draft-font-family;
                        draft-font-size <=> root.draft-font-size;
                        draft-line-height-percent <=> root.draft-line-height-percent;
                        draft-brightness-percent <=> root.draft-brightness-percent;
                        draft-bright-bold-text <=> root.draft-bright-bold-text;
                        draft-theme-mode <=> root.draft-theme-mode;
                        draft-theme-palette <=> root.draft-theme-palette;
                        draft-theme-light-background <=> root.draft-theme-light-background;
                        draft-theme-light-panel <=> root.draft-theme-light-panel;
                        draft-theme-light-panel-alt <=> root.draft-theme-light-panel-alt;
                        draft-theme-light-border <=> root.draft-theme-light-border;
                        draft-theme-light-text <=> root.draft-theme-light-text;
                        draft-theme-light-muted <=> root.draft-theme-light-muted;
                        draft-theme-light-accent <=> root.draft-theme-light-accent;
                        draft-theme-light-success <=> root.draft-theme-light-success;
                        draft-theme-light-danger <=> root.draft-theme-light-danger;
                        draft-theme-light-overlay <=> root.draft-theme-light-overlay;
                        draft-theme-light-terminal-foreground <=> root.draft-theme-light-terminal-foreground;
                        draft-theme-light-terminal-background <=> root.draft-theme-light-terminal-background;
                        draft-theme-light-terminal-selection <=> root.draft-theme-light-terminal-selection;
                        draft-theme-dark-background <=> root.draft-theme-dark-background;
                        draft-theme-dark-panel <=> root.draft-theme-dark-panel;
                        draft-theme-dark-panel-alt <=> root.draft-theme-dark-panel-alt;
                        draft-theme-dark-border <=> root.draft-theme-dark-border;
                        draft-theme-dark-text <=> root.draft-theme-dark-text;
                        draft-theme-dark-muted <=> root.draft-theme-dark-muted;
                        draft-theme-dark-accent <=> root.draft-theme-dark-accent;
                        draft-theme-dark-success <=> root.draft-theme-dark-success;
                        draft-theme-dark-danger <=> root.draft-theme-dark-danger;
                        draft-theme-dark-overlay <=> root.draft-theme-dark-overlay;
                        draft-theme-dark-terminal-foreground <=> root.draft-theme-dark-terminal-foreground;
                        draft-theme-dark-terminal-background <=> root.draft-theme-dark-terminal-background;
                        draft-theme-dark-terminal-selection <=> root.draft-theme-dark-terminal-selection;
                    }

                    if root.selected-section == "Terminal" : TerminalSettingsPage {
                        width: parent.width;
                        height: parent.height;
                        draft-scrollback-lines <=> root.draft-scrollback-lines;
                        draft-right-click-copy-or-paste <=> root.draft-right-click-copy-or-paste;
                    }

                    if root.selected-section == "Workspace" : WorkspaceSettingsPage {
                        width: parent.width;
                        height: parent.height;
                        draft-sidebar-width <=> root.draft-sidebar-width;
                        draft-tab-width <=> root.draft-tab-width;
                        draft-session-mask-character <=> root.draft-session-mask-character;
                    }

                    if root.selected-section == "Shortcuts" : ShortcutsSettingsPage {
                        width: parent.width;
                        height: parent.height;
                        draft-open-settings-shortcut <=> root.draft-open-settings-shortcut;
                        draft-toggle-sidebar-shortcut <=> root.draft-toggle-sidebar-shortcut;
                        draft-copy-selection-shortcut <=> root.draft-copy-selection-shortcut;
                        draft-paste-shortcut <=> root.draft-paste-shortcut;
                        default-open-settings-shortcut: root.default-open-settings-shortcut;
                        default-toggle-sidebar-shortcut: root.default-toggle-sidebar-shortcut;
                        default-copy-selection-shortcut: root.default-copy-selection-shortcut;
                        default-paste-shortcut: root.default-paste-shortcut;
                        format-shortcut(text, alt, control, meta, shift) => {
                            return root.format-shortcut(text, alt, control, meta, shift);
                        }
                        shortcut-recording-changed(recording) => {
                            root.shortcut-recording-changed(recording);
                        }
                    }

                    if root.selected-section == "About" : AboutSettingsPage {
                        width: parent.width;
                        height: parent.height;
                        app-version: root.app-version;
                    }
                }

            }
        }
    }
}
