import { WorkspaceSettingsPage } from "settings/workspace.slint";
import { ShortcutsSettingsPage } from "settings/shortcuts.slint";
import { AboutSettingsPage } from "settings/about.slint";

// Rust supplies one immutable settings snapshot. The pane owns its editable
// draft, emits a coalesced in-memory preview while it changes, and commits the
// same candidate when its Settings tab is closed.
export struct SettingsViewState {
    ui_language: string,
    local_shell_options: [string],
    application_font_family: string,
    application_font_options: [string],
    application_font_index: int,
    renderer_preference: string,
    terminal_font_family: string,
    terminal_font_options: [string],
    terminal_font_index: int,
    terminal_font_size: int,
    terminal_line_height_percent: int,
    terminal_text_brightness: float,
    bright_bold_text: bool,
    terminal_semantic_highlighting: bool,
    terminal_compact_rendering: bool,
    terminal_row_render_cache: bool,
    terminal_cursor_blink: bool,
    focused_terminal_refresh_fps: int,
    unfocused_terminal_refresh_fps: int,
    terminal_semantic_link_color: string,
    terminal_semantic_success_color: string,
    terminal_semantic_info_color: string,
    terminal_semantic_warning_color: string,
    terminal_semantic_error_color: string,
    theme_mode: string,
    theme_palette: string,
    theme_light_background: string,
    theme_light_panel: string,
    theme_light_panel_alt: string,
    theme_light_border: string,
    theme_light_text: string,
    theme_light_muted: string,
    theme_light_accent: string,
    theme_light_success: string,
    theme_light_danger: string,
    theme_light_overlay: string,
    theme_light_terminal_foreground: string,
    theme_light_terminal_background: string,
    theme_light_terminal_selection: string,
    theme_dark_background: string,
    theme_dark_panel: string,
    theme_dark_panel_alt: string,
    theme_dark_border: string,
    theme_dark_text: string,
    theme_dark_muted: string,
    theme_dark_accent: string,
    theme_dark_success: string,
    theme_dark_danger: string,
    theme_dark_overlay: string,
    theme_dark_terminal_foreground: string,
    theme_dark_terminal_background: string,
    theme_dark_terminal_selection: string,
    right_click_copy_or_paste: bool,
    copy_selection_on_select: bool,
    terminal_mouse_local_selection_priority: bool,
    option_as_meta: bool,
    x11_server_provider_options: [string],
    x11_server_installations: [string],
    x11_server_provider: string,
    x11_server_provider_index: int,
    x11_server_app_path: string,
    x11_launch_on_connect: bool,
    x11_allow_no_auth: bool,
    apple_platform: bool,
    scrollback_lines: int,
    default_terminal_columns: int,
    default_terminal_rows: int,
    local_shell: string,
    local_shell_index: int,
    credential_storage: string,
    sidebar_width: int,
    tab_width: int,
    session_mask_character: string,
    collapsed_group_label_chars: int,
    open_settings_shortcut: string,
    new_session_shortcut: string,
    import_sessions_shortcut: string,
    export_selected_shortcut: string,
    toggle_sidebar_shortcut: string,
    copy_selection_shortcut: string,
    paste_shortcut: string,
    open_sftp_shortcut: string,
    default_open_settings_shortcut: string,
    default_new_session_shortcut: string,
    default_import_sessions_shortcut: string,
    default_export_selected_shortcut: string,
    default_toggle_sidebar_shortcut: string,
    default_copy_selection_shortcut: string,
    default_paste_shortcut: string,
    default_open_sftp_shortcut: string,
    app_version: string,
    status: string,
}

export struct SettingsSearchEntry {
    section: string,
    title: string,
    description: string,
}

