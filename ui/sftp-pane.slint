import { CheckBox, ListView } from "std-widgets.slint";
import { ActionMenuItem, FlatActionMenu } from "components/flat-action-menu.slint";
import { ElidedLabel } from "components/elided-controls.slint";
import { FlatTextInput } from "components/flat-text-input.slint";
import { SftpActionButton, SftpPathCopyButton } from "components/sftp-controls.slint";
import { Theme } from "theme.slint";

export { SftpEntryRow, SftpTransferRow, SftpNativeDropRegion, SftpViewState } from "sftp/types.slint";
import { SftpNativeDropRegion, SftpViewState } from "sftp/types.slint";
import { SftpDirectoryPane } from "sftp/directory.slint";
import { SftpTransferQueue } from "sftp/transfers.slint";

component SftpSplitHandle inherits FocusScope {
    in property <Orientation> orientation: Orientation.horizontal;
    in property <string> accessible-name;
    in property <float> value;
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    in property <float> step: Theme.sftp-splitter-step;
    in property <length> available-length;
    callback adjust(float);
    callback set-value(float);
    callback activated();

    private property <bool> horizontal: root.orientation == Orientation.horizontal;
    private property <float> drag-start-value: root.value;
    private property <length> drag-start-position: 0px;
    private property <bool> active: root.has-focus || touch.pressed;

    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: slider;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-orientation: root.orientation;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-set-value(candidate) => {
        if candidate.is-float() {
            root.set-value(max(root.minimum, min(root.maximum, candidate.to-float())));
        }
    }
    accessible-action-increment => { root.adjust(root.step); }
    accessible-action-decrement => { root.adjust(-root.step); }
    accessible-action-default => { root.activated(); }

    key-pressed(event) => {
        if root.horizontal && event.text == Key.RightArrow {
            root.adjust(root.step);
            return EventResult.accept;
        }
        if root.horizontal && event.text == Key.LeftArrow {
            root.adjust(-root.step);
            return EventResult.accept;
        }
        if !root.horizontal && event.text == Key.DownArrow {
            root.adjust(root.step);
            return EventResult.accept;
        }
        if !root.horizontal && event.text == Key.UpArrow {
            root.adjust(-root.step);
            return EventResult.accept;
        }
        if event.text == Key.Home {
            root.set-value(root.minimum);
            return EventResult.accept;
        }
        if event.text == Key.End {
            root.set-value(root.maximum);
            return EventResult.accept;
        }
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        x: root.horizontal ? (parent.width - self.width) / 2 : 0px;
        y: root.horizontal ? 0px : (parent.height - self.height) / 2;
        width: root.horizontal
            ? (root.active ? Theme.sftp-splitter-active-thickness : Theme.hairline)
            : parent.width;
        height: root.horizontal
            ? parent.height
            : (root.active ? Theme.sftp-splitter-active-thickness : Theme.hairline);
        background: root.active ? Theme.accent : Theme.divider;
    }

    touch := TouchArea {
        mouse-cursor: root.horizontal ? ew-resize : ns-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.drag-start-value = root.value;
                root.drag-start-position = root.horizontal
                    ? root.x + self.mouse-x
                    : root.y + self.mouse-y;
                root.focus();
            }
        }
        moved => {
            if self.pressed && root.available-length > 0px {
                let pointer-position = root.horizontal
                    ? root.x + self.mouse-x
                    : root.y + self.mouse-y;
                root.set-value(max(
                    root.minimum,
                    min(
                        root.maximum,
                        root.drag-start-value
                            + (pointer-position - root.drag-start-position)
                                / root.available-length,
                    ),
                ));
            }
        }
        double-clicked => { root.activated(); }
    }
}

export component SftpPane inherits Rectangle {
    in property <SftpViewState> view;
    in property <bool> native-file-drag-enabled: false;
    in-out property <float> directory-split-ratio: 0.5;
    in-out property <float> files-split-ratio: 0.7;
    in-out property <bool> transfers-collapsed: false;
    callback list-directory(string);
    callback load-more();
    callback list-local-directory(string);
    callback load-more-local();
    callback navigate-back();
    callback navigate-forward();
    callback navigate-up();
    callback navigate-local-back();
    callback navigate-local-forward();
    callback navigate-local-up();
    callback toggle-remote-selection(string, bool);
    callback select-all-remote(bool);
    callback toggle-local-selection(string, bool);
    callback select-all-local(bool);
    callback sort-remote(string);
    callback sort-local(string);
    callback open-remote-file(string);
    callback download-selected-remote();
    callback open-local-file(string);
    callback toggle-transfer-selection(string, bool);
    callback pause-transfer(string);
    callback resume-transfer(string);
    callback cancel-transfer(string);
    callback pause-selected-transfers();
    callback resume-selected-transfers();
    callback cancel-selected-transfers();
    callback reveal-local-file(string);
    callback reveal-transfer-local(string);
    callback remove-transfer(string);
    callback write-clipboard(string);
    callback remove-selected-remote();
    callback upload-selected-local();
    callback rename-remote(string, string);
    callback edit-remote();
    callback upload-edited-file();
    callback stop-editing-file();
    callback reveal-edit-copy();
    callback toggle-editor-auto-upload(bool);
    callback dropped-local-files(data-transfer);
    callback dropped-remote-files(data-transfer);
    callback begin-native-remote-file-drag(string);
    pure callback drag-local-file(string) -> data-transfer;
    pure callback drag-remote-file(string) -> data-transfer;
    callback drag-diagnostic(string, bool);
    callback native-remote-drop-region-changed(SftpNativeDropRegion);
    callback native-local-drop-region-changed(SftpNativeDropRegion);

    // Native file events have no Slint DropArea target. Publish the live,
    // finite layout through callbacks instead of a two-way struct property:
    // two-way bindings retain their right-hand binding and could otherwise
    // preserve a parent's default geometry. The application bridge performs
    // the final live SFTP readiness check before creating an upload intent.
    out property <SftpNativeDropRegion> native-remote-drop-region: {
        x: 0px,
        y: 0px,
        width: root.remote-pane-width,
        height: root.files-area-height,
        accepts: root.remote-pane-width > 0px && root.files-area-height > 0px,
    };
    out property <SftpNativeDropRegion> native-local-drop-region: {
        x: root.remote-pane-width + root.directory-splitter-size,
        y: 0px,
        width: max(0px, root.width - root.remote-pane-width - root.directory-splitter-size),
        height: root.files-area-height,
        accepts: root.view.available && !root.view.local_loading
            && !root.view.local_path.is-empty
            && root.width > root.remote-pane-width + root.directory-splitter-size
            && root.files-area-height > 0px,
    };

    changed native-remote-drop-region => {
        root.native-remote-drop-region-changed(root.native-remote-drop-region);
    }
    changed native-local-drop-region => {
        root.native-local-drop-region-changed(root.native-local-drop-region);
    }

    min-width: 0px;
    preferred-width: 0px;
    max-width: 100000px;
    min-height: 0px;
    background: Theme.background;
    accessible-role: list;
    accessible-label: @tr("SFTP files");

    private property <length> directory-splitter-size: min(
        Theme.sftp-splitter-size,
        root.width,
    );
    private property <length> horizontal-available-width:
        max(0px, root.width - root.directory-splitter-size);
    private property <length> directory-pane-floor: min(
        Theme.sftp-directory-pane-min-width,
        root.horizontal-available-width / 2,
    );
    private property <float> directory-ratio-min: root.horizontal-available-width > 0px
        ? root.directory-pane-floor / root.horizontal-available-width : 0.5;
    private property <float> directory-ratio-max: 1.0 - root.directory-ratio-min;
    private property <float> clamped-directory-split-ratio: max(
        root.directory-ratio-min,
        min(root.directory-ratio-max, root.directory-split-ratio),
    );
    private property <length> remote-pane-width:
        root.horizontal-available-width * root.clamped-directory-split-ratio;

    private property <length> transfer-splitter-size: min(
        Theme.sftp-splitter-size,
        root.height,
    );
    private property <bool> transfer-content-empty:
        root.view.active_transfers.length == 0
            && root.view.failed_transfers.length == 0
            && root.view.completed_transfers.length == 0;
    // Keep an empty queue compact on first render, while allowing the divider
    // to expand it when the user drags or activates the handle.
    private property <bool> transfer-layout-touched: false;
    private property <bool> effective-transfers-collapsed:
        root.transfers-collapsed
            || (root.transfer-content-empty && !root.transfer-layout-touched);
    private property <length> editor-height: root.view.editor_path.is-empty ? 0px : max(
        Theme.settings-control-height,
        Theme.sftp-control-font-size * 1.5 + Theme.sftp-control-padding-y * 2,
    ) + Theme.space-sm * 2;
    private property <length> expanded-vertical-available-height:
        max(0px, root.height - root.transfer-splitter-size - root.editor-height);
    private property <length> files-area-floor: min(
        Theme.sftp-files-area-min-height,
        root.expanded-vertical-available-height / 2,
    );
    private property <length> compact-transfer-height: min(
        Theme.sftp-transfer-toolbar-height,
        root.expanded-vertical-available-height,
    );
    private property <length> transfer-area-floor: root.transfer-content-empty
        ? root.compact-transfer-height
        : min(
            Theme.sftp-transfer-area-min-height,
            root.expanded-vertical-available-height / 2,
        );
    private property <float> files-ratio-min: root.expanded-vertical-available-height > 0px
        ? root.files-area-floor / root.expanded-vertical-available-height : 0.5;
    private property <float> files-ratio-max: root.expanded-vertical-available-height > 0px
        ? 1.0 - root.transfer-area-floor / root.expanded-vertical-available-height : 0.5;
    private property <float> clamped-files-split-ratio: max(
        root.files-ratio-min,
        min(root.files-ratio-max, root.files-split-ratio),
    );
    private property <length> collapsed-transfer-height: min(
        Theme.sftp-transfer-toolbar-height,
        root.expanded-vertical-available-height,
    );
    private property <float> compact-files-split-ratio:
        root.expanded-vertical-available-height > 0px
            ? (root.expanded-vertical-available-height - root.collapsed-transfer-height)
                / root.expanded-vertical-available-height
            : 0.5;
    private property <float> displayed-files-split-ratio: root.effective-transfers-collapsed
        ? root.compact-files-split-ratio
        : root.clamped-files-split-ratio;
    private property <length> files-area-height: root.effective-transfers-collapsed
        ? max(0px, root.expanded-vertical-available-height - root.collapsed-transfer-height)
        : root.expanded-vertical-available-height * root.clamped-files-split-ratio;
    private property <length> transfer-area-height: root.effective-transfers-collapsed
        ? root.collapsed-transfer-height
        : max(0px, root.expanded-vertical-available-height - root.files-area-height);

    Timer {
        running: true;
        interval: 1ms;
        triggered => {
            self.running = false;
            root.native-remote-drop-region-changed(root.native-remote-drop-region);
            root.native-local-drop-region-changed(root.native-local-drop-region);
        }
    }

    init => {
        root.native-remote-drop-region-changed(root.native-remote-drop-region);
        root.native-local-drop-region-changed(root.native-local-drop-region);
        if !root.view.local_loaded && !root.view.local_path.is-empty {
            root.list-local-directory(root.view.local_path);
        }
    }

    VerticalLayout {
        spacing: 0px;

        files-area := Rectangle {
            width: parent.width;
            height: root.files-area-height;
            background: Theme.panel;
            clip: true;

            remote-pane := SftpDirectoryPane {
                x: 0px;
                width: root.remote-pane-width;
                height: parent.height;
                title: @tr("Remote files");
                interactive: root.view.available;
                entries: root.view.entries;
                loading: root.view.loading;
                upload-ready: root.view.upload_ready;
                path: root.view.path;
                truncated: root.view.truncated;
                status: root.view.status;
                has-more: root.view.has_more;
                selection-all: root.view.all_selected;
                selection-count: root.view.selected_count;
                sort-column: root.view.remote_sort_column;
                sort-descending: root.view.remote_sort_descending;
                allow-refresh: true;
                allow-navigation: true;
                allow-drag: true;
                allow-drop: true;
                native-file-drag-enabled: root.native-file-drag-enabled;
                can-go-back: root.view.can_go_back;
                can-go-forward: root.view.can_go_forward;
                can-go-up: root.view.can_go_up;
                list-directory(path) => { root.list-directory(path); }
                load-more => { root.load-more(); }
                refresh => { root.list-directory(root.view.path); }
                navigate-back => { root.navigate-back(); }
                navigate-forward => { root.navigate-forward(); }
                navigate-up => { root.navigate-up(); }
                open-file(path) => { root.open-remote-file(path); }
                download-selected => { root.download-selected-remote(); }
                remove-selected => { root.remove-selected-remote(); }
                upload-selected => { root.upload-selected-local(); }
                rename-entry(path, name) => { root.rename-remote(path, name); }
                edit-selected => { root.edit-remote(); }
                toggle-selection(path, selected) => {
                    root.toggle-remote-selection(path, selected);
                }
                select-all(selected) => { root.select-all-remote(selected); }
                sort(column) => { root.sort-remote(column); }
                copy-path(path) => { root.write-clipboard(path); }
                begin-native-file-drag(path) => { root.begin-native-remote-file-drag(path); }
                drag-data(path) => { return root.drag-remote-file(path); }
                drag-diagnostic(stage) => { root.drag-diagnostic(stage, false); }
                dropped(data) => { root.dropped-remote-files(data); }
            }

            directory-splitter := SftpSplitHandle {
                x: remote-pane.width;
                width: root.directory-splitter-size;
                height: parent.height;
                orientation: Orientation.horizontal;
                accessible-name: @tr("Remote and local file pane sizes");
                value: root.clamped-directory-split-ratio;
                minimum: root.directory-ratio-min;
                maximum: root.directory-ratio-max;
                available-length: root.horizontal-available-width;
                adjust(delta) => {
                    root.directory-split-ratio = max(
                        root.directory-ratio-min,
                        min(root.directory-ratio-max, root.directory-split-ratio + delta),
                    );
                }
                set-value(candidate) => {
                    root.directory-split-ratio = max(
                        root.directory-ratio-min,
                        min(root.directory-ratio-max, candidate),
                    );
                }
                activated => { root.directory-split-ratio = 0.5; }
            }

            local-pane := SftpDirectoryPane {
                x: directory-splitter.x + directory-splitter.width;
                width: max(0px, parent.width - self.x);
                height: parent.height;
                title: @tr("Local files");
                allow-drag: true;
                allow-drop: true;
                local-actions: true;
                allow-navigation: true;
                entries: root.view.local_entries;
                loading: root.view.local_loading;
                upload-ready: root.view.upload_ready && root.view.local_upload_selection_ready;
                allow-refresh: true;
                path: root.view.local_path;
                has-more: root.view.local_has_more;
                truncated: root.view.local_truncated;
                status: root.view.local_status;
                selection-all: root.view.local_all_selected;
                selection-count: root.view.local_selected_count;
                sort-column: root.view.local_sort_column;
                sort-descending: root.view.local_sort_descending;
                list-directory(path) => { root.list-local-directory(path); }
                refresh => { root.list-local-directory(root.view.local_path); }
                load-more => { root.load-more-local(); }
                navigate-back => { root.navigate-local-back(); }
                navigate-forward => { root.navigate-local-forward(); }
                navigate-up => { root.navigate-local-up(); }
                can-go-back: root.view.local_can_go_back;
                can-go-forward: root.view.local_can_go_forward;
                can-go-up: root.view.local_can_go_up;
                open-file(path) => { root.open-local-file(path); }
                reveal-local(path) => { root.reveal-local-file(path); }
                drag-data(path) => { return root.drag-local-file(path); }
                drag-diagnostic(stage) => { root.drag-diagnostic(stage, true); }
                dropped(data) => { root.dropped-local-files(data); }
                toggle-selection(path, selected) => {
                    root.toggle-local-selection(path, selected);
                }
                select-all(selected) => { root.select-all-local(selected); }
                sort(column) => { root.sort-local(column); }
                copy-path(path) => { root.write-clipboard(path); }
            }
        }

        if !root.view.editor_path.is-empty : Rectangle {
            height: root.editor-height;
            background: Theme.panel-alt;
            HorizontalLayout {
                padding: Theme.space-sm;
                spacing: Theme.space-xs;
                ElidedLabel {
                    text: root.view.editor_path;
                    tooltip-text: root.view.editor_local_path;
                    horizontal-stretch: 1;
                }
                SftpActionButton {
                    text: @tr("Upload changes");
                    enabled: root.view.editor_can_upload;
                    clicked => { root.upload-edited-file(); }
                }
                SftpActionButton {
                    text: @tr("Show local copy");
                    enabled: !root.view.editor_local_path.is-empty;
                    clicked => { root.reveal-edit-copy(); }
                }
                CheckBox {
                    text: @tr("Auto upload");
                    checked: root.view.editor_auto_upload;
                    toggled => { root.toggle-editor-auto-upload(self.checked); }
                }
                ElidedLabel {
                    text: root.view.editor_status;
                    horizontal-stretch: 1;
                }
                SftpActionButton {
                    text: @tr("Stop editing");
                    enabled: root.view.editor_can_upload;
                    clicked => { root.stop-editing-file(); }
                }
            }
        }

        transfer-splitter := SftpSplitHandle {
            width: parent.width;
            height: root.transfer-splitter-size;
            orientation: Orientation.vertical;
            accessible-name: @tr("Files and transfers area sizes");
            value: root.displayed-files-split-ratio;
            minimum: root.files-ratio-min;
            maximum: root.files-ratio-max;
            available-length: root.expanded-vertical-available-height;
            adjust(delta) => {
                root.transfer-layout-touched = true;
                root.transfers-collapsed = false;
                root.files-split-ratio = max(
                    root.files-ratio-min,
                    min(root.files-ratio-max, root.displayed-files-split-ratio + delta),
                );
            }
            set-value(candidate) => {
                root.transfer-layout-touched = true;
                root.transfers-collapsed = false;
                root.files-split-ratio = max(
                    root.files-ratio-min,
                    min(root.files-ratio-max, candidate),
                );
            }
            activated => {
                if root.transfer-content-empty && !root.transfer-layout-touched {
                    root.transfer-layout-touched = true;
                    root.transfers-collapsed = false;
                } else {
                    root.transfers-collapsed = !root.transfers-collapsed;
                }
            }
        }

        SftpTransferQueue {
            width: parent.width;
            height: root.transfer-area-height;
            collapsed: root.effective-transfers-collapsed;
            active-transfers: root.view.active_transfers;
            failed-transfers: root.view.failed_transfers;
            completed-transfers: root.view.completed_transfers;
            active-count: root.view.transfer_active_count;
            failed-count: root.view.transfer_failed_count;
            completed-count: root.view.transfer_completed_count;
            selected-active-count: root.view.transfer_selected_active_count;
            selected-pausable-count: root.view.transfer_selected_pausable_count;
            selected-resumable-count: root.view.transfer_selected_resumable_count;
            toggle-selection(id, selected) => { root.toggle-transfer-selection(id, selected); }
            pause-transfer(id) => { root.pause-transfer(id); }
            resume-transfer(id) => { root.resume-transfer(id); }
            cancel-transfer(id) => { root.cancel-transfer(id); }
            reveal-transfer-local(id) => { root.reveal-transfer-local(id); }
            remove-transfer(id) => { root.remove-transfer(id); }
            pause-selected => { root.pause-selected-transfers(); }
            resume-selected => { root.resume-selected-transfers(); }
            cancel-selected => { root.cancel-selected-transfers(); }
            toggle-collapse => {
                root.transfers-collapsed = !root.transfers-collapsed;
            }
        }
    }
}
