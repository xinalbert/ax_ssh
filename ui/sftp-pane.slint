import { CheckBox, ListView } from "std-widgets.slint";
import { FlatTextInput } from "components/flat-text-input.slint";
import { Theme } from "theme.slint";

export struct SftpEntryRow {
    name: string,
    path: string,
    kind: string,
    icon: image,
    has_icon: bool,
    size: string,
    modified: string,
    hidden: bool,
    selected: bool,
}

// Rust owns the bounded transfer snapshot and updates it in batches. Slint
// only renders these presentation fields and returns the opaque id on cancel.
export struct SftpTransferRow {
    id: string,
    name: string,
    state: string,
    status: string,
    progress: float,
    size: string,
    speed: string,
    cancellable: bool,
}

export struct SftpViewState {
    available: bool,
    open: bool,
    loading: bool,
    home: string,
    path: string,
    entries: [SftpEntryRow],
    has_more: bool,
    truncated: bool,
    status: string,
    can_go_back: bool,
    can_go_forward: bool,
    selected_count: int,
    all_selected: bool,
    local_loading: bool,
    local_path: string,
    local_entries: [SftpEntryRow],
    local_truncated: bool,
    local_status: string,
    local_selected_count: int,
    local_all_selected: bool,
    transfers: [SftpTransferRow],
    transfer_active_count: int,
    transfer_failed_count: int,
    transfer_completed_count: int,
}

component SftpActionButton inherits FocusScope {
    in property <string> text;
    in property <string> accessible-name: root.text;
    in property <length> font-size: Theme.sftp-control-font-size;
    in property <int> font-weight: Theme.sftp-control-font-weight;
    callback clicked();

    private property <length> text-height:
        label.font-metrics.ascent - label.font-metrics.descent;
    out property <length> control-height: max(
        Theme.sftp-control-min-height,
        root.text-height + 2 * Theme.sftp-control-padding-y,
    );

    height: root.control-height;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    key-pressed(event) => {
        if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
            root.clicked();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        border-width: Theme.hairline;
        border-color: root.has-focus ? Theme.focus : Theme.control-border;
        border-radius: Theme.radius-small;
        background: !root.enabled
            ? Theme.hover
            : (touch.has-hover || root.has-focus ? Theme.hover : Theme.panel-alt);
        opacity: root.enabled ? 1 : Theme.combo-box-disabled-opacity;

        label := Text {
            x: Theme.space-md;
            width: parent.width - 2 * Theme.space-md;
            height: parent.height;
            text: root.text;
            color: Theme.text;
            font-size: root.font-size;
            font-weight: root.font-weight;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.clicked(); }
        }
    }
}

component SftpSplitHandle inherits FocusScope {
    in property <Orientation> orientation: Orientation.horizontal;
    in property <string> accessible-name;
    in property <float> value;
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    in property <float> step: Theme.sftp-splitter-step;
    in property <length> available-length;
    callback adjust(float);
    callback set-value(float);
    callback activated();

    private property <bool> horizontal: root.orientation == Orientation.horizontal;
    private property <float> drag-start-value: root.value;
    private property <length> drag-start-position: 0px;
    private property <bool> active: root.has-focus || touch.pressed;

    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: slider;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-orientation: root.orientation;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-set-value(candidate) => {
        if candidate.is-float() {
            root.set-value(max(root.minimum, min(root.maximum, candidate.to-float())));
        }
    }
    accessible-action-increment => { root.adjust(root.step); }
    accessible-action-decrement => { root.adjust(-root.step); }
    accessible-action-default => { root.activated(); }

    key-pressed(event) => {
        if root.horizontal && event.text == Key.RightArrow {
            root.adjust(root.step);
            return EventResult.accept;
        }
        if root.horizontal && event.text == Key.LeftArrow {
            root.adjust(-root.step);
            return EventResult.accept;
        }
        if !root.horizontal && event.text == Key.DownArrow {
            root.adjust(root.step);
            return EventResult.accept;
        }
        if !root.horizontal && event.text == Key.UpArrow {
            root.adjust(-root.step);
            return EventResult.accept;
        }
        if event.text == Key.Home {
            root.set-value(root.minimum);
            return EventResult.accept;
        }
        if event.text == Key.End {
            root.set-value(root.maximum);
            return EventResult.accept;
        }
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        x: root.horizontal ? (parent.width - self.width) / 2 : 0px;
        y: root.horizontal ? 0px : (parent.height - self.height) / 2;
        width: root.horizontal
            ? (root.active ? Theme.sftp-splitter-active-thickness : Theme.hairline)
            : parent.width;
        height: root.horizontal
            ? parent.height
            : (root.active ? Theme.sftp-splitter-active-thickness : Theme.hairline);
        background: root.active ? Theme.accent : Theme.divider;
    }

    touch := TouchArea {
        mouse-cursor: root.horizontal ? ew-resize : ns-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.drag-start-value = root.value;
                root.drag-start-position = root.horizontal
                    ? root.x + self.mouse-x
                    : root.y + self.mouse-y;
                root.focus();
            }
        }
        moved => {
            if self.pressed && root.available-length > 0px {
                let pointer-position = root.horizontal
                    ? root.x + self.mouse-x
                    : root.y + self.mouse-y;
                root.set-value(max(
                    root.minimum,
                    min(
                        root.maximum,
                        root.drag-start-value
                            + (pointer-position - root.drag-start-position)
                                / root.available-length,
                    ),
                ));
            }
        }
        double-clicked => { root.activated(); }
    }
}

component SftpDirectoryHeader inherits Rectangle {
    in property <bool> selection-checked: false;
    in property <bool> selection-enabled: false;
    callback select-all(bool);
    private property <bool> show-size: root.width >= Theme.sftp-size-visible-width;
    private property <bool> show-modified: root.width >= Theme.sftp-time-visible-width;
    private property <length> leading-x: Theme.sftp-column-padding;
    private property <length> icon-x: root.leading-x + Theme.sftp-selection-width + Theme.sftp-column-gap;
    private property <length> name-x: root.icon-x + Theme.sftp-icon-width + Theme.sftp-column-gap;
    private property <length> modified-x:
        root.width - Theme.sftp-column-padding - Theme.sftp-time-width;
    private property <length> size-x: root.show-modified
        ? root.modified-x - Theme.sftp-column-gap - Theme.sftp-size-width
        : root.width - Theme.sftp-column-padding - Theme.sftp-size-width;
    private property <length> name-right: root.show-size
        ? root.size-x - Theme.sftp-column-gap
        : root.width - Theme.sftp-column-padding;

    height: Theme.sftp-header-height;
    background: Theme.panel-alt;
    clip: true;

    Rectangle {
        x: root.leading-x;
        width: Theme.sftp-selection-width;
        height: Theme.sftp-selection-width;
        y: (parent.height - self.height) / 2;
        border-width: Theme.hairline;
        border-color: Theme.control-border;
        border-radius: Theme.radius-small;
        background: root.selection-checked ? Theme.accent : transparent;

        Text {
            visible: root.selection-checked;
            width: parent.width;
            height: parent.height;
            text: "x";
            color: Theme.background;
            font-size: Theme.font-caption;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    TouchArea {
        x: root.leading-x;
        width: Theme.sftp-selection-width;
        height: parent.height;
        enabled: root.selection-enabled;
        mouse-cursor: pointer;
        accessible-role: checkbox;
        accessible-label: "Select all files";
        accessible-checked: root.selection-checked;
        accessible-enabled: root.selection-enabled;
        accessible-action-default => { root.select-all(!root.selection-checked); }
        clicked => { root.select-all(!root.selection-checked); }
    }
    Text {
        x: root.name-x;
        width: max(0px, root.name-right - self.x);
        height: parent.height;
        text: "Name";
        color: Theme.muted;
        font-size: Theme.font-caption;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: root.size-x;
        width: Theme.sftp-size-width;
        height: parent.height;
        visible: root.show-size;
        text: "Size";
        color: Theme.muted;
        font-size: Theme.font-caption;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Text {
        x: root.modified-x;
        width: Theme.sftp-time-width;
        height: parent.height;
        visible: root.show-modified;
        text: "Modified";
        color: Theme.muted;
        font-size: Theme.font-caption;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - Theme.hairline;
        width: parent.width;
        height: Theme.hairline;
        background: Theme.divider;
    }
}

component SftpEntry inherits Rectangle {
    in property <SftpEntryRow> entry;
    in property <bool> shown: true;
    in property <bool> interactive: true;
    callback open-directory(string);
    callback open-file(string);
    callback toggle-selection(string, bool);

    private property <bool> show-size: root.width >= Theme.sftp-size-visible-width;
    private property <bool> show-modified: root.width >= Theme.sftp-time-visible-width;
    private property <length> leading-x: Theme.sftp-column-padding;
    private property <length> icon-x: root.leading-x + Theme.sftp-selection-width + Theme.sftp-column-gap;
    private property <length> name-x: root.icon-x + Theme.sftp-icon-width + Theme.sftp-column-gap;
    private property <length> modified-x:
        root.width - Theme.sftp-column-padding - Theme.sftp-time-width;
    private property <length> size-x: root.show-modified
        ? root.modified-x - Theme.sftp-column-gap - Theme.sftp-size-width
        : root.width - Theme.sftp-column-padding - Theme.sftp-size-width;
    private property <length> name-right: root.show-size
        ? root.size-x - Theme.sftp-column-gap
        : root.width - Theme.sftp-column-padding;

    visible: root.shown;
    clip: true;
    background: root.entry.selected
        ? Theme.selected
        : (touch.has-hover ? Theme.hover : transparent);
    accessible-role: list-item;
    accessible-label: root.entry.name;

    Rectangle {
        x: root.leading-x;
        width: Theme.sftp-selection-width;
        height: Theme.sftp-selection-width;
        y: (parent.height - self.height) / 2;
        border-width: Theme.hairline;
        border-color: root.entry.selected ? Theme.accent : Theme.control-border;
        border-radius: Theme.radius-small;
        background: root.entry.selected ? Theme.accent : transparent;

        Text {
            visible: root.entry.selected;
            width: parent.width;
            height: parent.height;
            text: "x";
            color: Theme.background;
            font-size: Theme.font-caption;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        visible: !root.entry.has_icon && root.entry.kind != "file";
        x: root.icon-x;
        width: Theme.sftp-icon-width;
        height: parent.height;
        text: root.entry.kind == "folder" ? ">" : (root.entry.kind == "link" ? "@" : "");
        color: root.entry.kind == "folder" ? Theme.accent : Theme.muted;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        visible: !root.entry.has_icon && root.entry.kind == "file";
        x: root.icon-x + Theme.space-xs;
        y: (parent.height - self.height) / 2;
        width: max(Theme.hairline, Theme.sftp-icon-width - 2 * Theme.space-xs);
        height: Theme.sftp-icon-width - Theme.space-xs;
        border-width: Theme.hairline;
        border-color: Theme.muted;
        border-radius: Theme.hairline;
        background: transparent;
    }
    Image {
        visible: root.entry.has_icon;
        x: root.icon-x;
        y: (parent.height - self.height) / 2;
        width: Theme.sftp-icon-width;
        height: Theme.sftp-icon-width;
        source: root.entry.icon;
        image-fit: contain;
    }
    Text {
        x: root.name-x;
        width: max(0px, root.name-right - self.x);
        height: parent.height;
        text: root.entry.name;
        color: Theme.text;
        font-size: Theme.font-body;
        font-weight: root.entry.kind == "folder" ? 600 : 400;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: root.size-x;
        width: Theme.sftp-size-width;
        height: parent.height;
        visible: root.show-size;
        text: root.entry.size;
        color: Theme.muted;
        font-size: Theme.font-caption;
        horizontal-alignment: right;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: root.modified-x;
        width: Theme.sftp-time-width;
        height: parent.height;
        visible: root.show-modified;
        text: root.entry.modified;
        color: Theme.muted;
        font-size: Theme.font-caption;
        horizontal-alignment: right;
        overflow: elide;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - Theme.hairline;
        width: parent.width;
        height: Theme.hairline;
        background: Theme.divider.with-alpha(0.44);
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.shown && root.interactive;
        mouse-cursor: root.entry.kind == "folder" || root.entry.kind == "file"
            ? pointer : default;
        double-clicked => {
            if root.entry.kind == "folder" {
                root.open-directory(root.entry.path);
            } else if root.entry.kind == "file" {
                root.open-file(root.entry.path);
            }
        }
    }
    TouchArea {
        x: 0px;
        width: root.leading-x + Theme.sftp-selection-width + Theme.sftp-column-gap;
        height: parent.height;
        enabled: root.shown && root.interactive;
        mouse-cursor: pointer;
        accessible-role: checkbox;
        accessible-label: "Select " + root.entry.name;
        accessible-checked: root.entry.selected;
        accessible-enabled: root.shown && root.interactive;
        accessible-action-default => {
            root.toggle-selection(root.entry.path, !root.entry.selected);
        }
        clicked => { root.toggle-selection(root.entry.path, !root.entry.selected); }
    }
}

component SftpDirectoryPane inherits Rectangle {
    in property <bool> interactive: true;
    in property <string> title;
    in property <[SftpEntryRow]> entries;
    in property <bool> loading;
    in property <string> path;
    in property <bool> truncated;
    in property <string> status;
    in property <bool> has-more: false;
    in property <bool> selection-all: false;
    in property <int> selection-count: 0;
    in property <bool> allow-hidden: true;
    in property <bool> allow-refresh: false;
    in property <bool> allow-navigation: false;
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;
    callback list-directory(string);
    callback load-more();
    callback refresh();
    callback navigate-back();
    callback navigate-forward();
    callback open-file(string);
    callback toggle-selection(string, bool);
    callback select-all(bool);

    private property <string> current-path: root.path;
    private property <string> path-draft: root.current-path;
    private property <bool> show-hidden: false;
    private property <length> control-text-height:
        control-text-probe.font-metrics.ascent - control-text-probe.font-metrics.descent;
    private property <length> control-height: max(
        Theme.sftp-control-min-height,
        root.control-text-height + 2 * Theme.sftp-control-padding-y,
    );
    private property <length> path-row-height:
        root.control-height + 2 * Theme.sftp-path-row-padding-y;
    private property <length> status-height:
        root.control-height + 2 * Theme.sftp-status-row-padding-y;

    changed current-path => { root.path-draft = root.current-path; }

    background: Theme.panel;
    clip: true;
    min-width: 0px;
    min-height: 0px;

    control-text-probe := Text {
        visible: false;
        text: "Open";
        font-size: Theme.sftp-control-font-size;
        font-weight: Theme.sftp-control-font-weight;
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: Theme.sftp-toolbar-height;
            background: Theme.panel-alt;

            Text {
                x: Theme.sftp-column-padding;
                width: parent.width - 2 * Theme.sftp-column-padding;
                height: parent.height;
                text: root.title;
                color: Theme.accent;
                font-size: Theme.font-body;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.allow-hidden : CheckBox {
                x: max(Theme.sftp-column-padding, parent.width - self.width - Theme.sftp-column-padding);
                width: Theme.sftp-hidden-control-width;
                height: parent.height;
                text: "Hidden";
                checked <=> root.show-hidden;
                enabled: root.interactive;
            }
            Rectangle {
                y: parent.height - Theme.hairline;
                width: parent.width;
                height: Theme.hairline;
                background: Theme.divider;
            }
        }

        Rectangle {
            height: root.path-row-height;
            background: Theme.panel;

            HorizontalLayout {
                padding-left: Theme.sftp-column-padding;
                padding-right: Theme.sftp-column-padding;
                padding-top: Theme.sftp-path-row-padding-y;
                padding-bottom: Theme.sftp-path-row-padding-y;
                spacing: Theme.space-sm;

                if root.allow-navigation : SftpActionButton {
                    width: Theme.sftp-nav-icon-button-width;
                    height: root.control-height;
                    text: "<";
                    accessible-name: "Back";
                    enabled: root.interactive && !root.loading && root.can-go-back;
                    clicked => { root.navigate-back(); }
                }
                if root.allow-navigation : SftpActionButton {
                    width: Theme.sftp-nav-icon-button-width;
                    height: root.control-height;
                    text: ">";
                    accessible-name: "Forward";
                    enabled: root.interactive && !root.loading && root.can-go-forward;
                    clicked => { root.navigate-forward(); }
                }

                FlatTextInput {
                    text <=> root.path-draft;
                    placeholder-text: "Path";
                    height: root.control-height;
                    control-min-height: root.control-height;
                    font-size: Theme.sftp-control-font-size;
                    font-weight: Theme.sftp-control-font-weight;
                    enabled: root.interactive && !root.loading;
                    accepted(path) => { root.list-directory(path); }
                }
                SftpActionButton {
                    width: Theme.sftp-path-action-width;
                    height: root.control-height;
                    text: "Open";
                    enabled: root.interactive && !root.loading && !root.path-draft.is-empty;
                    clicked => { root.list-directory(root.path-draft); }
                }
                if root.allow-refresh && root.width >= 340px : SftpActionButton {
                    width: Theme.sftp-refresh-button-width;
                    height: root.control-height;
                    text: "Refresh";
                    enabled: root.interactive && !root.loading && !root.current-path.is-empty;
                    clicked => { root.refresh(); }
                }
            }
            Rectangle {
                y: parent.height - Theme.hairline;
                width: parent.width;
                height: Theme.hairline;
                background: Theme.divider;
            }
        }

        SftpDirectoryHeader {
            selection-checked: root.selection-all;
            selection-enabled: root.interactive && root.entries.length > 0 && !root.loading;
            select-all(checked) => { root.select-all(checked); }
        }

        if root.entries.length > 0 : ListView {
            vertical-stretch: 1;
            min-height: 0px;

            // The direct ListView delegate owns its height. Keeping this
            // geometry outside SftpEntry makes virtualized rows advance even
            // when the entry is nested in another reusable component.
            for entry in root.entries : Rectangle {
                width: parent.width;
                height: root.show-hidden || !entry.hidden
                    ? Theme.sftp-row-height : 0px;
                clip: true;

                SftpEntry {
                    width: parent.width;
                    height: parent.height;
                    entry: entry;
                    shown: root.show-hidden || !entry.hidden;
                    interactive: root.interactive && !root.loading;
                    open-directory(path) => { root.list-directory(path); }
                    open-file(path) => { root.open-file(path); }
                    toggle-selection(path, selected) => { root.toggle-selection(path, selected); }
                }
            }
        }

        if root.entries.length == 0 : Rectangle {
            vertical-stretch: 1;
            Text {
                text: root.loading ? "Loading..." : "No files";
                color: Theme.muted;
                font-size: Theme.font-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: root.status-height;
            background: Theme.panel-alt;

            Text {
                x: Theme.sftp-column-padding;
                width: parent.width - 2 * Theme.sftp-column-padding
                    - (root.has-more ? Theme.sftp-more-button-width + Theme.space-sm : 0px);
                height: parent.height;
                text: root.status;
                color: root.truncated ? Theme.danger : Theme.muted;
                font-size: Theme.font-caption;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.has-more : SftpActionButton {
                x: parent.width - Theme.sftp-column-padding - self.width;
                y: (parent.height - self.height) / 2;
                width: Theme.sftp-more-button-width;
                height: root.control-height;
                text: root.loading ? "Loading" : "More";
                enabled: root.interactive && !root.loading;
                clicked => { root.load-more(); }
            }
        }
    }
}

component SftpTransferEntry inherits Rectangle {
    in property <SftpTransferRow> transfer;
    callback cancel(string);

    private property <length> action-slot-width:
        Theme.sftp-nav-icon-button-width + Theme.sftp-column-gap;
    private property <length> content-width: max(
        0px,
        root.width - Theme.sftp-column-padding - root.action-slot-width,
    );
    private property <length> name-x: Theme.sftp-column-padding;
    private property <length> status-x: root.content-width * 0.48;
    private property <length> size-x: root.content-width * 0.72;
    private property <length> speed-x: root.content-width * 0.86;
    private property <float> bounded-progress:
        max(0.0, min(1.0, root.transfer.progress));
    private property <color> state-color: root.transfer.state == "failed"
        ? Theme.danger
        : (root.transfer.state == "completed" ? Theme.success
        : (root.transfer.state == "cancelled" ? Theme.muted : Theme.accent));

    height: Theme.sftp-row-height;
    clip: true;
    background: cancel-button.has-focus ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.transfer.name + ", " + root.transfer.status
        + (root.transfer.size.is-empty ? "" : ", " + root.transfer.size);

    Text {
        x: root.name-x;
        width: max(0px, root.status-x - Theme.sftp-column-gap - self.x);
        height: parent.height;
        text: root.transfer.name;
        color: Theme.text;
        font-size: Theme.font-body;
        overflow: elide;
        vertical-alignment: center;
    }
    Rectangle {
        x: root.status-x;
        y: parent.height - Theme.space-sm;
        width: max(0px, root.size-x - Theme.sftp-column-gap - self.x);
        height: Theme.space-xxs;
        border-radius: Theme.hairline;
        background: Theme.divider.with-alpha(0.44);

        Rectangle {
            width: parent.width * root.bounded-progress;
            height: parent.height;
            border-radius: parent.border-radius;
            background: root.state-color;
        }
    }
    Text {
        x: root.status-x;
        width: max(0px, root.size-x - Theme.sftp-column-gap - self.x);
        height: parent.height - Theme.space-sm;
        text: root.transfer.status;
        color: root.state-color;
        font-size: Theme.font-caption;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: root.size-x;
        width: max(0px, root.speed-x - Theme.sftp-column-gap - self.x);
        height: parent.height;
        text: root.transfer.size;
        color: Theme.muted;
        font-size: Theme.font-caption;
        horizontal-alignment: right;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: root.speed-x;
        width: max(
            0px,
            parent.width - root.action-slot-width - Theme.sftp-column-gap - self.x,
        );
        height: parent.height;
        text: root.transfer.speed;
        color: Theme.muted;
        font-size: Theme.font-caption;
        horizontal-alignment: right;
        overflow: elide;
        vertical-alignment: center;
    }
    cancel-button := SftpActionButton {
        visible: root.transfer.cancellable;
        x: parent.width - Theme.sftp-column-padding - self.width;
        y: (parent.height - self.height) / 2;
        width: Theme.sftp-nav-icon-button-width;
        height: parent.height;
        text: "x";
        accessible-name: "Cancel transfer " + root.transfer.name;
        font-size: Theme.font-small;
        enabled: root.transfer.cancellable;
        clicked => { root.cancel(root.transfer.id); }
    }
    Rectangle {
        y: parent.height - Theme.hairline;
        width: parent.width;
        height: Theme.hairline;
        background: Theme.divider.with-alpha(0.44);
    }
}

component SftpTransferQueue inherits Rectangle {
    in property <bool> collapsed: false;
    in property <[SftpTransferRow]> transfers;
    in property <int> active-count: 0;
    in property <int> failed-count: 0;
    in property <int> completed-count: 0;
    callback cancel-transfer(string);

    background: Theme.panel;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: Theme.sftp-transfer-toolbar-height;
            background: Theme.panel-alt;
            Text {
                x: Theme.sftp-column-padding;
                width: parent.width - 2 * Theme.sftp-column-padding;
                height: parent.height;
                text: "Transfers   Active (" + root.active-count + ")   Failed ("
                    + root.failed-count + ")   Completed (" + root.completed-count + ")";
                color: Theme.muted;
                font-size: Theme.font-caption;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle {
                y: parent.height - Theme.hairline;
                width: parent.width;
                height: Theme.hairline;
                background: Theme.divider;
            }
        }
        if !root.collapsed : Rectangle {
            private property <length> action-slot-width:
                Theme.sftp-nav-icon-button-width + Theme.sftp-column-gap;
            private property <length> content-width: max(
                0px,
                self.width - Theme.sftp-column-padding - self.action-slot-width,
            );
            height: Theme.sftp-transfer-header-height;
            background: Theme.panel;
            Text {
                x: Theme.sftp-column-padding;
                width: max(0px, parent.content-width * 0.48 - Theme.sftp-column-gap - self.x);
                height: parent.height;
                text: "Name";
                color: Theme.muted;
                font-size: Theme.font-caption;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                x: parent.content-width * 0.48;
                width: max(0px, parent.content-width * 0.24 - Theme.sftp-column-gap);
                height: parent.height;
                text: "Status";
                color: Theme.muted;
                font-size: Theme.font-caption;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                x: parent.content-width * 0.72;
                width: max(0px, parent.content-width * 0.14 - Theme.sftp-column-gap);
                height: parent.height;
                text: "Size";
                color: Theme.muted;
                font-size: Theme.font-caption;
                font-weight: 700;
                horizontal-alignment: right;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                x: parent.content-width * 0.86;
                width: max(
                    0px,
                    parent.width - parent.action-slot-width - Theme.sftp-column-gap - self.x,
                );
                height: parent.height;
                text: "Speed";
                color: Theme.muted;
                font-size: Theme.font-caption;
                font-weight: 700;
                horizontal-alignment: right;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle {
                y: parent.height - Theme.hairline;
                width: parent.width;
                height: Theme.hairline;
                background: Theme.divider;
            }
        }
        if !root.collapsed && root.transfers.length > 0 : ListView {
            vertical-stretch: 1;
            min-height: 0px;
            accessible-role: list;
            accessible-label: "File transfers";

            for transfer in root.transfers : Rectangle {
                width: parent.width;
                height: Theme.sftp-row-height;

                SftpTransferEntry {
                    width: parent.width;
                    height: parent.height;
                    transfer: transfer;
                    cancel(id) => { root.cancel-transfer(id); }
                }
            }
        }
        if !root.collapsed && root.transfers.length == 0 : Rectangle {
            vertical-stretch: 1;
            Text {
                text: "No transfers yet";
                color: Theme.muted;
                font-size: Theme.font-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component SftpPane inherits Rectangle {
    in property <SftpViewState> view;
    in property <bool> standalone: false;
    in-out property <float> directory-split-ratio: 0.5;
    in-out property <float> files-split-ratio: 0.7;
    in-out property <bool> transfers-collapsed: false;
    callback list-directory(string);
    callback load-more();
    callback list-local-directory(string);
    callback navigate-back();
    callback navigate-forward();
    callback toggle-remote-selection(string, bool);
    callback select-all-remote(bool);
    callback toggle-local-selection(string, bool);
    callback select-all-local(bool);
    callback open-remote-file(string);
    callback open-local-file(string);
    callback cancel-transfer(string);
    callback close();

    min-width: root.standalone ? 0px : Theme.sftp-panel-min-width;
    preferred-width: root.standalone ? 0px : Theme.sftp-panel-width;
    max-width: root.standalone ? 100000px : Theme.sftp-panel-max-width;
    min-height: 0px;
    background: Theme.background;
    accessible-role: list;
    accessible-label: "SFTP files";

    private property <length> directory-splitter-size: min(
        Theme.sftp-splitter-size,
        root.width,
    );
    private property <length> horizontal-available-width:
        max(0px, root.width - root.directory-splitter-size);
    private property <length> directory-pane-floor: min(
        Theme.sftp-directory-pane-min-width,
        root.horizontal-available-width / 2,
    );
    private property <float> directory-ratio-min: root.horizontal-available-width > 0px
        ? root.directory-pane-floor / root.horizontal-available-width : 0.5;
    private property <float> directory-ratio-max: 1.0 - root.directory-ratio-min;
    private property <float> clamped-directory-split-ratio: max(
        root.directory-ratio-min,
        min(root.directory-ratio-max, root.directory-split-ratio),
    );
    private property <length> remote-pane-width:
        root.horizontal-available-width * root.clamped-directory-split-ratio;

    private property <length> transfer-splitter-size: min(
        Theme.sftp-splitter-size,
        root.height,
    );
    private property <length> expanded-vertical-available-height:
        max(0px, root.height - root.transfer-splitter-size);
    private property <length> files-area-floor: min(
        Theme.sftp-files-area-min-height,
        root.expanded-vertical-available-height / 2,
    );
    private property <length> transfer-area-floor: min(
        Theme.sftp-transfer-area-min-height,
        root.expanded-vertical-available-height / 2,
    );
    private property <float> files-ratio-min: root.expanded-vertical-available-height > 0px
        ? root.files-area-floor / root.expanded-vertical-available-height : 0.5;
    private property <float> files-ratio-max: root.expanded-vertical-available-height > 0px
        ? 1.0 - root.transfer-area-floor / root.expanded-vertical-available-height : 0.5;
    private property <float> clamped-files-split-ratio: max(
        root.files-ratio-min,
        min(root.files-ratio-max, root.files-split-ratio),
    );
    private property <length> collapsed-transfer-height: min(
        Theme.sftp-transfer-toolbar-height,
        root.expanded-vertical-available-height,
    );
    private property <length> files-area-height: root.transfers-collapsed
        ? max(0px, root.expanded-vertical-available-height - root.collapsed-transfer-height)
        : root.expanded-vertical-available-height * root.clamped-files-split-ratio;
    private property <length> transfer-area-height: root.transfers-collapsed
        ? root.collapsed-transfer-height
        : max(0px, root.expanded-vertical-available-height - root.files-area-height);

    init => {
        if !root.view.local_path.is-empty {
            root.list-local-directory(root.view.local_path);
        }
    }

    VerticalLayout {
        spacing: 0px;

        files-area := Rectangle {
            width: parent.width;
            height: root.files-area-height;
            background: Theme.panel;
            clip: true;

            remote-pane := SftpDirectoryPane {
                x: 0px;
                width: root.remote-pane-width;
                height: parent.height;
                title: "Remote files";
                interactive: root.view.available;
                entries: root.view.entries;
                loading: root.view.loading;
                path: root.view.path;
                truncated: root.view.truncated;
                status: root.view.status;
                has-more: root.view.has_more;
                selection-all: root.view.all_selected;
                selection-count: root.view.selected_count;
                allow-refresh: true;
                allow-navigation: true;
                can-go-back: root.view.can_go_back;
                can-go-forward: root.view.can_go_forward;
                list-directory(path) => { root.list-directory(path); }
                load-more => { root.load-more(); }
                refresh => { root.list-directory(root.view.path); }
                navigate-back => { root.navigate-back(); }
                navigate-forward => { root.navigate-forward(); }
                open-file(path) => { root.open-remote-file(path); }
                toggle-selection(path, selected) => {
                    root.toggle-remote-selection(path, selected);
                }
                select-all(selected) => { root.select-all-remote(selected); }
            }

            directory-splitter := SftpSplitHandle {
                x: remote-pane.width;
                width: root.directory-splitter-size;
                height: parent.height;
                orientation: Orientation.horizontal;
                accessible-name: "Remote and local file pane sizes";
                value: root.clamped-directory-split-ratio;
                minimum: root.directory-ratio-min;
                maximum: root.directory-ratio-max;
                available-length: root.horizontal-available-width;
                adjust(delta) => {
                    root.directory-split-ratio = max(
                        root.directory-ratio-min,
                        min(root.directory-ratio-max, root.directory-split-ratio + delta),
                    );
                }
                set-value(candidate) => {
                    root.directory-split-ratio = max(
                        root.directory-ratio-min,
                        min(root.directory-ratio-max, candidate),
                    );
                }
                activated => { root.directory-split-ratio = 0.5; }
            }

            SftpDirectoryPane {
                x: directory-splitter.x + directory-splitter.width;
                width: max(0px, parent.width - self.x);
                height: parent.height;
                title: "Local files";
                allow-hidden: false;
                entries: root.view.local_entries;
                loading: root.view.local_loading;
                path: root.view.local_path;
                truncated: root.view.local_truncated;
                status: root.view.local_status;
                selection-all: root.view.local_all_selected;
                selection-count: root.view.local_selected_count;
                list-directory(path) => { root.list-local-directory(path); }
                open-file(path) => { root.open-local-file(path); }
                toggle-selection(path, selected) => {
                    root.toggle-local-selection(path, selected);
                }
                select-all(selected) => { root.select-all-local(selected); }
            }
        }

        transfer-splitter := SftpSplitHandle {
            width: parent.width;
            height: root.transfer-splitter-size;
            orientation: Orientation.vertical;
            accessible-name: "Files and transfers area sizes";
            value: root.clamped-files-split-ratio;
            minimum: root.files-ratio-min;
            maximum: root.files-ratio-max;
            available-length: root.expanded-vertical-available-height;
            adjust(delta) => {
                root.transfers-collapsed = false;
                root.files-split-ratio = max(
                    root.files-ratio-min,
                    min(root.files-ratio-max, root.files-split-ratio + delta),
                );
            }
            set-value(candidate) => {
                root.transfers-collapsed = false;
                root.files-split-ratio = max(
                    root.files-ratio-min,
                    min(root.files-ratio-max, candidate),
                );
            }
            activated => { root.transfers-collapsed = !root.transfers-collapsed; }
        }

        SftpTransferQueue {
            width: parent.width;
            height: root.transfer-area-height;
            collapsed: root.transfers-collapsed;
            transfers: root.view.transfers;
            active-count: root.view.transfer_active_count;
            failed-count: root.view.transfer_failed_count;
            completed-count: root.view.transfer_completed_count;
            cancel-transfer(id) => { root.cancel-transfer(id); }
        }
    }
}
