import { Theme } from "theme.slint";
import {
    TerminalGrid,
    TerminalGridView,
    TerminalRenderLine,
    TerminalSelectionView,
} from "components/terminal-grid.slint";

// Rust owns the rendered terminal snapshot and connection lifecycle. The pane
// owns only selection, focus, cursor blink, and measured layout state.
export struct TerminalViewState {
    terminal_id: string,
    connected: bool,
    render_lines: [TerminalRenderLine],
    content_columns: int,
    cursor_row: int,
    cursor_column: int,
    cursor_visible: bool,
    cursor_text: string,
    font_family: string,
    font_size: length,
    line_height_percent: int,
    foreground: color,
    background: color,
    selection_background: color,
    right_click_copy_or_paste: bool,
    option_as_meta: bool,
    copy_selection_shortcut: string,
    paste_shortcut: string,
}

export component TerminalPane inherits Rectangle {
    in property <TerminalViewState> view;
    private property <bool> connected: root.view.connected;
    private property <string> terminal-id: root.view.terminal_id;
    private property <[TerminalRenderLine]> render-lines: root.view.render_lines;
    private property <int> content-columns: root.view.content_columns;
    private property <int> cursor-row: root.view.cursor_row;
    private property <int> cursor-column: root.view.cursor_column;
    private property <bool> cursor-visible: root.view.cursor_visible;
    private property <string> cursor-text: root.view.cursor_text;
    private property <string> terminal-font-family: root.view.font_family;
    private property <length> terminal-font-size: root.view.font_size;
    private property <int> terminal-line-height-percent: root.view.line_height_percent;
    private property <color> terminal-foreground: root.view.foreground;
    private property <color> terminal-background: root.view.background;
    private property <color> terminal-selection-background: root.view.selection_background;
    private property <bool> right-click-copy-or-paste: root.view.right_click_copy_or_paste;
    private property <bool> option-as-meta: root.view.option_as_meta;
    private property <string> copy-selection-shortcut: root.view.copy_selection_shortcut;
    private property <string> paste-shortcut: root.view.paste_shortcut;

    callback terminal-key(string, bool, bool, bool, bool, bool) -> bool;
    callback terminal-key-direct(string, bool, bool, bool, bool, bool, bool) -> bool;
    callback resized(int, int);
    callback scrolled(int);
    callback selection-text(int, int, int, int) -> string;
    callback format-shortcut(string, bool, bool, bool, bool) -> string;
    callback write-clipboard(string);
    callback read-clipboard() -> string;

    private property <length> font-cell-width:
        max(1px, cell-probe.preferred-width / 50);
    private property <length> font-cell-height: max(1px, cell-probe.preferred-height);
    private property <length> cell-width: root.font-cell-width;
    private property <length> cell-height:
        max(root.font-cell-height,
            root.font-cell-height * root.terminal-line-height-percent / 100);
    private property <int> terminal-columns:
        max(Theme.terminal-grid-min-columns,
            min(Theme.terminal-grid-max-columns, floor(grid-clip.width / root.cell-width)));
    private property <int> terminal-rows:
        max(Theme.terminal-grid-min-rows,
            min(Theme.terminal-grid-max-rows, floor(grid-clip.height / root.cell-height)));
    private property <length> grid-top-offset:
        max(0px, grid-clip.height - root.terminal-rows * root.cell-height);
    private property <bool> terminal-resize-pending: false;
    private property <bool> cursor-blink: true;
    private property <bool> selecting: false;
    private property <int> selection-anchor-row: 0;
    private property <int> selection-anchor-column: 0;
    private property <int> selection-focus-row: 0;
    private property <int> selection-focus-column: 0;
    private property <bool> selection-active:
        root.selection-anchor-row != root.selection-focus-row
        || root.selection-anchor-column != root.selection-focus-column;
    private property <bool> anchor-first:
        root.selection-anchor-row < root.selection-focus-row
        || (root.selection-anchor-row == root.selection-focus-row
            && root.selection-anchor-column <= root.selection-focus-column);
    private property <int> selection-first-row:
        root.anchor-first ? root.selection-anchor-row : root.selection-focus-row;
    private property <int> selection-first-column:
        root.anchor-first ? root.selection-anchor-column : root.selection-focus-column;
    private property <int> selection-last-row:
        root.anchor-first ? root.selection-focus-row : root.selection-anchor-row;
    private property <int> selection-last-column:
        root.anchor-first ? root.selection-focus-column : root.selection-anchor-column;
    private property <TerminalGridView> grid-view: {
        connected: root.connected, render_lines: root.render-lines,
        content_columns: root.content-columns,
        cursor_row: root.cursor-row, cursor_column: root.cursor-column,
        cursor_visible: root.cursor-visible, cursor_text: root.cursor-text,
        font_family: root.terminal-font-family, font_size: root.terminal-font-size,
        foreground: root.terminal-foreground, background: root.terminal-background,
        selection_background: root.terminal-selection-background,
    };
    private property <TerminalSelectionView> grid-selection: {
        active: root.selection-active, first_row: root.selection-first-row,
        first_column: root.selection-first-column, last_row: root.selection-last-row,
        last_column: root.selection-last-column,
    };

    public function focus-terminal() {
        ime-input.focus();
    }

    function update-terminal-size() {
        if root.connected {
            root.resized(root.terminal-columns, root.terminal-rows);
        }
    }

    function schedule-terminal-size-update() {
        root.terminal-resize-pending = true;
    }

    function clear-selection() {
        root.selecting = false;
        root.selection-focus-row = root.selection-anchor-row;
        root.selection-focus-column = root.selection-anchor-column;
    }

    function copy-selection() {
        if root.selection-active {
            root.write-clipboard(root.selection-text(
                root.selection-anchor-row,
                root.selection-anchor-column,
                root.selection-focus-row,
                root.selection-focus-column,
            ));
            ime-input.focus();
        }
    }

    function select-all-visible() {
        root.selection-anchor-row = 0;
        root.selection-anchor-column = 0;
        root.selection-focus-row = max(0, root.render-lines.length - 1);
        root.selection-focus-column = max(0, root.content-columns - 1);
    }

    function paste-from-clipboard() {
        let text = root.read-clipboard();
        if root.connected && !text.is-empty {
            root.clear-selection();
            root.terminal-key(text, false, false, false, false, false);
        }
        ime-input.focus();
    }

    changed terminal-columns => { root.schedule-terminal-size-update(); }
    changed terminal-rows => { root.schedule-terminal-size-update(); }
    changed terminal-font-family => { root.schedule-terminal-size-update(); }
    changed terminal-font-size => { root.schedule-terminal-size-update(); }
    changed terminal-line-height-percent => { root.schedule-terminal-size-update(); }
    changed terminal-id => { root.schedule-terminal-size-update(); }
    changed connected => {
        root.schedule-terminal-size-update();
        if root.connected {
            root.focus-terminal();
        }
    }
    changed visible => {
        if self.visible && root.connected {
            root.focus-terminal();
        }
    }

    background: root.terminal-background;
    border-width: 0px;
    forward-focus: ime-input;
    accessible-role: text;
    accessible-label: "Terminal";

    cell-probe := Text {
        x: -1000px;
        y: -1000px;
        width: 0px;
        height: 0px;
        text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM";
        font-family: root.terminal-font-family;
        font-size: root.terminal-font-size;
        font-weight: 400;
        letter-spacing: 0px;
        opacity: 0;
    }

    Timer {
        running: root.connected && ime-input.has-focus && root.cursor-visible;
        interval: 530ms;
        triggered => { root.cursor-blink = !root.cursor-blink; }
    }

    // Let font measurement and layout settle before one coalesced PTY resize.
    Timer {
        running: root.terminal-resize-pending;
        interval: 1ms;
        triggered => {
            root.terminal-resize-pending = false;
            root.update-terminal-size();
        }
    }

    ime-input := TextInput {
        x: grid-clip.x + max(0px, min(grid-clip.width - 1px,
            root.cursor-column * root.cell-width));
        y: grid-clip.y + max(0px, min(grid-clip.height - root.cell-height,
            root.grid-top-offset + root.cursor-row * root.cell-height));
        width: Theme.hairline;
        height: root.cell-height;
        opacity: 0;
        single-line: true;
        color: transparent;
        selection-foreground-color: transparent;
        selection-background-color: transparent;
        text-cursor-width: 0px;
        font-family: root.terminal-font-family;
        font-size: root.terminal-font-size;
        accessible-role: none;

        changed has-focus => {
            if self.has-focus {
                root.cursor-blink = true;
            }
        }
        key-pressed(event) => {
            let shortcut = root.format-shortcut(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
            );
            if shortcut == root.copy-selection-shortcut && root.selection-active {
                root.copy-selection();
                return EventResult.accept;
            }
            if shortcut == root.paste-shortcut {
                root.paste-from-clipboard();
                return EventResult.accept;
            }
            let direct-terminal-key = root.terminal-key-direct(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
                root.option-as-meta,
                self.preedit-text != "",
            );
            if !direct-terminal-key {
                return EventResult.reject;
            }
            root.clear-selection();
            if root.terminal-key(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
                true,
            ) {
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        edited => {
            if self.preedit-text == "" && self.text != "" {
                root.clear-selection();
                root.terminal-key(self.text, false, false, false, false, false);
                self.text = "";
            }
        }
    }

    VerticalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        padding-top: Theme.space-md;
        padding-bottom: 0px;

        grid-clip := Rectangle {
            vertical-stretch: 1;
            background: root.terminal-background;

            TerminalGrid {
                width: parent.width;
                height: parent.height;
                view: root.grid-view;
                selection: root.grid-selection;
                cell-width: root.cell-width;
                cell-height: root.cell-height;
                font-cell-height: root.font-cell-height;
                top-offset: root.grid-top-offset;
                cursor-blink: root.cursor-blink;
                preedit-text: ime-input.preedit-text;
                right-click-copy-or-paste: root.right-click-copy-or-paste;
                pointer-down(row, column, left, right) => {
                    root.focus-terminal();
                    if left {
                        root.selection-anchor-row = row;
                        root.selection-anchor-column = column;
                        root.selection-focus-row = row;
                        root.selection-focus-column = column;
                        root.selecting = true;
                    } else if right && root.right-click-copy-or-paste {
                        if root.selection-active {
                            root.copy-selection();
                            root.clear-selection();
                        } else if root.connected {
                            root.paste-from-clipboard();
                        }
                    }
                }
                pointer-moved(row, column) => {
                    if root.selecting {
                        root.selection-focus-row = row;
                        root.selection-focus-column = column;
                    }
                }
                pointer-up => { root.selecting = false; }
                scrolled(lines) => {
                    root.clear-selection();
                    root.scrolled(lines);
                }
                copy-request => { root.copy-selection(); }
                paste-request => { root.paste-from-clipboard(); }
                select-all-request => { root.select-all-visible(); }
            }
        }
    }
}
