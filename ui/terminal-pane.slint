import { Theme } from "theme.slint";
import { ElidedButton } from "components/elided-controls.slint";
import {
    TerminalGrid,
    TerminalGridView,
    TerminalRenderLine,
    TerminalTargetHighlight,
    TerminalSelectionView,
} from "components/terminal-grid.slint";

// Rust owns the rendered terminal snapshot and connection lifecycle. The pane
// owns only selection, focus, cursor blink, and measured layout state.
export struct TerminalCursorState {
    row: int,
    column: int,
    cells: int,
    visible: bool,
    text: string,
}

export struct TerminalNoticeViewState {
    visible: bool,
    severity: string,
    title: string,
    message: string,
    primary_action: string,
    primary_label: string,
    secondary_action: string,
    secondary_label: string,
}

// Rust computes only this bounded viewport-relative range. TerminalPane keeps
// it as local interaction state, including the single-cell active case.
export struct TerminalSemanticSelection {
    active: bool,
    anchor_row: int,
    anchor_column: int,
    focus_row: int,
    focus_column: int,
}

export struct TerminalViewState {
    terminal_id: string,
    connected: bool,
    selection_revision: int,
    notice: TerminalNoticeViewState,
    render_lines: [TerminalRenderLine],
    cursor_state: [TerminalCursorState],
    content_columns: int,
    cursor_row: int,
    cursor_column: int,
    cursor_cells: int,
    cursor_visible: bool,
    cursor_text: string,
    font_family: string,
    font_size: length,
    line_height_percent: int,
    foreground: color,
    background: color,
    selection_background: color,
    compact_rendering: bool,
    row_render_cache: bool,
    right_click_copy_or_paste: bool,
    copy_selection_on_select: bool,
    option_as_meta: bool,
    copy_selection_shortcut: string,
    paste_shortcut: string,
    select_all_shortcut: string,
    mouse_button_reporting: bool,
    mouse_wheel_reporting: bool,
    mouse_local_selection_priority: bool,
    display_offset: int,
    viewport_detached: bool,
    alternate_screen: bool,
}

component TerminalPaneCloseButton inherits FocusScope {
    callback activated();

    width: Theme.terminal-pane-close-size;
    height: Theme.terminal-pane-close-size;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: @tr("Close terminal pane");
    accessible-action-default => { root.activated(); }

    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.activated();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    Rectangle {
        border-width: root.has-focus ? Theme.hairline : 0px;
        border-color: Theme.focus;
        border-radius: Theme.radius-small;
        background: close-touch.has-hover || root.has-focus ? Theme.hover : transparent;

        Text {
            width: parent.width;
            height: parent.height;
            text: @tr("x");
            color: close-touch.has-hover || root.has-focus ? Theme.text : Theme.muted;
            font-size: Theme.tab-close-font-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }

        close-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.activated(); }
        }

        Tooltip {
            Text {
                text: @tr("Close terminal pane");
                color: Theme.text;
                font-family: Theme.application-font-family;
                font-size: Theme.font-caption;
            }
        }
    }
}

component TerminalNoticeBanner inherits Rectangle {
    in property <TerminalNoticeViewState> notice;
    callback action(string);

    height: Theme.terminal-pane-notice-height;
    background: root.notice.severity == "error"
        ? Theme.danger.with-alpha(0.14)
        : Theme.accent.with-alpha(0.12);
    border-width: Theme.hairline;
    border-color: root.notice.severity == "error" ? Theme.danger : Theme.accent;
    border-radius: Theme.radius-small;
    clip: true;
    accessible-role: text;
    accessible-label: root.notice.title + ": " + root.notice.message;

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        padding-top: Theme.space-sm;
        padding-bottom: Theme.space-sm;
        spacing: Theme.space-md;

        VerticalLayout {
            vertical-stretch: 1;
            spacing: Theme.space-xxs;

            Text {
                text: root.notice.title;
                color: Theme.text;
                font-size: Theme.font-small;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.notice.message;
                color: Theme.text;
                font-size: Theme.font-caption;
                overflow: elide;
            }
        }

        ElidedButton {
            visible: !root.notice.primary_action.is-empty;
            width: self.visible ? 88px : 0px;
            text: root.notice.primary_label;
            clicked => { root.action(root.notice.primary_action); }
        }
        ElidedButton {
            visible: !root.notice.secondary_action.is-empty;
            width: self.visible ? 76px : 0px;
            text: root.notice.secondary_label;
            clicked => { root.action(root.notice.secondary_action); }
        }
    }
}

export component TerminalPane inherits Rectangle {
    in property <TerminalViewState> view;
    in property <bool> focused: false;
    in property <bool> closable: false;
    in property <bool> cursor-blink-enabled: true;
    in property <string> edit-command;
    in property <int> edit-command-revision: 0;
    in property <int> focus-request-revision: 0;
    private property <bool> connected: root.view.connected;
    private property <TerminalNoticeViewState> notice: root.view.notice;
    private property <string> terminal-id: root.view.terminal_id;
    private property <[TerminalRenderLine]> render-lines: root.view.render_lines;
    private property <int> selection-revision: root.view.selection_revision;
    private property <int> content-columns: root.view.content_columns;
    private property <int> cursor-row: root.view.cursor_state.length > 0
        ? root.view.cursor_state[0].row : root.view.cursor_row;
    private property <int> cursor-column: root.view.cursor_state.length > 0
        ? root.view.cursor_state[0].column : root.view.cursor_column;
    private property <int> cursor-cells: root.view.cursor_state.length > 0
        ? root.view.cursor_state[0].cells : root.view.cursor_cells;
    private property <bool> cursor-visible: root.view.cursor_state.length > 0
        ? root.view.cursor_state[0].visible : root.view.cursor_visible;
    private property <string> cursor-text: root.view.cursor_state.length > 0
        ? root.view.cursor_state[0].text : root.view.cursor_text;
    private property <string> terminal-font-family: root.view.font_family;
    private property <length> terminal-font-size: root.view.font_size;
    private property <int> terminal-line-height-percent: root.view.line_height_percent;
    private property <color> terminal-foreground: root.view.foreground;
    private property <color> terminal-background: root.view.background;
    private property <color> terminal-selection-background: root.view.selection_background;
    private property <bool> right-click-copy-or-paste: root.view.right_click_copy_or_paste;
    private property <bool> copy-selection-on-select: root.view.copy_selection_on_select;
    private property <bool> option-as-meta: root.view.option_as_meta;
    private property <string> copy-selection-shortcut: root.view.copy_selection_shortcut;
    private property <string> paste-shortcut: root.view.paste_shortcut;
    private property <string> select-all-shortcut: root.view.select_all_shortcut;
    private property <bool> mouse-local-selection-priority:
        root.view.mouse_local_selection_priority;

    callback terminal-key(string, bool, bool, bool, bool, bool) -> bool;
    callback terminal-key-direct(string, bool, bool, bool, bool, bool, bool) -> bool;
    callback resized(int, int);
    callback presentation-layout(length, length, length, length, length);
    callback scrolled(int);
    callback mouse-event(int, int, int, int, bool, bool, bool);
    callback selection-text(int, int, int, int) -> string;
    callback semantic-selection-range(int, int) -> TerminalSemanticSelection;
    callback line-selection-range(int, int) -> TerminalSemanticSelection;
    callback terminal-target-at-cell(int, int, bool, bool) -> TerminalTargetHighlight;
    callback activate-terminal-target(int, int, bool, bool) -> bool;
    callback format-shortcut(string, bool, bool, bool, bool) -> string;
    callback write-clipboard(string);
    callback read-clipboard() -> string;
    callback pane-focus(string);
    callback pane-command(string, string) -> bool;

    // Measure the primary font and the registered fallback glyphs separately.
    // The terminal grid uses one logical cell width for every script; using
    // only Latin M can leave CJK and box-drawing glyphs on a fractional edge.
    private property <length> font-cell-width:
        max(
            max(1px,
                max(cell-probe.preferred-width / 50,
                    wide-cell-probe.preferred-width / 50)),
            symbol-cell-probe.preferred-width / 3);
    private property <length> font-cell-height: max(1px, cell-probe.preferred-height);
    private property <length> cell-width: root.font-cell-width;
    private property <length> cell-height:
        max(root.font-cell-height,
            root.font-cell-height * root.terminal-line-height-percent / 100);
    private property <int> terminal-columns:
        max(Theme.terminal-grid-min-columns,
            min(Theme.terminal-grid-max-columns, floor(grid-clip.width / root.cell-width)));
    private property <int> terminal-rows:
        max(Theme.terminal-grid-min-rows,
            min(Theme.terminal-grid-max-rows, floor(grid-clip.height / root.cell-height)));
    // Complete rows meet the pane bottom and any fractional height stays above
    // them. Only panes below the minimum row floor clip older top rows.
    private property <length> grid-top-offset:
        grid-clip.height - root.terminal-rows * root.cell-height;
    // The grid, pre-edit overlay, and native IME proxy share this one
    // content-space cursor position. The clipping parent handles negatives.
    private property <length> cursor-cell-y:
        root.grid-top-offset + root.cursor-row-in-grid * root.cell-height;
    private property <length> cursor-cell-x:
        root.cursor-column-in-grid * root.cell-width;
    // Snapshot delivery and a pending resize can briefly describe different
    // grid sizes. Keep every cursor surface inside the current measured grid
    // until the next terminal snapshot catches up.
    private property <int> cursor-row-in-grid:
        max(0, min(root.terminal-rows - 1, root.cursor-row));
    private property <int> cursor-column-in-grid:
        max(0, min(root.terminal-columns - 1, root.cursor-column));
    private property <int> cursor-cells-in-grid:
        max(1, min(root.cursor-cells,
            root.terminal-columns - root.cursor-column-in-grid));
    private property <bool> terminal-resize-pending: false;
    private property <bool> presentation-layout-pending: false;
    // A newly created pane cannot own native focus until Slint has completed
    // the current layout pass. Existing split panes focus directly.
    private property <bool> initial-input-focus-pending: false;
    private property <bool> cursor-blink: true;
    private property <bool> selecting: false;
    private property <bool> selection-valid: false;
    // In local-selection-priority mode, defer a reporting click until release
    // so a drag can remain local while a stationary click reaches a TUI.
    private property <bool> local-click-candidate: false;
    private property <int> pressed-button: -1;
    private property <bool> last-pointer-shift: false;
    private property <bool> last-pointer-alt: false;
    private property <bool> last-pointer-control: false;
    private property <bool> last-primary-target-activated: false;
    private property <bool> mouse-motion-pending: false;
    private property <int> mouse-motion-row: 0;
    private property <int> mouse-motion-column: 0;
    private property <int> mouse-motion-button: 5;
    private property <bool> mouse-motion-shift: false;
    private property <bool> mouse-motion-alt: false;
    private property <bool> mouse-motion-control: false;
    private property <int> selection-anchor-row: 0;
    private property <int> selection-anchor-column: 0;
    private property <int> selection-focus-row: 0;
    private property <int> selection-focus-column: 0;
    private property <int> target-pointer-row: 0;
    private property <int> target-pointer-column: 0;
    private property <bool> target-pointer-in-grid: false;
    private property <TerminalTargetHighlight> terminal-target-highlight: {
        active: false, row: 0, start_column: 0, end_column: 0,
    };
    private property <bool> selection-active: root.selection-valid;
    private property <bool> anchor-first:
        root.selection-anchor-row < root.selection-focus-row
        || (root.selection-anchor-row == root.selection-focus-row
            && root.selection-anchor-column <= root.selection-focus-column);
    private property <int> selection-first-row:
        root.anchor-first ? root.selection-anchor-row : root.selection-focus-row;
    private property <int> selection-first-column:
        root.anchor-first ? root.selection-anchor-column : root.selection-focus-column;
    private property <int> selection-last-row:
        root.anchor-first ? root.selection-focus-row : root.selection-anchor-row;
    private property <int> selection-last-column:
        root.anchor-first ? root.selection-focus-column : root.selection-anchor-column;
    private property <TerminalGridView> grid-view: {
        connected: root.connected, render_lines: root.render-lines,
        row_count: root.render-lines.length,
        content_columns: root.content-columns,
        cursor_row: root.cursor-row-in-grid,
        cursor_column: root.cursor-column-in-grid,
        cursor_cells: root.cursor-cells-in-grid,
        cursor_visible: root.cursor-visible, cursor_text: root.cursor-text,
        font_family: root.terminal-font-family, font_size: root.terminal-font-size,
        foreground: root.terminal-foreground, background: root.terminal-background,
        selection_background: root.terminal-selection-background,
        compact_rendering: root.view.compact_rendering,
        row_render_cache: root.view.row_render_cache,
        mouse_button_reporting: root.view.mouse_button_reporting,
    };
    private property <TerminalSelectionView> grid-selection: {
        active: root.selection-active, first_row: root.selection-first-row,
        first_column: root.selection-first-column, last_row: root.selection-last-row,
        last_column: root.selection-last-column,
    };

    function focus-input() {
        if root.connected {
            ime-input.focus();
        }
    }

    public function focus-terminal() {
        root.pane-focus(root.terminal-id);
        root.focus-input();
    }

    function update-terminal-size() {
        if root.connected {
            root.resized(root.terminal-columns, root.terminal-rows);
        }
    }

    function schedule-terminal-size-update() {
        root.terminal-resize-pending = true;
        root.presentation-layout-pending = true;
    }

    function update-presentation-layout() {
        root.presentation-layout(
            grid-clip.x,
            grid-clip.y,
            grid-clip.width,
            grid-clip.height,
            root.cell-height,
        );
    }

    // A pane may be created with both its final view and connected state already
    // set, which does not fire a property-change handler for the first layout.
    // Queue the existing coalesced resize after Slint has resolved its geometry.
    init => {
        root.schedule-terminal-size-update();
        root.initial-input-focus-pending = true;
    }

    function clear-terminal-target-highlight() {
        root.terminal-target-highlight = {
            active: false, row: 0, start_column: 0, end_column: 0,
        };
    }

    function clear-selection() {
        root.selecting = false;
        root.selection-valid = false;
        root.cursor-blink = true;
        root.clear-terminal-target-highlight();
        root.selection-focus-row = root.selection-anchor-row;
        root.selection-focus-column = root.selection-anchor-column;
    }

    function copy-selection() {
        if root.selection-active {
            root.write-clipboard(root.selection-text(
                root.selection-anchor-row,
                root.selection-anchor-column,
                root.selection-focus-row,
                root.selection-focus-column,
            ));
            ime-input.focus();
        }
    }

    function select-all-visible() {
        root.selection-anchor-row = 0;
        root.selection-anchor-column = 0;
        root.selection-focus-row = max(0, root.render-lines.length - 1);
        root.selection-focus-column = max(0, root.content-columns - 1);
        root.selection-valid = true;
        if root.copy-selection-on-select {
            root.copy-selection();
        }
    }

    function paste-from-clipboard() {
        let text = root.read-clipboard();
        if root.connected && !text.is-empty {
            root.clear-selection();
            root.terminal-key(text, false, false, false, false, false);
        }
        ime-input.focus();
    }

    function forward-mouse-to-terminal(shift: bool, alt: bool) -> bool {
        return root.view.mouse_button_reporting
            && !shift
            && (!root.mouse-local-selection-priority || alt);
    }

    function apply-selection-range(selection: TerminalSemanticSelection) {
        if !selection.active {
            return;
        }
        root.selection-anchor-row = selection.anchor_row;
        root.selection-anchor-column = selection.anchor_column;
        root.selection-focus-row = selection.focus_row;
        root.selection-focus-column = selection.focus_column;
        root.selection-valid = true;
        root.selecting = false;
        root.clear-terminal-target-highlight();
        if root.copy-selection-on-select {
            root.copy-selection();
        }
        root.focus-input();
    }

    function apply-semantic-selection(row: int, column: int) {
        if root.last-pointer-shift
            || root.last-primary-target-activated
            || root.forward-mouse-to-terminal(root.last-pointer-shift, root.last-pointer-alt) {
            return;
        }
        root.apply-selection-range(root.semantic-selection-range(row, column));
    }

    function apply-line-selection(row: int, column: int) {
        if root.last-pointer-shift
            || root.last-primary-target-activated
            || root.forward-mouse-to-terminal(root.last-pointer-shift, root.last-pointer-alt) {
            return;
        }
        root.apply-selection-range(root.line-selection-range(row, column));
    }

    function queue-mouse-motion(
        row: int, column: int, button: int,
        shift: bool, alt: bool, control: bool,
    ) {
        if root.mouse-motion-pending
            && root.mouse-motion-row == row
            && root.mouse-motion-column == column
            && root.mouse-motion-button == button
            && root.mouse-motion-shift == shift
            && root.mouse-motion-alt == alt
            && root.mouse-motion-control == control {
            return;
        }
        root.mouse-motion-row = row;
        root.mouse-motion-column = column;
        root.mouse-motion-button = button;
        root.mouse-motion-shift = shift;
        root.mouse-motion-alt = alt;
        root.mouse-motion-control = control;
        root.mouse-motion-pending = true;
    }

    function flush-mouse-motion() {
        if root.mouse-motion-pending {
            root.mouse-motion-pending = false;
            root.mouse-event(
                root.mouse-motion-row,
                root.mouse-motion-column,
                root.mouse-motion-button,
                2,
                root.mouse-motion-shift,
                root.mouse-motion-alt,
                root.mouse-motion-control,
            );
        }
    }

    changed terminal-columns => { root.schedule-terminal-size-update(); }
    changed terminal-rows => { root.schedule-terminal-size-update(); }
    changed terminal-font-family => { root.schedule-terminal-size-update(); }
    changed terminal-font-size => { root.schedule-terminal-size-update(); }
    changed terminal-line-height-percent => { root.schedule-terminal-size-update(); }
    changed width => { root.schedule-terminal-size-update(); }
    changed height => { root.schedule-terminal-size-update(); }
    changed terminal-id => {
        root.mouse-motion-pending = false;
        root.pressed-button = -1;
        root.clear-selection();
        root.schedule-terminal-size-update();
        if root.focused && root.connected {
            root.focus-input();
        }
    }
    changed connected => {
        if !root.connected {
            root.mouse-motion-pending = false;
            root.pressed-button = -1;
            root.clear-selection();
        }
        root.schedule-terminal-size-update();
        if root.connected && root.focused {
            root.focus-input();
        }
    }
    changed focused => {
        if root.focused && root.connected {
            root.focus-input();
        } else {
            root.clear-selection();
        }
    }
    changed selection-revision => { root.clear-selection(); }
    changed edit-command-revision => {
        if root.focused {
            if root.edit-command == "copy" {
                root.copy-selection();
            } else if root.edit-command == "paste" {
                root.paste-from-clipboard();
            } else if root.edit-command == "select-all" {
                root.select-all-visible();
            }
        }
    }
    changed focus-request-revision => {
        if root.focused && root.connected {
            root.focus-input();
        }
    }
    changed visible => {
        if root.visible && root.focused && root.connected {
            root.focus-input();
        }
    }
    changed selecting => {
        if root.selecting {
            root.cursor-blink = true;
        }
    }
    changed selection-active => {
        // A selected range should remain visually stable. Reset the phase in
        // both directions so clearing a selection never leaves a hidden cursor.
        root.cursor-blink = true;
    }

    background: root.terminal-background;
    clip: true;
    forward-focus: ime-input;
    accessible-role: text;
    accessible-label: @tr("Terminal");

    cell-probe := Text {
        x: -1000px;
        y: -1000px;
        width: 0px;
        height: 0px;
        text: @tr("MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM");
        font-family: root.terminal-font-family;
        font-size: root.terminal-font-size;
        font-weight: 400;
        letter-spacing: 0px;
        opacity: 0;
    }

    wide-cell-probe := Text {
        x: -1000px;
        y: -1000px;
        width: 0px;
        height: 0px;
        text: "中中中中中中中中中中中中中中中中中中中中中中中中中";
        font-family: root.terminal-font-family;
        font-size: root.terminal-font-size;
        font-weight: 400;
        letter-spacing: 0px;
        opacity: 0;
    }

    symbol-cell-probe := Text {
        x: -1000px;
        y: -1000px;
        width: 0px;
        height: 0px;
        text: "┌─┐";
        font-family: root.terminal-font-family;
        font-size: root.terminal-font-size;
        font-weight: 400;
        letter-spacing: 0px;
        opacity: 0;
    }

    Timer {
        running: root.cursor-blink-enabled
            && root.connected && ime-input.has-focus && root.cursor-visible
            && !root.selecting && !root.selection-active;
        interval: 530ms;
        triggered => { root.cursor-blink = !root.cursor-blink; }
    }

    changed cursor-blink-enabled => { root.cursor-blink = true; }

    // Let font measurement and layout settle, then send at most one resize per
    // display frame while the native window is being dragged. The terminal
    // keeps its current snapshot between these bounded resize requests.
    Timer {
        running: root.terminal-resize-pending;
        interval: 16ms;
        triggered => {
            root.terminal-resize-pending = false;
            root.update-terminal-size();
            if root.presentation-layout-pending {
                root.presentation-layout-pending = false;
                root.update-presentation-layout();
            }
        }
    }

    // Pointer motion is lossy by design. Keep only the newest event per frame;
    // press/release/cancel explicitly flush this slot to preserve ordering.
    Timer {
        running: root.mouse-motion-pending;
        interval: 16ms;
        triggered => { root.flush-mouse-motion(); }
    }

    Timer {
        running: root.initial-input-focus-pending;
        interval: 1ms;
        triggered => {
            root.initial-input-focus-pending = false;
            if root.visible && root.focused && root.connected {
                root.focus-input();
            }
        }
    }

    ime-input := TextInput {
        x: grid-clip.x + max(0px, min(grid-clip.width - 1px,
            root.cursor-cell-x));
        y: grid-clip.y + root.cursor-cell-y;
        width: Theme.hairline;
        height: root.cell-height;
        opacity: 0;
        single-line: true;
        color: transparent;
        selection-foreground-color: transparent;
        selection-background-color: transparent;
        text-cursor-width: 0px;
        font-family: root.terminal-font-family;
        font-size: root.terminal-font-size;
        accessible-role: none;
        enabled: root.connected;

        changed has-focus => {
            if self.has-focus {
                root.cursor-blink = true;
            } else {
                root.clear-selection();
            }
        }
        key-pressed(event) => {
            if root.target-pointer-in-grid
                && !root.selecting
                && event.modifiers.control {
                root.terminal-target-highlight = root.terminal-target-at-cell(
                    root.target-pointer-row,
                    root.target-pointer-column,
                    event.modifiers.control,
                    event.modifiers.meta,
                );
            }
            if event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta {
                let pane-command =
                    (event.text == "h" || event.text == "H")
                        ? (event.modifiers.shift ? "split-left" : "focus-left")
                    : (event.text == "j" || event.text == "J")
                        ? (event.modifiers.shift ? "split-down" : "focus-down")
                    : (event.text == "k" || event.text == "K")
                        ? (event.modifiers.shift ? "split-up" : "focus-up")
                    : (event.text == "l" || event.text == "L")
                        ? (event.modifiers.shift ? "split-right" : "focus-right")
                    : "";
                if !pane-command.is-empty && root.pane-command(root.terminal-id, pane-command) {
                    return EventResult.accept;
                }
            }
            if !root.connected {
                return EventResult.reject;
            }
            let shortcut = root.format-shortcut(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
            );
            if shortcut == root.copy-selection-shortcut && root.selection-active {
                root.copy-selection();
                return EventResult.accept;
            }
            if shortcut == root.paste-shortcut {
                root.paste-from-clipboard();
                return EventResult.accept;
            }
            if shortcut == root.select-all-shortcut {
                root.select-all-visible();
                return EventResult.accept;
            }
            let direct-terminal-key = root.terminal-key-direct(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
                root.option-as-meta,
                self.preedit-text != "",
            );
            if !direct-terminal-key {
                return EventResult.reject;
            }
            root.clear-selection();
            if root.terminal-key(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
                true,
            ) {
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        key-released(event) => {
            if !event.modifiers.control {
                root.clear-terminal-target-highlight();
            }
            return EventResult.reject;
        }
        edited => {
            if !root.connected {
                self.text = "";
            } else if self.preedit-text == "" && self.text != "" {
                root.clear-selection();
                root.terminal-key(self.text, false, false, false, false, false);
                self.text = "";
            }
        }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        padding-bottom: 0px;

        Rectangle {
            height: root.closable ? Theme.terminal-pane-header-height : 0px;

            if root.closable : TerminalPaneCloseButton {
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                activated => { root.pane-command(root.terminal-id, "close"); }
            }
        }

        if root.notice.visible : TerminalNoticeBanner {
            width: parent.width;
            notice: root.notice;
            action(command) => { root.pane-command(root.terminal-id, command); }
        }

        grid-clip := Rectangle {
            vertical-stretch: 1;
            background: root.terminal-background;
            clip: true;

            TerminalGrid {
                width: parent.width;
                height: parent.height;
                view: root.grid-view;
                selection: root.grid-selection;
                cell-width: root.cell-width;
                cell-height: root.cell-height;
                font-cell-height: root.font-cell-height;
                top-offset: root.grid-top-offset;
                cursor-x: root.cursor-cell-x;
                cursor-y: root.cursor-cell-y;
                cursor-blink: root.cursor-blink;
                cursor-blink-enabled: root.cursor-blink-enabled;
                preedit-text: ime-input.preedit-text;
                right-click-pastes:
                    root.right-click-copy-or-paste || root.copy-selection-on-select;
                mouse-local-selection-priority: root.mouse-local-selection-priority;
                target-highlight: root.terminal-target-highlight;
                pointer-down(row, column, button, shift, alt, control, meta) => {
                    let left = button == 0;
                    let right = button == 2;
                    let report-mouse = root.forward-mouse-to-terminal(shift, alt);
                    root.flush-mouse-motion();
                    root.local-click-candidate = false;
                    root.target-pointer-row = row;
                    root.target-pointer-column = column;
                    root.target-pointer-in-grid = true;
                    root.last-pointer-shift = shift;
                    root.last-pointer-alt = alt;
                    root.last-pointer-control = control;
                    root.last-primary-target-activated = false;
                    root.focus-terminal();
                    root.pressed-button = -1;
                    if report-mouse {
                        root.selecting = false;
                        if button <= 2 {
                            root.pressed-button = button;
                            root.mouse-event(row, column, root.pressed-button, 0,
                                shift, alt, control);
                        }
                    }
                    if !report-mouse && left && !shift
                        && root.activate-terminal-target(row, column, control, meta) {
                        root.last-primary-target-activated = true;
                        root.clear-selection();
                    } else if !report-mouse && left {
                        root.selection-anchor-row = row;
                        root.selection-anchor-column = column;
                        root.selection-focus-row = row;
                        root.selection-focus-column = column;
                        root.selection-valid = false;
                        root.selecting = true;
                        root.local-click-candidate = root.view.mouse_button_reporting
                            && root.mouse-local-selection-priority
                            && !shift && !alt;
                        root.clear-terminal-target-highlight();
                    } else if !report-mouse && right
                        && (root.right-click-copy-or-paste || root.copy-selection-on-select) {
                        if root.copy-selection-on-select && root.connected {
                            root.paste-from-clipboard();
                        } else if root.selection-active {
                            root.copy-selection();
                            root.clear-selection();
                        } else if root.connected {
                            root.paste-from-clipboard();
                        }
                    }
                }
                pointer-moved(row, column, shift, alt, control, meta) => {
                    root.target-pointer-row = row;
                    root.target-pointer-column = column;
                    root.target-pointer-in-grid = true;
                    root.last-pointer-shift = shift;
                    root.last-pointer-alt = alt;
                    root.last-pointer-control = control;
                    if root.pressed-button >= 0 {
                        root.queue-mouse-motion(
                            row, column, root.pressed-button, shift, alt, control,
                        );
                    } else if root.selecting {
                        root.selection-focus-row = row;
                        root.selection-focus-column = column;
                        root.selection-valid = root.selection-anchor-row != row
                            || root.selection-anchor-column != column;
                        if root.selection-valid {
                            root.local-click-candidate = false;
                        }
                        root.clear-terminal-target-highlight();
                    } else if root.forward-mouse-to-terminal(shift, alt) {
                        root.queue-mouse-motion(row, column, 5, shift, alt, control);
                    } else {
                        root.terminal-target-highlight = root.terminal-target-at-cell(
                            row, column, control, meta,
                        );
                    }
                }
                pointer-hovered(hovered) => {
                    if !hovered {
                        root.target-pointer-in-grid = false;
                        root.clear-terminal-target-highlight();
                    }
                }
                pointer-up(row, column, _button, shift, alt, control) => {
                    root.last-pointer-shift = shift;
                    root.last-pointer-alt = alt;
                    root.last-pointer-control = control;
                    if root.pressed-button >= 0 {
                        root.flush-mouse-motion();
                        root.mouse-event(row, column,
                            root.pressed-button, 1,
                            shift, alt, control);
                        root.pressed-button = -1;
                    }
                    if root.selecting {
                        root.selection-focus-row = row;
                        root.selection-focus-column = column;
                        root.selection-valid = root.selection-anchor-row != row
                            || root.selection-anchor-column != column;
                        if root.selection-valid {
                            root.local-click-candidate = false;
                        }
                    }
                    if root.selecting && root.copy-selection-on-select && root.selection-active {
                        root.copy-selection();
                    }
                    if root.local-click-candidate {
                        root.mouse-event(row, column, 0, 0, shift, alt, control);
                        root.mouse-event(row, column, 0, 1, shift, alt, control);
                    }
                    root.local-click-candidate = false;
                    root.selecting = false;
                }
                pointer-cancel => {
                    if root.pressed-button >= 0 {
                        root.flush-mouse-motion();
                        root.mouse-event(
                            root.target-pointer-row,
                            root.target-pointer-column,
                            root.pressed-button,
                            1,
                            root.last-pointer-shift,
                            root.last-pointer-alt,
                            root.last-pointer-control,
                        );
                    }
                    root.pressed-button = -1;
                    root.mouse-motion-pending = false;
                    root.local-click-candidate = false;
                    root.selecting = false;
                }
                semantic-selection-request(row, column) => {
                    root.apply-semantic-selection(row, column);
                }
                line-selection-request(row, column) => {
                    root.apply-line-selection(row, column);
                }
                scrolled(row, column, lines, shift, alt, control) => {
                    if root.view.mouse_wheel_reporting && !shift {
                        root.mouse-event(
                            row,
                            column,
                            lines > 0 ? 3 : 4, 0, shift, alt, control);
                    } else {
                        root.clear-selection();
                        root.scrolled(lines);
                    }
                }
                copy-request => { root.copy-selection(); }
                paste-request => { root.paste-from-clipboard(); }
                select-all-request => { root.select-all-visible(); }
            }
        }
    }
}
